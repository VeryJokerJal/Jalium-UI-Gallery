<ResourceDictionary xmlns="http://schemas.jalium.ui/2024"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
                    xmlns:presentation="clr-namespace:Jalium.UI.Gallery.Modules.Main.Presentation">
    <Style x:Key="InspectorStepperButton" TargetType="RepeatButton">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource GalleryCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GalleryBorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GalleryTextPrimary}" />
    </Style>
    <Style TargetType="presentation:GalleryInspectorNumericStepper">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <ControlTemplate TargetType="presentation:GalleryInspectorNumericStepper">
                <Grid>
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters><Setter Property="Opacity" Value="0.55" /></VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                        <VisualStateGroup x:Name="FocusStates">
                            <VisualState x:Name="Unfocused" />
                            <VisualState x:Name="Focused">
                                <VisualState.Setters>
                                    <Setter TargetName="PART_ValueFrame" Property="BorderBrush" Value="{DynamicResource GalleryAccent}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{TemplateBinding Label}" FontSize="12" FontWeight="Medium"
                               Foreground="{DynamicResource GalleryTextSecondary}" VerticalAlignment="Center" />
                    <Border x:Name="PART_ValueFrame" Grid.Column="1" Background="{DynamicResource GalleryCardInnerBackground}"
                            BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <RepeatButton x:Name="PART_DecreaseButton" Style="{StaticResource InspectorStepperButton}"
                                          IsEnabled="{TemplateBinding CanDecrease}" ToolTip="{TemplateBinding DecreaseLabel}"
                                          automation:AutomationProperties.Name="{TemplateBinding DecreaseLabel}">
                                <Path Width="12" Height="12" Data="M 3,6 H 9" Stroke="{DynamicResource GalleryTextPrimary}" StrokeThickness="1.2" />
                            </RepeatButton>
                            <Border Width="56" Height="24" Margin="4,0" Background="{DynamicResource GalleryShellBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderSubtle}" BorderThickness="1" CornerRadius="5">
                                <TextBlock Text="{TemplateBinding DisplayValue}" FontFamily="{ThemeResource MonoFontFamily}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource GalleryTextPrimary}"
                                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <RepeatButton x:Name="PART_IncreaseButton" Style="{StaticResource InspectorStepperButton}"
                                          IsEnabled="{TemplateBinding CanIncrease}" ToolTip="{TemplateBinding IncreaseLabel}"
                                          automation:AutomationProperties.Name="{TemplateBinding IncreaseLabel}">
                                <Path Width="12" Height="12" Data="M 3,6 H 9 M 6,3 V 9" Stroke="{DynamicResource GalleryTextPrimary}" StrokeThickness="1.2" />
                            </RepeatButton>
                        </StackPanel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style TargetType="presentation:GalleryInspectorColorEditor">
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <ControlTemplate TargetType="presentation:GalleryInspectorColorEditor">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding Label}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextSecondary}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Background="{DynamicResource GalleryCardInnerBackground}"
                                BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" CornerRadius="7" Padding="6,3,8,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="14" Height="14" CornerRadius="4" Background="{TemplateBinding ColorBrush}"
                                        BorderBrush="{DynamicResource GalleryBorderStrong}" BorderThickness="1" Margin="0,0,6,0" />
                                <TextBlock Text="{TemplateBinding HexValue}" FontFamily="{ThemeResource MonoFontFamily}" FontSize="10.5"
                                           FontWeight="SemiBold" Foreground="{DynamicResource GalleryTextSecondary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ListBox x:Name="PART_Palette" ItemsSource="{TemplateBinding Swatches}" Margin="0,0,0,10" Background="Transparent"
                             SelectedItem="{Binding SelectedSwatch, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ListBox.Template><ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate></ListBox.Template>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
                                <Setter Property="Margin" Value="0,0,7,0" />
                                <Setter Property="Background" Value="{Binding Brush}" />
                                <Setter Property="ToolTip" Value="{Binding Hex}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource GalleryBorderStrong}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Template">
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource GalleryTextPrimary}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <presentation:GalleryInspectorNumericStepper Label="R" Minimum="0" Maximum="255" Step="5"
                        Value="{Binding Red, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <presentation:GalleryInspectorNumericStepper Label="G" Minimum="0" Maximum="255" Step="5"
                        Value="{Binding Green, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <presentation:GalleryInspectorNumericStepper Label="B" Minimum="0" Maximum="255" Step="5"
                        Value="{Binding Blue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
