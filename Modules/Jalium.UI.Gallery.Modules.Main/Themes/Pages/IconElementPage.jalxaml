<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for IconElementPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.IconElementPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <ItemsControl ItemsSource="{Binding FeaturedSymbols}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="80"
                                        Height="68"
                                        Padding="4,8,4,4"
                                        CornerRadius="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="{Binding Symbol}"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource GalleryTextPrimary}"
                                                    HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="72"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:IconElementPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="IconElement" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:IconElementPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <!--
        Hybrid page: the header and the two code-example cards live in markup;
        the interactive demo cards are built imperatively into DemoHost by
        CreateContent() using the GalleryUi factory (the C# mirror of the shared
        styles), so both halves render the identical card scaffold.
    -->
    <StackPanel x:Name="RootPanel" Style="{StaticResource GalleryPageStack}">

        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.P.IconElement.Eyebrow1}" Title="{DynamicResource Loc.P.IconElement.Title1}" Description="{DynamicResource Loc.P.IconElement.Sub1}" />

        <gallery:GallerySection Header="{DynamicResource Loc.P.IconElement.CT1}" Description="{DynamicResource Loc.P.IconElement.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <ItemsControl ItemsSource="{Binding FeaturedSymbols}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="80"
                                        Height="68"
                                        Padding="4,8,4,4"
                                        CornerRadius="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <SymbolIcon Symbol="{Binding Symbol}"
                                                    Width="24"
                                                    Height="24"
                                                    Foreground="{DynamicResource GalleryTextPrimary}"
                                                    HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="72"
                                                   Margin="0,4,0,0"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.IconElement.CT2}" Description="{DynamicResource Loc.P.IconElement.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <ItemsControl ItemsSource="{Binding FontIcons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="108"
                                        Height="76"
                                        Padding="4,8,4,4"
                                        CornerRadius="4">
                                    <StackPanel HorizontalAlignment="Center">
                                        <FontIcon Glyph="{Binding Glyph}"
                                                  FontSize="{Binding Size}"
                                                  Foreground="{Binding Foreground}"
                                                  Width="36"
                                                  Height="36"
                                                  HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.IconElement.CT3}" Description="{DynamicResource Loc.P.IconElement.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Horizontal">
                        <AppBarButton Label="Save" Icon="Save" IsCompact="True" MinWidth="40" Height="48" />
                        <AppBarButton Label="Undo" Icon="Undo" IsCompact="True" MinWidth="40" Height="48" />
                        <AppBarButton Label="Redo" Icon="Redo" IsCompact="True" MinWidth="40" Height="48" />
                        <AppBarSeparator Height="48" />
                        <AppBarButton Label="Start" Icon="Play" IsCompact="True" MinWidth="40" Height="48" Foreground="{DynamicResource GallerySuccessOnSurface}" />
                        <AppBarButton Label="Stop" Icon="Stop" IsCompact="True" MinWidth="40" Height="48" Foreground="{DynamicResource GalleryErrorOnSurface}" />
                        <AppBarSeparator Height="48" />
                        <AppBarButton Label="Debug" Icon="Bug" IsCompact="True" MinWidth="40" Height="48" />
                        <AppBarButton Label="Search" Icon="Find" IsCompact="True" MinWidth="40" Height="48" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.IconElement.CT4}" Description="{DynamicResource Loc.P.IconElement.CC4}">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding SymbolCategories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource GalleryValueLabel}"
                                           Margin="0,12,0,6" />
                                <gallery:GalleryDemoSurface>
                                    <ItemsControl ItemsSource="{Binding Symbols}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="80"
                                                        Height="68"
                                                        Padding="4,8,4,4"
                                                        CornerRadius="4">
                                                    <StackPanel HorizontalAlignment="Center">
                                                        <SymbolIcon Symbol="{Binding Symbol}"
                                                                    Width="24"
                                                                    Height="24"
                                                                    Foreground="{DynamicResource GalleryTextPrimary}"
                                                                    HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   MaxWidth="72"
                                                                   Margin="0,4,0,0"
                                                                   HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </gallery:GalleryDemoSurface>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.IconElement.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.IconElement.CC6}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>
    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
