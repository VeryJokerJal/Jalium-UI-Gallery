<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for RangeSliderPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.RangeSliderPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <RangeSlider x:Name="DemoRangeSlider"
                                     Minimum="0"
                                     Maximum="100"
                                     RangeStart="{Binding RangeStart, Mode=TwoWay}"
                                     RangeEnd="{Binding RangeEnd, Mode=TwoWay}"
                                     Height="24"
                                     Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Range" Margin="0,0,10,0" />
                            <Border Style="{StaticResource GalleryCodeBadge}">
                                <TextBlock x:Name="RangeStartLabel"
                                           Style="{StaticResource GalleryCodeBadgeText}"
                                           Text="{Binding RangeStartText}" />
                            </Border>
                            <Border Width="14" Height="2" CornerRadius="1"
                                    Background="{DynamicResource GalleryBorderStrong}"
                                    VerticalAlignment="Center"
                                    Margin="8,0" />
                            <Border Style="{StaticResource GalleryCodeBadge}">
                                <TextBlock x:Name="RangeEndLabel"
                                           Style="{StaticResource GalleryCodeBadgeText}"
                                           Text="{Binding RangeEndText}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:RangeSliderPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="RangeSlider" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:RangeSliderPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.BasicInput}" Title="{DynamicResource Loc.P.RangeSlider.Title1}" Description="{DynamicResource Loc.P.RangeSlider.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.RangeSlider.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <RangeSlider x:Name="DemoRangeSlider"
                                     Minimum="0"
                                     Maximum="100"
                                     RangeStart="{Binding RangeStart, Mode=TwoWay}"
                                     RangeEnd="{Binding RangeEnd, Mode=TwoWay}"
                                     Height="24"
                                     Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Range" Margin="0,0,10,0" />
                            <Border Style="{StaticResource GalleryCodeBadge}">
                                <TextBlock x:Name="RangeStartLabel"
                                           Style="{StaticResource GalleryCodeBadgeText}"
                                           Text="{Binding RangeStartText}" />
                            </Border>
                            <Border Width="14" Height="2" CornerRadius="1"
                                    Background="{DynamicResource GalleryBorderStrong}"
                                    VerticalAlignment="Center"
                                    Margin="8,0" />
                            <Border Style="{StaticResource GalleryCodeBadge}">
                                <TextBlock x:Name="RangeEndLabel"
                                           Style="{StaticResource GalleryCodeBadgeText}"
                                           Text="{Binding RangeEndText}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Minimum gap -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.RangeSlider.CT1}" Description="{DynamicResource Loc.P.RangeSlider.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.RangeSlider.Cap1}" Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="35"
                                     RangeEnd="65"
                                     MinimumRange="10"
                                     Height="24" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Snap to ticks -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.SnapToTicks}" Description="{DynamicResource Loc.P.RangeSlider.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="25"
                                     RangeEnd="75"
                                     TickFrequency="25"
                                     IsSnapToTickEnabled="True"
                                     Height="24" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Segmented track -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.SegmentedTrack}" Description="{DynamicResource Loc.P.RangeSlider.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.RangeSlider.Cap2}"
                                   Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="20"
                                     RangeEnd="80"
                                     TickFrequency="20"
                                     IsSnapToTickEnabled="True"
                                     TrackMode="Segmented"
                                     Height="24"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.RangeSlider.Cap3}"
                                   Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="30"
                                     RangeEnd="70"
                                     TickFrequency="10"
                                     IsSnapToTickEnabled="True"
                                     SegmentGap="2"
                                     TrackMode="Segmented"
                                     Height="24" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Custom bounds -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.RangeSlider.CT2}" Description="{DynamicResource Loc.P.RangeSlider.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.RangeSlider.Cap4}" Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="1000"
                                     RangeStart="100"
                                     RangeEnd="600"
                                     Height="24"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.RangeSlider.Cap5}" Margin="0,0,0,4" />
                        <RangeSlider Minimum="-20"
                                     Maximum="40"
                                     RangeStart="18"
                                     RangeEnd="24"
                                     Height="24" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.RangeSlider.CC6}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.RangeSlider.CC7}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
