<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for ToggleSwitchPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.ToggleSwitchPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <ToggleSwitch x:Name="WifiSwitch" Header="Wi-Fi" OnContent="On" OffContent="Off" Margin="0,0,0,16" />
                        <ToggleSwitch Header="Bluetooth" IsOn="True" OnContent="Enabled" OffContent="Disabled" Margin="0,0,0,16" />
                        <ToggleSwitch Header="Airplane Mode" Margin="0,0,0,16">
                            <ToggleSwitch.OnContent>
                                <SymbolIcon Symbol="Accept" Width="14" Height="14" />
                            </ToggleSwitch.OnContent>
                            <ToggleSwitch.OffContent>
                                <SymbolIcon Symbol="Cancel" Width="14" Height="14" />
                            </ToggleSwitch.OffContent>
                        </ToggleSwitch>
                        <ToggleSwitch Header="Dark Mode" IsEnabled="False" />
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:ToggleSwitchPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:ToggleSwitchPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.BasicInput}" Title="{DynamicResource Loc.P.ToggleSwitch.Title1}" Description="{DynamicResource Loc.P.ToggleSwitch.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.ToggleSwitch.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <ToggleSwitch x:Name="WifiSwitch" Header="Wi-Fi" OnContent="On" OffContent="Off" Margin="0,0,0,16" />
                        <ToggleSwitch Header="Bluetooth" IsOn="True" OnContent="Enabled" OffContent="Disabled" Margin="0,0,0,16" />
                        <ToggleSwitch Header="Airplane Mode" Margin="0,0,0,16">
                            <ToggleSwitch.OnContent>
                                <SymbolIcon Symbol="Accept" Width="14" Height="14" />
                            </ToggleSwitch.OnContent>
                            <ToggleSwitch.OffContent>
                                <SymbolIcon Symbol="Cancel" Width="14" Height="14" />
                            </ToggleSwitch.OffContent>
                        </ToggleSwitch>
                        <ToggleSwitch Header="Dark Mode" IsEnabled="False" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.ToggleSwitch.CC2}">
            <StackPanel>

                <StackPanel Orientation="Vertical">
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.ToggleSwitch.Body1}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.ToggleSwitch.Body2}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.ToggleSwitch.Body3}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.ToggleSwitch.Body4}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.ToggleSwitch.Body5}" />
                </StackPanel>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.ToggleSwitch.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.ToggleSwitch.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
