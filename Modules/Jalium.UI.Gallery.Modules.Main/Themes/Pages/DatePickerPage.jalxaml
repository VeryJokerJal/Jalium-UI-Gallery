<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for DatePickerPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.DatePickerPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <WrapPanel>
                        <DatePicker Width="200" Margin="0,0,10,10" />
                        <DatePicker Width="200" IsEnabled="False" Margin="0,0,10,10" />
                    </WrapPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:DatePickerPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="DatePicker" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:DatePickerPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.DateAndTime}" Title="{DynamicResource Loc.P.DatePicker.Title1}" Description="{DynamicResource Loc.P.DatePicker.Sub1}" />

        <!-- Basic DatePicker -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.DatePicker.CT1}" Description="{DynamicResource Loc.P.DatePicker.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <DatePicker Width="200" Margin="0,0,10,10" />
                        <DatePicker Width="200" IsEnabled="False" Margin="0,0,10,10" />
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Date formats -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.DatePicker.CT2}" Description="{DynamicResource Loc.P.DatePicker.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.DatePicker.Val1}" Width="120" />
                            <DatePicker Width="200" SelectedDateFormat="Short" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.DatePicker.Val2}" Width="120" />
                            <DatePicker Width="250" SelectedDateFormat="Long" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Date range constraints -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.DatePicker.CT3}" Description="{DynamicResource Loc.P.DatePicker.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.DatePicker.Val3}" Width="120" />
                            <DatePicker x:Name="StartDatePicker" Width="200" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.DatePicker.Val4}" Width="120" />
                            <DatePicker x:Name="EndDatePicker" Width="200" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo2}" Description="{DynamicResource Loc.P.DatePicker.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.DatePicker.Val5}" Width="120" />
                            <DatePicker x:Name="DemoDatePicker"
                                        Width="200"
                                        SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
                        </StackPanel>
                        <TextBlock x:Name="SelectedDateText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding SelectedDateText}" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Common use cases -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CommonUseCases}" Description="{DynamicResource Loc.P.DatePicker.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.DatePicker.Cap1}" Margin="0,0,0,4" />
                        <DatePicker Width="200" HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.DatePicker.Cap2}" Margin="0,0,0,4" />
                        <DatePicker Width="200" HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.DatePicker.Cap3}" Margin="0,0,0,4" />
                        <DatePicker Width="200" HorizontalAlignment="Left" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.XamlCodeExample}" Description="{DynamicResource Loc.P.DatePicker.CC6}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharpCodeExample}" Description="{DynamicResource Loc.P.DatePicker.CC7}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
