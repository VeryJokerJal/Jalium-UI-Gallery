<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for ComboBoxPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.ComboBoxPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <ComboBox PlaceholderText="{DynamicResource Loc.P.ComboBox.Ph1}"
                              ItemsSource="{Binding Fruits}"
                              Width="220" />

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:ComboBoxPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="ComboBox" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:ComboBoxPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel x:Name="ContentPanel" Style="{StaticResource GalleryPageStack}">

        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.BasicInput}" Title="{DynamicResource Loc.P.ComboBox.Title1}" Description="{DynamicResource Loc.P.ComboBox.Sub1}" />

        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Basic}" Description="{DynamicResource Loc.P.ComboBox.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <ComboBox PlaceholderText="{DynamicResource Loc.P.ComboBox.Ph1}"
                              ItemsSource="{Binding Fruits}"
                              Width="220" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.ComboBox.CT1}" Description="{DynamicResource Loc.P.ComboBox.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <ComboBox PlaceholderText="{DynamicResource Loc.P.ComboBox.Ph2}"
                              ItemsSource="{Binding Colors}"
                              SelectedItem="{Binding SelectedColor, Mode=TwoWay}"
                              Width="220" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.ComboBox.CT2}" Description="{DynamicResource Loc.P.ComboBox.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox PlaceholderText="{DynamicResource Loc.P.ComboBox.Ph3}"
                                  ItemsSource="{Binding Days}"
                                  SelectedItem="{Binding SelectedDay, Mode=TwoWay}"
                                  Width="220" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                  Margin="0,0,16,0" />
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding SelectedDayText}" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.ComboBox.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.ComboBox.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>
    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
