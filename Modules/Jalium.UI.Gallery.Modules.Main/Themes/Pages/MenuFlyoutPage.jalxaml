<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for MenuFlyoutPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.MenuFlyoutPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <Button Content="Show Menu"
                            Width="120"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding ExecuteBasicCommand}" CommandParameter="Open" />
                                <MenuItem Header="Edit" Command="{Binding ExecuteBasicCommand}" CommandParameter="Edit" />
                                <MenuItem Header="Rename" Command="{Binding ExecuteBasicCommand}" CommandParameter="Rename" />
                                <Separator />
                                <MenuItem Header="Share" Command="{Binding ExecuteBasicCommand}" CommandParameter="Share" />
                                <MenuItem Header="Delete" Command="{Binding ExecuteBasicCommand}" CommandParameter="Delete" />
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:MenuFlyoutPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="MenuFlyout" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:MenuFlyoutPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.MenusAndToolbars}" Title="{DynamicResource Loc.P.MenuFlyout.Title1}" Description="{DynamicResource Loc.P.MenuFlyout.Sub1}" />

        <gallery:GallerySection Header="{DynamicResource Loc.P.MenuFlyout.CT1}" Description="{DynamicResource Loc.P.MenuFlyout.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Button Content="Show Menu"
                            Width="120"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding ExecuteBasicCommand}" CommandParameter="Open" />
                                <MenuItem Header="Edit" Command="{Binding ExecuteBasicCommand}" CommandParameter="Edit" />
                                <MenuItem Header="Rename" Command="{Binding ExecuteBasicCommand}" CommandParameter="Rename" />
                                <Separator />
                                <MenuItem Header="Share" Command="{Binding ExecuteBasicCommand}" CommandParameter="Share" />
                                <MenuItem Header="Delete" Command="{Binding ExecuteBasicCommand}" CommandParameter="Delete" />
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>
                </gallery:GalleryDemoSurface>
                <TextBlock Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding BasicStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.MenuFlyout.CT2}" Description="{DynamicResource Loc.P.MenuFlyout.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Button Content="Show Icon Menu"
                            Width="140"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Cut}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Cut">
                                    <MenuItem.Icon><SymbolIcon Symbol="Cut" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Copy}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Copy">
                                    <MenuItem.Icon><SymbolIcon Symbol="Copy" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Paste"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Paste}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Paste">
                                    <MenuItem.Icon><SymbolIcon Symbol="Paste" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Undo"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Undo}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Undo">
                                    <MenuItem.Icon><SymbolIcon Symbol="Undo" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Redo"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Redo}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Redo">
                                    <MenuItem.Icon><SymbolIcon Symbol="Redo" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>
                </gallery:GalleryDemoSurface>
                <TextBlock Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding IconStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.P.MenuFlyout.CT3}" Description="{DynamicResource Loc.P.MenuFlyout.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Button Content="View Options"
                            Width="120"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Toolbar"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsToolbarVisible, Mode=TwoWay}" />
                                <MenuItem Header="Status Bar"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsStatusBarVisible, Mode=TwoWay}" />
                                <MenuItem Header="Sidebar"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="Minimap"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsMiniMapVisible, Mode=TwoWay}" />
                                <MenuItem Header="Breadcrumbs"
                                          IsCheckable="True"
                                          IsChecked="{Binding AreBreadcrumbsVisible, Mode=TwoWay}" />
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>
                </gallery:GalleryDemoSurface>
                <TextBlock Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding CheckStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.MenuFlyout.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.MenuFlyout.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>
    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
