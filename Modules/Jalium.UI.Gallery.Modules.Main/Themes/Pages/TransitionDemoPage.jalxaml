<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for TransitionDemoPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.TransitionDemoPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Transition Mode:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="TransitionComboBox"
                                      Width="220"
                                      Height="32"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                        </StackPanel>

                        <WrapPanel>
                            <Button x:Name="SwitchButton"
                                    Content="Switch Content"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SwitchContentCommand}" />
                            <Button x:Name="AutoPlayButton"
                                    Content="{Binding AutoPlayButtonText}"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding ToggleAutoPlayCommand}" />
                        </WrapPanel>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:TransitionDemoPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Content Transitions" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:TransitionDemoPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Effects}" Title="{DynamicResource Loc.P.TransitionDemo.Title1}" Description="{DynamicResource Loc.P.TransitionDemo.Sub1}" />

        <!-- Transition settings -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.TransitionDemo.CT1}" Description="{DynamicResource Loc.P.TransitionDemo.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Transition Mode:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="TransitionComboBox"
                                      Width="220" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                      Height="32"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                        </StackPanel>

                        <WrapPanel>
                            <Button x:Name="SwitchButton"
                                    Content="Switch Content"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SwitchContentCommand}" />
                            <Button x:Name="AutoPlayButton"
                                    Content="{Binding AutoPlayButtonText}"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding ToggleAutoPlayCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Live preview -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.TransitionDemo.CT2}" Description="{DynamicResource Loc.P.TransitionDemo.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel>
                        <Border Background="{DynamicResource GalleryEffectStage}"
                                CornerRadius="8"
                                Height="300"
                                ClipToBounds="True">
                            <TransitioningContentControl x:Name="TransitionControl"
                                                         TransitionMode="{Binding SelectedMode}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="120"
                                            Height="120"
                                            Background="{Binding ContentBackground}"
                                            CornerRadius="{Binding ContentCornerRadius}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,16">
                                        <TextBlock Text="{Binding ContentLetter}"
                                                   FontSize="48"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding ContentTitle}"
                                               FontSize="18"
                                               Foreground="{DynamicResource GalleryTextPrimary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </TransitioningContentControl>
                        </Border>
                        <TextBlock x:Name="CurrentTransitionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CurrentTransitionText}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.TransitionDemo.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13"/>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.TransitionDemo.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13"/>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
