<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for DesignTokensPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.DesignTokensPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <EditControl Height="220"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding TokenExample}" />

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:DesignTokensPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Design Tokens" />
        <Setter Property="CompactWidth" Value="480" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:DesignTokensPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact"><VisualState.Setters><Setter TargetName="ThemeActions" Property="Visibility" Value="Collapsed" /></VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.P.DesignTokens.Eyebrow1}" Title="{DynamicResource Loc.P.DesignTokens.Title1}" Description="{DynamicResource Loc.P.DesignTokens.Sub1}" />
            </StackPanel>
            <StackPanel x:Name="ThemeActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Top">
                <RadioButton Content="Light"
                             GroupName="DesignTokenThemes"
                             Style="{StaticResource GallerySegmentButton}"
                             IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                             Command="{Binding UseLightThemeCommand}"
                             Width="74"
                             Margin="0,0,6,0" />
                <RadioButton Content="Dark"
                             GroupName="DesignTokenThemes"
                             Style="{StaticResource GallerySegmentButton}"
                             IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                             Command="{Binding UseDarkThemeCommand}"
                             Width="74" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{Binding ActiveThemeLabel}"
                   Style="{StaticResource GalleryCaptionText}"
                   Margin="0,0,0,10" />

        <gallery:GallerySection Header="{DynamicResource Loc.P.DesignTokens.CT1}" Description="{DynamicResource Loc.P.DesignTokens.CC1}">
            <StackPanel>

                <ItemsControl ItemsSource="{Binding ColorTokens}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="210"
                                    Height="92"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10"
                                    Margin="0,0,10,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="54" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="8"
                                            Background="{Binding Preview}"
                                            VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource GalleryValueLabel}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Role}"
                                                   Style="{StaticResource GalleryCaptionText}"
                                                   FontSize="10" />
                                        <TextBlock Text="{Binding Value}"
                                                   Style="{StaticResource GalleryBodyText}"
                                                   FontFamily="{ThemeResource MonoFontFamily}"
                                                   FontSize="10"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </gallery:GallerySection>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.DesignTokens.CT2}" />
                <ItemsControl ItemsSource="{Binding TypeTokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource GalleryCaptionText}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Sample}"
                                           FontSize="{Binding Size}"
                                           FontWeight="{Binding Weight}"
                                           Foreground="{DynamicResource GalleryTextPrimary}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <gallery:GallerySection Header="{DynamicResource Loc.P.DesignTokens.CT3}" Description="{DynamicResource Loc.P.DesignTokens.CC2}">
            <StackPanel>

                <WrapPanel>
                    <StackPanel Width="400" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                Margin="0,0,28,0">
                        <TextBlock Style="{StaticResource GalleryEyebrow}"
                                   Text="{DynamicResource Loc.P.DesignTokens.Eyebrow2}" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.DesignTokens.Cap1}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding SpacingTokens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38"
                                          Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border Width="14"
                                                    Height="22"
                                                    Background="{DynamicResource GalleryAccentSoft}"
                                                    BorderBrush="{DynamicResource GalleryAccentOnSurface}"
                                                    BorderThickness="1"
                                                    CornerRadius="3" />
                                            <Border Width="{Binding Pixels}"
                                                    Background="Transparent" />
                                            <Border Width="14"
                                                    Height="22"
                                                    Background="{DynamicResource GalleryAccentSoft}"
                                                    BorderBrush="{DynamicResource GalleryAccentOnSurface}"
                                                    BorderThickness="1"
                                                    CornerRadius="3" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource GalleryValueLabel}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   Style="{StaticResource GalleryBodyText}"
                                                   FontFamily="{ThemeResource MonoFontFamily}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Usage}"
                                                   Style="{StaticResource GalleryCaptionText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Width="400" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}">
                        <TextBlock Style="{StaticResource GalleryEyebrow}"
                                   Text="{DynamicResource Loc.P.DesignTokens.Eyebrow3}" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.DesignTokens.Cap2}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding RadiusTokens}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="44"
                                          Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="78" />
                                            <ColumnDefinition Width="62" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="60"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource GalleryAccentSoft}"
                                                BorderBrush="{DynamicResource GalleryAccentOnSurface}"
                                                BorderThickness="1"
                                                CornerRadius="{Binding PreviewRadius}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Style="{StaticResource GalleryValueLabel}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   Style="{StaticResource GalleryBodyText}"
                                                   FontFamily="{ThemeResource MonoFontFamily}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Usage}"
                                                   Style="{StaticResource GalleryCaptionText}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </gallery:GallerySection>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.DesignTokens.CT4}" />
                <ItemsControl ItemsSource="{Binding MotionTokens}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource GalleryValueLabel}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           Style="{StaticResource GalleryBodyText}"
                                           FontFamily="{ThemeResource MonoFontFamily}" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Usage}"
                                           Style="{StaticResource GalleryCaptionText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.DesignTokens.CT5}" />
                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl Height="220"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding TokenExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </Border>
    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
