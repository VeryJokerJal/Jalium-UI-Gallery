<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for NetworkGraphPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.NetworkGraphPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <NetworkGraph Width="600"
                                  Height="450"
                                  LayoutAlgorithm="ForceDirected"
                                  ShowLabels="True"
                                  NodeRadius="12"
                                  IsNodeDraggable="False"
                                  Title="Social Network"
                                  Nodes="{Binding ForceNodes}"
                                  Links="{Binding ForceLinks}" />

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:NetworkGraphPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="NetworkGraph" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:NetworkGraphPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.DataVisualization}" Title="{DynamicResource Loc.P.NetworkGraph.Title1}" Description="{DynamicResource Loc.P.NetworkGraph.Sub1}" />

        <!-- Force-Directed Layout -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.NetworkGraph.CT1}" Description="{DynamicResource Loc.P.NetworkGraph.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <NetworkGraph Width="600" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                  Height="450"
                                  LayoutAlgorithm="ForceDirected"
                                  ShowLabels="True"
                                  NodeRadius="12"
                                  IsNodeDraggable="False"
                                  Title="Social Network"
                                  Nodes="{Binding ForceNodes}"
                                  Links="{Binding ForceLinks}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Circular Layout -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.NetworkGraph.CT2}" Description="{DynamicResource Loc.P.NetworkGraph.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <NetworkGraph Width="600" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                  Height="450"
                                  LayoutAlgorithm="Circular"
                                  ShowLabels="True"
                                  NodeRadius="14"
                                  IsNodeDraggable="False"
                                  Title="Module Dependencies"
                                  Nodes="{Binding CircularNodes}"
                                  Links="{Binding CircularLinks}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Interactive -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.NetworkGraph.CT3}" Description="{DynamicResource Loc.P.NetworkGraph.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <NetworkGraph Width="600" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                  Height="450"
                                  LayoutAlgorithm="ForceDirected"
                                  ShowLabels="True"
                                  NodeRadius="16"
                                  IsNodeDraggable="True"
                                  Title="Drag Nodes to Rearrange"
                                  Nodes="{Binding InteractiveNodes}"
                                  Links="{Binding InteractiveLinks}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.NetworkGraph.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.NetworkGraph.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
