<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for TitleBarPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.TitleBarPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <TitleBar x:Name="DemoTitleBar"
                                  Title="Jalium.UI Demo Window"
                                  ShowMinimizeButton="{Binding ShowMinimizeButton}"
                                  ShowMaximizeButton="{Binding ShowMaximizeButton}"
                                  ShowCloseButton="{Binding ShowCloseButton}"
                                  IsMaximized="{Binding IsMaximized}"
                                  behaviors:TitleBarCommandBehavior.MinimizeCommand="{Binding MinimizeCommand}"
                                  behaviors:TitleBarCommandBehavior.MaximizeRestoreCommand="{Binding MaximizeRestoreCommand}"
                                  behaviors:TitleBarCommandBehavior.CloseCommand="{Binding CloseCommand}"
                                  Height="36" />
                        <Border Background="{DynamicResource GalleryCardBackground}" Padding="16">
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="{DynamicResource Loc.P.TitleBar.Body1}" />
                        </Border>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:TitleBarPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:TitleBarPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.System}" Title="{DynamicResource Loc.P.TitleBar.Title1}" Description="{DynamicResource Loc.P.TitleBar.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.TitleBar.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <StackPanel Orientation="Vertical">
                        <TitleBar x:Name="DemoTitleBar"
                                  Title="Jalium.UI Demo Window"
                                  ShowMinimizeButton="{Binding ShowMinimizeButton}"
                                  ShowMaximizeButton="{Binding ShowMaximizeButton}"
                                  ShowCloseButton="{Binding ShowCloseButton}"
                                  IsMaximized="{Binding IsMaximized}"
                                  behaviors:TitleBarCommandBehavior.MinimizeCommand="{Binding MinimizeCommand}"
                                  behaviors:TitleBarCommandBehavior.MaximizeRestoreCommand="{Binding MaximizeRestoreCommand}"
                                  behaviors:TitleBarCommandBehavior.CloseCommand="{Binding CloseCommand}"
                                  Height="36" />
                        <Border Background="{DynamicResource GalleryCardBackground}" Padding="16">
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="{DynamicResource Loc.P.TitleBar.Body1}" />
                        </Border>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
                <WrapPanel Margin="0,16,0,0">
                    <CheckBox x:Name="MinimizeCheckBox" Content="Show Minimize" IsChecked="{Binding ShowMinimizeButton, Mode=TwoWay}" Margin="0,0,10,10" />
                    <CheckBox x:Name="MaximizeCheckBox" Content="Show Maximize" IsChecked="{Binding ShowMaximizeButton, Mode=TwoWay}" Margin="0,0,10,10" />
                    <CheckBox x:Name="CloseCheckBox" Content="Show Close" IsChecked="{Binding ShowCloseButton, Mode=TwoWay}" Margin="0,0,10,10" />
                    <CheckBox x:Name="IsMaximizedCheckBox" Content="Is Maximized" IsChecked="{Binding IsMaximized, Mode=TwoWay}" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding TitleBarStatus}"
                           Margin="0,6,0,0" />
            </StackPanel>
        </gallery:GallerySection>

        <!-- Notes -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.TitleBar.CT1}" Description="{DynamicResource Loc.P.TitleBar.CC2}">
            <StackPanel>

                <TextBlock Style="{StaticResource GalleryBodyText}"
                           Text="{DynamicResource Loc.P.TitleBar.Body2}"
                           Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}"
                           Text="{DynamicResource Loc.P.TitleBar.Body3}"
                           Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}"
                           Text="{DynamicResource Loc.P.TitleBar.Body4}" />
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.TitleBar.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.TitleBar.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
