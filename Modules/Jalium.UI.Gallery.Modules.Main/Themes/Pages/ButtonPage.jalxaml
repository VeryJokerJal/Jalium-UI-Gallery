<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for ButtonPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.ButtonPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CounterButton"
                                Content="Click Me"
                                Height="40"
                                Padding="20,0"
                                Command="{Binding IncrementCommand}" />
                        <TextBlock x:Name="CounterText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CounterText}"
                                   Margin="18,0,0,0" />
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:ButtonPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Button" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:ButtonPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <!--
        Reference layout for every gallery page. Structure:
          header (eyebrow + title + subtitle)  →  a stack of GalleryCard sections.
        Each card = title + caption + a GalleryDemoSurface holding the live demo.
        Control rows sit in a WrapPanel so they reflow on narrow / mobile widths.
        All visual tokens come from GalleryStyles.jalxaml — no inline style soup.
    -->

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.BasicInput}" Title="{DynamicResource Loc.P.Button.Title1}" Description="{DynamicResource Loc.P.Button.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.Button.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CounterButton"
                                Content="Click Me"
                                Height="40"
                                Padding="20,0"
                                Command="{Binding IncrementCommand}" />
                        <TextBlock x:Name="CounterText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CounterText}"
                                   Margin="18,0,0,0" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Basic button -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Basic}" Description="{DynamicResource Loc.P.Button.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Button Content="Click Me" Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Disabled" Height="40" Padding="20,0" Margin="0,0,10,10" IsEnabled="False" />
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Sizes -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Button.CT1}" Description="{DynamicResource Loc.P.Button.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Button Content="Small"  Height="30" Padding="14,0" FontSize="12" Margin="0,0,10,10" />
                        <Button Content="Medium" Height="38" Padding="18,0" FontSize="14" Margin="0,0,10,10" />
                        <Button Content="Large"  Height="46" Padding="24,0" FontSize="16" Margin="0,0,10,10" />
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Accent theming -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Button.CT2}" Description="{DynamicResource Loc.P.Button.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Button Content="Accent"
                                Background="{ThemeResource AccentBrush}"
                                BorderBrush="{ThemeResource AccentBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Hover"
                                Background="{ThemeResource AccentBrushHover}"
                                BorderBrush="{ThemeResource AccentBrushHover}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Pressed"
                                Background="{ThemeResource AccentBrushPressed}"
                                BorderBrush="{ThemeResource AccentBrushPressed}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Outlined"
                                Background="Transparent"
                                BorderBrush="{ThemeResource AccentBrush}"
                                BorderThickness="1.5"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Button.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Button.CC6}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
