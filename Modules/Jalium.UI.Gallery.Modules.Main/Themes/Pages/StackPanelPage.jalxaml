<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for StackPanelPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.StackPanelPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <Border Background="{DynamicResource GalleryAccent}" Height="40" Margin="0,0,0,8">
                            <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Height="40" Margin="0,0,0,8">
                            <TextBlock Foreground="Black" Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Height="40">
                            <TextBlock Foreground="Black" Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:StackPanelPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="StackPanel" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:StackPanelPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Layout}" Title="{DynamicResource Loc.P.StackPanel.Title1}" Description="{DynamicResource Loc.P.StackPanel.Sub1}" />

        <!-- Vertical StackPanel -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.StackPanel.CT1}" Description="{DynamicResource Loc.P.StackPanel.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <Border Background="{DynamicResource GalleryAccent}" Height="40" Margin="0,0,0,8">
                            <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Height="40" Margin="0,0,0,8">
                            <TextBlock Foreground="Black" Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Height="40">
                            <TextBlock Foreground="Black" Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Horizontal StackPanel -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.StackPanel.CT2}" Description="{DynamicResource Loc.P.StackPanel.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource GalleryAccent}" Width="100" Height="60" Margin="0,0,8,0">
                            <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Width="100" Height="60" Margin="0,0,8,0">
                            <TextBlock Foreground="Black" Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Width="100" Height="60">
                            <TextBlock Foreground="Black" Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Nested StackPanels -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.StackPanel.CT3}" Description="{DynamicResource Loc.P.StackPanel.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#CA5010" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="#CA5010" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="#CA5010" Width="60" Height="40"/>
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.StackPanel.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.StackPanel.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
