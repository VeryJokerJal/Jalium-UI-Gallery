<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for SparklinePage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.SparklinePage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Revenue" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Revenue}" LineBrush="#417EE0" ShowHighLowPoints="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Users" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Users}" LineBrush="#4CAF50" ShowHighLowPoints="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Latency" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Latency}" LineBrush="#FF9E22" ShowHighLowPoints="True" />
                        </StackPanel>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:SparklinePage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Sparkline" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:SparklinePage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.DataVisualization}" Title="{DynamicResource Loc.P.Sparkline.Title1}" Description="{DynamicResource Loc.P.Sparkline.Sub1}" />

        <!-- Line Sparklines -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Sparkline.CT1}" Description="{DynamicResource Loc.P.Sparkline.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Revenue" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Revenue}" LineBrush="#417EE0" ShowHighLowPoints="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Users" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Users}" LineBrush="#4CAF50" ShowHighLowPoints="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Latency" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Latency}" LineBrush="#FF9E22" ShowHighLowPoints="True" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Bar & Area -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Sparkline.CT2}" Description="{DynamicResource Loc.P.Sparkline.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Sales (Bar)" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="40" SparklineType="Bar" Values="{Binding Sales}" LineBrush="#417EE0" NegativeBarBrush="#E0593E" BaselineValue="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Traffic (Area)" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="40" SparklineType="Area" Values="{Binding Traffic}" LineBrush="#4CAF50" FillBrush="#3C4CAF50" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Win/Loss -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Sparkline.CT3}" Description="{DynamicResource Loc.P.Sparkline.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Team Alpha" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="WinLoss" Values="{Binding TeamAlpha}" WinColor="#4CAF50" LossColor="#E0593E" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Team Beta" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="WinLoss" Values="{Binding TeamBeta}" WinColor="#4CAF50" LossColor="#E0593E" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Team Gamma" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="WinLoss" Values="{Binding TeamGamma}" WinColor="#4CAF50" LossColor="#E0593E" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Sparkline.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Sparkline.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
