<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for TreeDataGridPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.TreeDataGridPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button x:Name="ExpandAllButton" Content="{DynamicResource Loc.P.TreeDataGrid.ExpandAll}"
                                    Command="{Binding ExpandAllCommand, ElementName=DemoTreeDataGrid}"
                                    Margin="0,0,10,10" />
                            <Button x:Name="CollapseAllButton" Content="{DynamicResource Loc.P.TreeDataGrid.CollapseAll}"
                                    Command="{Binding CollapseAllCommand, ElementName=DemoTreeDataGrid}"
                                    Margin="0,0,10,10" />
                        </WrapPanel>
                        <TreeDataGrid x:Name="DemoTreeDataGrid"
                                      Height="280"
                                      Margin="0,0,0,12"
                                      ChildrenPropertyPath="Children"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      SelectionMode="Single">
                            <TreeDataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.P.TreeDataGrid.Name}" Binding="{Binding Name}" Width="250" />
                                <DataGridTextColumn Header="{DynamicResource Loc.P.TreeDataGrid.Type}" Binding="{Binding Type}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Loc.P.TreeDataGrid.Size}" Binding="{Binding SizeDisplay}" Width="100" />
                            </TreeDataGrid.Columns>
                        </TreeDataGrid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.TreeDataGrid.Selected}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedItemText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding SelectedItemText}" />
                        </StackPanel>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:TreeDataGridPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="TreeDataGrid" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:TreeDataGridPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Collections}" Title="{DynamicResource Loc.P.TreeDataGrid.Title1}" Description="{DynamicResource Loc.P.TreeDataGrid.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.TreeDataGrid.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button x:Name="ExpandAllButton" Content="{DynamicResource Loc.P.TreeDataGrid.ExpandAll}"
                                    Command="{Binding ExpandAllCommand, ElementName=DemoTreeDataGrid}"
                                    Margin="0,0,10,10" />
                            <Button x:Name="CollapseAllButton" Content="{DynamicResource Loc.P.TreeDataGrid.CollapseAll}"
                                    Command="{Binding CollapseAllCommand, ElementName=DemoTreeDataGrid}"
                                    Margin="0,0,10,10" />
                        </WrapPanel>
                        <TreeDataGrid x:Name="DemoTreeDataGrid"
                                      Height="280"
                                      Margin="0,0,0,12"
                                      ChildrenPropertyPath="Children"
                                      ItemsSource="{Binding Items}"
                                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                      SelectionMode="Single">
                            <TreeDataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource Loc.P.TreeDataGrid.Name}" Binding="{Binding Name}" Width="250" />
                                <DataGridTextColumn Header="{DynamicResource Loc.P.TreeDataGrid.Type}" Binding="{Binding Type}" Width="120" />
                                <DataGridTextColumn Header="{DynamicResource Loc.P.TreeDataGrid.Size}" Binding="{Binding SizeDisplay}" Width="100" />
                            </TreeDataGrid.Columns>
                        </TreeDataGrid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.TreeDataGrid.Selected}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedItemText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding SelectedItemText}" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.TreeDataGrid.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body1}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body2}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body3}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body4}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body5}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body6}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body7}" />
                        <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.TreeDataGrid.Body8}" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.TreeDataGrid.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.TreeDataGrid.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
