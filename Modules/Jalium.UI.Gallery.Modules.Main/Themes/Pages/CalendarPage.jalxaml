<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for CalendarPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.CalendarPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <WrapPanel>
                        <Calendar x:Name="DemoCalendar"
                                  SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                  Margin="0,0,10,10" />
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Calendar.Cap1}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="SelectedDateText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding SelectedDateText}" />
                        </StackPanel>
                    </WrapPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:CalendarPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:CalendarPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Collections}" Title="{DynamicResource Loc.P.Calendar.Title1}" Description="{DynamicResource Loc.P.Calendar.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.Calendar.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Calendar x:Name="DemoCalendar"
                                  SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                  Margin="0,0,10,10" />
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Calendar.Cap1}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="SelectedDateText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding SelectedDateText}" />
                        </StackPanel>
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Selection modes and display constraints -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Calendar.CT1}" Description="{DynamicResource Loc.P.Calendar.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,18,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Calendar.Cap2}"
                                       Margin="0,0,0,6" />
                            <Calendar x:Name="RangeCalendar"
                                      SelectionMode="SingleRange" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,18,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Calendar.Cap3}"
                                       Margin="0,0,0,6" />
                            <Calendar x:Name="WeekStartCalendar"
                                      FirstDayOfWeek="Sunday"
                                      IsTodayHighlighted="False" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Calendar.Cap4}"
                                       Margin="0,0,0,6" />
                            <Calendar x:Name="DecadeCalendar"
                                      DisplayMode="Year" />
                        </StackPanel>
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.Calendar.CC2}">
            <StackPanel>

                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Calendar.Body1}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Calendar.Body2}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Calendar.Body3}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Calendar.Body4}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Calendar.Body5}" />
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Calendar.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Calendar.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
