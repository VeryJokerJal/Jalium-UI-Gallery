<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for RepeatButtonPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.RepeatButtonPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton x:Name="DecrementButton"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      ToolTip="Decrease"
                                      automation:AutomationProperties.Name="Decrease"
                                      Command="{Binding DecrementCommand}">
                            <SymbolIcon Symbol="Remove"
                                        Width="18"
                                        Height="18" />
                        </RepeatButton>
                        <TextBlock x:Name="CounterText"
                                   Text="{Binding Count}"
                                   Width="60"
                                   TextAlignment="Center"
                                   FontSize="24"
                                   VerticalAlignment="Center" />
                        <RepeatButton x:Name="IncrementButton"
                                      Width="40"
                                      Height="40"
                                      Margin="8,0,0,0"
                                      ToolTip="Increase"
                                      automation:AutomationProperties.Name="Increase"
                                      Command="{Binding IncrementCommand}">
                            <SymbolIcon Symbol="Add"
                                        Width="18"
                                        Height="18" />
                        </RepeatButton>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:RepeatButtonPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:RepeatButtonPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.BasicInput}" Title="{DynamicResource Loc.P.RepeatButton.Title1}" Description="{DynamicResource Loc.P.RepeatButton.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.RepeatButton.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton x:Name="DecrementButton"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      ToolTip="Decrease"
                                      automation:AutomationProperties.Name="Decrease"
                                      Command="{Binding DecrementCommand}">
                            <SymbolIcon Symbol="Remove"
                                        Width="18"
                                        Height="18" />
                        </RepeatButton>
                        <TextBlock x:Name="CounterText"
                                   Text="{Binding Count}"
                                   Width="60"
                                   TextAlignment="Center"
                                   FontSize="24"
                                   VerticalAlignment="Center" />
                        <RepeatButton x:Name="IncrementButton"
                                      Width="40"
                                      Height="40"
                                      Margin="8,0,0,0"
                                      ToolTip="Increase"
                                      automation:AutomationProperties.Name="Increase"
                                      Command="{Binding IncrementCommand}">
                            <SymbolIcon Symbol="Add"
                                        Width="18"
                                        Height="18" />
                        </RepeatButton>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.RepeatButton.CC2}">
            <StackPanel>

                <StackPanel>
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.RepeatButton.Body1}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.RepeatButton.Body2}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.RepeatButton.Body3}" />
                    <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.RepeatButton.Body4}" />
                </StackPanel>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.RepeatButton.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.RepeatButton.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
