                            <TextBlock Text="N=4" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="150" Height="100"
                                Shape="SuperEllipse" SuperEllipseN="4"
