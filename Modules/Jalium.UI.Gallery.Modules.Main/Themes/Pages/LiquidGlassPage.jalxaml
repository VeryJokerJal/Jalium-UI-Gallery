        </gallery:GallerySection>

        <!-- Usage Code -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Usage}" Description="{DynamicResource Loc.P.LiquidGlass.CC9}">
            <StackPanel>


                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&lt;!-- JALXAML --&gt;" FontSize="12"/>
                        <TextBlock Text="&lt;Border LiquidGlass=&quot;True&quot;" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="        CornerRadius=&quot;16&quot;" FontSize="12"/>
                        <TextBlock Text="        Background=&quot;#200078D4&quot;" FontSize="12"/>
                        <TextBlock Text="        LiquidGlassBlurRadius=&quot;8&quot;" FontSize="12"/>
                        <TextBlock Text="        LiquidGlassRefractionAmount=&quot;60&quot;" FontSize="12"/>
                        <TextBlock Text="        LiquidGlassChromaticAberration=&quot;0.5&quot; /&gt;" FontSize="12" Margin="0,0,0,12"/>

                        <TextBlock Text="// C# code-behind" FontSize="12"/>
                        <TextBlock Text="border.LiquidGlass = true;" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="border.LiquidGlassBlurRadius = 8;" FontSize="12"/>
                        <TextBlock Text="border.LiquidGlassRefractionAmount = 60;" FontSize="12"/>
                        <TextBlock Text="border.LiquidGlassChromaticAberration = 0.5;" FontSize="12"/>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML Code Example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.LiquidGlass.CC10}">
            <StackPanel>

                <gallery:GalleryDemoSurface
                        HorizontalAlignment="Stretch" Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# Code Example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.LiquidGlass.CC11}">
            <StackPanel>

                <gallery:GalleryDemoSurface
                        HorizontalAlignment="Stretch" Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
