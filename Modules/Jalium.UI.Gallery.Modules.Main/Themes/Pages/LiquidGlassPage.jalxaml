<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for LiquidGlassPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.LiquidGlassPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF6B6B"/>
                                <Border Width="40" Height="40" Background="#4ECDC4"/>
                                <Border Width="40" Height="40" Background="#45B7D1"/>
                                <Border Width="40" Height="40" Background="#96CEB4"/>
                                <Border Width="40" Height="40" Background="#FFEAA7"/>
                                <Border Width="40" Height="40" Background="#A0DDB4"/>
                                <Border Width="40" Height="40" Background="#98D8C8"/>
                                <Border Width="40" Height="40" Background="#F7DC6F"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#1EE962"/>
                                <Border Width="40" Height="40" Background="#27B055"/>
                                <Border Width="40" Height="40" Background="#3AB764"/>
                                <Border Width="40" Height="40" Background="#3F51B5"/>
                                <Border Width="40" Height="40" Background="#2196F3"/>
                                <Border Width="40" Height="40" Background="#03A9F4"/>
                                <Border Width="40" Height="40" Background="#00BCD4"/>
                                <Border Width="40" Height="40" Background="#009688"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#4CAF50"/>
                                <Border Width="40" Height="40" Background="#8BC34A"/>
                                <Border Width="40" Height="40" Background="#CDDC39"/>
                                <Border Width="40" Height="40" Background="#FFEB3B"/>
                                <Border Width="40" Height="40" Background="#FFC107"/>
                                <Border Width="40" Height="40" Background="#FF9800"/>
                                <Border Width="40" Height="40" Background="#FF5722"/>
                                <Border Width="40" Height="40" Background="#795548"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#FF7F00"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#00822B"/>
                                <Border Width="40" Height="40" Background="#00D346"/>
                                <Border Width="40" Height="40" Background="#14FF62"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Liquid glass overlay -->
                        <Border x:Name="DefaultGlassDemo"
                                Margin="30"
                                CornerRadius="16"
                                LiquidGlass="True"
                                LiquidGlassInteractive="True"
                                Background="#200078D4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Liquid Glass"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:LiquidGlassPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Liquid Glass" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:LiquidGlassPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Effects}" Title="{DynamicResource Loc.P.LiquidGlass.Title1}" Description="{DynamicResource Loc.P.LiquidGlass.Sub1}" />

        <!-- Default Liquid Glass -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT1}" Description="{DynamicResource Loc.P.LiquidGlass.CC1}">
            <StackPanel>


                <gallery:GalleryDemoSurface  Height="200">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF6B6B"/>
                                <Border Width="40" Height="40" Background="#4ECDC4"/>
                                <Border Width="40" Height="40" Background="#45B7D1"/>
                                <Border Width="40" Height="40" Background="#96CEB4"/>
                                <Border Width="40" Height="40" Background="#FFEAA7"/>
                                <Border Width="40" Height="40" Background="#A0DDB4"/>
                                <Border Width="40" Height="40" Background="#98D8C8"/>
                                <Border Width="40" Height="40" Background="#F7DC6F"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#1EE962"/>
                                <Border Width="40" Height="40" Background="#27B055"/>
                                <Border Width="40" Height="40" Background="#3AB764"/>
                                <Border Width="40" Height="40" Background="#3F51B5"/>
                                <Border Width="40" Height="40" Background="#2196F3"/>
                                <Border Width="40" Height="40" Background="#03A9F4"/>
                                <Border Width="40" Height="40" Background="#00BCD4"/>
                                <Border Width="40" Height="40" Background="#009688"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#4CAF50"/>
                                <Border Width="40" Height="40" Background="#8BC34A"/>
                                <Border Width="40" Height="40" Background="#CDDC39"/>
                                <Border Width="40" Height="40" Background="#FFEB3B"/>
                                <Border Width="40" Height="40" Background="#FFC107"/>
                                <Border Width="40" Height="40" Background="#FF9800"/>
                                <Border Width="40" Height="40" Background="#FF5722"/>
                                <Border Width="40" Height="40" Background="#795548"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#FF7F00"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#00822B"/>
                                <Border Width="40" Height="40" Background="#00D346"/>
                                <Border Width="40" Height="40" Background="#14FF62"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Liquid glass overlay -->
                        <Border x:Name="DefaultGlassDemo"
                                Margin="30"
                                CornerRadius="16"
                                LiquidGlass="True"
                                LiquidGlassInteractive="True"
                                Background="#200078D4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Liquid Glass"
                                       FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Chromatic Aberration Demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT2}" Description="{DynamicResource Loc.P.LiquidGlass.CC2}">
            <StackPanel>


                <gallery:GalleryDemoSurface  Height="200">
                    <Grid>
                        <!-- Colorful background -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#FF4000"/>
                                <Border Width="40" Height="40" Background="#FF8000"/>
                                <Border Width="40" Height="40" Background="#FFC000"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#C0FF00"/>
                                <Border Width="40" Height="40" Background="#80FF00"/>
                                <Border Width="40" Height="40" Background="#40FF00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#00FF40"/>
                                <Border Width="40" Height="40" Background="#00FF80"/>
                                <Border Width="40" Height="40" Background="#00FFC0"/>
                                <Border Width="40" Height="40" Background="#00FFFF"/>
                                <Border Width="40" Height="40" Background="#00C0FF"/>
                                <Border Width="40" Height="40" Background="#0080FF"/>
                                <Border Width="40" Height="40" Background="#0040FF"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#1ABC9C"/>
                                <Border Width="40" Height="40" Background="#2ECC71"/>
                                <Border Width="40" Height="40" Background="#3498DB"/>
                                <Border Width="40" Height="40" Background="#59B678"/>
                                <Border Width="40" Height="40" Background="#E74C3C"/>
                                <Border Width="40" Height="40" Background="#F39C12"/>
                                <Border Width="40" Height="40" Background="#E67E22"/>
                                <Border Width="40" Height="40" Background="#34495E"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Liquid glass with chromatic aberration -->
                        <Border x:Name="ChromaticGlassDemo"
                                Margin="30"
                                CornerRadius="16"
                                LiquidGlass="True"
                                LiquidGlassInteractive="True"
                                LiquidGlassChromaticAberration="0.5"
                                Background="#200078D4"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Chromatic Aberration (0.5)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Different Corner Radii -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT3}" Description="{DynamicResource Loc.P.LiquidGlass.CC3}">
            <StackPanel>


                <WrapPanel>
                    <!-- Sharp corners -->
                    <gallery:GalleryDemoSurface  Width="160" Height="160" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="#FF6B6B"/>
                                    <Border Width="30" Height="30" Background="#4ECDC4"/>
                                    <Border Width="30" Height="30" Background="#45B7D1"/>
                                    <Border Width="30" Height="30" Background="#FFEAA7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#1EE962"/>
                                    <Border Width="30" Height="30" Background="#27B055"/>
                                    <Border Width="30" Height="30" Background="#2196F3"/>
                                    <Border Width="30" Height="30" Background="#4CAF50"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#FF9800"/>
                                    <Border Width="30" Height="30" Background="#FFEB3B"/>
                                    <Border Width="30" Height="30" Background="#00BCD4"/>
                                    <Border Width="30" Height="30" Background="#8BC34A"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#FF5722"/>
                                    <Border Width="30" Height="30" Background="#795548"/>
                                    <Border Width="30" Height="30" Background="#607D8B"/>
                                    <Border Width="30" Height="30" Background="#9E9E9E"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="SharpGlassDemo"
                                    Margin="12"
                                    CornerRadius="0"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#200078D4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="R=0"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>

                    <!-- Small radius -->
                    <gallery:GalleryDemoSurface  Width="160" Height="160" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="#1EE962"/>
                                    <Border Width="30" Height="30" Background="#27B055"/>
                                    <Border Width="30" Height="30" Background="#3AB764"/>
                                    <Border Width="30" Height="30" Background="#3F51B5"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#2196F3"/>
                                    <Border Width="30" Height="30" Background="#03A9F4"/>
                                    <Border Width="30" Height="30" Background="#00BCD4"/>
                                    <Border Width="30" Height="30" Background="#009688"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#4CAF50"/>
                                    <Border Width="30" Height="30" Background="#8BC34A"/>
                                    <Border Width="30" Height="30" Background="#CDDC39"/>
                                    <Border Width="30" Height="30" Background="#FFEB3B"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#FFC107"/>
                                    <Border Width="30" Height="30" Background="#FF9800"/>
                                    <Border Width="30" Height="30" Background="#FF5722"/>
                                    <Border Width="30" Height="30" Background="#795548"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="SmallRadiusGlassDemo"
                                    Margin="12"
                                    CornerRadius="14"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#200078D4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="R=8"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>

                    <!-- Large radius -->
                    <gallery:GalleryDemoSurface  Width="160" Height="160" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="#FF0000"/>
                                    <Border Width="30" Height="30" Background="#00FF00"/>
                                    <Border Width="30" Height="30" Background="#0000FF"/>
                                    <Border Width="30" Height="30" Background="#FFFF00"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#00FF55"/>
                                    <Border Width="30" Height="30" Background="#00FFFF"/>
                                    <Border Width="30" Height="30" Background="#FF8000"/>
                                    <Border Width="30" Height="30" Background="#00FF55"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#00FF55"/>
                                    <Border Width="30" Height="30" Background="#80FF00"/>
                                    <Border Width="30" Height="30" Background="#0080FF"/>
                                    <Border Width="30" Height="30" Background="#FF8080"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#80FF80"/>
                                    <Border Width="30" Height="30" Background="#8080FF"/>
                                    <Border Width="30" Height="30" Background="#FFFF80"/>
                                    <Border Width="30" Height="30" Background="#80FFFF"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="LargeRadiusGlassDemo"
                                    Margin="12"
                                    CornerRadius="24"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#200078D4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="R=24"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>

                    <!-- Circle (pill) -->
                    <gallery:GalleryDemoSurface  Width="160" Height="160" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="#1ABC9C"/>
                                    <Border Width="30" Height="30" Background="#2ECC71"/>
                                    <Border Width="30" Height="30" Background="#3498DB"/>
                                    <Border Width="30" Height="30" Background="#59B678"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#E74C3C"/>
                                    <Border Width="30" Height="30" Background="#F39C12"/>
                                    <Border Width="30" Height="30" Background="#E67E22"/>
                                    <Border Width="30" Height="30" Background="#34495E"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#16A085"/>
                                    <Border Width="30" Height="30" Background="#27AE60"/>
                                    <Border Width="30" Height="30" Background="#2980B9"/>
                                    <Border Width="30" Height="30" Background="#44AD67"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#D35400"/>
                                    <Border Width="30" Height="30" Background="#C0392B"/>
                                    <Border Width="30" Height="30" Background="#BDC3C7"/>
                                    <Border Width="30" Height="30" Background="#7F8C8D"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="PillGlassDemo"
                                    Margin="12"
                                    CornerRadius="60"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#200078D4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="R=60"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>
                </WrapPanel>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Tinted Glass -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT4}" Description="{DynamicResource Loc.P.LiquidGlass.CC4}">
            <StackPanel>


                <WrapPanel>
                    <!-- Blue tint -->
                    <gallery:GalleryDemoSurface  Width="200" Height="140" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" Background="#FF6B6B"/>
                                    <Border Width="40" Height="40" Background="#4ECDC4"/>
                                    <Border Width="40" Height="40" Background="#45B7D1"/>
                                    <Border Width="40" Height="40" Background="#FFEAA7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="40" Height="40" Background="#1EE962"/>
                                    <Border Width="40" Height="40" Background="#4CAF50"/>
                                    <Border Width="40" Height="40" Background="#FF9800"/>
                                    <Border Width="40" Height="40" Background="#27B055"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="BlueTintGlass"
                                    Margin="16"
                                    CornerRadius="16"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#400078D4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="Blue Tint"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>

                    <!-- Green tint -->
                    <gallery:GalleryDemoSurface  Width="200" Height="140" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" Background="#FF6B6B"/>
                                    <Border Width="40" Height="40" Background="#4ECDC4"/>
                                    <Border Width="40" Height="40" Background="#45B7D1"/>
                                    <Border Width="40" Height="40" Background="#FFEAA7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="40" Height="40" Background="#1EE962"/>
                                    <Border Width="40" Height="40" Background="#4CAF50"/>
                                    <Border Width="40" Height="40" Background="#FF9800"/>
                                    <Border Width="40" Height="40" Background="#27B055"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="GreenTintGlass"
                                    Margin="16"
                                    CornerRadius="16"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#4000C853"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="Green Tint"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>

                    <!-- Purple tint -->
                    <gallery:GalleryDemoSurface  Width="200" Height="140" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40" Height="40" Background="#FF6B6B"/>
                                    <Border Width="40" Height="40" Background="#4ECDC4"/>
                                    <Border Width="40" Height="40" Background="#45B7D1"/>
                                    <Border Width="40" Height="40" Background="#FFEAA7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="40" Height="40" Background="#1EE962"/>
                                    <Border Width="40" Height="40" Background="#4CAF50"/>
                                    <Border Width="40" Height="40" Background="#FF9800"/>
                                    <Border Width="40" Height="40" Background="#27B055"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="PurpleTintGlass"
                                    Margin="16"
                                    CornerRadius="16"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    Background="#4027B055"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock Text="Purple Tint"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>
                </WrapPanel>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Interactive Parameters -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT5}" Description="{DynamicResource Loc.P.LiquidGlass.CC5}">
            <StackPanel>


                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preview area -->
                    <gallery:GalleryDemoSurface  Height="240" Margin="0,0,16,0">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="50" Height="50" Background="#FF6B6B"/>
                                    <Border Width="50" Height="50" Background="#4ECDC4"/>
                                    <Border Width="50" Height="50" Background="#45B7D1"/>
                                    <Border Width="50" Height="50" Background="#96CEB4"/>
                                    <Border Width="50" Height="50" Background="#FFEAA7"/>
                                    <Border Width="50" Height="50" Background="#A0DDB4"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="50" Height="50" Background="#1EE962"/>
                                    <Border Width="50" Height="50" Background="#27B055"/>
                                    <Border Width="50" Height="50" Background="#2196F3"/>
                                    <Border Width="50" Height="50" Background="#4CAF50"/>
                                    <Border Width="50" Height="50" Background="#FF9800"/>
                                    <Border Width="50" Height="50" Background="#795548"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="50" Height="50" Background="#FF0000"/>
                                    <Border Width="50" Height="50" Background="#00FF00"/>
                                    <Border Width="50" Height="50" Background="#0000FF"/>
                                    <Border Width="50" Height="50" Background="#FFFF00"/>
                                    <Border Width="50" Height="50" Background="#00FF55"/>
                                    <Border Width="50" Height="50" Background="#00FFFF"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Width="50" Height="50" Background="#1ABC9C"/>
                                    <Border Width="50" Height="50" Background="#F39C12"/>
                                    <Border Width="50" Height="50" Background="#E74C3C"/>
                                    <Border Width="50" Height="50" Background="#3498DB"/>
                                    <Border Width="50" Height="50" Background="#44AD67"/>
                                    <Border Width="50" Height="50" Background="#2C3E50"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="InteractiveGlassDemo"
                                    Margin="40"
                                    CornerRadius="16"
                                    LiquidGlass="True"
                                    LiquidGlassInteractive="True"
                                    LiquidGlassBlurRadius="{Binding BlurRadius}"
                                    LiquidGlassRefractionAmount="{Binding RefractionAmount}"
                                    LiquidGlassChromaticAberration="{Binding ChromaticAberration}"
                                    Background="#200078D4"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <TextBlock x:Name="InteractiveLabel"
                                           Text="{Binding SettingsSummary}"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>

                    <!-- Controls -->
                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Blur Radius" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="BlurSlider"
                                Minimum="1"
                                Maximum="30"
                                Value="{Binding BlurRadius, Mode=TwoWay}"
                                Margin="0,0,0,12"/>

                        <TextBlock Text="Refraction Amount" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="RefractionSlider"
                                Minimum="0"
                                Maximum="120"
                                Value="{Binding RefractionAmount, Mode=TwoWay}"
                                Margin="0,0,0,12"/>

                        <TextBlock Text="Chromatic Aberration" FontSize="12" Margin="0,0,0,4"/>
                        <Slider x:Name="ChromaticSlider"
                                Minimum="0"
                                Maximum="1"
                                Value="{Binding ChromaticAberration, Mode=TwoWay}"
                                Margin="0,0,0,12"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Fusion Demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT6}" Description="{DynamicResource Loc.P.LiquidGlass.CC6}">
            <StackPanel>


                <gallery:GalleryDemoSurface  Height="280">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="50" Height="50" Background="#FF6B6B"/>
                                <Border Width="50" Height="50" Background="#4ECDC4"/>
                                <Border Width="50" Height="50" Background="#45B7D1"/>
                                <Border Width="50" Height="50" Background="#96CEB4"/>
                                <Border Width="50" Height="50" Background="#FFEAA7"/>
                                <Border Width="50" Height="50" Background="#A0DDB4"/>
                                <Border Width="50" Height="50" Background="#98D8C8"/>
                                <Border Width="50" Height="50" Background="#F7DC6F"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="50" Height="50" Background="#1EE962"/>
                                <Border Width="50" Height="50" Background="#27B055"/>
                                <Border Width="50" Height="50" Background="#3AB764"/>
                                <Border Width="50" Height="50" Background="#3F51B5"/>
                                <Border Width="50" Height="50" Background="#2196F3"/>
                                <Border Width="50" Height="50" Background="#03A9F4"/>
                                <Border Width="50" Height="50" Background="#00BCD4"/>
                                <Border Width="50" Height="50" Background="#009688"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="50" Height="50" Background="#4CAF50"/>
                                <Border Width="50" Height="50" Background="#8BC34A"/>
                                <Border Width="50" Height="50" Background="#CDDC39"/>
                                <Border Width="50" Height="50" Background="#FFEB3B"/>
                                <Border Width="50" Height="50" Background="#FFC107"/>
                                <Border Width="50" Height="50" Background="#FF9800"/>
                                <Border Width="50" Height="50" Background="#FF5722"/>
                                <Border Width="50" Height="50" Background="#795548"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="50" Height="50" Background="#FF0000"/>
                                <Border Width="50" Height="50" Background="#FF7F00"/>
                                <Border Width="50" Height="50" Background="#FFFF00"/>
                                <Border Width="50" Height="50" Background="#00FF00"/>
                                <Border Width="50" Height="50" Background="#0000FF"/>
                                <Border Width="50" Height="50" Background="#00822B"/>
                                <Border Width="50" Height="50" Background="#00D346"/>
                                <Border Width="50" Height="50" Background="#14FF62"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Two adjacent liquid glass panels with ~20px gap (within fusionRadius=30) -->
                        <!-- Both are siblings in the same Grid (Panel.Children) so neighbor discovery works -->
                        <Border CornerRadius="16"
                                LiquidGlass="True"
                                LiquidGlassInteractive="True"
                                Background="#200078D4"
                                Width="200" Height="180"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,210,0">
                            <TextBlock Text="Panel A"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Border CornerRadius="16"
                                LiquidGlass="True"
                                LiquidGlassInteractive="True"
                                Background="#200078D4"
                                Width="200" Height="180"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="210,0,0,0">
                            <TextBlock Text="Panel B"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- SuperEllipse Shape -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.LiquidGlass.CT7}" Description="{DynamicResource Loc.P.LiquidGlass.CC7}">
            <StackPanel>


                <WrapPanel>
                    <!-- N=2 (Ellipse) -->
                    <gallery:GalleryDemoSurface  Width="160" Height="160" Margin="0,0,10,10">
                        <Grid>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" Background="#FF6B6B"/>
                                    <Border Width="30" Height="30" Background="#4ECDC4"/>
                                    <Border Width="30" Height="30" Background="#45B7D1"/>
                                    <Border Width="30" Height="30" Background="#FFEAA7"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border Width="30" Height="30" Background="#1EE962"/>
