                                <TextBlock Text="N=10"
                                           FontSize="11"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </gallery:GalleryDemoSurface>
                </WrapPanel>

                <!-- Non-glass superellipse demo -->
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.LiquidGlass.CC8}"
                           Margin="0,4,0,12" />
                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Border Width="100" Height="100"
                                Shape="SuperEllipse" SuperEllipseN="4"
                                Background="#400078D4" BorderBrush="{DynamicResource GalleryAccent}" BorderThickness="2"
                                Margin="0,0,10,10">
                            <TextBlock Text="N=4" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="100" Height="100"
                                Shape="SuperEllipse" SuperEllipseN="4"
                                Background="#4000C853" BorderBrush="#00C853" BorderThickness="2"
                                Margin="0,0,10,10">
                            <TextBlock Text="N=4" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="100" Height="100"
                                Shape="SuperEllipse" SuperEllipseN="4"
                                Background="#4027B055" BorderBrush="#27B055" BorderThickness="2"
