<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for ThumbPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.ThumbPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel>
                        <Border Background="{DynamicResource GalleryCardBackground}"
                                Height="40"
                                CornerRadius="8"
                                Margin="0,0,0,16">
                            <Canvas>
                                <Thumb x:Name="DemoThumb"
                                       Width="20"
                                       Height="36"
                                       Canvas.Left="{Binding Left}"
                                       Canvas.Top="{Binding Top}"
                                       behaviors:ThumbCommandBehavior.DragStartedCommand="{Binding DragStartedCommand}"
                                       behaviors:ThumbCommandBehavior.DragDeltaCommand="{Binding DragDeltaCommand}"
                                       behaviors:ThumbCommandBehavior.DragCompletedCommand="{Binding DragCompletedCommand}" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="ThumbPositionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding PositionText}" />
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:ThumbPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:ThumbPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.StatusAndInfo}" Title="{DynamicResource Loc.P.Thumb.Title1}" Description="{DynamicResource Loc.P.Thumb.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.Thumb.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel>
                        <Border Background="{DynamicResource GalleryCardBackground}"
                                Height="40"
                                CornerRadius="8"
                                Margin="0,0,0,16">
                            <Canvas>
                                <Thumb x:Name="DemoThumb"
                                       Width="20"
                                       Height="36"
                                       Canvas.Left="{Binding Left}"
                                       Canvas.Top="{Binding Top}"
                                       behaviors:ThumbCommandBehavior.DragStartedCommand="{Binding DragStartedCommand}"
                                       behaviors:ThumbCommandBehavior.DragDeltaCommand="{Binding DragDeltaCommand}"
                                       behaviors:ThumbCommandBehavior.DragCompletedCommand="{Binding DragCompletedCommand}" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="ThumbPositionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding PositionText}" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.Thumb.CC2}">
            <StackPanel>

                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Thumb.Body1}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Thumb.Body2}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Thumb.Body3}" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.Shared.CustomizableAppearance}" />
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Thumb.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Thumb.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
