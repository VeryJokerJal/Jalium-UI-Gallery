<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for RazorVirtualizePage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.RazorVirtualizePage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <!-- The block sits directly inside the ScrollViewer, which is what lets the
                         generated host reuse that viewport instead of building its own. The
                         explicit height is what bounds the scrolling axis. -->
                    <ScrollViewer CanContentScroll="True" Height="320" HorizontalScrollBarVisibility="Disabled">
                        @virtualize(var row in Rows)
                        {
                            <Border Height="44"
                                    Padding="14,0"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource GalleryDivider}">
                                <Grid ColumnDefinitions="*,120,90" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0"
                                               Text="@row.Name"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GalleryTextPrimary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="@row.Category"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GalleryTextSecondary}" />
                                    <TextBlock Grid.Column="2"
                                               Text="@(row.Value.ToString(&quot;F1&quot;))"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GalleryTextSecondary}" />
                                </Grid>
                            </Border>
                        }
                    </ScrollViewer>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:RazorVirtualizePage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Razor @@virtualize" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:RazorVirtualizePage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.DataAndBinding}" Title="Razor @@virtualize" Description="{DynamicResource Loc.P.RazorVirtualize.Sub1}" />

        <!-- ======== 1. Collection form over a large source ======== -->
        <gallery:GallerySection Header="1. @@virtualize over 100,000 rows" Description="{DynamicResource Loc.P.RazorVirtualize.CC1}">
            <StackPanel>


                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="@RowCountLabel" />

                <gallery:GalleryDemoSurface  Margin="0,0,0,10">
                    <!-- The block sits directly inside the ScrollViewer, which is what lets the
                         generated host reuse that viewport instead of building its own. The
                         explicit height is what bounds the scrolling axis. -->
                    <ScrollViewer CanContentScroll="True" Height="320" HorizontalScrollBarVisibility="Disabled">
                        @virtualize(var row in Rows)
                        {
                            <Border Height="44"
                                    Padding="14,0"
                                    BorderThickness="0,0,0,1"
                                    BorderBrush="{DynamicResource GalleryDivider}">
                                <Grid ColumnDefinitions="*,120,90" VerticalAlignment="Center">
                                    <TextBlock Grid.Column="0"
                                               Text="@row.Name"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GalleryTextPrimary}" />
                                    <TextBlock Grid.Column="1"
                                               Text="@row.Category"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GalleryTextSecondary}" />
                                    <TextBlock Grid.Column="2"
                                               Text="@(row.Value.ToString(&quot;F1&quot;))"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource GalleryTextSecondary}" />
                                </Grid>
                            </Border>
                        }
                    </ScrollViewer>
                </gallery:GalleryDemoSurface>

                <Border Background="{DynamicResource GalleryCodeSurface}" CornerRadius="8" Padding="12">
                    <TextBlock Text="{Binding VirtualizeExample}" FontSize="12" FontFamily="{ThemeResource MonoFontFamily}"
                               Foreground="{DynamicResource GalleryCodeText}" />
                </Border>
            </StackPanel>
        </gallery:GallerySection>

        <!-- ======== 2. Collection changes ======== -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.RazorVirtualize.CT1}" Description="The loop binds to the source rather than copying it, so adding and removing rows updates the list in place. A plain @@foreach would have to re-expand the whole document to notice.">
            <StackPanel>


                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <Button Content="{DynamicResource Loc.P.RazorVirtualize.Ui1}" Command="{Binding PrependRowCommand}" />
                    <Button Content="{DynamicResource Loc.P.RazorVirtualize.Ui2}" Command="{Binding RemoveFirstRowCommand}" />
                    <TextBlock Text="@RowCountLabel"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GalleryTextSecondary}" />
                </StackPanel>

                <gallery:GalleryDemoSurface>
                    <ScrollViewer CanContentScroll="True" Height="180" HorizontalScrollBarVisibility="Disabled">
                        @virtualize(var row in Rows)
                        {
                            <Border Height="32" Padding="14,0">
                                <TextBlock Text="@row.Name"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource GalleryTextPrimary}" />
                            </Border>
                        }
                    </ScrollViewer>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- ======== 3. Numeric form ======== -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.RazorVirtualize.CT2}" Description="{DynamicResource Loc.P.RazorVirtualize.CC2}">
            <StackPanel>


                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <Button Content="{DynamicResource Loc.P.RazorVirtualize.Ui3}" Command="{Binding GrowTilesCommand}" />
                    <Button Content="{DynamicResource Loc.P.RazorVirtualize.Ui4}" Command="{Binding ShrinkTilesCommand}" />
                    <TextBlock Text="Count: @TileCount"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource GalleryTextSecondary}" />
                </StackPanel>

                <gallery:GalleryDemoSurface  Margin="0,0,0,10">
                    <ScrollViewer CanContentScroll="True" Height="220" HorizontalScrollBarVisibility="Disabled">
                        @virtualize(var i = 0; i < TileCount; i++)
                        {
                            <Border Height="36" Padding="14,0">
                                <TextBlock Text="Tile @i."
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource GalleryTextPrimary}" />
                            </Border>
                        }
                    </ScrollViewer>
                </gallery:GalleryDemoSurface>

                <Border Background="{DynamicResource GalleryCodeSurface}" CornerRadius="8" Padding="12">
                    <TextBlock Text="{Binding NumericExample}" FontSize="12" FontFamily="{ThemeResource MonoFontFamily}"
                               Foreground="{DynamicResource GalleryCodeText}" />
                </Border>
            </StackPanel>
        </gallery:GallerySection>

        <!-- ======== 4. How it differs from @foreach ======== -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.RazorVirtualize.CT3}" Description="@@foreach expands while the document is read: one real element per item, no recycling, evaluated once at load. It suits a short fixed list. Anything data-driven or open-ended belongs in @@virtualize.">
            <StackPanel>


                <Border Background="{DynamicResource GalleryCodeSurface}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <TextBlock Text="{Binding ForeachExample}" FontSize="12" FontFamily="{ThemeResource MonoFontFamily}"
                               Foreground="{DynamicResource GalleryCodeText}" />
                </Border>

                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RazorVirtualize.CC3}" />
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
