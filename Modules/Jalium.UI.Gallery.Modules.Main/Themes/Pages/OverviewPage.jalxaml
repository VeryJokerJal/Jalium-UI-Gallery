<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
    xmlns:themes="clr-namespace:Jalium.UI.Gallery.Modules.Main.Themes"
    xmlns:effects="clr-namespace:Jalium.UI.Media.Effects;assembly=Jalium.UI.Media"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for OverviewPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.OverviewPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <pages:OverviewPage Width="1500" Height="920" IsEntranceAnimationEnabled="False"
                                hosting:ViewModelLocator.AutoWireViewModel="False" />
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:OverviewPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Background" Value="{x:Static themes:GalleryTheme.ShellBackgroundBrush}" />
        <Setter Property="Title" Value="Jalium.UI Gallery Overview" />
        <Setter Property="CompactWidth" Value="980" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:OverviewPage">
                <Grid x:Name="PART_Root" ClipToBounds="True">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact"><VisualState.Setters>
                            <Setter TargetName="EditorialGrid" Property="Margin" Value="18,0" />
                            <Setter TargetName="InsetColumn" Property="Width" Value="0" />
                            <Setter TargetName="RuleColumn" Property="Width" Value="0" />
                            <Setter TargetName="SampleColumn" Property="Width" Value="0" />
                            <Setter TargetName="HeaderRow" Property="Height" Value="Auto" />
                            <Setter TargetName="HeroRow" Property="Height" Value="Auto" />
                            <Setter TargetName="SampleRow" Property="Height" Value="Auto" />
                            <Setter TargetName="FooterRow" Property="Height" Value="Auto" />
                            <Setter TargetName="RunningHead" Property="Margin" Value="0,16,0,16" />
                            <Setter TargetName="IssueBadge" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeadRule" Property="Margin" Value="0" />
                            <Setter TargetName="HeroContent" Property="Margin" Value="0,28,0,28" />
                            <Setter TargetName="HeroContent" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="TitleLine1" Property="FontSize" Value="48" />
                            <Setter TargetName="TitleLine2" Property="FontSize" Value="48" />
                            <Setter TargetName="TitleLine3" Property="FontSize" Value="48" />
                            <Setter TargetName="Deck" Property="Margin" Value="0,20,0,0" />
                            <Setter TargetName="Deck" Property="FontSize" Value="15" />
                            <Setter TargetName="CtaRow" Property="Orientation" Value="Vertical" />
                            <Setter TargetName="CtaRow" Property="Margin" Value="0,28,0,0" />
                            <Setter TargetName="EnterButton" Property="MinWidth" Value="0" />
                            <Setter TargetName="EntryDetails" Property="Margin" Value="0,16,0,0" />
                            <Setter TargetName="SpecimenRail" Property="Grid.Column" Value="1" />
                            <Setter TargetName="SpecimenRail" Property="Grid.Row" Value="2" />
                            <Setter TargetName="SpecimenRail" Property="Margin" Value="0,24,0,24" />
                            <Setter TargetName="SpineRule" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Colophon" Property="Grid.Row" Value="3" />
                            <Setter TargetName="Colophon" Property="Margin" Value="0,16,0,28" />
                            <Setter TargetName="FooterBadges" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="FooterLink" Property="Grid.Row" Value="1" />
                            <Setter TargetName="FooterLink" Property="Grid.Column" Value="0" />
                            <Setter TargetName="FooterLink" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="FooterLink" Property="Margin" Value="0,12,0,0" />
                            <Setter TargetName="GhostGlyph" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HaloEmerald" Property="Width" Value="300" />
                            <Setter TargetName="HaloEmerald" Property="Height" Value="300" />
                            <Setter TargetName="HaloEmerald" Property="CornerRadius" Value="150" />
                            <Setter TargetName="HaloEmerald" Property="Canvas.Left" Value="-160" />
                            <Setter TargetName="HaloEmerald" Property="Canvas.Top" Value="140" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="EntranceStates">
                        <VisualState x:Name="Pending" />
                        <VisualState x:Name="Entering"><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HaloEmerald" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.060" Duration="0:0:0.720"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HaloAmber" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.120" Duration="0:0:0.720"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="GhostGlyph" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.160" Duration="0:0:0.820"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RunningHead" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.180" Duration="0:0:0.420"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="HeadRule" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.240" Duration="0:0:0.460"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Kicker" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.300" Duration="0:0:0.380"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TitleLine1" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.360" Duration="0:0:0.440"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TitleLine2" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.440" Duration="0:0:0.440"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="TitleLine3" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.520" Duration="0:0:0.480"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Deck" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.640" Duration="0:0:0.420"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CtaRow" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.720" Duration="0:0:0.460"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SpineRule" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.560" Duration="0:0:0.520"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RailHead" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.660" Duration="0:0:0.360"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RailSub" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.700" Duration="0:0:0.360"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Specimen1" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.760" Duration="0:0:0.380"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RailDiv1" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.800" Duration="0:0:0.320"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Specimen2" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.840" Duration="0:0:0.380"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RailDiv2" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.880" Duration="0:0:0.320"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Specimen3" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.920" Duration="0:0:0.380"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RailDiv3" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.960" Duration="0:0:0.320"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Specimen4" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.000" Duration="0:0:0.380"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="RailDiv4" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.040" Duration="0:0:0.320"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Specimen5" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.080" Duration="0:0:0.400"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="Colophon" Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:1.140" Duration="0:0:0.460"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
                        </Storyboard></VisualState>
                        <VisualState x:Name="Visible"><VisualState.Setters>
                            <Setter TargetName="HaloEmerald" Property="Opacity" Value="1" />
                            <Setter TargetName="HaloAmber" Property="Opacity" Value="1" />
                            <Setter TargetName="GhostGlyph" Property="Opacity" Value="1" />
                            <Setter TargetName="RunningHead" Property="Opacity" Value="1" />
                            <Setter TargetName="HeadRule" Property="Opacity" Value="1" />
                            <Setter TargetName="Kicker" Property="Opacity" Value="1" />
                            <Setter TargetName="TitleLine1" Property="Opacity" Value="1" />
                            <Setter TargetName="TitleLine2" Property="Opacity" Value="1" />
                            <Setter TargetName="TitleLine3" Property="Opacity" Value="1" />
                            <Setter TargetName="Deck" Property="Opacity" Value="1" />
                            <Setter TargetName="CtaRow" Property="Opacity" Value="1" />
                            <Setter TargetName="SpineRule" Property="Opacity" Value="1" />
                            <Setter TargetName="RailHead" Property="Opacity" Value="1" />
                            <Setter TargetName="RailSub" Property="Opacity" Value="1" />
                            <Setter TargetName="Specimen1" Property="Opacity" Value="1" />
                            <Setter TargetName="RailDiv1" Property="Opacity" Value="1" />
                            <Setter TargetName="Specimen2" Property="Opacity" Value="1" />
                            <Setter TargetName="RailDiv2" Property="Opacity" Value="1" />
                            <Setter TargetName="Specimen3" Property="Opacity" Value="1" />
                            <Setter TargetName="RailDiv3" Property="Opacity" Value="1" />
                            <Setter TargetName="Specimen4" Property="Opacity" Value="1" />
                            <Setter TargetName="RailDiv4" Property="Opacity" Value="1" />
                            <Setter TargetName="Specimen5" Property="Opacity" Value="1" />
                            <Setter TargetName="Colophon" Property="Opacity" Value="1" />
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="PaletteStates">
                        <VisualState x:Name="LightTheme" />
                        <VisualState x:Name="DarkTheme"><VisualState.Setters>
                            <Setter TargetName="HaloEmerald" Property="Background" Value="#3A1F793F" />
                            <Setter TargetName="HaloAmber" Property="Background" Value="#1EF59E0B" />
                            <Setter TargetName="GhostGlyph" Property="Foreground" Value="#14278A52" />
                            <Setter TargetName="HaloEmerald" Property="Effect"><Setter.Value><effects:OuterGlowEffect GlowSize="90" GlowColor="#1E793F" Intensity="0.7" Opacity="0.6" /></Setter.Value></Setter>
                            <Setter TargetName="HaloAmber" Property="Effect"><Setter.Value><effects:OuterGlowEffect GlowSize="58" GlowColor="#F59E0B" Intensity="0.6" Opacity="0.34" /></Setter.Value></Setter>
                        </VisualState.Setters></VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <Border x:Name="PosterRoot" Background="{TemplateBinding Background}">
        <Grid>

            <!-- ============================================================ -->
            <!--  ATMOSPHERE  -  off-canvas halo blooms + ghost glyph          -->
            <!-- ============================================================ -->
            <Canvas x:Name="AuraLayer">
                <Border x:Name="HaloEmerald"
                        Canvas.Left="-150" Canvas.Top="380"
                        Width="560" Height="560" CornerRadius="280"
                        Opacity="0" Background="#2A1F793F"><Border.Effect><effects:OuterGlowEffect GlowSize="90" GlowColor="#1E793F" Intensity="0.7" Opacity="0.35" /></Border.Effect></Border>
                <Border x:Name="HaloAmber"
                        Canvas.Left="1080" Canvas.Top="-160"
                        Width="420" Height="420" CornerRadius="210"
                        Opacity="0" Background="#18F59E0B"><Border.Effect><effects:OuterGlowEffect GlowSize="58" GlowColor="#F59E0B" Intensity="0.6" Opacity="0.22" /></Border.Effect></Border>
                <TextBlock x:Name="GhostGlyph"
                           Canvas.Left="690" Canvas.Top="120"
                           Text="J"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="640" FontWeight="Bold"
                           Opacity="0"
                           Foreground="#12278A52"/>
            </Canvas>

            <!-- ============================================================ -->
            <!--  EDITORIAL GRID                                               -->
            <!-- ============================================================ -->
            <Grid x:Name="EditorialGrid">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="HeaderRow" Height="104"/>
                    <RowDefinition x:Name="HeroRow" Height="*"/>
                    <RowDefinition x:Name="SampleRow" Height="132"/>
                    <RowDefinition x:Name="FooterRow" Height="0"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InsetColumn" Width="88"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="RuleColumn" Width="1"/>
                    <ColumnDefinition x:Name="SampleColumn" Width="326"/>
                </Grid.ColumnDefinitions>

                <!-- ===== RUNNING HEAD ===== -->
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                      x:Name="RunningHead" Opacity="0" Margin="0,30,40,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                CornerRadius="8"
                                Shape="RoundedRectangle"
                                Background="{DynamicResource GalleryAccent}"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="J"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="#06140C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="JALIUM.UI"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource GalleryTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <Border Style="{StaticResource GalleryVerticalDivider}" />
                        <Border Style="{StaticResource GalleryCodeBadge}">
                            <TextBlock Style="{StaticResource GalleryCodeBadgeText}"
                                       Text="{DynamicResource Loc.P.Overview.Hero1}"/>
                        </Border>
                    </StackPanel>
                    <Border x:Name="IssueBadge" HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GalleryCardBackground}"
                            BorderBrush="{DynamicResource GalleryBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="999"
                            Padding="12,5">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="LiveDot" Width="8" Height="8" CornerRadius="4"
                                    Background="{DynamicResource GalleryAccentLight}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"><Border.Effect><effects:OuterGlowEffect GlowSize="12" GlowColor="#12A89B" Intensity="1" Opacity="0.85" /></Border.Effect></Border>
                            <TextBlock Text="{DynamicResource Loc.P.Overview.Hero2}"
                                       FontFamily="{ThemeResource MonoFontFamily}"
                                       FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                        x:Name="HeadRule" Height="2" CornerRadius="1"
                        VerticalAlignment="Bottom" Margin="2,0,40,0" Opacity="0"
                        Background="{DynamicResource GalleryBorderSubtle}"/>

                <!-- ===== HERO MASTHEAD (LEFT) ===== -->
                <StackPanel x:Name="HeroContent" Grid.Row="1" Grid.Column="1"
                            VerticalAlignment="Center" Margin="0,0,48,0">

                    <StackPanel x:Name="Kicker" Orientation="Horizontal"
                                Opacity="0" Margin="2,0,0,22">
                        <Border x:Name="KickerTick" Width="34" Height="6" CornerRadius="3"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                Background="{DynamicResource GalleryWarningOnSurface}"><Border.Effect><effects:OuterGlowEffect GlowSize="14" GlowColor="#F59E0B" Intensity="1" Opacity="0.8" /></Border.Effect></Border>
                        <TextBlock Text="{DynamicResource Loc.P.Overview.Hero3}"
                                   FontFamily="{ThemeResource MonoFontFamily}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TitleLine1" TextWrapping="Wrap" Text="{DynamicResource Loc.P.Overview.Hero4}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="84" FontWeight="Bold"
                               Opacity="0"
                               Foreground="{DynamicResource GalleryTextPrimary}"/>
                    <TextBlock x:Name="TitleLine2" TextWrapping="Wrap" Text="{DynamicResource Loc.P.Overview.Hero5}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="84" FontWeight="Light"
                               Opacity="0"
                               Foreground="{DynamicResource GalleryTextSecondary}"/>
                    <TextBlock x:Name="TitleLine3" TextWrapping="Wrap" Text="{DynamicResource Loc.P.Overview.Hero6}"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="84" FontWeight="Bold"
                               HorizontalAlignment="Left"
                               Opacity="0" Foreground="{DynamicResource GalleryWarningOnSurface}"><TextBlock.Effect><effects:OuterGlowEffect GlowSize="26" GlowColor="#F59E0B" Intensity="0.9" Opacity="0.45" /></TextBlock.Effect></TextBlock>

                    <TextBlock x:Name="Deck"
                               Text="{DynamicResource Loc.P.Overview.Hero7}"
                               FontFamily="Segoe UI" FontSize="16"
                               MaxWidth="520" Opacity="0" TextWrapping="Wrap"
                               HorizontalAlignment="Left" Margin="4,28,0,0"
                               Foreground="{DynamicResource GalleryTextTertiary}"/>

                    <StackPanel x:Name="CtaRow" Orientation="Horizontal"
                                Opacity="0" Margin="4,38,0,0" VerticalAlignment="Center">
                        <Button x:Name="EnterButton"
                                Command="{Binding EnterGalleryCommand}"
                                Style="{StaticResource GalleryPrimaryButton}"
                                automation:AutomationProperties.Name="{DynamicResource Loc.P.Overview.Hero8}"
                                Height="56" MinWidth="248"
                                FontSize="16" FontWeight="Bold"
                                Padding="32,0,32,0"><Button.Effect><effects:DropShadowEffect ShadowDepth="0" BlurRadius="34" Color="#66000000" Direction="270" /></Button.Effect>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Loc.P.Overview.Hero8}"
                                           Foreground="{DynamicResource GalleryTextOnAccent}"
                                           VerticalAlignment="Center" />
                                <Path Data="M 1,1 L 7,7 L 1,13" Width="8" Height="14"
                                      Margin="10,0,0,0" Stretch="Uniform" VerticalAlignment="Center"
                                      Stroke="{DynamicResource GalleryTextOnAccent}" StrokeThickness="1.8" />
                            </StackPanel>
                        </Button>
                        <StackPanel x:Name="EntryDetails" Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Loc.P.Overview.Hero9}"
                                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,6,0">
                                    <TextBlock Style="{StaticResource GalleryCodeBadgeText}"
                                               Text="{DynamicResource Loc.P.Overview.Hero10}" />
                                </Border>
                                <Border Style="{StaticResource GalleryBadge}" Margin="0,0,6,0" Padding="7,3">
                                    <TextBlock Style="{StaticResource GalleryBadgeText}" Text="LIVE" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource GalleryBadge}" Margin="0,0,6,0" Padding="7,3">
                                    <TextBlock Style="{StaticResource GalleryBadgeText}" Text="GPU" FontSize="10" />
                                </Border>
                                <Border Style="{StaticResource GalleryBadge}" Padding="7,3">
                                    <TextBlock Style="{StaticResource GalleryBadgeText}" Text="NATIVE-AOT" FontSize="10" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ===== VERTICAL RULE ===== -->
                <Border Grid.Row="1" Grid.Column="2"
                        x:Name="SpineRule" Width="1" Opacity="0"
                        VerticalAlignment="Stretch" Margin="0,24,0,24"
                        Background="{DynamicResource GalleryBorderSubtle}"/>

                <!-- ===== SPECIMEN RAIL (RIGHT) ===== -->
                <StackPanel x:Name="SpecimenRail" Grid.Row="1" Grid.Column="3"
                            VerticalAlignment="Center" Margin="34,0,40,0">

                    <TextBlock x:Name="RailHead" Text="{DynamicResource Loc.P.Overview.Hero11}"
                               FontFamily="{ThemeResource MonoFontFamily}"
                               FontSize="12" FontWeight="SemiBold"
                               Opacity="0" Margin="0,0,0,6"
                               Foreground="{DynamicResource GalleryTextTertiary}"/>
                    <TextBlock x:Name="RailSub"
                               Text="{DynamicResource Loc.P.Overview.Hero12}"
                               FontFamily="Segoe UI" FontSize="12" Opacity="0"
                               TextWrapping="Wrap" Margin="0,0,0,20"
                               Foreground="{DynamicResource GalleryTextMuted}"/>

                    <StackPanel x:Name="Specimen1" Opacity="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="01"/>
                            </Border>
                            <TextBlock Text="ToggleSwitch"
                                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource GalleryBadge}" Margin="8,0,0,0" Padding="7,2">
                                <TextBlock Style="{StaticResource GalleryBadgeText}" Text="CheckBox" FontSize="10.5"/>
                            </Border>
                        </StackPanel>
                        <ToggleSwitch Header="{DynamicResource Loc.P.Overview.Hero13}"
                                      IsOn="True" OnContent="On" OffContent="Off"/>
                        <CheckBox IsChecked="True" Margin="0,4,0,0">
                            <TextBlock Text="{DynamicResource Loc.P.Overview.Hero14}" FontSize="11"
                                       Foreground="{DynamicResource GalleryTextSecondary}"/>
                        </CheckBox>
                    </StackPanel>

                    <Border x:Name="RailDiv1" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen2" Opacity="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="02"/>
                            </Border>
                            <TextBlock Text="Slider"
                                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource GalleryBadge}" Margin="8,0,0,0" Padding="7,2">
                                <TextBlock Style="{StaticResource GalleryBadgeText}" Text="ProgressBar" FontSize="10.5"/>
                            </Border>
                        </StackPanel>
                        <Slider Minimum="0" Maximum="100" Value="72"
                                Height="22" Margin="0,0,0,10"/>
                        <ProgressBar Value="72" Minimum="0" Maximum="100" Height="6"/>
                    </StackPanel>

                    <Border x:Name="RailDiv2" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen3" Opacity="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="03"/>
                            </Border>
                            <TextBlock Text="SplitButton"
                                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource GalleryBadge}" Margin="8,0,0,0" Padding="7,2">
                                <TextBlock Style="{StaticResource GalleryBadgeText}" Text="ComboBox" FontSize="10.5"/>
                            </Border>
                        </StackPanel>
                        <SplitButton Content="dotnet run" Height="34"
                                     HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Desktop"/>
                                    <MenuFlyoutItem Text="Android"/>
                                    <MenuFlyoutItem Text="Web (WASM)"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <ComboBox Height="30" SelectedIndex="0"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Forest Emerald"/>
                            <ComboBoxItem Content="Midnight Slate"/>
                            <ComboBoxItem Content="Amber Dusk"/>
                        </ComboBox>
                    </StackPanel>

                    <Border x:Name="RailDiv3" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen4" Opacity="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="04"/>
                            </Border>
                            <TextBlock Text="Razor @@{ for }"
                                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource GalleryBadge}" Margin="8,0,0,0" Padding="7,2">
                                <TextBlock Style="{StaticResource GalleryBadgeText}" Text="rounded corners" FontSize="10.5"/>
                            </Border>
                        </StackPanel>
                        <WrapPanel>
                            @{
                                for (var i = 1; i <= 6; i++) {
                                    <Border Width="34" Height="34"
                                            CornerRadius="8"
                                            Shape="RoundedRectangle"
                                            Background="{DynamicResource GalleryAccent}"
                                            Margin="0,0,7,7">
                                        <TextBlock Text="@(i.ToString())"
                                                   FontFamily="{ThemeResource MonoFontFamily}"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="#06140C"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                }
                            }
                        </WrapPanel>
                    </StackPanel>

                    <Border x:Name="RailDiv4" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen5" Opacity="0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,8,0">
                                <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="05"/>
                            </Border>
                            <TextBlock Text="LiquidGlass"
                                       FontFamily="{ThemeResource MonoFontFamily}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource GalleryTextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource GalleryBadge}" Margin="8,0,0,0" Padding="7,2">
                                <TextBlock Style="{StaticResource GalleryBadgeText}" Text="refractive" FontSize="10.5"/>
                            </Border>
                        </StackPanel>
                        <Border Height="46" CornerRadius="12"
                                LiquidGlass="True" LiquidGlassInteractive="True"
                                Background="{DynamicResource GalleryInfoSoft}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="3"
                                        Background="{DynamicResource GalleryAccentLight}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,8,0"/>
                                <TextBlock Text="{DynamicResource Loc.P.Overview.Hero15}"
                                           FontFamily="{ThemeResource MonoFontFamily}" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GalleryTextPrimary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ===== FOOTER / COLOPHON ===== -->
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                      x:Name="Colophon" Opacity="0" Margin="2,0,40,34"
                      VerticalAlignment="Bottom">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Grid.ColumnSpan="2"
                            Height="1" VerticalAlignment="Top" Margin="0,0,0,18"
                            Background="{DynamicResource GalleryBorderSubtle}"/>
                    <WrapPanel x:Name="FooterBadges" Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,18,0,0">
                        <Border Style="{StaticResource GalleryBadge}" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource GalleryBadgeText}"
                                       FontFamily="{ThemeResource MonoFontFamily}"
                                       Text="DESKTOP"/>
                        </Border>
                        <Border Style="{StaticResource GalleryBadge}" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource GalleryBadgeText}"
                                       FontFamily="{ThemeResource MonoFontFamily}"
                                       Text="ANDROID"/>
                        </Border>
                        <Border Style="{StaticResource GalleryBadge}">
                            <TextBlock Style="{StaticResource GalleryBadgeText}"
                                       FontFamily="{ThemeResource MonoFontFamily}"
                                       Text="WEB"/>
                        </Border>
                        <Border Style="{StaticResource GalleryVerticalDivider}" />
                        <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="gpu-rendered"/>
                        </Border>
                        <Border Style="{StaticResource GalleryCodeBadge}" Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="native-aot"/>
                        </Border>
                        <Border Style="{StaticResource GalleryCodeBadge}">
                            <TextBlock Style="{StaticResource GalleryCodeBadgeText}" Text="16.6 ms/frame"/>
                        </Border>
                    </WrapPanel>
                    <Border x:Name="FooterLink" Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,18,0,0"
                            Background="{DynamicResource GalleryCardBackground}"
                            BorderBrush="{DynamicResource GalleryBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,4">
                        <TextBlock Text="jaliumui.top"
                                   FontFamily="{ThemeResource MonoFontFamily}" FontSize="11.5"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource GalleryWarningOnSurface}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
