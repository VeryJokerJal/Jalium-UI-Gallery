<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for LabelPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.LabelPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,16">
                            <Label Content="Username:" Width="100"/>
                            <TextBox x:Name="UsernameBox" Width="200" />
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,16">
                            <Label Content="Password:" Width="100"/>
                            <PasswordBox Width="200" />
                        </WrapPanel>

                        <WrapPanel>
                            <Label Content="Email:" Width="100"/>
                            <TextBox Width="200" />
                        </WrapPanel>
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:LabelPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:LabelPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.TextAndTypography}" Title="{DynamicResource Loc.P.Label.Title1}" Description="{DynamicResource Loc.P.Label.Sub1}" />

        <!-- Interactive demo -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.InteractiveDemo}" Description="{DynamicResource Loc.P.Label.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,16">
                            <Label Content="Username:" Width="100"/>
                            <TextBox x:Name="UsernameBox" Width="200" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,16">
                            <Label Content="Password:" Width="100"/>
                            <PasswordBox Width="200" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </WrapPanel>

                        <WrapPanel>
                            <Label Content="Email:" Width="100"/>
                            <TextBox Width="200" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ContentPresenter}}" />
                        </WrapPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.Label.CC2}">
            <StackPanel>

                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Label.Body1}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Label.Body2}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Label.Body3}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Label.Body4}" />
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Label.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Label.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
