<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for PlatformUnavailablePage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.PlatformUnavailablePage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">





    <StackPanel Orientation="Vertical" Margin="8">
        <TextBlock Text="{Binding Feature}"
                   FontSize="32"
                   Foreground="{DynamicResource GalleryTextPrimary}"
                   Margin="0,0,0,8" />
        <TextBlock Text="{DynamicResource Loc.P.PlatformUnavailable.Msg1}"
                   FontSize="16"
                   Foreground="{DynamicResource GalleryWarningOnSurface}"
                   Margin="0,0,0,24" />
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding Reason}"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="{DynamicResource GalleryTextPrimary}"
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding Guidance}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource GalleryTextSecondary}"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding RuntimeDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource GalleryTextMuted}" />
            </StackPanel>
        </Border>
    </StackPanel>


            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:PlatformUnavailablePage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:PlatformUnavailablePage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

    <StackPanel Orientation="Vertical" Margin="8">
        <TextBlock Text="{Binding Feature}"
                   FontSize="32"
                   Foreground="{DynamicResource GalleryTextPrimary}"
                   Margin="0,0,0,8" />
        <TextBlock Text="{DynamicResource Loc.P.PlatformUnavailable.Msg1}"
                   FontSize="16"
                   Foreground="{DynamicResource GalleryWarningOnSurface}"
                   Margin="0,0,0,24" />
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="{Binding Reason}"
                           TextWrapping="Wrap"
                           FontSize="15"
                           Foreground="{DynamicResource GalleryTextPrimary}"
                           Margin="0,0,0,12" />
                <TextBlock Text="{Binding Guidance}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{DynamicResource GalleryTextSecondary}"
                           Margin="0,0,0,16" />
                <TextBlock Text="{Binding RuntimeDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource GalleryTextMuted}" />
            </StackPanel>
        </Border>
    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
