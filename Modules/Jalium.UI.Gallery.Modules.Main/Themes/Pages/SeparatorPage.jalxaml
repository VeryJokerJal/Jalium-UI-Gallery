<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for SeparatorPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.SeparatorPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Section 1 Content" Margin="0,0,0,8" />
                        <Separator />
                        <TextBlock Text="Section 2 Content" Margin="0,8,0,0" />
                    </StackPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:SeparatorPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:SeparatorPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Layout}" Title="{DynamicResource Loc.P.Separator.Title1}" Description="{DynamicResource Loc.P.Separator.Sub1}" />

        <!-- Between content -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Separator.CT1}" Description="{DynamicResource Loc.P.Separator.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Section 1 Content" Margin="0,0,0,8" />
                        <Separator />
                        <TextBlock Text="Section 2 Content" Margin="0,8,0,0" />
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- In a menu -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Separator.CT2}" Description="{DynamicResource Loc.P.Separator.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Border Background="{DynamicResource GalleryCardBackground}"
                            BorderBrush="{DynamicResource GalleryBorderDefault}"
                            BorderThickness="1"
                            Padding="8" CornerRadius="8" Width="200" HorizontalAlignment="Left">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="New File" Margin="4" />
                            <TextBlock Text="Open File" Margin="4" />
                            <Separator Margin="0,4" />
                            <TextBlock Text="Save" Margin="4" />
                            <TextBlock Text="Save As..." Margin="4" />
                            <Separator Margin="0,4" />
                            <TextBlock Text="Exit" Margin="4" />
                        </StackPanel>
                    </Border>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Features -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Features}" Description="{DynamicResource Loc.P.Separator.CC3}">
            <StackPanel>

                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Separator.Body1}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Separator.Body2}" />
                <gallery:GalleryFeatureItem Text="{DynamicResource Loc.P.Separator.Body3}" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.Shared.CustomizableAppearance}" />
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Separator.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Separator.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
