<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for ShapesPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.ShapesPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <WrapPanel>
                        <Rectangle Width="100" Height="60" Fill="{DynamicResource GalleryAccent}" Margin="0,0,10,10"/>
                        <Rectangle Width="100" Height="60" Fill="#00CC6A" Stroke="#FFFFFF" StrokeThickness="2" Margin="0,0,10,10"/>
                        <Rectangle Width="100" Height="60" Fill="#F7630C" RadiusX="10" RadiusY="10" Margin="0,0,10,10"/>
                        <Rectangle Width="60" Height="60" Fill="Transparent" Stroke="#E81123" StrokeThickness="3" Margin="0,0,10,10"/>
                    </WrapPanel>

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:ShapesPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="Shapes" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:ShapesPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.Media}" Title="{DynamicResource Loc.P.Shapes.Title1}" Description="{DynamicResource Loc.P.Shapes.Sub1}" />

        <!-- Rectangle -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT1}" Description="{DynamicResource Loc.P.Shapes.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Rectangle Width="100" Height="60" Fill="{DynamicResource GalleryAccent}" Margin="0,0,10,10"/>
                        <Rectangle Width="100" Height="60" Fill="#00CC6A" Stroke="#FFFFFF" StrokeThickness="2" Margin="0,0,10,10"/>
                        <Rectangle Width="100" Height="60" Fill="#F7630C" RadiusX="10" RadiusY="10" Margin="0,0,10,10"/>
                        <Rectangle Width="60" Height="60" Fill="Transparent" Stroke="#E81123" StrokeThickness="3" Margin="0,0,10,10"/>
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Ellipse -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT2}" Description="{DynamicResource Loc.P.Shapes.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <Ellipse Width="60" Height="60" Fill="{DynamicResource GalleryAccent}" Margin="0,0,10,10"/>
                        <Ellipse Width="100" Height="60" Fill="#00CC6A" Margin="0,0,10,10"/>
                        <Ellipse Width="60" Height="60" Fill="Transparent" Stroke="#F7630C" StrokeThickness="3" Margin="0,0,10,10"/>
                        <Ellipse Width="80" Height="80" Fill="#6CE494" Stroke="#FFFFFF" StrokeThickness="2" Margin="0,0,10,10"/>
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Line -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT3}" Description="{DynamicResource Loc.P.Shapes.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><Canvas Width="400" Height="100">
                        <Line X1="0" Y1="10" X2="150" Y2="10" Stroke="{DynamicResource GalleryAccent}" StrokeThickness="2"/>
                        <Line X1="0" Y1="30" X2="150" Y2="80" Stroke="#00CC6A" StrokeThickness="3"/>
                        <Line X1="200" Y1="10" X2="350" Y2="90" Stroke="#F7630C" StrokeThickness="4" StrokeDashArray="5,3"/>
                        <Line X1="200" Y1="90" X2="350" Y2="10" Stroke="#E81123" StrokeThickness="2" StrokeDashArray="10,5"/>
                    </Canvas></Viewbox>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Polygon -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT4}" Description="{DynamicResource Loc.P.Shapes.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <!-- Triangle -->
                        <Polygon Points="30,0 60,60 0,60" Fill="{DynamicResource GalleryAccent}" Margin="0,0,10,10"/>
                        <!-- Pentagon -->
                        <Polygon Points="30,0 60,22 48,60 12,60 0,22" Fill="#00CC6A" Margin="0,0,10,10"/>
                        <!-- Star -->
                        <Polygon Points="30,0 36,20 60,20 42,32 50,55 30,42 10,55 18,32 0,20 24,20"
                                 Fill="#FFB900" Margin="0,0,10,10"/>
                        <!-- Hexagon with stroke -->
                        <Polygon Points="20,0 50,0 65,30 50,60 20,60 5,30"
                                 Fill="Transparent" Stroke="#E81123" StrokeThickness="2" Margin="0,0,10,10"/>
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Polyline -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT5}" Description="{DynamicResource Loc.P.Shapes.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><Canvas Width="400" Height="80">
                        <Polyline Points="0,40 50,10 100,60 150,20 200,50 250,30 300,70 350,40"
                                  Stroke="{DynamicResource GalleryAccent}" StrokeThickness="3" Fill="Transparent"/>
                        <Polyline Points="0,70 100,70 150,10 200,70 300,70"
                                  Stroke="#00CC6A" StrokeThickness="2" Fill="Transparent"
                                  Canvas.Top="5"/>
                    </Canvas></Viewbox>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Path -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT6}" Description="{DynamicResource Loc.P.Shapes.CC6}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <WrapPanel>
                        <!-- Heart shape -->
                        <Path Data="M 50,30 C 50,0 0,0 0,30 C 0,60 50,80 50,80 C 50,80 100,60 100,30 C 100,0 50,0 50,30"
                              Fill="#E81123" Width="50" Height="50" Stretch="Uniform" Margin="0,0,10,10"/>
                        <!-- Arrow -->
                        <Path Data="M 0,20 L 30,20 L 30,10 L 50,25 L 30,40 L 30,30 L 0,30 Z"
                              Fill="{DynamicResource GalleryAccent}" Width="50" Height="40" Stretch="Uniform" Margin="0,0,10,10"/>
                        <!-- Check mark -->
                        <Path Data="M 10,25 L 20,35 L 40,10"
                              Stroke="#00CC6A" StrokeThickness="4" Fill="Transparent"
                              Width="50" Height="45" Stretch="Uniform" Margin="0,0,10,10"/>
                    </WrapPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Combined shapes -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.Shapes.CT7}" Description="{DynamicResource Loc.P.Shapes.CC7}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><Canvas Width="300" Height="150">
                        <!-- Simple house -->
                        <Rectangle Canvas.Left="50" Canvas.Top="70" Width="100" Height="70" Fill="#8B4513"/>
                        <Polygon Points="100,20 50,70 150,70" Fill="#B22222"/>
                        <Rectangle Canvas.Left="80" Canvas.Top="100" Width="25" Height="40" Fill="#654321"/>
                        <Ellipse Canvas.Left="135" Canvas.Top="85" Width="25" Height="25" Fill="#87CEEB"/>

                        <!-- Sun -->
                        <Ellipse Canvas.Left="220" Canvas.Top="20" Width="50" Height="50" Fill="#FFD700"/>

                        <!-- Ground -->
                        <Rectangle Canvas.Left="0" Canvas.Top="140" Width="300" Height="10" Fill="#228B22"/>
                    </Canvas></Viewbox>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.Shapes.CC8}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.Shapes.CC9}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
