<ResourceDictionary
    xmlns="http://schemas.jalium.ui/2024"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    xmlns:pages="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages"
    xmlns:gallery="clr-namespace:Jalium.UI.Gallery.Modules.Main.Controls">
    <!-- Default template for MapViewPage. Data and commands are supplied by its ViewModel. -->
    <!-- Independent preview instance: shares data, never re-parents a page's template parts. -->
    <DataTemplate x:Key="Gallery.Preview.MapViewPage">
        <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="True">
            <Grid Width="640" ClipToBounds="True">


                    <MapView Height="300"
                             Center="{Binding BeijingCenter}"
                             ZoomLevel="12"
                             TileSource="{Binding TileSource}"
                             ShowZoomControls="True"
                             ShowScaleBar="True"
                             ShowAttribution="True"
                             IsPanEnabled="True"
                             IsZoomEnabled="True" />

            </Grid>
        </Viewbox>
    </DataTemplate>
    <Style TargetType="pages:MapViewPage">
        <Setter Property="hosting:ViewModelLocator.AutoWireViewModel" Value="True" />
        <Setter Property="Title" Value="MapView" />
        <Setter Property="Template">
            <ControlTemplate TargetType="pages:MapViewPage">
                <Grid x:Name="PART_Root">

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="FocusStates">
                        <VisualState x:Name="Focused" />
                        <VisualState x:Name="Unfocused" />
                    </VisualStateGroup>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="Wide" />
                        <VisualState x:Name="Compact" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>


    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <gallery:GalleryPageHeader Eyebrow="{DynamicResource Loc.Shared.MapsAndGeo}" Title="{DynamicResource Loc.P.MapView.Title1}" Description="{DynamicResource Loc.P.MapView.Sub1}" />

        <!-- Basic Map -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.MapView.CT1}" Description="{DynamicResource Loc.P.MapView.CC1}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <MapView Height="300"
                             Center="{Binding BeijingCenter}"
                             ZoomLevel="12"
                             TileSource="{Binding TileSource}"
                             ShowZoomControls="True"
                             ShowScaleBar="True"
                             ShowAttribution="True"
                             IsPanEnabled="True"
                             IsZoomEnabled="True" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Markers & Overlays -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.MapView.CT2}" Description="{DynamicResource Loc.P.MapView.CC2}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <MapView Height="350"
                             Center="{Binding ChinaCenter}"
                             ZoomLevel="4"
                             TileSource="{Binding TileSource}"
                             ShowZoomControls="True"
                             ShowScaleBar="True"
                             Markers="{Binding Markers}"
                             Polylines="{Binding Polylines}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- Zoom Controls -->
        <gallery:GallerySection Header="{DynamicResource Loc.P.MapView.CT3}" Description="{DynamicResource Loc.P.MapView.CC3}">
            <StackPanel>

                <gallery:GalleryDemoSurface>
                    <StackPanel Orientation="Vertical">
                        <MapView Height="300"
                                 Center="{Binding ZoomCenter, Mode=TwoWay}"
                                 ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                 TileSource="{Binding TileSource}"
                                 ShowZoomControls="True"
                                 ShowScaleBar="True"
                                 IsPanEnabled="True"
                                 IsZoomEnabled="True" />
                        <TextBlock Text="{Binding ZoomLevelText}"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Margin="0,8,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Zoom In"
                                    Command="{Binding ZoomInCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Zoom Out"
                                    Command="{Binding ZoomOutCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Reset View"
                                    Command="{Binding ResetViewCommand}" />
                        </StackPanel>
                    </StackPanel>
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- XAML code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.Xaml}" Description="{DynamicResource Loc.P.MapView.CC4}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

        <!-- C# code example -->
        <gallery:GallerySection Header="{DynamicResource Loc.Shared.CSharp}" Description="{DynamicResource Loc.P.MapView.CC5}">
            <StackPanel>

                <gallery:GalleryDemoSurface Padding="0">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </gallery:GalleryDemoSurface>
            </StackPanel>
        </gallery:GallerySection>

    </StackPanel>

                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
</ResourceDictionary>
