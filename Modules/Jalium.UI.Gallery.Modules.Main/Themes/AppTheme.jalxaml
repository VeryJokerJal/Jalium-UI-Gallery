<ResourceDictionary x:Class="Jalium.UI.Gallery.Modules.Main.Themes.AppTheme"
                    xmlns="http://schemas.jalium.ui/2024"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Compatibility aliases for samples that still consume App* resource
        names. Gallery chrome uses Gallery* DynamicResources; keeping these
        aliases in ThemeDictionaries prevents Light from exposing a dark-only
        legacy palette.
    -->

    <x:String x:Key="ThemeName">Jalium Teal</x:String>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="AccentPrimary" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#08948A" />
                <GradientStop Offset="1" Color="#0B7F78" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentHover" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#12A89B" />
                <GradientStop Offset="1" Color="#08948A" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentSubtle" Color="#4008948A" />
            <SolidColorBrush x:Key="AccentForeground" Color="#101827" />

            <SolidColorBrush x:Key="AppBackground" Color="#121719" />
            <SolidColorBrush x:Key="AppSurface" Color="#171D1F" />
            <SolidColorBrush x:Key="AppSurfaceHover" Color="#242D30" />
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="#1C2326" />
            <SolidColorBrush x:Key="AppBorder" Color="#323C40" />
            <SolidColorBrush x:Key="AppBorderStrong" Color="#455256" />
            <SolidColorBrush x:Key="AppTextPrimary" Color="#F4F7F7" />
            <SolidColorBrush x:Key="AppTextSecondary" Color="#CFD7D9" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="AccentPrimary" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#08948A" />
                <GradientStop Offset="1" Color="#0B7F78" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentHover" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#12A89B" />
                <GradientStop Offset="1" Color="#08948A" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="AccentSubtle" Color="#3408948A" />
            <SolidColorBrush x:Key="AccentForeground" Color="#101827" />

            <SolidColorBrush x:Key="AppBackground" Color="#F5F7F8" />
            <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="AppSurfaceHover" Color="#EDF7F5" />
            <SolidColorBrush x:Key="AppSurfaceElevated" Color="#F6F8F9" />
            <SolidColorBrush x:Key="AppBorder" Color="#DEE4E8" />
            <SolidColorBrush x:Key="AppBorderStrong" Color="#C8D2D9" />
            <SolidColorBrush x:Key="AppTextPrimary" Color="#101827" />
            <SolidColorBrush x:Key="AppTextSecondary" Color="#354052" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
