    <x:String x:Key="Loc.P.CssLayout.Tile3">margin: 10%&#x0a;→ 四边各 20 DIP</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile4">width: 90% 被 max-width: 50% 钳制</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile5">width: 10% 被 min-width: 40% 抬升</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile6">2 / 3&#x0a;（已给出高度）</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile7">border-box → 总宽 200</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile8">普通流中的元素</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile9">另一个流中元素 —— 不受钉住的方块影响</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile10">top + right</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile11">left + right + bottom  →  在两边之间拉伸</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile12">left/top&#x0a;用百分比</x:String>
    <x:String x:Key="Loc.P.CssLayout.Tile13">Width=&quot;140&quot; 胜过它</x:String>

    <!-- CssMappings -->
    <x:String x:Key="Loc.P.CssMappings.Tile1">9 —— 超出&#x0a;范围，被丢弃</x:String>
    <x:String x:Key="Loc.P.CssMappings.Tile2">horizontal-alignment: Right</x:String>
    <x:String x:Key="Loc.P.CssMappings.Tile3">text-wrapping: Wrap  ·  font-weight 来自真正的 CSS</x:String>

    <!-- CssSelectors -->
    <x:String x:Key="Loc.P.CssSelectors.Tile1">Border { … }  —— 类型选择器</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile2">.tinted { … }  —— 类选择器</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile3">#named { … }  —— id 选择器，匹配 x:Name</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile4">直接子级 —— .outer &gt; TextBlock 胜出（绿色、加粗）</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile5">嵌套更深 —— 只有 .outer TextBlock 命中（琥珀色）</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile6">悬停 / 按下我</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile7">按 Tab 到这里体验 :focus-visible</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile8">切换我 —— :checked 会翻转标签</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile9">只有 Border  →  优先级 0,0,1  →  石板灰</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile10">#winner  →  1,0,0 胜过任何类  →  紫罗兰</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile11">#louder 优先级更高，但类型规则带 !important —— 玫红胜出。</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile12">没有本地值  →  CSS 背景生效（蓝色）</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile13">标记里设置了本地 Background  →  本地值继续胜出（棕色）</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile14">无过渡&#x0a;—— 瞬间切换</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile15">transition: 0.35s ease-in-out&#x0a;—— 双向缓动</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Tile16">内容 TextBlock —— 已命中（琥珀色）</x:String>

    <!-- CssStyling -->
    <x:String x:Key="Loc.P.CssStyling.Tile1">rgb() 现代写法&#x0a;胶囊圆角</x:String>
