    <!-- Overview -->
    <x:String x:Key="Loc.P.Overview.Hero1">  /  组件图鉴</x:String>
    <x:String x:Key="Loc.P.Overview.Hero2">第 1 期</x:String>
    <x:String x:Key="Loc.P.Overview.Hero3">原生 .NET 10 UI 平台</x:String>
    <x:String x:Key="Loc.P.Overview.Hero4">构建</x:String>
    <x:String x:Key="Loc.P.Overview.Hero5">能交付的</x:String>
    <x:String x:Key="Loc.P.Overview.Hero6">用户界面。</x:String>
    <x:String x:Key="Loc.P.Overview.Hero7">WPF 级的开发手感、GPU 加速的渲染器、跨桌面与移动端和 Web 的同一套 XAML 方言——每一个控件都在这座图鉴里实时可验。</x:String>
    <x:String x:Key="Loc.P.Overview.Hero8">进入图鉴</x:String>
    <x:String x:Key="Loc.P.Overview.Hero9">按 [ enter ] 加载图鉴</x:String>
    <x:String x:Key="Loc.P.Overview.Hero10">120+ 控件 · 实时 · gpu · native-aot</x:String>
    <x:String x:Key="Loc.P.Overview.Hero11">样张</x:String>
    <x:String x:Key="Loc.P.Overview.Hero12">自藏品中手工挑选的几件实时样张</x:String>
    <x:String x:Key="Loc.P.Overview.Hero13">GPU 合成</x:String>
    <x:String x:Key="Loc.P.Overview.Hero14">硬件加速</x:String>
    <x:String x:Key="Loc.P.Overview.Hero15">磨砂 · 折射玻璃</x:String>

