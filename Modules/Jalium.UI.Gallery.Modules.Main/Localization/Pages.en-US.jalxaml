    <x:String x:Key="Loc.P.PropertyGrid.Cap2">Alphabetical:</x:String>

    <!-- QRCode -->
    <x:String x:Key="Loc.P.QRCode.Title1">QRCode</x:String>
    <x:String x:Key="Loc.P.QRCode.Sub1">Generate QR codes for links, contact payloads, Wi-Fi setup strings, or any other compact text payload.</x:String>
    <x:String x:Key="Loc.P.QRCode.CC1">Change the payload and error correction level, then regenerate the QR code.</x:String>
    <x:String x:Key="Loc.P.QRCode.CT1">Interactive Generator</x:String>
    <x:String x:Key="Loc.P.QRCode.CC2">A few practical formats that work well with QRCode.</x:String>
    <x:String x:Key="Loc.P.QRCode.CT2">Common Payloads</x:String>
    <x:String x:Key="Loc.P.QRCode.CC3">The key properties you set to control encoding and presentation.</x:String>
    <x:String x:Key="Loc.P.QRCode.CT3">QRCode Properties</x:String>
    <x:String x:Key="Loc.P.QRCode.CC4">Declarative markup for the QR codes above.</x:String>
    <x:String x:Key="Loc.P.QRCode.CC5">Generating and updating a QRCode through ViewModel bindings.</x:String>
    <x:String x:Key="Loc.P.QRCode.Body1">Text - The payload encoded into the QR matrix</x:String>
    <x:String x:Key="Loc.P.QRCode.Body2">ErrorCorrectionLevel - Choose L, M, Q, or H based on resilience needs</x:String>
    <x:String x:Key="Loc.P.QRCode.Body3">QuietZoneModules - Control the blank border around the encoded matrix</x:String>
    <x:String x:Key="Loc.P.QRCode.Body4">Foreground / Background / Padding / CornerRadius - Style the presentation surface</x:String>
    <x:String x:Key="Loc.P.QRCode.Cap1">Great for mobile-friendly links.</x:String>
    <x:String x:Key="Loc.P.QRCode.Cap2">Encode setup info for quick scanning.</x:String>
    <x:String x:Key="Loc.P.QRCode.Cap3">Share compact contact payloads.</x:String>
    <x:String x:Key="Loc.P.QRCode.Val1">Documentation URL</x:String>
    <x:String x:Key="Loc.P.QRCode.Val2">Wi-Fi Onboarding</x:String>
    <x:String x:Key="Loc.P.QRCode.Val3">Contact Card</x:String>

    <!-- RadioButton -->
    <x:String x:Key="Loc.P.RadioButton.Title1">RadioButton</x:String>
    <x:String x:Key="Loc.P.RadioButton.Sub1">A button that can be selected but not cleared by a user. RadioButtons in the same group are mutually exclusive.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC1">Select your favorite color — options in the same group are mutually exclusive.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CT1">Grouped RadioButtons</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC2">RadioButtons split into separate groups track their selection independently.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC3">Declarative markup for the RadioButton groups above.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC4">Wiring Checked events and building radio groups in code-behind.</x:String>
    <x:String x:Key="Loc.P.RadioButton.Val1">Size</x:String>
    <x:String x:Key="Loc.P.RadioButton.Val2">Speed</x:String>

    <!-- RangeSlider -->
    <x:String x:Key="Loc.P.RangeSlider.Title1">RangeSlider</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Sub1">A slider with two thumbs that lets the user pick a continuous sub-range from a numeric range.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC1">Drag either thumb to change RangeStart / RangeEnd. Click the track to jump the closest thumb. Tab switches keyboard focus between thumbs.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CT1">Minimum gap (MinimumRange)</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC2">The two thumbs cannot get closer than MinimumRange — useful for price filters where the lower and upper bound must stay separated.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CT2">Custom bounds</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC3">Both thumbs snap to TickFrequency when IsSnapToTickEnabled is true.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC4">TrackMode=&quot;Segmented&quot; splits the track into one pill per TickFrequency interval; the segments between the two thumbs take the fill brush and SegmentGap controls the spacing between them.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC5">RangeSliders can address any numeric domain, including negative numbers.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC6">Declarative markup for the RangeSliders above.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC7">Wiring the RangeStartChanged / RangeEndChanged events and creating RangeSliders in code-behind.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap1">MinimumRange = 10</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap2">TickFrequency = 20, snapped</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap3">TickFrequency = 10 with SegmentGap = 2 — finer steps stay legible as long as a segment can still hold its gap</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap4">Price Filter ($0 — $1000)</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap5">Temperature Comfort Zone (-20 — 40°C)</x:String>

    <!-- RazorDemo -->
    <x:String x:Key="Loc.P.RazorDemo.Title1">Razor Syntax</x:String>
    <x:String x:Key="Loc.P.RazorDemo.Sub1">Razor directives embed C# loops, conditionals, and expressions directly in JALXAML markup, generating and data-binding UI from real code at load time.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC1">Evaluates a C# expression inline. Supports ternary, arithmetic, method calls.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CT1">3. Mixed Text - Path + Literal</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC2">Generates repeated elements using a classic C-style for loop.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CT2">10. Combined Loops + Expressions</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC3">Iterates over a collection to generate child elements.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CT3">13. $.Property - Self-Reference</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC4">Renders different elements based on a switch expression.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CT4">14. #.Property - Data Model Reference</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC5">Executes C# code blocks with local functions, variables, and mixed markup output.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC6">Wraps markup generation in a try/catch block for safe execution.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC7">Combines for loops with ternary expressions to generate styled squares.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC8">Generates elements using a do-while loop (always executes at least once).</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC9">Access the control's own properties with $. prefix. Equivalent to RelativeSource Self binding.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC10">Access the DataContext model directly with #. prefix. Ideal for ItemTemplate where each item has its own DataContext.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC11">Full JALXAML markup showing every Razor directive above.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC12">The independent ViewModel and its AOT-safe property accessors.</x:String>

    <!-- RazorVirtualize -->
    <x:String x:Key="Loc.P.RazorVirtualize.Sub1">A data-bound loop that lowers to a virtualized list: elements are created for the visible window rather than for the data, containers are recycled while scrolling, and the list follows collection changes.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CC1">The source really does hold a hundred thousand rows. Only the rows in view exist as elements, so the list appears instantly and scrolls at full speed.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CT1">2. It follows the collection</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CC2">A counting loop virtualizes too. The bound is an expression, so changing it re-publishes the sequence without materializing it.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CT2">3. Numeric form</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CC3">Two rules are worth remembering. The body becomes the item template, so it must be a single element — wrap several in a container. And virtualization needs a bounded scrolling axis: put the block directly inside a ScrollViewer, or give it an explicit Height. Placed where neither holds, it still renders correctly but without the benefit, and says so in the trace.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CT3">4. When to use which</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.Ui1">Add a row</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.Ui2">Remove a row</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.Ui3">More tiles</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.Ui4">Fewer tiles</x:String>

    <!-- RepeatButton -->
    <x:String x:Key="Loc.P.RepeatButton.Title1">RepeatButton</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Sub1">A button that fires Click events repeatedly while it stays pressed — ideal for steppers, spinners and scroll repeat, with a configurable initial delay and repeat interval.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC1">Hold a button to repeat the action continuously — the counter keeps changing while pressed.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC2">What sets RepeatButton apart from a standard button.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC3">Declarative markup for the counter and volume-control demos.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC4">Commands keep repeated actions in the independent ViewModel.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body1">• Continuous click events while pressed</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body2">• Configurable initial delay</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body3">• Configurable repeat interval</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body4">• Useful for scrollbars and spinners</x:String>

    <!-- Ribbon -->
    <x:String x:Key="Loc.P.Ribbon.Title1">Ribbon</x:String>
    <x:String x:Key="Loc.P.Ribbon.Sub1">An Office-style ribbon control with tabs, groups, galleries, application menu, and quick access toolbar.</x:String>
    <x:String x:Key="Loc.P.Ribbon.CC1">A fully functional ribbon with tabs, groups, and buttons — click a command to see it echoed below.</x:String>
