    <!-- DiffViewer -->
    <x:String x:Key="Loc.P.DiffViewer.Title1">DiffViewer</x:String>
    <x:String x:Key="Loc.P.DiffViewer.Sub1">A control that displays side-by-side or unified text diffs with line-level and word-level highlighting.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC1">Compare two text documents with additions and removals highlighted in separate panels.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CT1">Side-by-Side Diff</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC2">Display the diff in a single unified view, similar to git diff output.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CT2">Unified View</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC3">Edit the original and modified text to see the diff update in real time.</x:String>
