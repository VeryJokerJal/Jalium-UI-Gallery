    <!-- CommandBar -->
    <x:String x:Key="Loc.P.CommandBar.Title1">CommandBar</x:String>
    <x:String x:Key="Loc.P.CommandBar.Sub1">A toolbar that lays out AppBarButton and related command elements, with primary commands inline and overflow support for the rest.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CC1">A CommandBar with primary commands.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CT1">Basic CommandBar</x:String>
    <x:String x:Key="Loc.P.CommandBar.CC2">A CommandBar with primary and secondary (overflow) commands. Click the overflow button to see more.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CT2">CommandBar with Secondary Commands</x:String>
