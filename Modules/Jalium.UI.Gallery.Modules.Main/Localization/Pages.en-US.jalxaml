    <x:String x:Key="Loc.P.Printing.Body2">Orientations: Portrait, Landscape, Reverse</x:String>
    <x:String x:Key="Loc.P.Printing.Body3">Colors: Color, Grayscale, Monochrome</x:String>
    <x:String x:Key="Loc.P.Printing.Body4">Duplex: OneSided, TwoSidedShortEdge, TwoSidedLongEdge</x:String>
    <x:String x:Key="Loc.P.Printing.Body5">Quality: Draft, Normal, High, Photographic</x:String>
    <x:String x:Key="Loc.P.Printing.Val1">Supported features</x:String>

    <!-- ProgressBar -->
    <x:String x:Key="Loc.P.ProgressBar.Title1">ProgressBar</x:String>
    <x:String x:Key="Loc.P.ProgressBar.Sub1">A control that visualizes the progress of an operation, either as a determinate percentage or an indeterminate loading animation.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC1">Use the slider to change the progress value.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CT1">Progress variants</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC2">The same ProgressBar filled to a range of determinate values.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CT2">Indeterminate mode</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC3">A progress bar that shows ongoing activity without a specific percentage.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC4">Declarative markup for the progress bars shown above.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC5">Wiring the slider to the bar and animating a download from code-behind.</x:String>

    <!-- PropertyGrid -->
    <x:String x:Key="Loc.P.PropertyGrid.Title1">PropertyGrid</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.Sub1">Displays the properties of an object for viewing and editing, with categorized and alphabetical sort modes, live search and descriptions.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC1">Inspect and edit the properties of a sample object with the categorized view.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CT1">Basic Property Grid</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC2">Compare the two sort modes side by side on the same object.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CT2">Categorized vs Alphabetical</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC3">A richer sample object with various property types including enums, collections and nested objects.</x:String>
