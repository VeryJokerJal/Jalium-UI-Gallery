    <!-- TextBlock -->
    <x:String x:Key="Loc.P.TextBlock.Title1">TextBlock</x:String>
    <x:String x:Key="Loc.P.TextBlock.Sub1">A lightweight, read-only control for displaying text, with control over font size, weight, wrapping and trimming.</x:String>
