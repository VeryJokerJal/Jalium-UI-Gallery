    <x:String x:Key="Loc.P.SplitButton.CC4">Primary and flyout actions are independent ViewModel commands.</x:String>

    <!-- Splitter -->
    <x:String x:Key="Loc.P.Splitter.Title1">Splitter</x:String>
    <x:String x:Key="Loc.P.Splitter.Sub1">Drag a GridSplitter between grid cells to resize adjacent panels — the building block for resizable columns, rows and full IDE-style layouts.</x:String>
    <x:String x:Key="Loc.P.Splitter.CC1">Drag the vertical bar to resize the left and right panels.</x:String>
    <x:String x:Key="Loc.P.Splitter.CT1">Horizontal Splitter</x:String>
