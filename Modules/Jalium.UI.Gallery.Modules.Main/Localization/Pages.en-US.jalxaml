    <!-- DockPanel -->
    <x:String x:Key="Loc.P.DockPanel.Title1">DockPanel</x:String>
    <x:String x:Key="Loc.P.DockPanel.Sub1">A panel that positions child elements to the edges (top, bottom, left, right) or fills the remaining space.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC1">Elements docked to different edges with the last child filling the center.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CT1">Basic DockPanel</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC2">When disabled, the last child does not fill the remaining space.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CT2">LastChildFill = false</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC3">A typical application layout with header, sidebar, and content area.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CT3">Application Layout</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC4">Declarative markup for the DockPanel layouts above.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC5">All DockPanel relationships are declared in XAML.</x:String>

    <!-- DocumentViewer -->
    <x:String x:Key="Loc.P.DocumentViewer.Title1">DocumentViewer</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.Sub1">A control for viewing paginated documents with zoom, page navigation, search, fit modes, and print support.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CC1">A DocumentViewer with toolbar controls for navigation and zoom.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CT1">Document Viewer Demo</x:String>
