<ResourceDictionary x:Class="Jalium.UI.Gallery.Modules.Main.Localization.PagesEnUS"
                    xmlns="http://schemas.jalium.ui/2024"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sample-page copy, English (en-US) - the reference dictionary every other
        language falls back to.

        Loc.Shared.*   copy repeated across pages (category eyebrows, section
                       headings such as "Interactive demo", "XAML" / "C#").
        Loc.P.<Page>.* copy owned by one page; the suffix names the design-system
                       role it renders in - Eyebrow / Title / Sub for the page
                       header, CT / CC for a section card's title and caption,
                       then Body / Cap / Chip / Val.

        Demo payload strings (button captions, sample rows) deliberately stay in
        the markup: they are part of the code example shown beside them.
    -->

    <!-- ============================== Shared ============================== -->

