    <!-- DesignTokens -->
    <x:String x:Key="Loc.P.DesignTokens.Eyebrow1">FOUNDATIONS</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Eyebrow2">SPACING / DISTANCE</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Eyebrow3">RADIUS / SILHOUETTE</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Title1">Design Tokens</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Sub1">Shared color, type, spacing, shape, and motion decisions used throughout the Gallery.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CC1">Semantic roles keep controls consistent across themes.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT1">Color roles</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CC2">Both families use the same 4 px grid: spacing measures distance, while radius changes the silhouette.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT2">Typography</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT3">Spacing &amp; corner radius</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT4">Motion</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT5">Resource export</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Cap1">The preview shows the exact gap between two elements.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Cap2">Each sample applies the token to the same 60 × 36 px surface.</x:String>

    <!-- Dialogs -->
    <x:String x:Key="Loc.P.Dialogs.Title1">File Dialogs</x:String>
    <x:String x:Key="Loc.P.Dialogs.Sub1">Invoke the native file, save, folder, shell, font, and message dialogs, then read back exactly what each one returns.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC1">Browse files, select multiple files, or use the WPF OpenFolderDialog.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT1">Open File Dialog</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC2">Allows users to specify a file name and location for saving.</x:String>
