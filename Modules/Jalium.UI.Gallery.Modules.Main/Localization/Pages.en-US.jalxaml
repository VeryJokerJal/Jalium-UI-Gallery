    <!-- ShellIntegration -->
    <x:String x:Key="Loc.P.ShellIntegration.Title1">Shell Integration</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Sub1">Windows Shell integration with WindowChrome, JumpList, and Taskbar features.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC1">Customize window frame appearance with DWM composition support.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT1">WindowChrome</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC2">Windows 7+ taskbar Jump Lists with tasks and recent items.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT2">JumpList</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC3">Control taskbar thumbnail, progress indicator, and overlay icons.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT3">TaskbarItemInfo</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC4">Access system metrics and DWM state information.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT4">SystemParameters2</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC5">Declarative markup applying WindowChrome and TaskbarItemInfo to a Window.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC6">Configuring window chrome, jump lists, taskbar progress, and reading system parameters in code-behind.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body1">CaptionHeight: Height of the title bar</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body2">ResizeBorderThickness: Size of resize grips</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body3">GlassFrameThickness: DWM glass frame extent</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body4">CornerRadius: Window corner rounding</x:String>
