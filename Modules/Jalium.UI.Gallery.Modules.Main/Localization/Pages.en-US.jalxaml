    <!-- SankeyDiagram -->
    <x:String x:Key="Loc.P.SankeyDiagram.Title1">SankeyDiagram</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.Sub1">A diagram control that visualizes flow data with proportionally-sized nodes and curved links.</x:String>
