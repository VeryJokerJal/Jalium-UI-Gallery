    <!-- TransitionDemo -->
    <x:String x:Key="Loc.P.TransitionDemo.Title1">Content Transitions</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.Sub1">TransitioningContentControl plays an animation whenever its content changes — pick a transition mode, then switch the content to watch the effect.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC1">Choose a transition mode, then switch content once or auto-play through every mode in sequence.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CT1">Transition settings</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC2">The selected transition plays each time the content swaps between panels A, B and C.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CT2">Live preview</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC3">Declarative markup for a clipped TransitioningContentControl.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC4">Content switching, mode selection and auto-play are ViewModel commands and state.</x:String>

    <!-- TreeDataGrid -->
    <x:String x:Key="Loc.P.TreeDataGrid.Title1">TreeDataGrid</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Sub1">A control that displays hierarchical data in a flat, column-based grid with expand/collapse support.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC1">Click arrows to expand/collapse, click rows to select, click column headers to sort.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC2">TreeDataGrid combines tree hierarchy with column-based data display.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC3">Declarative markup for the TreeDataGrid demo above.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC4">The ViewModel supplies the tree and selection; a behavior adapts expand/collapse and column configuration.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body1">* Hierarchical expand/collapse with indentation</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body2">* Reuses DataGrid column types (Text, CheckBox, Template, etc.)</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body3">* Row virtualization for large datasets</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body4">* Column sorting (recursive across all levels)</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body5">* Column resizing and drag reorder</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body6">* Single and Extended selection modes</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body7">* Keyboard navigation (arrows, Left/Right expand/collapse)</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body8">* ChildrenPropertyPath or ChildrenSelector for data binding</x:String>

    <!-- TreeMap -->
    <x:String x:Key="Loc.P.TreeMap.Title1">TreeMap</x:String>
    <x:String x:Key="Loc.P.TreeMap.Sub1">Displays hierarchical data as nested, space-filling rectangles proportional to data values.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC1">A flat tree map of market sectors sized by market capitalization.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CT1">Basic TreeMap</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC2">A hierarchical tree map with parent categories and child items.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CT2">Nested TreeMap</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC3">Comparison of Squarified vs SliceAndDice layout algorithms on identical data.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CT3">Squarified Algorithm</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC4">Declarative markup for building the tree maps above.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC5">The ViewModel supplies hierarchical item collections; algorithms and layout stay in XAML.</x:String>

    <!-- TreeSelector -->
    <x:String x:Key="Loc.P.TreeSelector.Title1">TreeSelector</x:String>
    <x:String x:Key="Loc.P.TreeSelector.Sub1">A drop-down hierarchical selector whose trigger shows the current selection — an ancestor path in single-select or removable chips in multi-select — while the popup hosts a checkable tree with optional cascade and live search.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC1">SelectionMode = Single. The trigger displays the full ancestor path; selecting a leaf auto-closes the popup.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC2">SelectionMode = Multiple + ShowCheckBoxes = True. Row selection creates removable chips; check-box state is tracked separately through CheckedItems.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC3">IsSearchEnabled = True. Typing filters the tree to matching entries and their ancestors.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC4">CheckCascadeMode = Cascade — checking a parent updates descendants and mixed children render an indeterminate parent.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC5">Declarative markup for the TreeSelectors above.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC6">Region data and status live in the ViewModel; a behavior projects the required TreeSelectorItem hierarchy and reports both selection and check-state events.</x:String>

    <!-- TreeView -->
    <x:String x:Key="Loc.P.TreeView.Title1">TreeView</x:String>
    <x:String x:Key="Loc.P.TreeView.Sub1">A hierarchical control that displays data in a tree structure with expandable and collapsible nodes.</x:String>
    <x:String x:Key="Loc.P.TreeView.CC1">A simple TreeView with hierarchical items.</x:String>
    <x:String x:Key="Loc.P.TreeView.CT1">Basic TreeView</x:String>
    <x:String x:Key="Loc.P.TreeView.CC2">Selection changes are published to the ViewModel through a behavior.</x:String>
    <x:String x:Key="Loc.P.TreeView.CT2">Pre-expanded Nodes</x:String>
    <x:String x:Key="Loc.P.TreeView.CC3">A TreeView with some nodes already expanded.</x:String>
    <x:String x:Key="Loc.P.TreeView.CC4">Declarative markup for the TreeViews above.</x:String>
    <x:String x:Key="Loc.P.TreeView.CC5">The ViewModel owns tree data and selection status; a behavior adapts TreeView containers and events.</x:String>

    <!-- UniformGrid -->
    <x:String x:Key="Loc.P.UniformGrid.Title1">UniformGrid</x:String>
    <x:String x:Key="Loc.P.UniformGrid.Sub1">A panel that arranges children in a grid where all cells are the same size. Rows and Columns can be auto-calculated or explicitly set.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC1">When Rows and Columns are both 0, the grid automatically calculates the best layout.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT1">Auto Layout</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC2">Set Rows and Columns explicitly to control the grid dimensions.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT2">Explicit Rows and Columns</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC3">Adjust Rows, Columns, and FirstColumn to see how the layout changes dynamically.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT3">Interactive Configuration</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC4">FirstColumn offsets items in the first row, leaving initial cells empty. Useful for calendar-like layouts.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT4">FirstColumn Property</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC5">Declarative markup for the UniformGrid layouts above.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC6">Creating and configuring a UniformGrid in code-behind.</x:String>

    <!-- Viewbox -->
    <x:String x:Key="Loc.P.Viewbox.Title1">Viewbox</x:String>
    <x:String x:Key="Loc.P.Viewbox.Sub1">A decorator that scales its single child to fit the available space, with control over stretch mode and direction.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC1">Content is scaled uniformly to fit while preserving aspect ratio.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CT1">Uniform Stretch</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC2">Different stretch modes control how content fills the viewbox.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CT2">Stretch Modes</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC3">Control whether content scales up, down, or both.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CT3">Stretch Direction</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC4">Resize the container with the sliders to see the viewbox rescale its child.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC5">Where a viewbox earns its keep in real layouts.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC6">Declarative markup for the viewbox examples above.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC7">Wiring the interactive sliders and scaling icons in code-behind.</x:String>
    <x:String x:Key="Loc.P.Viewbox.Use1">• Scaling icons to different sizes</x:String>
    <x:String x:Key="Loc.P.Viewbox.Use2">• Creating responsive layouts</x:String>
    <x:String x:Key="Loc.P.Viewbox.Use3">• Fitting vector graphics</x:String>
    <x:String x:Key="Loc.P.Viewbox.Use4">• Thumbnail previews</x:String>
    <x:String x:Key="Loc.P.Viewbox.Use5">• Zoom functionality</x:String>

    <!-- WebView -->
    <x:String x:Key="Loc.P.WebView.Title1">WebView</x:String>
    <x:String x:Key="Loc.P.WebView.Sub1">Embeds live web content in your app through the Microsoft Edge WebView2 runtime, with back / forward navigation, page-state events, and JavaScript execution.</x:String>
    <x:String x:Key="Loc.P.WebView.CC1">Navigate to any URL with back, forward, and refresh controls.</x:String>
    <x:String x:Key="Loc.P.WebView.CT1">Browser</x:String>
    <x:String x:Key="Loc.P.WebView.CC2">Displays the current document title and navigation state.</x:String>
    <x:String x:Key="Loc.P.WebView.CT2">Page Info</x:String>
    <x:String x:Key="Loc.P.WebView.CC3">Run JavaScript code in the web page and see the result.</x:String>
    <x:String x:Key="Loc.P.WebView.CT3">Execute JavaScript</x:String>
    <x:String x:Key="Loc.P.WebView.CC4">Key properties exposed by the WebView control.</x:String>
    <x:String x:Key="Loc.P.WebView.CT4">WebView Properties</x:String>
    <x:String x:Key="Loc.P.WebView.CC5">Declarative markup for the browser demo above.</x:String>
    <x:String x:Key="Loc.P.WebView.CC6">Navigation and script requests are commands; a behavior adapts WebView events to ViewModel state.</x:String>
    <x:String x:Key="Loc.P.WebView.Body1">Source - The URI to navigate to (Uri)</x:String>
    <x:String x:Key="Loc.P.WebView.Body2">CanGoBack / CanGoForward - Navigation history state (bool, read-only)</x:String>
    <x:String x:Key="Loc.P.WebView.Body3">ZoomFactor - Zoom level from 0.25 to 4.0 (double)</x:String>
    <x:String x:Key="Loc.P.WebView.Body4">DefaultBackgroundColor - Background color before content loads (Color)</x:String>
    <x:String x:Key="Loc.P.WebView.Body5">DocumentTitle - Current page title (string, read-only)</x:String>
    <x:String x:Key="Loc.P.WebView.Body6">CoreWebView2 - Underlying WebView2 instance for advanced usage</x:String>

    <!-- WrapPanel -->
    <x:String x:Key="Loc.P.WrapPanel.Title1">WrapPanel</x:String>
    <x:String x:Key="Loc.P.WrapPanel.Sub1">A panel that positions child elements sequentially, wrapping to the next line when it reaches the edge of the available space.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC1">Items flow from left to right, wrapping to the next row.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT1">Horizontal WrapPanel</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC2">Items flow from top to bottom, wrapping to the next column.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT2">Vertical WrapPanel</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC3">Using ItemWidth and ItemHeight for uniform sizing.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT3">Fixed Item Size</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC4">A practical use case for WrapPanel.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT4">Tag Cloud Example</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC5">Declarative markup for the WrapPanels above.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC6">Every wrapping layout and item is declared in XAML.</x:String>

    <!-- XamlUICommand -->
    <x:String x:Key="Loc.P.XamlUICommand.Title1">XamlUICommand</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.Sub1">Custom commands defined with user-specified labels, icons, and keyboard accelerators for application-specific actions.</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CC1">Application-specific commands with custom labels, icons, and accelerators, wired to toolbar buttons.</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CT1">Custom XamlUICommand</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CC2">Click the command buttons to trigger actions. The most recent result and history appear below.</x:String>
