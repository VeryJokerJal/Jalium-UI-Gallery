    <!-- TimePicker -->
    <x:String x:Key="Loc.P.TimePicker.Title1">TimePicker</x:String>
    <x:String x:Key="Loc.P.TimePicker.Sub1">A control that lets users pick a time of day, with support for 12- or 24-hour clocks and configurable minute increments.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC1">Click to open the flyout and choose a time; the second picker shows the disabled state.</x:String>
