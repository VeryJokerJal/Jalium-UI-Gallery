    <!-- NetworkGraph -->
    <x:String x:Key="Loc.P.NetworkGraph.Title1">NetworkGraph</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.Sub1">Displays a network visualization with nodes and links, supporting multiple layout algorithms and interactive dragging.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC1">Nodes are positioned using a Fruchterman-Reingold force-directed algorithm.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CT1">Force-Directed Layout</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC2">All nodes are evenly distributed around a circle.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CT2">Circular Layout</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC3">Nodes can be dragged interactively. Click and drag any node to reposition it.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CT3">Interactive</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC4">Declarative markup for the three graphs above.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC5">Node and link collections live in the ViewModel; graph layout is declarative XAML.</x:String>

    <!-- NotifyIcon -->
    <x:String x:Key="Loc.P.NotifyIcon.Title1">NotifyIcon</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.Sub1">Displays an icon in the system notification area (system tray), with support for tooltip text, balloon tips, context menus, and click events.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC1">Show or hide an icon in the system tray with tooltip text.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT1">Basic Tray Icon</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC2">Show balloon tip notifications from the tray icon with different icon types.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT2">Balloon Tips</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC3">NotifyIcon raises events for click, double-click, and balloon tip interactions.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT3">Events</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC4">Assign a ContextMenu to the tray icon. Right-click the tray icon to see the menu.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT4">Context Menu</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC5">The View declares controls and binds them to ViewModel commands.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC6">The ViewModel calls an injected tray service and exposes only bindable state.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.Cap1">The context menu includes: Show Window, Settings, About, Exit</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.Ui1">Enable context menu on tray icon</x:String>

    <!-- NumberBox -->
    <x:String x:Key="Loc.P.NumberBox.Title1">NumberBox</x:String>
    <x:String x:Key="Loc.P.NumberBox.Sub1">A text box optimized for entering numeric values, with spin buttons, range limits and validation built in.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC1">Four variants — a basic field, inline spin buttons, min / max bounds and a custom step size.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC2">What the NumberBox gives you out of the box.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC3">Declarative markup for the NumberBox variants above.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC4">Creating a NumberBox in code, handling ValueChanged and configuring range and step.</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body1">• Numeric input validation</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body2">• Spin buttons for increment / decrement</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body3">• Min / Max value constraints</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body4">• Configurable step size</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body5">• Expression evaluation support</x:String>

    <!-- PasswordBox -->
    <x:String x:Key="Loc.P.PasswordBox.Title1">PasswordBox</x:String>
    <x:String x:Key="Loc.P.PasswordBox.Sub1">A secure text input that masks each character as it is typed, keeping entered passwords hidden from view.</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CC1">Standard password input with masked characters.</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CT1">Basic PasswordBox</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CC2">Declarative markup for the password inputs above, plus a login form layout.</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CT2">PasswordBox States</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CC3">Handling PasswordChanged, validating matches and scoring password strength in code-behind.</x:String>

    <!-- PieChart -->
    <x:String x:Key="Loc.P.PieChart.Title1">PieChart</x:String>
    <x:String x:Key="Loc.P.PieChart.Sub1">Displays data as a pie or donut chart with optional slice explosion, labels, and connectors.</x:String>
    <x:String x:Key="Loc.P.PieChart.CC1">A standard pie chart with labeled slices showing proportional data.</x:String>
    <x:String x:Key="Loc.P.PieChart.CT1">Basic Pie Chart</x:String>
    <x:String x:Key="Loc.P.PieChart.CC2">A pie chart with an inner radius cut-out, creating a donut shape.</x:String>
    <x:String x:Key="Loc.P.PieChart.CT2">Donut Chart</x:String>
    <x:String x:Key="Loc.P.PieChart.CC3">Individual slices can be pulled out from the center for emphasis.</x:String>
    <x:String x:Key="Loc.P.PieChart.CT3">Exploded Slices</x:String>
    <x:String x:Key="Loc.P.PieChart.CC4">Declarative markup for the pie and donut charts above.</x:String>
    <x:String x:Key="Loc.P.PieChart.CC5">The ViewModel provides slice data; XAML owns chart and series configuration.</x:String>

    <!-- Popup -->
    <x:String x:Key="Loc.P.Popup.Title1">Popup</x:String>
    <x:String x:Key="Loc.P.Popup.Sub1">A lightweight overlay surface that floats contextual content above the page, anchored to a target element and shown or dismissed on demand.</x:String>
    <x:String x:Key="Loc.P.Popup.CC1">Toggle a small popup that opens directly below its trigger button.</x:String>
    <x:String x:Key="Loc.P.Popup.CT1">Basic popup</x:String>
    <x:String x:Key="Loc.P.Popup.CC2">Popups can host richer content such as a multi-field form.</x:String>
    <x:String x:Key="Loc.P.Popup.CT2">Popup with form</x:String>
    <x:String x:Key="Loc.P.Popup.CC3">Anchor a popup to the top, right, bottom or left edge of its target.</x:String>
    <x:String x:Key="Loc.P.Popup.CT3">Popup placement</x:String>
    <x:String x:Key="Loc.P.Popup.CC4">Declarative markup for the popups above.</x:String>
    <x:String x:Key="Loc.P.Popup.CC5">Toggle each popup's IsOpen property to show or dismiss it from code-behind.</x:String>
    <x:String x:Key="Loc.P.Popup.Demo1">This is a popup!</x:String>

    <!-- Printing -->
    <x:String x:Key="Loc.P.Printing.Title1">Printing</x:String>
    <x:String x:Key="Loc.P.Printing.Sub1">WPF-compatible printing with PrintDialog, PrintQueue, and DocumentPaginator support.</x:String>
    <x:String x:Key="Loc.P.Printing.CC1">Standard print dialog for selecting a printer and print options.</x:String>
    <x:String x:Key="Loc.P.Printing.CT1">PrintDialog</x:String>
    <x:String x:Key="Loc.P.Printing.CC2">Represents a printer and provides print-capabilities querying.</x:String>
    <x:String x:Key="Loc.P.Printing.CT2">PrintQueue</x:String>
    <x:String x:Key="Loc.P.Printing.CC3">Query printer capabilities including paper sizes, colors, and resolution.</x:String>
    <x:String x:Key="Loc.P.Printing.CT3">PrintCapabilities</x:String>
    <x:String x:Key="Loc.P.Printing.CC4">Paginate documents for printing with the IDocumentPaginatorSource interface.</x:String>
