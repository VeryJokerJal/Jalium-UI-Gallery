    <!-- AppBarButton -->
    <x:String x:Key="Loc.P.AppBarButton.Title1">AppBarButton</x:String>
    <x:String x:Key="Loc.P.AppBarButton.Sub1">A button control designed for use in a CommandBar, pairing an icon with a label to expose common commands on a toolbar.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC1">AppBarButtons pair an icon with a label for common actions.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CT1">Basic AppBarButton</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC2">AppBarButtons in compact mode show only icons, without labels.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CT2">Compact mode</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC3">Declarative markup for the AppBarButtons above.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC4">Creating AppBarButtons and wiring click handlers in code-behind.</x:String>

    <!-- AppBarSeparator -->
    <x:String x:Key="Loc.P.AppBarSeparator.Title1">AppBarSeparator</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.Sub1">A thin vertical rule that visually separates groups of related commands inside a CommandBar or toolbar.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC1">Separators divide toolbar buttons into logical groups. On narrow widths the strip reflows onto multiple lines.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CT1">AppBarSeparator in toolbar</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC2">Declarative markup for the toolbar and its separators above.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC3">Building the toolbar and wiring button click handlers in code-behind.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CT2">Separator inside a CommandBar</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC4">Its natural host: a separator divides the primary commands, and a second one groups the overflow menu.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St0">Click a toolbar button to see its action.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St1">New file created.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St2">Open file dialog triggered.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St3">File saved.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St4">Selection cut to clipboard.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St5">Selection copied to clipboard.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St6">Clipboard content pasted.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St7">Last action undone.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St8">Last undo redone.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.St9">Unknown toolbar action.</x:String>

    <!-- AppBarToggleButton -->
    <x:String x:Key="Loc.P.AppBarToggleButton.Title1">AppBarToggleButton</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.Sub1">A toggle button designed for use in a CommandBar, holding a persistent checked or unchecked state to switch a setting on and off.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC1">Toggle buttons for text formatting options like Bold, Italic, and Underline.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CT1">Text Formatting</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC2">Toggle buttons that display their IsChecked state.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CT2">Checked State</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC3">Declarative markup for the toggle buttons above.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC4">Wiring checked and unchecked handlers in code-behind.</x:String>

    <!-- AutoCompleteBox -->
    <x:String x:Key="Loc.P.AutoCompleteBox.Title1">AutoCompleteBox</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Sub1">A text input control that suggests matching items from a source list as you type, with keyboard navigation and configurable filter modes.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC1">Start typing to see suggestions. Use the arrow keys to navigate.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CT1">Filter modes</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC2">Choose how typed text is matched against the suggestion list.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC3">AutoCompleteBox provides rich auto-completion functionality.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC4">Declarative markup for the AutoCompleteBox examples.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC5">Wiring the items source, filter mode and selection handler in code-behind.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body1">* StartsWith - items beginning with typed text</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body2">* Contains - items containing typed text</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body3">* Equals - exact match only</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body4">* Custom - use your own filter predicate</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body5">* Watermark placeholder text</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body6">* Minimum prefix length before suggestions</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body7">* Keyboard navigation (Up/Down/Enter/Escape)</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body8">* Text completion on Tab key</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body9">* Customizable max drop-down height</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body10">* TextMemberPath for complex objects</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Cap1">Search for a programming language:</x:String>

    <!-- BackdropEffects -->
    <x:String x:Key="Loc.P.BackdropEffects.Title1">Backdrop Effects</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.Sub1">Apply blur and material effects to the background, using the built-in effects or your own IBackdropEffect implementation.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC1">Simple Gaussian blur effect. Adjust blur radius to control intensity.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT1">BackdropBlurEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC2">Windows Acrylic material with blur, tint color, and noise texture.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT2">AcrylicEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC3">Windows 11 Mica material with enhanced saturation and luminosity.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT3">MicaEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC4">Frosted glass effect with noise texture for a realistic glass appearance.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT4">FrostedGlassEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC5">Convert colors to grayscale. Useful for disabled states or artistic effects.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT5">ColorAdjustmentEffect - Grayscale</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC6">Apply vintage sepia tone effect for a warm, nostalgic look.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT6">ColorAdjustmentEffect - Sepia</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC7">Invert all colors. Red becomes cyan, white becomes black, etc.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT7">ColorAdjustmentEffect - Invert</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC8">Rotate the hue of all colors. 90° turns red to green, green to blue, etc.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT8">ColorAdjustmentEffect - Hue Rotate</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC9">Apply system-level backdrop effects that blur content behind the window (desktop, other apps). Requires Windows 11 22H2+.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT9">Window System Backdrop</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC10">Set the BackdropEffect property on any UIElement:</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC11">Declarative markup for the backdrop overlays and system-backdrop buttons above.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC12">Assigning each BackdropEffect and the window SystemBackdrop from code-behind.</x:String>

    <!-- BarChart -->
    <x:String x:Key="Loc.P.BarChart.Title1">BarChart</x:String>
    <x:String x:Key="Loc.P.BarChart.Sub1">Renders numeric series as grouped, stacked, or horizontal bars with optional value labels, gridlines, and a legend.</x:String>
    <x:String x:Key="Loc.P.BarChart.CC1">Multiple series displayed as grouped bars side by side for easy comparison.</x:String>
    <x:String x:Key="Loc.P.BarChart.CT1">Grouped Bars</x:String>
    <x:String x:Key="Loc.P.BarChart.CC2">Series stacked on top of each other to show total and composition.</x:String>
    <x:String x:Key="Loc.P.BarChart.CT2">Stacked Bars</x:String>
    <x:String x:Key="Loc.P.BarChart.CC3">Bars rendered horizontally, useful for category comparisons with long labels.</x:String>
    <x:String x:Key="Loc.P.BarChart.CT3">Horizontal Bars</x:String>
    <x:String x:Key="Loc.P.BarChart.CC4">Declarative markup for a grouped bar chart with two series.</x:String>
    <x:String x:Key="Loc.P.BarChart.CC5">Series are declared in XAML and bind to category/value collections owned by the ViewModel.</x:String>

    <!-- Binding -->
    <x:String x:Key="Loc.P.Binding.Title1">Binding</x:String>
    <x:String x:Key="Loc.P.Binding.Sub1">Connect one element's property to another element or a data source so their values stay in sync automatically, with no glue code.</x:String>
    <x:String x:Key="Loc.P.Binding.CC1">Bind one control directly to another element's property with ElementName. Drag the slider and the readout updates live.</x:String>
    <x:String x:Key="Loc.P.Binding.CT1">ElementName binding</x:String>
    <x:String x:Key="Loc.P.Binding.CC2">With Mode=TwoWay the value flows both ways — edit either box and the other follows instantly.</x:String>
    <x:String x:Key="Loc.P.Binding.CT2">Two-way ElementName binding</x:String>
    <x:String x:Key="Loc.P.Binding.CC3">How ElementName binding reads in JALXAML markup.</x:String>
    <x:String x:Key="Loc.P.Binding.CT3">JALXAML syntax</x:String>
    <x:String x:Key="Loc.P.Binding.CC4">The direction data flows between the binding source and its target.</x:String>
    <x:String x:Key="Loc.P.Binding.CT4">Binding modes</x:String>
    <x:String x:Key="Loc.P.Binding.CC5">Full markup for the bindings demonstrated above.</x:String>
    <x:String x:Key="Loc.P.Binding.CC6">Creating and applying the same bindings in code-behind.</x:String>
    <x:String x:Key="Loc.P.Binding.Body1">OneWay — Source to target only (default)</x:String>
    <x:String x:Key="Loc.P.Binding.Body2">TwoWay — Source to target and target to source</x:String>
    <x:String x:Key="Loc.P.Binding.Body3">OneWayToSource — Target to source only</x:String>
    <x:String x:Key="Loc.P.Binding.Body4">OneTime — Source to target once at binding time</x:String>
    <x:String x:Key="Loc.P.Binding.Cap1">Slider value (source):</x:String>
    <x:String x:Key="Loc.P.Binding.Cap2">TextBlock bound to Slider.Value:</x:String>
    <x:String x:Key="Loc.P.Binding.Cap3">Source TextBox:</x:String>
    <x:String x:Key="Loc.P.Binding.Cap4">Target TextBox (bound to SourceTextBox.Text):</x:String>

    <!-- Border -->
    <x:String x:Key="Loc.P.Border.Title1">Border</x:String>
    <x:String x:Key="Loc.P.Border.Sub1">A decorator that draws a border, background, or both around its child.</x:String>
    <x:String x:Key="Loc.P.Border.CC1">Fill only, stroke only, or both combined on a single decorator.</x:String>
    <x:String x:Key="Loc.P.Border.CT1">Basic Border</x:String>
    <x:String x:Key="Loc.P.Border.CC2">Rounding the corners from square to fully pill-shaped.</x:String>
    <x:String x:Key="Loc.P.Border.CT2">Corner Radius</x:String>
    <x:String x:Key="Loc.P.Border.CC3">Stroke weight from a hairline to a heavy outline.</x:String>
    <x:String x:Key="Loc.P.Border.CT3">Border Thickness</x:String>
    <x:String x:Key="Loc.P.Border.CC4">Inner spacing between the border and its content grows with each value.</x:String>
    <x:String x:Key="Loc.P.Border.CT4">Padding</x:String>
    <x:String x:Key="Loc.P.Border.CC5">Declarative markup for the borders above.</x:String>
    <x:String x:Key="Loc.P.Border.CC6">Building borders and cards in code-behind.</x:String>

    <!-- Button -->
    <x:String x:Key="Loc.P.Button.Title1">Button</x:String>
    <x:String x:Key="Loc.P.Button.Sub1">A clickable command surface that triggers an action. Buttons carry text or custom content, come in multiple sizes and states, and repaint automatically with the accent theme.</x:String>
    <x:String x:Key="Loc.P.Button.CC1">Tap the button to increment the counter.</x:String>
    <x:String x:Key="Loc.P.Button.CT1">Sizes</x:String>
    <x:String x:Key="Loc.P.Button.CC2">Standard button with default styling, plus a disabled state.</x:String>
    <x:String x:Key="Loc.P.Button.CT2">Accent theming</x:String>
    <x:String x:Key="Loc.P.Button.CC3">Small, medium and large presets scale font and padding together.</x:String>
    <x:String x:Key="Loc.P.Button.CC4">Buttons bound to the accent brushes via {ThemeResource} repaint automatically when the theme or accent color switches.</x:String>
    <x:String x:Key="Loc.P.Button.CC5">Declarative markup for the buttons above.</x:String>
    <x:String x:Key="Loc.P.Button.CC6">Keeping button state and actions in a bindable ViewModel.</x:String>

    <!-- Calendar -->
    <x:String x:Key="Loc.P.Calendar.Title1">Calendar</x:String>
    <x:String x:Key="Loc.P.Calendar.Sub1">A control that displays a monthly calendar for browsing and selecting dates, with month, year and decade views.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC1">Pick a day on the calendar and the selected date updates below.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC2">The Calendar control supports the following out of the box.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC3">Declarative markup for the Calendar shown above.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC4">Creating a Calendar and handling date selection in code-behind.</x:String>
    <x:String x:Key="Loc.P.Calendar.Body1">• Month / year / decade views</x:String>
    <x:String x:Key="Loc.P.Calendar.Body2">• Single or range date selection</x:String>
    <x:String x:Key="Loc.P.Calendar.Body3">• Blackout dates</x:String>
    <x:String x:Key="Loc.P.Calendar.Body4">• Display date range constraints</x:String>
    <x:String x:Key="Loc.P.Calendar.Body5">• First day of week customization</x:String>
    <x:String x:Key="Loc.P.Calendar.Cap1">Selected date</x:String>
    <x:String x:Key="Loc.P.Calendar.CT1">Selection modes and display options</x:String>
    <x:String x:Key="Loc.P.Calendar.CC5">The same control with a range selection, a Monday week start, and the year view — each set from a single property.</x:String>
    <x:String x:Key="Loc.P.Calendar.Cap2">SelectionMode = SingleRange</x:String>
    <x:String x:Key="Loc.P.Calendar.Cap3">FirstDayOfWeek = Sunday, today not highlighted</x:String>
    <x:String x:Key="Loc.P.Calendar.Cap4">DisplayMode = Year</x:String>

    <!-- CandlestickChart -->
    <x:String x:Key="Loc.P.CandlestickChart.Title1">CandlestickChart</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.Sub1">Displays financial OHLC data as candlesticks with optional volume bars and moving average overlays.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC1">A candlestick chart with simulated OHLC price data.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CT1">Basic Candlestick</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC2">A candlestick chart with a volume sub-chart below the price data.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CT2">With Volume</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC3">A candlestick chart with SMA and EMA overlay lines.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CT3">Moving Averages</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC4">Declarative markup for the candlestick charts above.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC5">The ViewModel generates deterministic OHLC collections; chart configuration stays declarative in XAML.</x:String>

    <!-- Canvas -->
    <x:String x:Key="Loc.P.Canvas.Title1">Canvas</x:String>
    <x:String x:Key="Loc.P.Canvas.Sub1">A layout panel that positions its children at absolute coordinates set through Canvas.Left, Canvas.Top, Canvas.Right and Canvas.Bottom, with Panel.ZIndex controlling how overlapping elements stack.</x:String>
    <x:String x:Key="Loc.P.Canvas.CC1">Elements positioned with Canvas.Left and Canvas.Top.</x:String>
    <x:String x:Key="Loc.P.Canvas.CT1">Canvas Overview</x:String>
    <x:String x:Key="Loc.P.Canvas.CC2">Key capabilities of the Canvas control.</x:String>
    <x:String x:Key="Loc.P.Canvas.CT2">Canvas Features</x:String>
    <x:String x:Key="Loc.P.Canvas.CC3">Declarative markup that positions borders on a Canvas.</x:String>
    <x:String x:Key="Loc.P.Canvas.CC4">Creating and positioning canvas children in code-behind.</x:String>
    <x:String x:Key="Loc.P.Canvas.Legend1">Canvas.Left — distance from the left edge</x:String>
    <x:String x:Key="Loc.P.Canvas.Legend2">Canvas.Top — distance from the top edge</x:String>
    <x:String x:Key="Loc.P.Canvas.Legend3">Canvas.Right — distance from the right edge</x:String>
    <x:String x:Key="Loc.P.Canvas.Legend4">Canvas.Bottom — distance from the bottom edge</x:String>
    <x:String x:Key="Loc.P.Canvas.Legend5">Panel.ZIndex — controls the layering order</x:String>
    <x:String x:Key="Loc.P.Canvas.Note1">Canvas allows absolute positioning of elements.</x:String>

    <!-- CheckBox -->
    <x:String x:Key="Loc.P.CheckBox.Title1">CheckBox</x:String>
    <x:String x:Key="Loc.P.CheckBox.Sub1">A control a user can select and clear, with optional support for an indeterminate third state.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC1">Click the checkbox to toggle its state.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CT1">Basic checkboxes</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC2">Standard checkbox controls in unchecked, checked and disabled states.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CT2">Three-state checkbox</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC3">A checkbox that adds an indeterminate state alongside checked and unchecked.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC4">Declarative markup for the checkboxes above.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC5">Wiring checked, unchecked and indeterminate handlers in code-behind.</x:String>
    <x:String x:Key="Loc.P.CheckBox.Demo1">I agree to the terms</x:String>
    <x:String x:Key="Loc.P.CheckBox.Demo2">Option 2 (checked)</x:String>
    <x:String x:Key="Loc.P.CheckBox.Demo3">Disabled option</x:String>
    <x:String x:Key="Loc.P.CheckBox.Demo4">Three-state checkbox</x:String>

    <!-- ColorPicker -->
    <x:String x:Key="Loc.P.ColorPicker.Eyebrow1">PICKERS</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Title1">ColorPicker</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Sub1">A control that lets users pick a color from a spectrum and sliders, with an optional alpha channel and a compact layout for tight spaces.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC1">A full-featured color picker with spectrum and sliders.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CT1">Basic ColorPicker</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC2">A more compact version for space-limited scenarios.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CT2">Compact ColorPicker</x:String>
