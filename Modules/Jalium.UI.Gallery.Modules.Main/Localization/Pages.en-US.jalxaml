    <x:String x:Key="Loc.P.DiffViewer.CC5">Binding both source documents to ViewModel properties.</x:String>

    <!-- DockLayout -->
    <x:String x:Key="Loc.P.DockLayout.Title1">DockLayout</x:String>
    <x:String x:Key="Loc.P.DockLayout.Sub1">A VS-style docking layout with resizable split panels and tab groups for composing IDE-like workspaces.</x:String>
    <x:String x:Key="Loc.P.DockLayout.CC1">Left sidebar + center editor + bottom panel, with resizable splitters.</x:String>
    <x:String x:Key="Loc.P.DockLayout.CT1">IDE Layout</x:String>
