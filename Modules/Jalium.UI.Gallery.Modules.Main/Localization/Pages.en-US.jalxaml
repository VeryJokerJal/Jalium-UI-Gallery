    <!-- Separator -->
    <x:String x:Key="Loc.P.Separator.Title1">Separator</x:String>
    <x:String x:Key="Loc.P.Separator.Sub1">A visual separator used to divide content in menus, toolbars, and other layouts.</x:String>
