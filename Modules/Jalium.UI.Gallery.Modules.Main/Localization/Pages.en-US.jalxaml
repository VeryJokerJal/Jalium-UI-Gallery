    <!-- StandardUICommand -->
    <x:String x:Key="Loc.P.StandardUICommand.Title1">StandardUICommand</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.Sub1">Predefined commands with standard labels, icons, keyboard shortcuts, and descriptions for common operations.</x:String>
