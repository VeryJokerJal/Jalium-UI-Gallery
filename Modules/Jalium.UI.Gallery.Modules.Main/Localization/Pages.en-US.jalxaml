    <x:String x:Key="Loc.P.Ribbon.Body7">RibbonMenuButton / RibbonSplitButton / RibbonToggleButton</x:String>

    <!-- RichTextBox -->
    <x:String x:Key="Loc.P.RichTextBox.Title1">RichTextBox</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Sub1">A control for editing and displaying rich text documents with inline formatting such as bold, italic, fonts, sizes and colors.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC1">A rich text editor for formatted text.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CT1">Basic RichTextBox</x:String>
