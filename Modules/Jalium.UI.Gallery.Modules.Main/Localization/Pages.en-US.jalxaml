    <x:String x:Key="Loc.P.StatusBar.Body2">• Can contain any content</x:String>
    <x:String x:Key="Loc.P.StatusBar.Body3">• Typically placed at window bottom</x:String>
    <x:String x:Key="Loc.P.StatusBar.Body4">• Supports progress indicators</x:String>

    <!-- SwipeControl -->
    <x:String x:Key="Loc.P.SwipeControl.Title1">SwipeControl</x:String>
    <x:String x:Key="Loc.P.SwipeControl.Sub1">A touch-friendly control that reveals contextual actions such as Archive, Delete and Flag through swipe gestures on list items.</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CC1">Swipe items left or right to reveal contextual actions like Archive and Delete.</x:String>
