    <!-- TextBox -->
    <x:String x:Key="Loc.P.TextBox.Title1">TextBox</x:String>
    <x:String x:Key="Loc.P.TextBox.Sub1">A single-line text input control for capturing and editing plain text, with pre-filled and disabled states, clipboard operations and the standard editing shortcuts.</x:String>
