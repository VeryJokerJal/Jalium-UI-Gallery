    <!-- Terminal -->
    <x:String x:Key="Loc.P.Terminal.Title1">Terminal</x:String>
    <x:String x:Key="Loc.P.Terminal.Sub1">A terminal emulator control with VT100/ANSI escape sequence support, shell process integration, and full keyboard/IME input.</x:String>
