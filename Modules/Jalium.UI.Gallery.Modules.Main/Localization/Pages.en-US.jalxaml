    <!-- ContextMenu -->
    <x:String x:Key="Loc.P.ContextMenu.Title1">ContextMenu</x:String>
    <x:String x:Key="Loc.P.ContextMenu.Sub1">A popup menu of commands that opens where the user right-clicks, attached to any element through the ContextMenuService.</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CC1">Right-click on the area below to open the context menu.</x:String>
