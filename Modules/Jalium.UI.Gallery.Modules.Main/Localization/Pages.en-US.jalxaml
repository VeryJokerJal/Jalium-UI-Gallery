    <!-- StatusBar -->
    <x:String x:Key="Loc.P.StatusBar.Title1">StatusBar</x:String>
    <x:String x:Key="Loc.P.StatusBar.Sub1">A horizontal bar that surfaces status information — cursor position, encoding, progress — along the bottom edge of a window.</x:String>
    <x:String x:Key="Loc.P.StatusBar.CC1">Status items separated by dividers, laid out as you would place them at the bottom of an editor window.</x:String>
    <x:String x:Key="Loc.P.StatusBar.CC2">What the StatusBar control gives you out of the box.</x:String>
