    <x:String x:Key="Loc.P.ToolTip.Tip6">Adjust the volume level</x:String>
    <x:String x:Key="Loc.P.ToolTip.Tip7">Volume slider</x:String>
    <x:String x:Key="Loc.P.ToolTip.Tip8">Enable notifications</x:String>
    <x:String x:Key="Loc.P.ToolTip.Tip9">Turn on/off notification alerts</x:String>
    <x:String x:Key="Loc.P.ToolTip.Tip10">Hover for rich tooltip</x:String>
