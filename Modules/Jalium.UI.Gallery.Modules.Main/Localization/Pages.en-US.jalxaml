    <x:String x:Key="Loc.P.SwipeControl.CC4">Each templated row exposes independent ViewModel commands.</x:String>

    <!-- SystemNotification -->
    <x:String x:Key="Loc.P.SystemNotification.Title1">SystemNotification</x:String>
    <x:String x:Key="Loc.P.SystemNotification.Sub1">Sends native OS notifications through SystemNotificationManager, with titles, body text, action buttons, priority levels, and activation callbacks.</x:String>
