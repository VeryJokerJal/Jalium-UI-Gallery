    <x:String x:Key="Loc.P.Splitter.Use4">• Dashboard layouts</x:String>
    <x:String x:Key="Loc.P.Splitter.Use5">• Settings panels</x:String>

    <!-- StackPanel -->
    <x:String x:Key="Loc.P.StackPanel.Title1">StackPanel</x:String>
    <x:String x:Key="Loc.P.StackPanel.Sub1">A panel that arranges its children in a single line — stacked vertically from top to bottom, or horizontally from left to right.</x:String>
