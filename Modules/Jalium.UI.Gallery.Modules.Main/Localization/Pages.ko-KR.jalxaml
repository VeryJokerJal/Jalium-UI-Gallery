<ResourceDictionary x:Class="Jalium.UI.Gallery.Modules.Main.Localization.PagesKoKR"
                    xmlns="http://schemas.jalium.ui/2024"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        샘플 페이지 문구, 한국어 (ko-KR).

        키는 Pages.en-US.jalxaml과 대응합니다. 여기에 없는 키는 영어로
        폴백되므로 페이지 단위로 조금씩 채워 넣어도 화면이 비지 않습니다.

        Loc.Shared.*   여러 페이지가 공유하는 문구(카테고리 아이브로우,
                       "인터랙티브 데모", XAML / C# 등).
        Loc.P.<페이지>.*  해당 페이지 전용 문구. 접미사는 디자인 시스템에서의
                       역할이며 Eyebrow / Title / Sub는 페이지 헤더,
                       CT / CC는 카드 제목과 설명, 나머지는 Body / Cap /
                       Chip / Val입니다.
    -->

    <!-- ============================== 공용 ================================ -->

    <x:String x:Key="Loc.Shared.Basic">기본</x:String>
    <x:String x:Key="Loc.Shared.BasicHeatmap">기본 히트맵</x:String>
    <x:String x:Key="Loc.Shared.BasicInput">기본 입력</x:String>
    <x:String x:Key="Loc.Shared.BoundSelection">바인딩된 선택</x:String>
    <x:String x:Key="Loc.Shared.CSharp">C#</x:String>
    <x:String x:Key="Loc.Shared.CSharpCodeExample">C# 코드 예제</x:String>
    <x:String x:Key="Loc.Shared.Collections">컬렉션</x:String>
    <x:String x:Key="Loc.Shared.CommonUseCases">일반적인 사용 사례</x:String>
    <x:String x:Key="Loc.Shared.CommonUseCases2">일반적인 사용 사례</x:String>
    <x:String x:Key="Loc.Shared.CustomizableAppearance">• 외형 사용자 지정 가능</x:String>
    <x:String x:Key="Loc.Shared.DataAndBinding">데이터와 바인딩</x:String>
    <x:String x:Key="Loc.Shared.DataViewers">데이터 뷰어</x:String>
    <x:String x:Key="Loc.Shared.DataVisualization">데이터 시각화</x:String>
    <x:String x:Key="Loc.Shared.DateAndTime">날짜와 시간</x:String>
    <x:String x:Key="Loc.Shared.Dialogs">대화 상자</x:String>
    <x:String x:Key="Loc.Shared.Effects">이펙트</x:String>
    <x:String x:Key="Loc.Shared.EnabledAndDisabledStates">사용 가능 상태와 비활성 상태.</x:String>
    <x:String x:Key="Loc.Shared.Features">기능</x:String>
    <x:String x:Key="Loc.Shared.InteractiveDemo">인터랙티브 데모</x:String>
    <x:String x:Key="Loc.Shared.InteractiveDemo2">인터랙티브 데모</x:String>
    <x:String x:Key="Loc.Shared.KeyboardShortcuts">키보드 단축키</x:String>
    <x:String x:Key="Loc.Shared.Layout">레이아웃</x:String>
    <x:String x:Key="Loc.Shared.LiveEditor">라이브 에디터</x:String>
    <x:String x:Key="Loc.Shared.MapsAndGeo">지도와 위치</x:String>
    <x:String x:Key="Loc.Shared.Media">미디어</x:String>
    <x:String x:Key="Loc.Shared.MenusAndToolbars">메뉴와 도구 모음</x:String>
    <x:String x:Key="Loc.Shared.Navigation">내비게이션</x:String>
    <x:String x:Key="Loc.Shared.Options">옵션</x:String>
    <x:String x:Key="Loc.Shared.Overlays">오버레이</x:String>
    <x:String x:Key="Loc.Shared.Properties">속성</x:String>
    <x:String x:Key="Loc.Shared.ReadOnlyMode">읽기 전용 모드</x:String>
    <x:String x:Key="Loc.Shared.SegmentedTrack">구간 트랙</x:String>
    <x:String x:Key="Loc.Shared.SnapToTicks">눈금에 맞추기</x:String>
    <x:String x:Key="Loc.Shared.StatusAndInfo">상태와 정보</x:String>
    <x:String x:Key="Loc.Shared.Styling">스타일링</x:String>
    <x:String x:Key="Loc.Shared.System">시스템</x:String>
    <x:String x:Key="Loc.Shared.TextAndTypography">텍스트와 타이포그래피</x:String>
    <x:String x:Key="Loc.Shared.Usage">사용법</x:String>
    <x:String x:Key="Loc.Shared.Xaml">XAML</x:String>
    <x:String x:Key="Loc.Shared.XamlCodeExample">XAML 코드 예제</x:String>

    <!-- AppBarButton -->
    <x:String x:Key="Loc.P.AppBarButton.Title1">AppBarButton</x:String>
    <x:String x:Key="Loc.P.AppBarButton.Sub1">CommandBar에서 사용하도록 설계된 버튼으로, 아이콘과 레이블을 짝지어 자주 쓰는 명령을 도구 모음에 노출합니다.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CT1">기본 AppBarButton</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC1">AppBarButton은 아이콘과 레이블을 함께 두어 자주 쓰는 동작을 나타냅니다.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CT2">컴팩트 모드</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC2">컴팩트 모드의 AppBarButton은 레이블 없이 아이콘만 표시합니다.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC3">위 AppBarButton을 선언형 마크업으로 작성한 예.</x:String>
    <x:String x:Key="Loc.P.AppBarButton.CC4">코드 비하인드에서 AppBarButton을 만들고 클릭 처리기를 연결합니다.</x:String>

    <!-- AppBarSeparator -->
    <x:String x:Key="Loc.P.AppBarSeparator.Title1">AppBarSeparator</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.Sub1">CommandBar나 도구 모음에서 관련 명령 그룹을 시각적으로 나누는 얇은 세로선입니다.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CT1">도구 모음의 AppBarSeparator</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC1">구분선은 도구 모음 버튼을 논리적 그룹으로 나눕니다. 너비가 좁으면 여러 줄로 흐릅니다.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC2">위 도구 모음과 구분선을 선언형 마크업으로 작성한 예.</x:String>
    <x:String x:Key="Loc.P.AppBarSeparator.CC3">코드 비하인드에서 도구 모음을 구성하고 버튼 클릭 처리기를 연결합니다.</x:String>

    <!-- AppBarToggleButton -->
    <x:String x:Key="Loc.P.AppBarToggleButton.Title1">AppBarToggleButton</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.Sub1">CommandBar용 토글 버튼으로, 선택/해제 상태를 유지하며 설정을 켜고 끕니다.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CT1">텍스트 서식</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC1">굵게, 기울임, 밑줄 같은 텍스트 서식 옵션을 위한 토글 버튼.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CT2">선택 상태</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC2">자신의 IsChecked 상태를 표시하는 토글 버튼.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC3">위 토글 버튼을 선언형 마크업으로 작성한 예.</x:String>
    <x:String x:Key="Loc.P.AppBarToggleButton.CC4">코드 비하인드에서 Checked, Unchecked 처리기를 연결합니다.</x:String>

    <!-- AutoCompleteBox -->
    <x:String x:Key="Loc.P.AutoCompleteBox.Title1">AutoCompleteBox</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Sub1">입력하는 대로 원본 목록에서 일치 항목을 제안하는 텍스트 입력 컨트롤로, 키보드 탐색과 다양한 필터 모드를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC1">입력을 시작하면 제안이 표시됩니다. 화살표 키로 이동하세요.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CT1">필터 모드</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC2">입력한 텍스트를 제안 목록과 어떻게 대조할지 선택합니다.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC3">AutoCompleteBox는 풍부한 자동 완성 기능을 제공합니다.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC4">위 AutoCompleteBox 예제를 선언형 마크업으로 작성한 예.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.CC5">코드 비하인드에서 항목 원본, 필터 모드, 선택 처리기를 연결합니다.</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body1">* StartsWith — 입력한 텍스트로 시작하는 항목</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body2">* Contains — 입력한 텍스트를 포함하는 항목</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body3">* Equals — 정확히 일치하는 항목만</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body4">* Custom — 직접 만든 필터 조건자 사용</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body5">* 워터마크 자리 표시자 텍스트</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body6">* 제안 전 최소 입력 길이</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body7">* 키보드 탐색(위/아래/Enter/Esc)</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body8">* Tab 키로 텍스트 완성</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body9">* 드롭다운 최대 높이 사용자 지정 가능</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Body10">* 복합 개체를 위한 TextMemberPath</x:String>
    <x:String x:Key="Loc.P.AutoCompleteBox.Cap1">프로그래밍 언어 검색:</x:String>

    <!-- BackdropEffects -->
    <x:String x:Key="Loc.P.BackdropEffects.Title1">배경 효과</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.Sub1">배경에 흐림과 머티리얼 효과를 적용합니다. 기본 제공 효과는 물론 직접 만든 IBackdropEffect도 쓸 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT1">BackdropBlurEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC1">단순한 가우시안 흐림 효과. 흐림 반경으로 강도를 조절합니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT2">AcrylicEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC2">흐림, 틴트 색상, 노이즈 텍스처를 갖춘 Windows 아크릴 머티리얼.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT3">MicaEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC3">채도와 휘도를 높인 Windows 11 마이카 머티리얼.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT4">FrostedGlassEffect</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC4">노이즈 텍스처를 더한 젖빛 유리 효과로 실제 유리에 가까운 느낌을 냅니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT5">ColorAdjustmentEffect — 그레이스케일</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC5">색을 회색조로 변환합니다. 비활성 상태나 예술적 효과에 유용합니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT6">ColorAdjustmentEffect — 세피아</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC6">빈티지 세피아 톤을 적용해 따뜻하고 아련한 느낌을 줍니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT7">ColorAdjustmentEffect — 색 반전</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC7">모든 색을 반전합니다. 빨강은 청록으로, 흰색은 검정으로 바뀝니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT8">ColorAdjustmentEffect — 색조 회전</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC8">모든 색의 색조를 회전합니다. 90°에서 빨강은 초록으로, 초록은 파랑으로 바뀝니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CT9">창 시스템 배경</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC9">창 뒤의 내용(바탕 화면, 다른 앱)을 흐리게 하는 시스템 수준 배경 효과입니다. Windows 11 22H2 이상이 필요합니다.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC10">임의의 UIElement에서 BackdropEffect 속성을 설정합니다:</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC11">위 배경 오버레이와 시스템 배경 버튼의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.BackdropEffects.CC12">코드 비하인드에서 각 BackdropEffect와 창의 SystemBackdrop을 지정합니다.</x:String>

    <!-- BarChart -->
    <x:String x:Key="Loc.P.BarChart.Title1">BarChart</x:String>
    <x:String x:Key="Loc.P.BarChart.Sub1">숫자 계열을 그룹, 누적, 가로 막대로 그립니다. 값 레이블, 눈금선, 범례를 선택적으로 표시합니다.</x:String>
    <x:String x:Key="Loc.P.BarChart.CT1">그룹 막대</x:String>
    <x:String x:Key="Loc.P.BarChart.CC1">여러 계열을 나란히 배치해 비교하기 쉽게 표시합니다.</x:String>
    <x:String x:Key="Loc.P.BarChart.CT2">누적 막대</x:String>
    <x:String x:Key="Loc.P.BarChart.CC2">계열을 쌓아 총량과 구성 비율을 함께 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.BarChart.CT3">가로 막대</x:String>
    <x:String x:Key="Loc.P.BarChart.CC3">막대를 가로로 그립니다. 레이블이 긴 범주를 비교할 때 좋습니다.</x:String>
    <x:String x:Key="Loc.P.BarChart.CC4">두 계열을 가진 그룹 막대 차트의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.BarChart.CC5">계열은 XAML에서 선언하고 ViewModel이 가진 범주/값 컬렉션에 바인딩합니다.</x:String>

    <!-- Binding -->
    <x:String x:Key="Loc.P.Binding.Title1">Binding</x:String>
    <x:String x:Key="Loc.P.Binding.Sub1">한 요소의 속성을 다른 요소나 데이터 원본에 연결해 값이 자동으로 동기화되도록 합니다. 접착 코드가 필요 없습니다.</x:String>
    <x:String x:Key="Loc.P.Binding.CT1">ElementName 바인딩</x:String>
    <x:String x:Key="Loc.P.Binding.CC1">ElementName으로 한 컨트롤을 다른 요소의 속성에 직접 바인딩합니다. 슬라이더를 움직이면 표시가 즉시 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.Binding.CT2">양방향 ElementName 바인딩</x:String>
    <x:String x:Key="Loc.P.Binding.CC2">Mode=TwoWay로 두면 값이 양방향으로 흐릅니다. 어느 쪽 상자를 편집해도 다른 쪽이 즉시 따라옵니다.</x:String>
    <x:String x:Key="Loc.P.Binding.CT3">JALXAML 구문</x:String>
    <x:String x:Key="Loc.P.Binding.CC3">ElementName 바인딩을 JALXAML 마크업으로 쓰면 이렇게 됩니다.</x:String>
    <x:String x:Key="Loc.P.Binding.CT4">바인딩 모드</x:String>
    <x:String x:Key="Loc.P.Binding.CC4">바인딩 원본과 대상 사이에서 데이터가 흐르는 방향입니다.</x:String>
    <x:String x:Key="Loc.P.Binding.CC5">위에서 보인 바인딩의 전체 마크업.</x:String>
    <x:String x:Key="Loc.P.Binding.CC6">코드 비하인드에서 같은 바인딩을 만들어 적용합니다.</x:String>
    <x:String x:Key="Loc.P.Binding.Body1">OneWay — 원본에서 대상으로만(기본값)</x:String>
    <x:String x:Key="Loc.P.Binding.Body2">TwoWay — 원본에서 대상으로, 대상에서 원본으로</x:String>
    <x:String x:Key="Loc.P.Binding.Body3">OneWayToSource — 대상에서 원본으로만</x:String>
    <x:String x:Key="Loc.P.Binding.Body4">OneTime — 바인딩 시점에 원본에서 대상으로 한 번만</x:String>
    <x:String x:Key="Loc.P.Binding.Cap1">슬라이더 값(원본):</x:String>
    <x:String x:Key="Loc.P.Binding.Cap2">Slider.Value에 바인딩한 TextBlock:</x:String>
    <x:String x:Key="Loc.P.Binding.Cap3">원본 TextBox:</x:String>
    <x:String x:Key="Loc.P.Binding.Cap4">대상 TextBox(SourceTextBox.Text에 바인딩):</x:String>

    <!-- Border -->
    <x:String x:Key="Loc.P.Border.Title1">Border</x:String>
    <x:String x:Key="Loc.P.Border.Sub1">자식 요소 둘레에 테두리나 배경, 또는 둘 다를 그리는 데코레이터입니다.</x:String>
    <x:String x:Key="Loc.P.Border.CT1">기본 Border</x:String>
    <x:String x:Key="Loc.P.Border.CC1">같은 데코레이터에서 채우기만, 선만, 또는 둘 다를 함께 사용합니다.</x:String>
    <x:String x:Key="Loc.P.Border.CT2">모서리 반경</x:String>
    <x:String x:Key="Loc.P.Border.CC2">직각에서 완전한 알약 모양까지 모서리를 둥글립니다.</x:String>
    <x:String x:Key="Loc.P.Border.CT3">테두리 두께</x:String>
    <x:String x:Key="Loc.P.Border.CC3">선 두께를 머리카락처럼 얇게부터 굵은 윤곽까지 조절합니다.</x:String>
    <x:String x:Key="Loc.P.Border.CT4">안쪽 여백</x:String>
    <x:String x:Key="Loc.P.Border.CC4">테두리와 내용 사이의 안쪽 여백이 값에 따라 넓어집니다.</x:String>
    <x:String x:Key="Loc.P.Border.CC5">위 테두리들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Border.CC6">코드 비하인드에서 테두리와 카드를 만듭니다.</x:String>

    <!-- Button -->
    <x:String x:Key="Loc.P.Button.Title1">Button</x:String>
    <x:String x:Key="Loc.P.Button.Sub1">동작을 실행하는 클릭 가능한 명령 표면입니다. 텍스트나 사용자 지정 콘텐츠를 담고 여러 크기와 상태를 제공하며 강조 테마에 맞춰 자동으로 다시 그려집니다.</x:String>
    <x:String x:Key="Loc.P.Button.CC1">버튼을 누르면 카운터가 1씩 증가합니다.</x:String>
    <x:String x:Key="Loc.P.Button.CT1">크기</x:String>
    <x:String x:Key="Loc.P.Button.CC2">기본 스타일의 표준 버튼과 비활성 상태.</x:String>
    <x:String x:Key="Loc.P.Button.CT2">강조 테마</x:String>
    <x:String x:Key="Loc.P.Button.CC3">소·중·대 프리셋이 글꼴 크기와 여백을 함께 조절합니다.</x:String>
    <x:String x:Key="Loc.P.Button.CC4">{ThemeResource}로 강조 브러시에 바인딩한 버튼은 테마나 강조 색이 바뀌면 자동으로 다시 그려집니다.</x:String>
    <x:String x:Key="Loc.P.Button.CC5">위 버튼들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Button.CC6">버튼 상태와 동작을 바인딩 가능한 ViewModel에 둡니다.</x:String>

    <!-- Calendar -->
    <x:String x:Key="Loc.P.Calendar.Title1">Calendar</x:String>
    <x:String x:Key="Loc.P.Calendar.Sub1">월별 달력을 표시해 날짜를 살펴보고 선택하는 컨트롤로, 월·연·10년 보기를 제공합니다.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC1">달력에서 날짜를 고르면 아래의 선택 날짜가 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC2">Calendar 컨트롤은 다음 기능을 기본으로 지원합니다.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC3">위 Calendar의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Calendar.CC4">코드 비하인드에서 Calendar를 만들고 날짜 선택을 처리합니다.</x:String>
    <x:String x:Key="Loc.P.Calendar.Body1">• 월 / 연 / 10년 보기</x:String>
    <x:String x:Key="Loc.P.Calendar.Body2">• 단일 또는 기간 날짜 선택</x:String>
    <x:String x:Key="Loc.P.Calendar.Body3">• 선택 불가 날짜</x:String>
    <x:String x:Key="Loc.P.Calendar.Body4">• 표시 날짜 범위 제한</x:String>
    <x:String x:Key="Loc.P.Calendar.Body5">• 주 시작 요일 사용자 지정</x:String>
    <x:String x:Key="Loc.P.Calendar.Cap1">선택한 날짜</x:String>

    <!-- CandlestickChart -->
    <x:String x:Key="Loc.P.CandlestickChart.Title1">CandlestickChart</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.Sub1">금융 OHLC 데이터를 캔들로 표시하며 거래량 막대와 이동평균선을 함께 그릴 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CT1">기본 캔들 차트</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC1">모의 OHLC 가격 데이터를 사용한 캔들 차트.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CT2">거래량 포함</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC2">가격 데이터 아래에 거래량 보조 차트를 둔 캔들 차트.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CT3">이동평균선</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC3">SMA와 EMA 선을 겹쳐 그린 캔들 차트.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC4">위 캔들 차트의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.CandlestickChart.CC5">ViewModel이 결정적인 OHLC 컬렉션을 만들고, 차트 설정은 XAML에 선언형으로 남깁니다.</x:String>

    <!-- Canvas -->
    <x:String x:Key="Loc.P.Canvas.Title1">Canvas</x:String>
    <x:String x:Key="Loc.P.Canvas.Sub1">자식 요소를 절대 좌표에 배치하는 레이아웃 패널입니다. 좌표는 Canvas.Left/Top/Right/Bottom으로 지정하고 겹침 순서는 Panel.ZIndex로 제어합니다.</x:String>
    <x:String x:Key="Loc.P.Canvas.CT1">Canvas 개요</x:String>
    <x:String x:Key="Loc.P.Canvas.CC1">Canvas.Left와 Canvas.Top으로 배치한 요소.</x:String>
    <x:String x:Key="Loc.P.Canvas.CT2">Canvas 기능</x:String>
    <x:String x:Key="Loc.P.Canvas.CC2">Canvas 컨트롤의 주요 기능.</x:String>
    <x:String x:Key="Loc.P.Canvas.CC3">Canvas 위에 Border를 배치하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Canvas.CC4">코드 비하인드에서 Canvas의 자식 요소를 만들고 배치합니다.</x:String>

    <!-- CheckBox -->
    <x:String x:Key="Loc.P.CheckBox.Title1">CheckBox</x:String>
    <x:String x:Key="Loc.P.CheckBox.Sub1">선택하고 해제할 수 있는 컨트롤이며, 세 번째 상태인 미정 상태도 지원할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC1">확인란을 클릭하면 상태가 전환됩니다.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CT1">기본 확인란</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC2">선택 해제, 선택, 비활성 상태의 표준 확인란.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CT2">3상태 확인란</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC3">선택과 해제 외에 미정 상태를 더한 확인란.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC4">위 확인란들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.CheckBox.CC5">코드 비하인드에서 Checked, Unchecked, Indeterminate 처리기를 연결합니다.</x:String>

    <!-- ColorPicker -->
    <x:String x:Key="Loc.P.ColorPicker.Eyebrow1">선택기</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Title1">ColorPicker</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Sub1">스펙트럼과 슬라이더로 색을 고르는 컨트롤입니다. 알파 채널을 선택적으로 켜고, 좁은 공간을 위한 컴팩트 레이아웃도 제공합니다.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CT1">기본 ColorPicker</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC1">스펙트럼과 슬라이더를 갖춘 완전한 색 선택기.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CT2">컴팩트 ColorPicker</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC2">공간이 좁은 상황을 위한 더 간결한 버전.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CT3">ColorPicker 옵션</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC3">알파 채널 등 어떤 구성 요소를 표시할지 설정합니다.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC4">색을 고르면 실시간 미리 보기 견본에 반영됩니다.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC5">ColorPicker를 견본, 트리거 버튼과 함께 쓰는 예.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC6">위 색 선택기의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.CC7">코드 비하인드에서 ColorChanged를 처리하고 선택한 색을 읽습니다.</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Cap1">알파 채널 포함:</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Cap2">알파 채널 없음:</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Cap3">미리 보기:</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Val1">글자 색:</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Val2">배경:</x:String>
    <x:String x:Key="Loc.P.ColorPicker.Val3">테두리 색:</x:String>

    <!-- ComboBox -->
    <x:String x:Key="Loc.P.ComboBox.Title1">ComboBox</x:String>
    <x:String x:Key="Loc.P.ComboBox.Sub1">옵션 목록을 펼쳐 하나를 고르게 하는 드롭다운으로, 자리 표시자 텍스트, 미리 선택, 선택 변경 이벤트를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ComboBox.CC1">문자열 항목으로 채운 간단한 드롭다운.</x:String>
    <x:String x:Key="Loc.P.ComboBox.CT1">미리 선택된 항목</x:String>
    <x:String x:Key="Loc.P.ComboBox.CC2">ViewModel 속성을 통해 열릴 때 이미 항목이 선택되어 있습니다.</x:String>
    <x:String x:Key="Loc.P.ComboBox.CT2">선택 변경</x:String>
    <x:String x:Key="Loc.P.ComboBox.CC3">양방향 바인딩 덕분에 뷰의 이벤트 처리기 없이 선택 변경에 반응합니다.</x:String>
    <x:String x:Key="Loc.P.ComboBox.CC4">위 ComboBox들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ComboBox.CC5">전용 ViewModel에서 항목과 선택 상태를 노출합니다.</x:String>

    <!-- CommandBar -->
    <x:String x:Key="Loc.P.CommandBar.Title1">CommandBar</x:String>
    <x:String x:Key="Loc.P.CommandBar.Sub1">AppBarButton 등 명령 요소를 배치하는 도구 모음으로, 주요 명령은 바로 보이고 나머지는 오버플로에 담깁니다.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CT1">기본 CommandBar</x:String>
    <x:String x:Key="Loc.P.CommandBar.CC1">주요 명령만 가진 CommandBar.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CT2">보조 명령이 있는 CommandBar</x:String>
    <x:String x:Key="Loc.P.CommandBar.CC2">주요 명령과 보조(오버플로) 명령을 함께 갖춘 CommandBar. 오버플로 버튼을 누르면 더 볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CC3">주요 명령과 보조 명령을 가진 CommandBar의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.CommandBar.CC4">CommandBar 동작을 ViewModel의 ICommand 속성으로 노출합니다.</x:String>

    <!-- CommandBarFlyout -->
    <x:String x:Key="Loc.P.CommandBarFlyout.Title1">CommandBarFlyout</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.Sub1">가벼운 팝업 안에 CommandBar를 띄워 주요 명령과 보조 명령을 함께 보여 주는 플라이아웃입니다.</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.CT1">기본 CommandBarFlyout</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.CC1">아래 버튼을 누르면 편집 명령이 담긴 CommandBarFlyout이 열립니다.</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.CT2">명령을 섞은 CommandBarFlyout</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.CC2">주요 명령은 항상 보이고 보조 명령은 오버플로에서 사용할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.CC3">명령에 바인딩한 플라이아웃의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.CommandBarFlyout.CC4">명령과 상태는 ViewModel에서 구현합니다.</x:String>

    <!-- ContentDialog -->
    <x:String x:Key="Loc.P.ContentDialog.Title1">ContentDialog</x:String>
    <x:String x:Key="Loc.P.ContentDialog.Sub1">확인, 인라인 검토 흐름, 비동기 검증에 쓰는 모달 대화 상자이며 XamlRoot가 필요 없습니다.</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CT1">팝업 ContentDialog</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CC1">현재 창 위에 고전적인 모달 대화 상자를 표시합니다. Enter는 기본 버튼을, Esc는 닫기를 실행합니다.</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CT2">인라인 ContentDialog</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CC2">이 예제는 대화 상자를 호스트 영역 안에 두어 임베드된 검토 흐름을 미리 봅니다.</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CT3">지연 검증</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CC3">기본 버튼의 Deferral을 쓰면 닫히기 전에 비동기 작업을 실행할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CC4">인라인 ContentDialog를 마크업에서 직접 선언합니다.</x:String>
    <x:String x:Key="Loc.P.ContentDialog.CC5">대화 상자 명령은 ViewModel에 두고, 팝업 생성은 대화 상자 서비스 뒤로 감춥니다.</x:String>

    <!-- ContextMenu -->
    <x:String x:Key="Loc.P.ContextMenu.Title1">ContextMenu</x:String>
    <x:String x:Key="Loc.P.ContextMenu.Sub1">마우스 오른쪽 버튼을 누른 위치에 열리는 명령 메뉴로, ContextMenuService를 통해 어떤 요소에도 붙일 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CT1">기본 ContextMenu</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CC1">아래 영역에서 오른쪽 버튼을 누르면 컨텍스트 메뉴가 열립니다.</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CT2">하위 메뉴가 있는 ContextMenu</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CC2">컨텍스트 메뉴에는 중첩된 하위 메뉴를 둘 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CC3">오른쪽 버튼으로 동작을 고르면 선택한 동작이 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CC4">ContextMenuService로 ContextMenu를 요소에 붙이는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ContextMenu.CC5">코드에서 ContextMenu를 만들고 MenuItem 클릭 처리기를 연결합니다.</x:String>

    <!-- CssLayout -->
    <x:String x:Key="Loc.P.CssLayout.Title1">CSS 레이아웃</x:String>
    <x:String x:Key="Loc.P.CssLayout.Sub1">백분율, aspect-ratio, box-sizing, position: absolute를 프레임워크 자체 레이아웃 패스가 처리합니다. 모든 패널이 참여하며 사용자 패널도 세 줄이면 합류합니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT1">백분율은 해석되는 값이지 고정되지 않습니다</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC1">가로 백분율은 포함 블록의 너비를, 세로 백분율은 높이를 기준으로 해석됩니다. 즉 해당 축이 확정되어 있어야 합니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT2">백분율 너비와 높이</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC2">네 변 모두 백분율을 받습니다. CSS 규정대로 위아래 변까지 포함해 모두 포함 블록의 너비를 기준으로 해석됩니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT3">백분율 바깥 여백과 안쪽 여백</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC3">min-width, max-width, min-height, max-height도 백분율을 받으며 선호 크기가 정해진 뒤에 제한을 적용합니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT4">백분율 최소·최대 경계</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC4">한 축만 지정하면 비율이 나머지를 결정합니다. 아래 타일들은 너비만 설정했습니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT5">aspect-ratio</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC5">두 타일 모두 width: 200px에 20px 여백과 4px 테두리를 지정했습니다. border-box(프레임워크 기본)는 장식을 안쪽에 포함하고 content-box는 바깥에 더하므로 두 번째 타일이 실제로 더 넓습니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT6">box-sizing</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC6">절대 배치된 요소는 패널의 흐름에서 완전히 빠집니다. 흐름에도 패널의 희망 크기에도 기여하지 않으며 inset 속성이 위치를 정합니다. 아래 호스트는 평범한 StackPanel이고, 흐르는 항목들은 고정된 요소를 무시합니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT7">position: absolute</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC7">두 막대는 같은 420 너비 블록 안에 있고 둘 다 width: 50%를 요청합니다. 두 번째는 마크업에서 Width도 지정했는데 이는 로컬 값이며, 로컬 값은 모든 CSS 레이어보다 우선합니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CT8">명시한 크기가 이깁니다</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC8">위 레이아웃 기능을 모두 마크업으로 작성한 예.</x:String>
    <x:String x:Key="Loc.P.CssLayout.CC9">사용자 정의 패널을 절대 배치 프로토콜에 참여시킵니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.Body1">백분율은 파싱하는 순간 고정된 Width가 될 수 없습니다. 포함 블록은 measure 중에만 알 수 있기 때문입니다. 그래서 백분율 길이는 레이아웃 상태로 보관되며 매 패스마다 부모가 내려주는 제약에 맞춰 해석됩니다. 창 크기 변경에도 유지되는 이유이자, 코드에서 지정한 로컬 Width가 CSS 백분율보다 우선하는 이유입니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.Cap1">StackPanel은 쌓는 축으로 무한 제약을 자식에게 전달하므로 그 방향의 백분율은 기준이 없어 0으로 무너지는 대신 auto로 대체됩니다. Canvas도, 가로로 쌓는 패널 안의 가로 백분율도 마찬가지입니다.</x:String>
    <x:String x:Key="Loc.P.CssLayout.Cap2">StackPanel, WrapPanel, DockPanel, Grid, Canvas가 모두 참여합니다. 사용자 패널은 반복문에서 절대 배치 자식을 건너뛰고(if (IsCssAbsolute(child)) continue;) MeasureCssAbsoluteChildren과 ArrangeCssAbsoluteChildren 두 도우미를 호출하면 됩니다. position: absolute를 쓰지 않으면 픽셀 단위 left/top은 기존 Canvas 첨부 속성 매핑을 유지합니다.</x:String>

    <!-- CssMappings -->
    <x:String x:Key="Loc.P.CssMappings.Title1">사용자 지정 속성</x:String>
    <x:String x:Key="Loc.P.CssMappings.Sub1">매핑 표는 양쪽 모두 열려 있습니다. 직접 만든 속성 이름이나 값 변환기를 등록할 수도 있고, 이름을 기존 속성으로 돌릴 수도 있습니다. 이 페이지의 모든 선언은 CSS에 없는 사용자 지정 속성을 씁니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT1">매핑 표를 확장하는 네 가지 방법</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC1">brand-corner는 border-radius의 별칭으로 등록됩니다. 캐스케이드 경쟁 방식까지 포함해 모든 면에서 해당 longhand와 똑같이 동작합니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT2">디자인 토큰의 별칭</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC2">gallery-elevation은 0에서 5까지의 단계를 받아 그에 맞는 그림자를 만듭니다. CSS에도 프레임워크에도 없으며 등록 코드 서른 줄이 전부입니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT3">사용자 변환기를 가진 사용자 지정 속성</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC3">gallery-tint은 임의의 CSS 색을 받아 알파 35%로 다시 칠합니다. 알파는 등록 시의 변환기 매개변수에서 오며, Background는 요소의 실제 형식에 맞춰 해석됩니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT4">이름으로 대상 확인</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC4">매개변수는 선언이 아니라 등록에 속합니다. gallery-tint와 gallery-tint-strong은 같은 변환기 인스턴스를 두 번 등록한 것이며, 차이는 등록 때 넘긴 알파뿐입니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT5">변환기 하나, 등록 둘</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC5">다중 속성 변환기는 요소를 받아 대입 목록을 돌려줍니다. gallery-square는 길이 하나로 Width와 Height를 함께 씁니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT6">선언 하나로 여러 속성</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC6">CSS에 키워드가 없는 이름은 케밥 케이스에서 변환되어 요소 자신의 속성으로 되돌아갑니다. 등록이 필요 없으며 horizontal-content-alignment는 HorizontalContentAlignment를, is-tab-stop은 IsTabStop을 찾습니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT7">케밥 케이스 채널 — 모든 종속성 속성을 그대로</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC7">패널은 TryApplyCssPropertyCore를 재정의해 CSS 개념을 가져와 자신의 속성으로 옮길 수 있습니다. StackPanel이 flex-direction에서 바로 그렇게 하므로, 원래 모르는 flexbox 키워드에도 반응합니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CT8">패널이 직접 속성을 가로챌 수 있습니다</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC8">사용자 지정 속성은 기본 제공 속성과 똑같이 읽힙니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.CC9">이 페이지를 뒷받침하는 등록 코드를 그대로 실었습니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.Body1">CssMappings.RegisterAlias는 한 이름을 다른 이름으로 돌립니다. RegisterProperty는 이름을 고정된 종속성 속성에 묶거나, 요소 형식마다 이름으로 대상을 찾거나, 여러 속성을 한 번에 지정하는 다중 속성 변환기에 전부 맡깁니다. 값 변환은 인터페이스 형태이며 ICssValueConverter는 IValueConverter를 본떴지만 CSS에 맞게 좁혔습니다. 입력은 언제나 선언 텍스트, 변환은 단방향, 컬처는 항상 인버리언트입니다. 나중에 등록한 쪽이 이기며(기본 제공 항목과 미지원 자리 표시자보다도 우선) 이미 파싱된 스타일 시트도 새 등록을 자동으로 반영합니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.Cap1">변환기가 null을 반환하면 해당 선언만 버려지고 블록의 나머지는 적용됩니다. 예외가 아니라 CSS의 오류 모델입니다. 기본적으로 같은 선언 텍스트당 한 번만 변환하고 결과를 일치한 모든 요소가 공유하므로 고정된 개체를 반환하세요. cacheByValue: false를 넘기면 적용할 때마다 변환합니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.Cap2">CssValueParsing은 엔진 자체의 색과 길이 파싱을 사용자 변환기에 열어 줍니다. 그래서 직접 만든 속성도 기본 제공 속성과 똑같은 구문을 이해합니다. 후행 알파가 붙은 16진수, CSS 이름 있는 색, 구·신 두 가지 표기의 rgb()/hsl()까지 지원합니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.Cap3">변환기는 대상 속성의 형식과 항상 인버리언트인 컬처도 함께 받습니다. 스타일 시트 텍스트는 컬처와 무관한 소스 코드이고 캐시된 변환 결과는 프로세스 전체가 공유하므로, 우연히 컴파일한 스레드에 의존해서는 안 됩니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.Cap4">값은 XAML이 쓰는 것과 같은 변환기 스택을 지나므로 열거형, 부울, 형식 변환기를 가진 어떤 형식도 동작합니다. 프레임워크가 지원할 수 없는 실제 CSS 속성은 명시적으로 미지원 항목으로 등록되어, 이 채널로 흘러들어 같은 이름 속성을 잘못 겨냥하는 일이 없습니다.</x:String>
    <x:String x:Key="Loc.P.CssMappings.Cap5">재정의는 전달받은 setter를 통해 값을 쓰므로 값이 CSS 레이어에 들어가고 규칙이 더 이상 일치하지 않으면 자동으로 지워집니다. 같은 훅은 등록되지 않은 속성 이름의 마지막 처리처이기도 해서, 사용자 패널이 원하는 키를 직접 소비할 수 있습니다.</x:String>

    <!-- CssOutline -->
    <x:String x:Key="Loc.P.CssOutline.Title1">아웃라인</x:String>
    <x:String x:Key="Loc.P.CssOutline.Sub1">요소 경계 바깥에 그려지며 레이아웃 공간을 차지하지 않는 링입니다. 프레임워크의 일급 기능으로 XAML과 코드 모두에서 쓰는 네 개의 종속성 속성을 가지며, CSS outline 계열이 그대로 대응됩니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT1">왜 테두리로는 안 될까요?</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC1">outline-style은 none, solid, dashed, dotted를 받습니다. 단축 표기에서는 세 부분을 어떤 순서로든 쓸 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT2">너비, 색, 스타일</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC2">양수 값은 링을 요소에서 밀어내고 음수 값은 안쪽으로 당깁니다. 어느 쪽도 요소 크기를 바꾸지 않습니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT3">outline-offset</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC3">둥근 모서리 요소에는 둥근 아웃라인이 생기고, 오프셋만큼 확장되어 곡선이 동심을 유지합니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT4">링이 모서리 반경을 따릅니다</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC4">두 행 모두 동일한 타일 세 개가 있습니다. 위 행은 가운데 타일에 아웃라인을, 아래 행은 같은 두께의 테두리를 더했습니다. 행이 어떻게 밀리는지 보세요.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT5">아웃라인은 레이아웃을 쓰지 않지만 테두리는 씁니다</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC5">먼저 버튼을 클릭한 다음 Tab을 눌러 보세요. :focus-visible은 키보드 포커스에만 일치하므로 링은 키보드에서만 나타나고 마우스에서는 방해하지 않습니다. 전체가 CSS 두 줄이면 끝납니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT6">원래 목적인 포커스 링</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC6">네 속성은 FrameworkElement에 있으므로 바인딩과 애니메이션이 가능하고, 스타일과 트리거에도 다른 속성처럼 참여합니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CT7">CSS 없이도 가능합니다</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC7">두 채널, 즉 CSS 단축 표기와 속성을 직접 지정하는 방법.</x:String>
    <x:String x:Key="Loc.P.CssOutline.CC8">코드에서 제어하는 검증용 후광.</x:String>
    <x:String x:Key="Loc.P.CssOutline.Body1">테두리는 상자의 일부라서 굵게 하면 주변이 모두 다시 배치됩니다. 아웃라인은 요소가 그려진 뒤 경계 바깥에 칠해지며 measure나 arrange에 전혀 참여하지 않습니다. 그래서 포커스 링, 검증 후광, 선택 표시에 알맞고 상태가 나타나도 레이아웃이 흔들리지 않습니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.Cap1">링은 요소 자체 효과 뒤, 경계 바깥에 그려지므로 부모의 둥근 모서리에 잘리지 않고 요소에 건 효과로 흐려지지도 않습니다.</x:String>
    <x:String x:Key="Loc.P.CssOutline.Cap2">OutlineStyle의 기본값은 Solid이므로 브러시와 두께만 지정하면 링이 보입니다. 반면 CSS 단축 표기는 항상 세 부분을 모두 재설정하므로 outline: 2px red는 스타일을 지정하기 전까지 보이지 않습니다(브라우저와 같은 규칙). outline: none은 모두 지웁니다.</x:String>

    <!-- CssSelectors -->
    <x:String x:Key="Loc.P.CssSelectors.Title1">선택자와 캐스케이드</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Sub1">형식·클래스·id·전체 선택자와 자손·자식 결합자, 동적 의사 클래스, 그리고 어떤 선언이 이길지 정하는 캐스케이드 규칙.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT1">선택자 종류</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC1">형식 선택자는 파생 형식에도 일치하므로 Control은 모든 Button을 잡습니다. id 선택자는 x:Name에 일치합니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT2">자손 결합자와 자식 결합자</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC2">A B는 A 아래 어떤 깊이의 B에도 일치하고, A &gt; B는 직계 자식에만 일치합니다. 둘 다 논리 트리를 따라갑니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT3">동적 의사 클래스</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC3">아래 컨트롤에 마우스를 올리고, 누르고, Tab으로 이동해 보세요. 여기의 모든 시각 변화는 트리거가 아니라 의사 클래스 규칙에서 나옵니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT4">명시도와 문서 순서</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC4">아래 각 Border는 여러 규칙에 동시에 일치합니다. 승자는 표준 CSS 캐스케이드, 즉 범위 → 명시도 → 문서 순서로 정해집니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT5">!important</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC5">important가 붙은 선언은 더 구체적인 일반 선언으로부터 보호됩니다. 웹과 똑같습니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT6">CSS가 속성 시스템에서 놓이는 자리</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC6">CSS 값은 전용 레이어 두 곳에 놓입니다. 테마·암시적·명시적 스타일 setter는 덮어쓰지만, 직접 지정한 로컬 값은 결코 넘지 못합니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT7">의사 클래스 전환 시의 트랜지션</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC7">transition을 선언하면 상태가 바뀔 때마다 애니메이션됩니다. 두 창에 마우스를 올려 비교해 보세요.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CT8">템플릿 부분은 페이지 CSS에 보이지 않습니다</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC8">컨트롤 템플릿이 만든 요소는 페이지 수준 선택자에 절대 일치하지 않고 조상 축에서도 건너뜁니다. 그래서 Button &gt; TextBlock은 시각적으로 사이에 템플릿 요소가 있어도 버튼의 콘텐츠에 닿습니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC9">위 선택자 예제를 마크업으로 작성한 예.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.CC10">스타일 시트, 클래스, 그리고 캐스케이드 결과를 되읽는 방법.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Cap1">형제 결합자(~와 +), 특성 선택자, 의사 요소, :not() 같은 함수형 의사 클래스는 지원하지 않습니다. 이들을 쓴 규칙은 조용히 잘못 일치시키는 대신 진단을 남기고 버려집니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Cap3">로컬 값  &gt;  템플릿 트리거  &gt;  CSS :state 승자  &gt;  스타일 트리거  &gt;  템플릿 트리거  &gt;  CSS 일반 승자  &gt;  스타일 setter  &gt;  기본값</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Cap4">요소마다 공유되는 지속 시간과 이징이 하나씩만 쓰입니다. 속성별 지연은 진단과 함께 무시됩니다.</x:String>
    <x:String x:Key="Loc.P.CssSelectors.Cap5">이 규칙이 없으면 버튼 자체의 템플릿 장식까지 스타일 대상이 되어, 페이지가 형식 선택자를 하나 쓰는 순간 모든 테마가 깨집니다. 직접 작성한 콘텐츠는 DataTemplate 출력까지 포함해 여전히 완전히 일치 대상입니다.</x:String>

    <!-- CssStyling -->
    <x:String x:Key="Loc.P.CssStyling.Title1">CSS 스타일링</x:String>
    <x:String x:Key="Loc.P.CssStyling.Sub1">진짜 CSS로 모든 요소를 스타일링합니다. 속성 키워드는 100% 네이티브 CSS이며, CSS에 키워드가 없는 것은 자동 케밥 케이스 이름으로 컨트롤의 종속성 속성에 도달합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT1">두 채널, 하나의 엔진</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC1">Css.Style은 선언 블록을 받습니다. 웹의 style 특성에 쓰는 것과 완전히 같은 형태입니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT2">인라인 선언</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC2">Css.StyleSheet은 해당 요소의 하위 트리로 범위가 한정된 규칙을 담습니다. 마크업판 &lt;style&gt; 블록인 셈입니다. 아래 Border들은 마크업에서 아무 스타일도 없고 전부 스타일 시트가 처리합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT3">마크업 속 스타일 시트</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC3">px(숫자에 단위가 없을 때의 기본값), pt, in, cm, mm, q, pc와 글꼴 상대 단위 em, rem. 아래 막대들은 모두 같은 시각적 너비를 다른 표기로 요청합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT4">길이 단위</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC4">CSS의 후행 알파 방식 16진 표기, 모든 CSS 이름 있는 색, 구·신 두 문법의 rgb()/rgba()/hsl()/hsla(), 그리고 transparent.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT5">색 구문</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC5">CSS와 프레임워크가 어긋나는 부분에서는 엔진이 새 키워드를 만들지 않고 변환으로 처리합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT6">CSS 이름이 속성 시스템에 닿는 방법</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC6">CSS는 예외를 던지지 않습니다. 잘못된 선언은 버려지고 블록의 나머지는 그대로 적용됩니다. 브라우저와 같은 오류 모델입니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CT7">속성을 적용할 수 없을 때</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC7">두 채널을 마크업에서 선언한 예.</x:String>
    <x:String x:Key="Loc.P.CssStyling.CC8">같은 엔진을 코드에서 쓰는 방법. 앱 전역 스타일 시트도 포함합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.Body1">Css.Style은 단일 요소에 선언 블록을 붙입니다. Css.StyleSheet(코드에서는 Css.StyleSheets)은 하위 트리로 범위가 한정된 선택자 규칙을, Application.StyleSheets은 앱 전역 규칙을 담습니다. 두 채널은 같은 캐스케이드로 합류하며 스타일 setter보다 위, 직접 지정한 로컬 값보다 아래의 전용 레이어에 놓입니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.Cap1">em은 요소 자신의 font-size를 기준으로 해석됩니다. 다만 font-size 자체에 쓸 때만은 CSS 규정대로 상속받은 크기를 기준으로 합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.Cap2">CSS 규정에서는 #RRGGBBAA처럼 알파가 마지막에 옵니다. XAML의 #AARRGGBB와 반대이므로 CSS 채널은 XAML 변환기를 빌리지 않고 직접 색을 파싱합니다.</x:String>
    <x:String x:Key="Loc.P.CssStyling.Cap3">프레임워크가 구현할 수 없는 실제 CSS 속성(letter-spacing, text-shadow, animation, backdrop-filter 등)은 명시적으로 미지원 항목으로 등록됩니다. 케밥 케이스 채널로 조용히 흘러들지 않으며, 각각 가장 가까운 대안을 알려 주는 일회성 진단을 남깁니다. CssDiagnostics.LogUnresolvedProperties = false로 끌 수 있습니다.</x:String>

    <!-- DataGrid -->
    <x:String x:Key="Loc.P.DataGrid.Title1">DataGrid</x:String>
    <x:String x:Key="Loc.P.DataGrid.Sub1">데이터 컬렉션을 사용자 지정 가능한 행과 열 격자로 보여 주는 컨트롤로, 정렬·열 너비 조절·선택·열 자동 생성을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.DataGrid.CC1">행을 클릭하면 선택되고 열 머리글을 클릭하면 정렬됩니다.</x:String>
    <x:String x:Key="Loc.P.DataGrid.CC2">격자가 기본으로 제공하는 기능을 한눈에 살펴봅니다.</x:String>
    <x:String x:Key="Loc.P.DataGrid.CC3">위 격자의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DataGrid.CC4">코드 비하인드에서 격자를 채우고 선택을 처리합니다.</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body1">•  데이터 원본에서 열 자동 생성</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body2">•  열 정렬(머리글 클릭)</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body3">•  열 너비 조절(열 경계 끌기)</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body4">•  단일 및 확장 선택 모드</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body5">•  행·열 머리글 표시 여부</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body6">•  행 교대 배경</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body7">•  눈금선 사용자 지정</x:String>
    <x:String x:Key="Loc.P.DataGrid.Body8">•  키보드 탐색(위 / 아래 / Home / End)</x:String>

    <!-- DatePicker -->
    <x:String x:Key="Loc.P.DatePicker.Title1">DatePicker</x:String>
    <x:String x:Key="Loc.P.DatePicker.Sub1">드롭다운 달력에서 날짜를 고르게 하는 컨트롤로, 표시 형식을 설정할 수 있고 범위 제한도 걸 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CT1">기본 DatePicker</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC1">클릭하면 달력이 열려 날짜를 고를 수 있으며 비활성 상태도 함께 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CT2">날짜 형식</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC2">DatePicker는 여러 날짜 표시 형식을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CT3">날짜 범위 제한</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC3">DatePicker에는 최소·최대 날짜를 설정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC4">날짜를 고르면 서식이 적용된 결과가 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC5">실제 상황에서의 DatePicker 사용 예.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC6">위 날짜 선택기의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DatePicker.CC7">코드 비하인드에서 날짜 선택기를 만들고 선택 변경을 처리합니다.</x:String>
    <x:String x:Key="Loc.P.DatePicker.Cap1">생년월일</x:String>
    <x:String x:Key="Loc.P.DatePicker.Cap2">예약 날짜</x:String>
    <x:String x:Key="Loc.P.DatePicker.Cap3">프로젝트 마감일</x:String>
    <x:String x:Key="Loc.P.DatePicker.Val1">짧은 형식:</x:String>
    <x:String x:Key="Loc.P.DatePicker.Val2">긴 형식:</x:String>
    <x:String x:Key="Loc.P.DatePicker.Val3">시작 날짜:</x:String>
    <x:String x:Key="Loc.P.DatePicker.Val4">종료 날짜:</x:String>
    <x:String x:Key="Loc.P.DatePicker.Val5">날짜 선택:</x:String>

    <!-- DesignTokens -->
    <x:String x:Key="Loc.P.DesignTokens.Eyebrow1">파운데이션</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Eyebrow2">간격 / 거리</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Eyebrow3">반경 / 실루엣</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Title1">디자인 토큰</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Sub1">Gallery 전체에서 공유하는 색·타이포그래피·간격·모양·모션 결정 사항.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT1">색 역할</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CC1">의미 기반 역할 덕분에 테마가 달라져도 컨트롤이 일관되게 보입니다.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT2">타이포그래피</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CC2">두 계열 모두 같은 4px 격자를 씁니다. 간격은 거리를, 반경은 실루엣을 결정합니다.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT3">간격과 모서리 반경</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT4">모션</x:String>
    <x:String x:Key="Loc.P.DesignTokens.CT5">리소스 내보내기</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Cap1">미리 보기는 두 요소 사이의 실제 간격을 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.DesignTokens.Cap2">각 샘플은 같은 60 × 36 px 면에 토큰을 적용합니다.</x:String>

    <!-- Dialogs -->
    <x:String x:Key="Loc.P.Dialogs.Title1">파일 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.Sub1">네이티브 파일·저장·폴더·셸·글꼴·메시지 대화 상자를 호출하고 각각의 반환값을 그대로 읽어 옵니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT1">파일 열기 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC1">파일을 찾아보거나 여러 개를 고르고, WPF의 OpenFolderDialog도 사용합니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT2">파일 저장 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC2">저장할 파일 이름과 위치를 사용자가 지정하게 합니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT3">폴더 찾아보기 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC3">폴더를 찾아 선택하게 합니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT4">셸 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC4">Win32 셸 API를 그대로 사용해 아이콘 선택, 연결 프로그램, 파일 속성 시트를 엽니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT5">글꼴 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC5">글꼴 모음, 스타일, 크기를 고르게 합니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT6">메시지 대화 상자</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC6">아이콘, 버튼 구성, 기본 동작을 달리해 네이티브 메시지 상자를 띄웁니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CT7">대화 상자 옵션</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC7">파일 대화 상자에서 자주 쓰는 설정 항목.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC8">위 대화 상자 버튼들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Dialogs.CC9">ViewModel 명령이 주입된 대화 상자 서비스를 호출하고 코드 비하인드는 비어 있습니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.Body1">재빠른 갈색 여우가 게으른 개를 뛰어넘습니다</x:String>
    <x:String x:Key="Loc.P.Dialogs.Body2">이 예제들은 Jalium.UI.Controls.MessageBox를 사용하므로 고전적인 시스템 프롬프트를 시험하는 동안에도 샘플 창이 소유자로 남습니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.Body3">동기화 성공 후 단추 하나짜리 확인 알림.</x:String>
    <x:String x:Key="Loc.P.Dialogs.Body4">현재 보기를 떠나기 전에 저장 흐름을 다시 시도하거나 취소합니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.Body5">시스템 오류 아이콘과 확인이 있는 가져오기 실패 차단 알림.</x:String>
    <x:String x:Key="Loc.P.Dialogs.Body6">예 / 아니요 / 취소 세 가지이며 파괴적인 선택에는 더 안전한 기본값을 둡니다.</x:String>
    <x:String x:Key="Loc.P.Dialogs.Cap1">가장 최근의 대화 상자 작업</x:String>
    <x:String x:Key="Loc.P.Dialogs.Cap2">필터:</x:String>
    <x:String x:Key="Loc.P.Dialogs.Cap3">초기 디렉터리:</x:String>
    <x:String x:Key="Loc.P.Dialogs.Chip1">정보</x:String>
    <x:String x:Key="Loc.P.Dialogs.Chip2">경고</x:String>
    <x:String x:Key="Loc.P.Dialogs.Chip3">오류</x:String>
    <x:String x:Key="Loc.P.Dialogs.Chip4">확인</x:String>

    <!-- DiffViewer -->
    <x:String x:Key="Loc.P.DiffViewer.Title1">DiffViewer</x:String>
    <x:String x:Key="Loc.P.DiffViewer.Sub1">텍스트 차이를 나란히 또는 통합 보기로 표시하며 줄 단위와 단어 단위로 강조하는 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CT1">나란히 비교</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC1">추가와 삭제를 각각의 패널에서 강조하며 두 문서를 비교합니다.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CT2">통합 보기</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC2">git diff 출력처럼 차이를 하나의 통합 보기로 표시합니다.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC3">원본과 수정본 텍스트를 편집하면 차이가 실시간으로 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC4">위 차이 뷰어의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DiffViewer.CC5">두 원본 문서를 모두 ViewModel 속성에 바인딩합니다.</x:String>

    <!-- DockLayout -->
    <x:String x:Key="Loc.P.DockLayout.Title1">DockLayout</x:String>
    <x:String x:Key="Loc.P.DockLayout.Sub1">VS 스타일 도킹 레이아웃으로, 크기를 조절할 수 있는 분할 패널과 탭 그룹으로 IDE 같은 작업 공간을 구성합니다.</x:String>
    <x:String x:Key="Loc.P.DockLayout.CT1">IDE 레이아웃</x:String>
    <x:String x:Key="Loc.P.DockLayout.CC1">왼쪽 사이드바 + 가운데 편집기 + 아래 패널이며 분할선으로 크기를 조절합니다.</x:String>
    <x:String x:Key="Loc.P.DockLayout.CT2">3열 레이아웃</x:String>
    <x:String x:Key="Loc.P.DockLayout.CC2">스타 크기로 균등 분할과 비례 분할을 구현합니다.</x:String>
    <x:String x:Key="Loc.P.DockLayout.CC3">위 도킹 레이아웃의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DockLayout.CC4">코드 비하인드에서 분할 패널과 도킹 가능한 탭 항목을 가진 DockLayout을 만듭니다.</x:String>

    <!-- DockPanel -->
    <x:String x:Key="Loc.P.DockPanel.Title1">DockPanel</x:String>
    <x:String x:Key="Loc.P.DockPanel.Sub1">자식 요소를 위·아래·왼쪽·오른쪽 가장자리에 붙이거나 남은 공간을 채우게 하는 패널입니다.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CT1">기본 DockPanel</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC1">요소를 서로 다른 가장자리에 붙이고 마지막 자식이 가운데를 채웁니다.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CT2">LastChildFill = false</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC2">이 옵션을 끄면 마지막 자식이 남은 공간을 채우지 않습니다.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CT3">애플리케이션 레이아웃</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC3">머리글, 사이드바, 콘텐츠 영역으로 이루어진 전형적인 앱 레이아웃.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC4">위 DockPanel 레이아웃의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DockPanel.CC5">DockPanel 관계는 모두 XAML에서 선언합니다.</x:String>

    <!-- DocumentViewer -->
    <x:String x:Key="Loc.P.DocumentViewer.Title1">DocumentViewer</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.Sub1">쪽으로 나뉜 문서를 보는 컨트롤로, 확대/축소·쪽 이동·검색·맞춤 모드·인쇄를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CT1">문서 뷰어 데모</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CC1">탐색과 확대/축소 도구 모음을 갖춘 DocumentViewer.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CT2">텍스트 검색</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CC2">문서 안의 텍스트를 일치 옵션과 함께 검색합니다.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CT3">표시 옵션</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CC3">쪽 표시 모드, 간격, 테두리 표시 여부를 설정합니다.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CC4">기본 설정을 쓴 DocumentViewer의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DocumentViewer.CC5">ViewModel이 명령과 바인딩으로 탐색, 확대/축소, 검색, 표시 옵션을 제어합니다.</x:String>

    <!-- DragDrop -->
    <x:String x:Key="Loc.P.DragDrop.Title1">끌어서 놓기</x:String>
    <x:String x:Key="Loc.P.DragDrop.Sub1">DragEnter, DragOver, DragLeave, Drop 이벤트와 함께 Windows 셸 확장을 보여 줍니다. 드래그 원본에서는 호출자가 지정한 드래그 이미지를 쓰고, 대상에서는 셸 드롭 설명을 지정하며, DoShellDragDrop으로 다른 앱에 파일을 끌어낼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CT1">기본 끌어서 놓기</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC1">원본 목록에서 항목을 끌어 대상 영역에 놓습니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CT2">DragEnter / DragLeave 피드백</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC2">아래 영역 위로 항목을 끌면 DragEnter와 DragLeave의 시각적 피드백을 볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CT3">사용자 지정 드래그 이미지(드래그 원본)</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC3">아래 항목을 끌어 보세요. 요소를 자동 복제하는 대신 호출자가 제공한 이미지가 커서를 따라옵니다. DragDrop.DoDragDrop(source, data, effects, dragImage, offset)을 사용합니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CT4">Windows 셸 드롭(외부 파일)</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC4">탐색기에서 파일을 하나 이상 아래 영역으로 끌어 보세요. Windows가 자체 드래그 이미지(IDropTargetHelper)를 그리고, DragOver 처리기가 e.SetDropDescription(...)으로 셸 드롭 설명을 지정합니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CT5">탐색기로 끌어내기(프로세스 간)</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC5">아래 항목을 탐색기 창이나 바탕 화면으로 끌어 보세요. 앱 내부 드래그와 달리 DragDrop.DoShellDragDrop은 진짜 OLE 드래그를 실행하므로 파일이 다른 앱으로 복사되고 Windows 시스템 드래그 이미지가 사용됩니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CT6">이벤트 로그</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC6">DragEnter, DragOver, DragLeave, Drop 이벤트를 발생 순서대로 표시합니다.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC7">위 끌어서 놓기 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.DragDrop.CC8">상태는 ViewModel이 갖고, 첨부 동작이 네이티브 드래그 이벤트를 이어 줍니다.</x:String>

    <!-- EditControl -->
    <x:String x:Key="Loc.P.EditControl.Title1">EditControl</x:String>
    <x:String x:Key="Loc.P.EditControl.Sub1">구문 강조, 줄 번호, 코드 접기, 키보드 탐색, 완전한 실행 취소/다시 실행을 갖춘 코드 편집기 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.EditControl.CT1">C# 구문 강조가 있는 코드 편집기</x:String>
    <x:String x:Key="Loc.P.EditControl.CC1">키보드 탐색, 선택, 클립보드, 실행 취소/다시 실행, 자동 들여쓰기를 모두 지원합니다.</x:String>
    <x:String x:Key="Loc.P.EditControl.CC2">편집기 기능을 켜고 끈 다음 문서 명령을 실행하고 샘플 코드를 불러옵니다.</x:String>
    <x:String x:Key="Loc.P.EditControl.CT2">아키텍처</x:String>
    <x:String x:Key="Loc.P.EditControl.CC3">컨트롤이 기본으로 인식하는 편집 제스처.</x:String>
    <x:String x:Key="Loc.P.EditControl.CC4">편집기가 내부적으로 어떻게 구성되어 있는지.</x:String>
    <x:String x:Key="Loc.P.EditControl.CC5">편집기와 옵션을 설정하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.EditControl.CC6">ViewModel이 편집기 상태와 명령을 갖고, 동작이 실행 취소·다시 실행·선택·캐럿 정보를 이어 줍니다.</x:String>
    <x:String x:Key="Loc.P.EditControl.Body1">{Shortcut.Copy} / {Shortcut.Cut} / {Shortcut.Paste} — 복사 / 잘라내기 / 붙여넣기</x:String>
    <x:String x:Key="Loc.P.EditControl.Body2">{Shortcut.Undo} / {Shortcut.Redo} — 실행 취소 / 다시 실행</x:String>
    <x:String x:Key="Loc.P.EditControl.Body3">{Shortcut.SelectAll} — 모두 선택</x:String>
    <x:String x:Key="Loc.P.EditControl.Body4">Home — 스마트 홈(첫 공백 아닌 문자 / 줄 시작)</x:String>
    <x:String x:Key="Loc.P.EditControl.Body5">{Shortcut.WordModifier}+왼쪽/오른쪽 — 단어 단위 이동</x:String>
    <x:String x:Key="Loc.P.EditControl.Body6">{Shortcut.DocumentBoundary} — 문서 시작 / 끝</x:String>
    <x:String x:Key="Loc.P.EditControl.Body7">Shift+화살표 — 선택 확장</x:String>
    <x:String x:Key="Loc.P.EditControl.Body8">Tab / Shift+Tab — 들여쓰기 / 내어쓰기</x:String>
    <x:String x:Key="Loc.P.EditControl.Body9">Enter — 자동 들여쓰기와 함께 줄 바꿈</x:String>
    <x:String x:Key="Loc.P.EditControl.Body10">두 번 클릭 — 단어 선택 / 세 번 클릭 — 줄 선택</x:String>
    <x:String x:Key="Loc.P.EditControl.Body11">문서 계층: 로프 기반 버퍼(삽입/삭제 O(log n)), DocumentLineTree, UndoStack</x:String>
    <x:String x:Key="Loc.P.EditControl.Body12">뷰 계층: DrawingContext 직접 렌더링과 스팬 기반 구문 강조</x:String>
    <x:String x:Key="Loc.P.EditControl.Body13">구문: ISyntaxHighlighter 인터페이스와 여러 줄 스팬을 지원하는 RegexSyntaxHighlighter</x:String>
    <x:String x:Key="Loc.P.EditControl.Body14">기능: 코드 접기, 괄호 짝 맞추기, 찾기/바꾸기, 미니맵</x:String>

    <!-- ElementEffects -->
    <x:String x:Key="Loc.P.ElementEffects.Title1">요소 효과</x:String>
    <x:String x:Key="Loc.P.ElementEffects.Sub1">요소 단위의 최신 시각 효과(OuterGlow, InnerShadow, Emboss, ColorMatrix, EffectGroup)입니다. 각각 한 요소에 적용되며 효과 그룹으로 합성할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CT1">OuterGlowEffect</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC1">요소 바깥 가장자리에 광채를 그립니다. 더 이상 쓰지 않는 OuterGlowBitmapEffect를 대체합니다.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CT2">InnerShadowEffect</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC2">요소 경계 안쪽에 그림자를 그립니다. CSS의 box-shadow: inset과 비슷합니다.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CT3">EmbossEffect</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC3">표면에 닿는 빛을 흉내 내어 튀어나오거나 들어간 느낌을 만듭니다. 더 이상 쓰지 않는 EmbossBitmapEffect를 대체합니다.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CT4">ColorMatrixEffect</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC4">5x4 색 행렬 변환을 적용합니다. 그레이스케일, 세피아, 밝기, 대비, 채도, 색조 회전, 반전 프리셋을 제공합니다.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CT5">EffectGroup</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC5">여러 효과를 하나의 그룹으로 묶습니다. 효과는 차례로 적용되며 앞 단계의 출력이 다음 단계의 입력이 됩니다.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC6">Effect 속성으로 요소 효과를 적용하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ElementEffects.CC7">효과 매개변수와 명령은 ViewModel에 바인딩하고, 효과 개체 자체는 XAML 선언으로 남깁니다.</x:String>

    <!-- Expander -->
    <x:String x:Key="Loc.P.Expander.Title1">Expander</x:String>
    <x:String x:Key="Loc.P.Expander.Sub1">클릭할 수 있는 머리글로 콘텐츠를 펼치고 접는 컨트롤입니다. 부차적인 세부 정보는 필요할 때까지 숨겨 둡니다.</x:String>
    <x:String x:Key="Loc.P.Expander.CT1">기본 Expander</x:String>
    <x:String x:Key="Loc.P.Expander.CC1">머리글을 클릭하면 콘텐츠 영역이 펼쳐지거나 접힙니다.</x:String>
    <x:String x:Key="Loc.P.Expander.CT2">복합 콘텐츠</x:String>
    <x:String x:Key="Loc.P.Expander.CC2">Expander에는 확인란과 드롭다운부터 완전한 입력 폼까지 어떤 콘텐츠도 담을 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Expander.CT3">중첩 Expander</x:String>
    <x:String x:Key="Loc.P.Expander.CC3">Expander는 중첩할 수 있어 접히는 트리 형태의 구역을 만들 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Expander.CC4">코드에서 Expander를 제어합니다. 버튼으로 펼치기, 접기, 전환할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Expander.CC5">위 Expander들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Expander.CC6">코드 비하인드에서 버튼을 Expander에 연결하고 펼침·접힘 이벤트를 처리합니다.</x:String>

    <!-- FlexPanel -->
    <x:String x:Key="Loc.P.FlexPanel.Title1">FlexPanel</x:String>
    <x:String x:Key="Loc.P.FlexPanel.Sub1">완전한 CSS 플렉스박스 컨테이너입니다. 방향, 줄 바꿈, 여섯 가지 justify 분배, 교차축 정렬, 그리고 명세대로의 grow/shrink/basis 알고리즘을 갖췄습니다. CSS 없이 XAML에서 평범한 패널로 쓸 수 있고 display: flex가 대응되는 대상이기도 합니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT1">방향</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC1">주축은 Direction을 따릅니다. reverse 계열은 Children 순서를 건드리지 않고 배치만 뒤집습니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT2">JustifyContent — 주축 분배</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC2">여섯 가지 CSS 분배 방식을 같은 100% 너비 무대에 같은 세 항목으로 비교합니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT3">AlignItems와 AlignSelf — 교차축</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC3">AlignItems는 줄의 기본값을 정하고 AlignSelf는 한 항목만 덮어씁니다. 기본값은 Stretch이며 줄 전체를 채웁니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT4">Grow, Shrink, Basis</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC4">Basis는 플렉스 계산 전의 크기입니다. 남은 공간은 Grow 비율로 나누고, 모자란 만큼은 Shrink × Basis 비율로 덜어냅니다. 최소·최대에 닿은 항목은 고정되고 그 몫이 다시 분배됩니다. 명세의 resolve-flexible-lengths 루프 그대로입니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT5">Wrap과 AlignContent</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC5">Wrap을 켜면 항목이 새 줄로 넘어가고 AlignContent가 그 줄들을 교차축 방향으로 분배합니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT6">Order</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC6">Order는 Children 컬렉션을 건드리지 않고 배치 위치만 바꾸므로 포커스 순서, 히트 테스트, 데이터 바인딩은 선언 순서를 그대로 따릅니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT7">CSS로 제어하기</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC7">flex 속성군 전체가 FlexPanel에 대응됩니다. 아래에서는 패널 속성을 마크업으로 하나도 설정하지 않았고, 항목의 flex 단축 표기까지 전부 스타일 시트가 처리합니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CT8">실용적인 앱 바</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC8">플렉스박스의 전형적인 일입니다. 제목이 남는 공간을 차지하고 동작 버튼은 오른쪽에 고정되며 모두 세로 가운데 정렬됩니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC9">패널 속성, 항목 첨부 속성, 그리고 그에 대응하는 CSS.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.CC10">같은 패널을 명령형 코드로 만든 예.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.Cap1">늘어나야 하는 요소에는 Width 대신 Basis를 쓰세요. 명시한 Width는 arrange가 항상 강제하는 강한 제약이라, Grow가 아무리 공간을 나눠 줘도 Width가 있는 항목은 크기를 유지합니다. CSS에서 flex: 1을 쓰면 Basis = 0에 대응되어 자동으로 올바르게 동작합니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.Cap2">Order 값이 같은 항목은 선언 순서를 유지합니다. CSS 규정대로 정렬은 안정적입니다.</x:String>
    <x:String x:Key="Loc.P.FlexPanel.Cap3">flex-direction, flex-wrap, justify-content, align-items, align-content, gap/row-gap/column-gap, flex(및 flex-grow/-shrink/-basis), align-self, order가 모두 대응됩니다. FlexPanel이 아닌 패널에서는 컨테이너 속성이 그 패널의 TryApplyCssPropertyCore 재정의로 전달됩니다. StackPanel이 그렇게 flex-direction을 Orientation으로 바꿉니다.</x:String>

    <!-- Flowchart -->
    <x:String x:Key="Loc.P.Flowchart.Title1">Flowchart</x:String>
    <x:String x:Key="Loc.P.Flowchart.Sub1">방향 있는 순서도를 그립니다. 노드를 자동으로 계층에 배치하고 도형, 화살표, 간선 레이블을 그립니다. 간결한 mermaid 텍스트로 작성합니다.</x:String>
    <x:String x:Key="Loc.P.Flowchart.CT1">판단 흐름</x:String>
    <x:String x:Key="Loc.P.Flowchart.CC1">판단 노드, 분기 레이블, 위에서 아래로 향하는 계층 레이아웃을 갖춘 순서도.</x:String>
    <x:String x:Key="Loc.P.Flowchart.CT2">노드 모양과 간선 스타일</x:String>
    <x:String x:Key="Loc.P.Flowchart.CC2">직사각형, 둥근 모서리, 스타디움, 원, 마름모, 육각형, 원기둥 등과 실선·점선·굵은 선 간선을 왼쪽에서 오른쪽 레이아웃으로 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.Flowchart.CC3">왼쪽에서 mermaid 소스를 편집하면 오른쪽 다이어그램이 실시간으로 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.Flowchart.CC4">순서도를 mermaid 텍스트로 선언형으로 작성합니다.</x:String>
    <x:String x:Key="Loc.P.Flowchart.CC5">MermaidDiagram이나 FlowchartDiagram으로 코드에서 순서도를 그립니다.</x:String>

    <!-- Frame -->
    <x:String x:Key="Loc.P.Frame.Title1">Frame</x:String>
    <x:String x:Key="Loc.P.Frame.Sub1">페이지 콘텐츠를 담고 페이지 사이를 이동하는 컨테이너로, 뒤로·앞으로 기록도 유지합니다.</x:String>
    <x:String x:Key="Loc.P.Frame.CT1">기본 Frame</x:String>
    <x:String x:Key="Loc.P.Frame.CC1">Frame은 페이지를 담고 그 사이를 이동할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Frame.CT2">탐색 제어</x:String>
    <x:String x:Key="Loc.P.Frame.CC2">Frame은 뒤로·앞으로 탐색을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.Frame.CT3">Frame 속성</x:String>
    <x:String x:Key="Loc.P.Frame.CC3">Frame에서 자주 쓰는 설정 항목.</x:String>
    <x:String x:Key="Loc.P.Frame.CC4">Frame은 다양한 탐색 상황에서 유용합니다.</x:String>
    <x:String x:Key="Loc.P.Frame.CC5">Frame과 탐색 버튼의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Frame.CC6">탐색 상태와 명령은 독립된 ViewModel에 둡니다.</x:String>

    <!-- GanttChart -->
    <x:String x:Key="Loc.P.GanttChart.Title1">GanttChart</x:String>
    <x:String x:Key="Loc.P.GanttChart.Sub1">작업을 타임라인에 표시하는 차트 컨트롤로, 의존 관계·마일스톤·진행률 추적을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.GanttChart.CT1">기본 간트 차트</x:String>
    <x:String x:Key="Loc.P.GanttChart.CC1">서로 다른 기간에 걸친 여러 작업을 담은 간단한 간트 차트.</x:String>
    <x:String x:Key="Loc.P.GanttChart.CT2">의존 관계와 마일스톤</x:String>
    <x:String x:Key="Loc.P.GanttChart.CC2">작업 사이에 의존 화살표를 그리고 마일스톤 표시를 더한 간트 차트.</x:String>
    <x:String x:Key="Loc.P.GanttChart.CT3">진행률 추적</x:String>
    <x:String x:Key="Loc.P.GanttChart.CC3">진행률 표시기로 작업의 부분 완료를 보여 주는 간트 차트.</x:String>
    <x:String x:Key="Loc.P.GanttChart.CC4">위 간트 차트의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.GanttChart.CC5">작업, 의존 관계, 마일스톤, 진행률은 모두 ViewModel의 컬렉션이며 XAML에서 바인딩합니다.</x:String>

    <!-- GaugeChart -->
    <x:String x:Key="Loc.P.GaugeChart.Title1">GaugeChart</x:String>
    <x:String x:Key="Loc.P.GaugeChart.Sub1">값을 방사형 게이지에 표시하며 색 구간, 눈금, 바늘 표시기를 제공합니다.</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CT1">기본 게이지</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CC1">값, 최솟값, 최댓값만 지정한 게이지 차트.</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CT2">색 구간</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CC2">초록·노랑·빨강 구간을 가진 게이지.</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CT3">여러 게이지</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CC3">CPU, 메모리, 디스크 사용량을 보여 주는 작은 게이지 세 개.</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CC4">위 게이지들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.GaugeChart.CC5">게이지 설정과 구간은 XAML에서 직접 선언합니다.</x:String>

    <!-- GeographicHeatmap -->
    <x:String x:Key="Loc.P.GeographicHeatmap.Title1">GeographicHeatmap</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.Sub1">지리적 히트맵을 그리는 컨트롤로, 가우시안 흐림을 적용한 강도 필드와 설정 가능한 그라데이션을 사용합니다.</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CC1">대도시권 주변에 열점을 흩뿌린 GeographicHeatmap.</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CT1">반경과 강도</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CC2">Radius와 Intensity 값을 달리한 여러 히트맵.</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CT2">색 그라데이션</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CC3">기본, 따뜻한 색, 차가운 색 세 가지 그라데이션을 쓴 히트맵.</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CC4">위 히트맵들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.GeographicHeatmap.CC5">열점과 그라데이션은 ViewModel에서 오고, XAML이 각 히트맵 변형을 선언합니다.</x:String>

    <!-- GettingStarted -->
    <x:String x:Key="Loc.P.GettingStarted.Eyebrow1">JALIUM.UI / 시작</x:String>
    <x:String x:Key="Loc.P.GettingStarted.Title1">시작하기</x:String>
    <x:String x:Key="Loc.P.GettingStarted.Sub1">Jalium.UI와 명확한 ViewModel 경계를 사용해 선언형 애플리케이션을 만드는 방법을 배웁니다.</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CT1">설치</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CC1">애플리케이션 프로젝트에 UI 패키지를 추가합니다.</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CT2">첫 창 만들기</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CC2">선언형 뷰가 필요 없을 때는 창을 C#만으로 구성할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CT3">JALXAML 사용하기</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CC3">비주얼 트리를 마크업에서 선언하고 전용 ViewModel에 바인딩합니다.</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CT4">레이아웃 컨트롤</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CC4">패널로 레이아웃 의도를 표현합니다.</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CT5">데이터 바인딩</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CC5">ViewModel에서 관찰 가능한 속성과 명령을 노출합니다.</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CT6">CSS로 스타일 지정</x:String>
    <x:String x:Key="Loc.P.GettingStarted.CC6">스타일은 진짜 CSS로도 쓸 수 있습니다. 속성 키워드는 100% 네이티브 CSS이며, CSS에 키워드가 없는 것은 케밥 케이스 이름으로 컨트롤의 종속성 속성에 닿습니다.</x:String>

    <!-- Grid -->
    <x:String x:Key="Loc.P.Grid.Title1">Grid</x:String>
    <x:String x:Key="Loc.P.Grid.Sub1">자식 요소를 행과 열에 배치하는 유연한 레이아웃 패널로, 고정·자동·스타 크기와 행·열 병합을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.Grid.CT1">기본 Grid 레이아웃</x:String>
    <x:String x:Key="Loc.P.Grid.CC1">3x3 격자이며 색을 넣은 각 셀에 행·열 인덱스를 표시했습니다.</x:String>
    <x:String x:Key="Loc.P.Grid.CT2">Grid 기능</x:String>
    <x:String x:Key="Loc.P.Grid.CC2">Grid 컨트롤의 주요 기능: 크기 지정 혼합, 행 병합, 열 병합.</x:String>
    <x:String x:Key="Loc.P.Grid.CC3">앱 형태의 격자 레이아웃에 대한 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Grid.CC4">같은 격자 레이아웃을 코드 비하인드에서 동적으로 구성합니다.</x:String>
    <x:String x:Key="Loc.P.Grid.Cap1">이 구역은 실제 RowDefinitions, ColumnDefinitions, RowSpan, ColumnSpan을 사용합니다.</x:String>

    <!-- GroupBox -->
    <x:String x:Key="Loc.P.GroupBox.Title1">GroupBox</x:String>
    <x:String x:Key="Loc.P.GroupBox.Sub1">관련 컨트롤을 제목이 있는 테두리로 묶는 컨테이너로, 폼과 설정 화면에 뚜렷한 시각적 구조를 줍니다.</x:String>
    <x:String x:Key="Loc.P.GroupBox.CC1">한 행에 놓인 두 GroupBox가 각각 다른 필드 묶음을 감싸고 있습니다.</x:String>
    <x:String x:Key="Loc.P.GroupBox.CC2">GroupBox 컨테이너가 제공하는 것.</x:String>
    <x:String x:Key="Loc.P.GroupBox.CC3">위 그룹화된 폼의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.GroupBox.CC4">코드 비하인드에서 설정용 GroupBox와 필드를 만듭니다.</x:String>
    <x:String x:Key="Loc.P.GroupBox.Body1">• 관련 컨트롤을 시각적으로 묶기</x:String>
    <x:String x:Key="Loc.P.GroupBox.Body2">• 머리글 텍스트 사용자 지정 가능</x:String>
    <x:String x:Key="Loc.P.GroupBox.Body3">• 머리글에 어떤 콘텐츠든 넣을 수 있음</x:String>
    <x:String x:Key="Loc.P.GroupBox.Body4">• 콘텐츠를 감싸는 스타일 적용 테두리</x:String>

    <!-- Heatmap -->
    <x:String x:Key="Loc.P.Heatmap.Title1">Heatmap</x:String>
    <x:String x:Key="Loc.P.Heatmap.Sub1">2차원 숫자 행렬을 색으로 구분한 격자로 표시하며 레이블과 색상 눈금 막대를 함께 둘 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Heatmap.CC1">기본 BlueToRed 색상 눈금을 쓴 10x10 히트맵.</x:String>
    <x:String x:Key="Loc.P.Heatmap.CT1">색상 눈금</x:String>
    <x:String x:Key="Loc.P.Heatmap.CC2">같은 데이터를 Viridis와 Grayscale 색상 눈금으로 그린 결과.</x:String>
    <x:String x:Key="Loc.P.Heatmap.CT2">셀 값</x:String>
    <x:String x:Key="Loc.P.Heatmap.CC3">ShowCellValues를 켠 히트맵으로, 각 셀 안에 숫자를 표시합니다.</x:String>
    <x:String x:Key="Loc.P.Heatmap.CC4">축 레이블과 셀 값을 갖춘 히트맵의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Heatmap.CC5">ViewModel이 행렬과 레이블을 갖고, XAML이 히트맵 렌더링 설정을 맡습니다.</x:String>

    <!-- HexEditor -->
    <x:String x:Key="Loc.P.HexEditor.Title1">HexEditor</x:String>
    <x:String x:Key="Loc.P.HexEditor.Sub1">이진 데이터를 16진 형식으로 표시하고 편집하는 컨트롤로, 오프셋·16진·ASCII 세 열을 제공합니다.</x:String>
    <x:String x:Key="Loc.P.HexEditor.CT1">기본 헥스 편집기</x:String>
    <x:String x:Key="Loc.P.HexEditor.CC1">오프셋, 16진, ASCII 세 열로 이진 데이터를 표시하고 편집합니다.</x:String>
    <x:String x:Key="Loc.P.HexEditor.CT2">설정 옵션</x:String>
    <x:String x:Key="Loc.P.HexEditor.CC2">아래 컨트롤로 열 표시를 전환하고 한 행당 바이트 수를 조절합니다.</x:String>
    <x:String x:Key="Loc.P.HexEditor.CC3">수정 없이 이진 데이터를 살펴보기 위한 읽기 전용 헥스 뷰어.</x:String>
    <x:String x:Key="Loc.P.HexEditor.CC4">위 헥스 편집기의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.HexEditor.CC5">이진 데이터와 편집기 설정은 ViewModel에서 바인딩합니다.</x:String>

    <!-- HyperlinkButton -->
    <x:String x:Key="Loc.P.HyperlinkButton.Title1">HyperlinkButton</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.Sub1">하이퍼링크처럼 보이는 버튼으로, URI로 이동하거나 클릭 처리기를 실행하며 마우스 오버·누름·밑줄 상태를 자동으로 처리합니다.</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.CC1">독립된 링크는 URI로 이동합니다. 링크는 문장 안에 인라인으로 흐르게 둘 수도 있습니다.</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.CC2">이 컨트롤이 기본으로 제공하는 주요 기능.</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.CC3">위 링크들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.CC4">코드 비하인드에서 링크를 만들고 연결합니다.</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.Body1">• 외부 URL로 이동</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.Body2">• 하이퍼링크 스타일(밑줄, 색)</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.Body3">• 마우스 오버와 누름 상태</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.Body4">• 기본 브라우저에서 열기</x:String>
    <x:String x:Key="Loc.P.HyperlinkButton.Cap1">문단 안에서:</x:String>

    <!-- IconElement -->
    <x:String x:Key="Loc.P.IconElement.Eyebrow1">아이코노그래피</x:String>
    <x:String x:Key="Loc.P.IconElement.Title1">IconElement</x:String>
    <x:String x:Key="Loc.P.IconElement.Sub1">확대·축소되는 벡터 아이콘 계열(SymbolIcon, FontIcon, PathIcon)로, Segoe Fluent Icons의 600개 이상 글리프를 버튼·도구 모음·앱 바에 사용합니다.</x:String>
    <x:String x:Key="Loc.P.IconElement.CT1">SymbolIcon</x:String>
    <x:String x:Key="Loc.P.IconElement.CC1">Symbol 열거형으로 Segoe Fluent Icons의 자주 쓰는 아이콘을 표시합니다.</x:String>
    <x:String x:Key="Loc.P.IconElement.CT2">FontIcon</x:String>
    <x:String x:Key="Loc.P.IconElement.CC2">임의의 글꼴 글리프를 사용하고 크기와 색을 바인딩으로 제어합니다.</x:String>
    <x:String x:Key="Loc.P.IconElement.CT3">SymbolIcon을 쓴 AppBarButton</x:String>
    <x:String x:Key="Loc.P.IconElement.CC3">AppBarButton.Icon은 원시 문자열이 아니라 IconElement를 받습니다.</x:String>
    <x:String x:Key="Loc.P.IconElement.CT4">전체 Symbol 열거형 갤러리</x:String>
    <x:String x:Key="Loc.P.IconElement.CC4">모든 Symbol 열거형 값을 ViewModel이 제공하며 알파벳 순으로 묶었습니다.</x:String>
    <x:String x:Key="Loc.P.IconElement.CC5">SymbolIcon, FontIcon, AppBarButton 아이콘의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.IconElement.CC6">전용 ViewModel이 재사용 가능한 XAML 템플릿에 아이콘 데이터를 공급합니다.</x:String>

    <!-- Image -->
    <x:String x:Key="Loc.P.Image.Title1">Image</x:String>
    <x:String x:Key="Loc.P.Image.Sub1">래스터와 벡터 이미지를 네 가지 늘이기 모드로 표시하며, 둥근 모서리·테두리·클리핑은 ControlTemplate에서 제공합니다.</x:String>
    <x:String x:Key="Loc.P.Image.CT1">원격 이미지</x:String>
    <x:String x:Key="Loc.P.Image.CC1">원격 URL에서 Stretch.Uniform으로 불러온 이미지.</x:String>
    <x:String x:Key="Loc.P.Image.CT2">늘이기 모드</x:String>
    <x:String x:Key="Loc.P.Image.CC2">같은 이미지로 네 가지 늘이기 모드를 나란히 비교합니다.</x:String>
    <x:String x:Key="Loc.P.Image.CT3">SVG 이미지</x:String>
    <x:String x:Key="Loc.P.Image.CC3">진짜 벡터 그래픽으로 그려지는 벡터 이미지로, 어떤 해상도에서도 선명하고 확대해도 품질이 떨어지지 않습니다.</x:String>
    <x:String x:Key="Loc.P.Image.CT4">SVG 늘이기 모드</x:String>
    <x:String x:Key="Loc.P.Image.CC4">SVG 벡터 이미지로 네 가지 늘이기 모드를 비교합니다.</x:String>
    <x:String x:Key="Loc.P.Image.CT5">스타일을 적용한 이미지</x:String>
    <x:String x:Key="Loc.P.Image.CC5">Image 컨트롤은 ControlTemplate을 통해 CornerRadius, 테두리, 배경 브러시를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.Image.CC6">Image 컨트롤이 노출하는 주요 속성.</x:String>
    <x:String x:Key="Loc.P.Image.CC7">이미지를 불러오고 꾸미는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Image.CC8">코드 비하인드에서 BitmapImage, SvgImage 원본과 Image 컨트롤을 만듭니다.</x:String>
    <x:String x:Key="Loc.P.Image.Body1">Source — 표시할 ImageSource(BitmapImage 또는 SvgImage)</x:String>
    <x:String x:Key="Loc.P.Image.Body2">Stretch — 이미지가 영역을 채우는 방식(None, Fill, Uniform, UniformToFill)</x:String>
    <x:String x:Key="Loc.P.Image.Body3">StretchDirection — 배율 방향 제한(UpOnly, DownOnly, Both)</x:String>
    <x:String x:Key="Loc.P.Image.Body4">Background — 이미지 뒤의 배경 브러시(ControlTemplate 경유)</x:String>
    <x:String x:Key="Loc.P.Image.Body5">CornerRadius — 클리핑을 동반한 둥근 모서리(ControlTemplate 경유)</x:String>
    <x:String x:Key="Loc.P.Image.Body6">BorderBrush / BorderThickness — 이미지를 감싸는 테두리(ControlTemplate 경유)</x:String>
    <x:String x:Key="Loc.P.Image.Cap1">원본 크기, 배율 없음</x:String>
    <x:String x:Key="Loc.P.Image.Cap2">컨테이너를 채움, 왜곡될 수 있음</x:String>
    <x:String x:Key="Loc.P.Image.Cap3">안쪽에 맞춤, 비율 유지</x:String>
    <x:String x:Key="Loc.P.Image.Cap4">컨테이너를 채우고 넘치는 부분은 잘라냄</x:String>
    <x:String x:Key="Loc.P.Image.Cap5">둥근 모서리</x:String>
    <x:String x:Key="Loc.P.Image.Cap6">원형</x:String>
    <x:String x:Key="Loc.P.Image.Cap7">테두리 있음</x:String>

    <!-- InfoBar -->
    <x:String x:Key="Loc.P.InfoBar.Title1">InfoBar</x:String>
    <x:String x:Key="Loc.P.InfoBar.Sub1">중요하지만 작업을 막지 않는 상태 메시지를 그 자리에 보여 주는 알림 막대로, 사용자를 방해하지 않습니다.</x:String>
    <x:String x:Key="Loc.P.InfoBar.CC1">심각도마다 고유한 강조색, 아이콘, 색조가 적용됩니다. 마지막 막대는 닫기 버튼으로 없앨 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.InfoBar.CC2">InfoBar 컨트롤이 기본으로 제공하는 기능.</x:String>
    <x:String x:Key="Loc.P.InfoBar.CC3">위 InfoBar들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.InfoBar.CC4">코드 비하인드에서 알림을 만들고 표시하고 닫습니다.</x:String>
    <x:String x:Key="Loc.P.InfoBar.Body1">• 네 가지 심각도(정보, 성공, 경고, 오류)</x:String>
    <x:String x:Key="Loc.P.InfoBar.Body2">• 제목과 메시지 내용</x:String>
    <x:String x:Key="Loc.P.InfoBar.Body3">• 선택적 닫기 단추</x:String>
    <x:String x:Key="Loc.P.InfoBar.Body4">• 동작 단추 지원</x:String>
    <x:String x:Key="Loc.P.InfoBar.Body5">• 사용자 지정 콘텐츠 영역</x:String>

    <!-- InkCanvas -->
    <x:String x:Key="Loc.P.InkCanvas.Title1">InkCanvas</x:String>
    <x:String x:Key="Loc.P.InkCanvas.Sub1">마우스, 펜, 터치로 그린 자유 곡선 획을 받아들이는 그리기 면으로, 획 색·두께·브러시 종류·지우개 모드를 설정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT1">기본 그리기</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC1">마우스로 그리고, 잉크와 지우기 모드를 전환하거나 캔버스를 지웁니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT2">획 색</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC2">그릴 색을 고릅니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT3">획 두께</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC3">획의 두께를 조절합니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT4">형광펜 모드</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC4">형광펜 모드를 켜면 반투명한 획이 됩니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT5">브러시 종류</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC5">새 획에 사용할 브러시 종류를 고릅니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT6">테이퍼 모드</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC6">새 획의 끝이 가늘어지는 방식을 고릅니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CT7">획 정보</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC7">현재 캔버스에 있는 획 개수를 표시합니다.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC8">위 InkCanvas 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.InkCanvas.CC9">ViewModel이 그리기 상태와 명령을 노출하고, 첨부 동작이 InkCanvas 인스턴스 API를 이어 줍니다.</x:String>

    <!-- JsonTreeViewer -->
    <x:String x:Key="Loc.P.JsonTreeViewer.Title1">JsonTreeViewer</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.Sub1">JSON 데이터를 대화형 트리 보기로 표시하는 컨트롤로, 검색·펼치기/접기·경로 복사를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CT1">기본 JSON 트리</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CC1">형식별로 색을 입힌 펼침 가능한 노드로 구조화된 JSON 데이터를 표시합니다.</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CT2">검색과 필터</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CC2">검색 상자에 입력하면 트리에서 일치하는 키와 값이 강조됩니다.</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CC3">왼쪽에 JSON 텍스트를 입력하면 오른쪽 트리 보기가 실시간으로 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CC4">위 JSON 트리 뷰어의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.JsonTreeViewer.CC5">JSON 내용과 실시간 검색 상태는 ViewModel이 노출합니다.</x:String>

    <!-- Label -->
    <x:String x:Key="Loc.P.Label.Title1">Label</x:String>
    <x:String x:Key="Loc.P.Label.Sub1">텍스트를 표시하고 대상 요소에 연결할 수 있는 컨트롤입니다. 레이블을 클릭하거나 액세스 키를 누르면 짝지어진 컨트롤로 포커스가 이동해 폼 접근성이 좋아집니다.</x:String>
    <x:String x:Key="Loc.P.Label.CC1">각 캡션은 입력란과 짝지어진 Label입니다. 레이블을 클릭하면 옆 필드에 포커스가 갑니다.</x:String>
    <x:String x:Key="Loc.P.Label.CC2">Label 컨트롤이 폼에 더해 주는 것.</x:String>
    <x:String x:Key="Loc.P.Label.CC3">액세스 키로 각 레이블을 대상에 연결하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Label.CC4">코드 비하인드에서 레이블을 만들고 Target을 지정합니다.</x:String>
    <x:String x:Key="Loc.P.Label.Body1">• 레이블과 대상 컨트롤을 연결</x:String>
    <x:String x:Key="Loc.P.Label.Body2">• 레이블을 클릭해 대상에 포커스</x:String>
    <x:String x:Key="Loc.P.Label.Body3">• 액세스 키 지원(Alt+키)</x:String>
    <x:String x:Key="Loc.P.Label.Body4">• 폼 접근성 향상</x:String>

    <!-- LineChart -->
    <x:String x:Key="Loc.P.LineChart.Title1">LineChart</x:String>
    <x:String x:Key="Loc.P.LineChart.Sub1">데이터를 이어진 선분으로 표시하며 곡선 부드럽게 하기, 영역 채우기, 데이터 요소 표식을 선택할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.LineChart.CT1">기본 꺾은선 차트</x:String>
    <x:String x:Key="Loc.P.LineChart.CC1">단일 데이터 계열을 데이터 요소 표식이 있는 꺾은선 차트로 그립니다.</x:String>
    <x:String x:Key="Loc.P.LineChart.CT2">여러 계열</x:String>
    <x:String x:Key="Loc.P.LineChart.CC2">같은 차트에 여러 데이터 계열을 겹치고 범례를 함께 둡니다.</x:String>
    <x:String x:Key="Loc.P.LineChart.CT3">부드러운 선과 영역</x:String>
    <x:String x:Key="Loc.P.LineChart.CC3">Catmull-Rom 스플라인으로 부드럽게 하고 선 아래를 채웁니다.</x:String>
    <x:String x:Key="Loc.P.LineChart.CC4">단일 계열 꺾은선 차트의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.LineChart.CC5">계열은 XAML에서 선언하고 ViewModel이 가진 데이터 컬렉션에 바인딩합니다.</x:String>

    <!-- LiquidGlass -->
    <x:String x:Key="Loc.P.LiquidGlass.Title1">리퀴드 글래스</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.Sub1">SDF 기반 굴절, 색수차, 가장자리 하이라이트, 안쪽 그림자를 갖춘 Apple 스타일 리퀴드 글래스 효과입니다. 아무 Border에나 LiquidGlass=True를 지정하면 됩니다.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT1">기본 리퀴드 글래스</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC1">가장자리 하이라이트와 안쪽 그림자를 동반한 배경 굴절. BlurRadius=8, RefractionAmount=60.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT2">색수차</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC2">무지개 가장자리 분산 효과를 더합니다. ChromaticAberration이 색 분리 정도를 결정합니다.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT3">모서리 반경 변형</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC3">리퀴드 글래스는 SDF 모양을 다양한 모서리 반경에 맞춰 조정합니다.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT4">색을 입힌 리퀴드 글래스</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC4">Border에 Background를 지정하면 유리 효과 위에 색조를 덧입힐 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT5">대화형 매개변수</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC5">흐림 반경, 굴절량, 색수차를 실시간으로 조절합니다.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT6">리퀴드 글래스 융합</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC6">인접한 리퀴드 글래스 패널은 SDF 스무스 최솟값(smin)을 통해 메타볼처럼 부드럽게 융합됩니다. 패널들은 같은 부모 Panel의 형제여야 합니다.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CT7">초타원 모양</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC7">Shape=SuperEllipse를 지정하면 iOS 스타일 스퀘어클이 됩니다. SuperEllipseN이 지수를 정합니다(2=원, 4=iOS, 클수록 직사각형에 가까움).</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC8">리퀴드 글래스 없음(단색 채우기)</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC9">Border에 LiquidGlass 관련 속성을 설정합니다:</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC10">Border에 리퀴드 글래스 효과를 적용하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.LiquidGlass.CC11">코드 비하인드에서 대화형 슬라이더를 연결하고 유리 속성을 설정합니다.</x:String>

    <!-- ListBox -->
    <x:String x:Key="Loc.P.ListBox.Title1">ListBox</x:String>
    <x:String x:Key="Loc.P.ListBox.Sub1">스크롤 가능한 컨테이너로, 항목 컬렉션을 보여 주고 하나 또는 여러 개를 선택하게 합니다.</x:String>
    <x:String x:Key="Loc.P.ListBox.CC1">항목을 클릭하면 선택됩니다.</x:String>
    <x:String x:Key="Loc.P.ListBox.CC2">ListBox는 여러 선택 모드, 키보드 탐색, 데이터 바인딩을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ListBox.CC3">ListBox를 만들고 항목을 채우는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ListBox.CC4">코드 비하인드에서 항목을 채우고 선택을 처리합니다.</x:String>
    <x:String x:Key="Loc.P.ListBox.Body1">• 단일 선택 모드(기본값)</x:String>
    <x:String x:Key="Loc.P.ListBox.Body2">• 다중 선택 모드</x:String>
    <x:String x:Key="Loc.P.ListBox.Body3">• 확장 선택 모드({Shortcut.PrimaryModifier}/Shift)</x:String>
    <x:String x:Key="Loc.P.ListBox.Body4">• 키보드 탐색(위/아래/Home/End)</x:String>
    <x:String x:Key="Loc.P.ListBox.Body5">• ItemsSource 바인딩</x:String>
    <x:String x:Key="Loc.P.ListBox.Body6">• ItemTemplate 지원</x:String>

    <!-- ListView -->
    <x:String x:Key="Loc.P.ListView.Title1">ListView</x:String>
    <x:String x:Key="Loc.P.ListView.Sub1">스크롤 가능한 컬렉션 컨트롤로, 항목을 단순 목록이나 여러 열의 행으로 표시하며 단일·다중·확장 선택을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ListView.CT1">기본 ListView</x:String>
    <x:String x:Key="Loc.P.ListView.CC1">세로로 늘어선 선택 가능한 항목 목록.</x:String>
    <x:String x:Key="Loc.P.ListView.CT2">열이 있는 ListView</x:String>
    <x:String x:Key="Loc.P.ListView.CC2">GridView로 바꿔 머리글이 있는 여러 열에 항목을 배치합니다.</x:String>
    <x:String x:Key="Loc.P.ListView.CT3">선택 모드</x:String>
    <x:String x:Key="Loc.P.ListView.CC3">단일, 다중, 확장 선택은 클릭과 드래그에서 각각 다르게 동작합니다.</x:String>
    <x:String x:Key="Loc.P.ListView.CC4">항목을 추가하고 제거하면서 선택 정보가 갱신되는 모습을 확인합니다.</x:String>
    <x:String x:Key="Loc.P.ListView.CC5">목록형 레이아웃이 자연스럽게 어울리는 상황.</x:String>
    <x:String x:Key="Loc.P.ListView.CC6">위 목록들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ListView.CC7">독립된 ViewModel에서 항목을 채우고 편집하며 선택 상태를 관찰합니다.</x:String>
    <x:String x:Key="Loc.P.ListView.Cap1">단일 선택</x:String>
    <x:String x:Key="Loc.P.ListView.Cap2">다중 선택</x:String>
    <x:String x:Key="Loc.P.ListView.Cap3">확장 선택</x:String>
    <x:String x:Key="Loc.P.ListView.Chip1">파일 탐색기</x:String>
    <x:String x:Key="Loc.P.ListView.Chip2">메일 목록</x:String>
    <x:String x:Key="Loc.P.ListView.Chip3">연락처 목록</x:String>
    <x:String x:Key="Loc.P.ListView.Chip4">작업 관리자</x:String>
    <x:String x:Key="Loc.P.ListView.Chip5">로그 뷰어</x:String>

    <!-- MapView -->
    <x:String x:Key="Loc.P.MapView.Title1">MapView</x:String>
    <x:String x:Key="Loc.P.MapView.Sub1">슬리피 맵 타일을 표시하는 지도 컨트롤로, 마커·폴리라인·이동·확대를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.MapView.CT1">기본 지도</x:String>
    <x:String x:Key="Loc.P.MapView.CC1">베이징을 중심에 둔 MapView로, 기본 확대 컨트롤과 축척 막대를 갖췄습니다.</x:String>
    <x:String x:Key="Loc.P.MapView.CT2">마커와 오버레이</x:String>
    <x:String x:Key="Loc.P.MapView.CC2">주요 지점에 레이블이 붙은 마커를 두고 폴리라인으로 연결한 MapView.</x:String>
    <x:String x:Key="Loc.P.MapView.CT3">확대 제어</x:String>
    <x:String x:Key="Loc.P.MapView.CC3">대화형 확대와 이동 데모. 버튼으로 확대·축소하고 지도를 클릭하면 이동합니다.</x:String>
    <x:String x:Key="Loc.P.MapView.CC4">위 지도들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.MapView.CC5">지도 데이터, 뷰포트 상태, 명령은 모두 ViewModel이 노출합니다.</x:String>

    <!-- Markdown -->
    <x:String x:Key="Loc.P.Markdown.Title1">Markdown</x:String>
    <x:String x:Key="Loc.P.Markdown.Sub1">제목, 목록, 표, 코드 펜스, 상대 링크를 갖춘 풍부한 Markdown 문서를 렌더링합니다.</x:String>
    <x:String x:Key="Loc.P.Markdown.CT1">대화형 미리 보기</x:String>
    <x:String x:Key="Loc.P.Markdown.CC1">대표적인 Markdown 문서 몇 가지를 전환하며 렌더링 결과가 바로 바뀌는 모습을 확인합니다.</x:String>
    <x:String x:Key="Loc.P.Markdown.CC2">왼쪽 입력 상자에 Markdown을 입력하면 오른쪽에 렌더링 결과가 실시간으로 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.Markdown.CT2">사용자 지정 스타일</x:String>
    <x:String x:Key="Loc.P.Markdown.CC3">이 컨트롤은 주변 테마를 상속할 수도 있고, 네이티브 스타일 속성으로 기사 같은 레이아웃을 만들 수도 있습니다.</x:String>
    <x:String x:Key="Loc.P.Markdown.CT3">Mermaid 다이어그램</x:String>
    <x:String x:Key="Loc.P.Markdown.CC4">mermaid를 지정한 펜스 코드 블록은 소스가 아니라 다이어그램(순서도, 원 그래프)으로 그려집니다. 단독 컨트롤은 '차트 &gt; Flowchart' 페이지를 보세요.</x:String>
    <x:String x:Key="Loc.P.Markdown.CT4">Markdown 속성</x:String>
    <x:String x:Key="Loc.P.Markdown.CC5">원본 지정, 상대 링크 해석, 네이티브 렌더러 모양을 정하는 주요 속성.</x:String>
    <x:String x:Key="Loc.P.Markdown.CT5">선택과 복사</x:String>
    <x:String x:Key="Loc.P.Markdown.CC6">끌어서 텍스트를 선택하거나 {Shortcut.SelectAll}를 누른 뒤 {Shortcut.Copy}나 오른쪽 클릭 메뉴로 복사합니다. 이 컨트롤은 일반 텍스트, Markdown 소스, 서식 있는 텍스트(HTML + RTF) 세 형식으로 복사하며 번역 등 연동을 위해 텍스트를 노출합니다.</x:String>
    <x:String x:Key="Loc.P.Markdown.CC7">위 Markdown 컨트롤의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Markdown.CC8">텍스트, 샘플, 복사 명령, 라이브 편집기 상태는 모두 ViewModel이 제공합니다.</x:String>
    <x:String x:Key="Loc.P.Markdown.Body1">Text — 컨트롤이 렌더링하는 Markdown 원본 문자열</x:String>
    <x:String x:Key="Loc.P.Markdown.Body2">BaseUri — 생성된 HTML의 상대 링크와 이미지를 해석</x:String>
    <x:String x:Key="Loc.P.Markdown.Body3">LinkForeground / CodeBackground / QuoteBorderBrush — 서식 있는 콘텐츠를 위한 네이티브 스타일 훅</x:String>
    <x:String x:Key="Loc.P.Markdown.Body4">Background / Foreground / FontFamily / FontSize — 네이티브 렌더러의 타이포그래피 결정</x:String>
    <x:String x:Key="Loc.P.Markdown.Cap1">Markdown 입력:</x:String>
    <x:String x:Key="Loc.P.Markdown.Cap2">렌더링 결과:</x:String>

    <!-- MediaElement -->
    <x:String x:Key="Loc.P.MediaElement.Title1">MediaElement</x:String>
    <x:String x:Key="Loc.P.MediaElement.Sub1">오디오와 비디오를 재생하는 컨트롤로, 재생 제어·음량·재생 속도 옵션을 제공합니다.</x:String>
    <x:String x:Key="Loc.P.MediaElement.CT1">비디오 플레이어</x:String>
    <x:String x:Key="Loc.P.MediaElement.CC1">로컬 파일이나 URL을 불러온 뒤 ViewModel 명령으로 재생을 제어합니다.</x:String>
    <x:String x:Key="Loc.P.MediaElement.CT2">오디오 플레이어</x:String>
    <x:String x:Key="Loc.P.MediaElement.CC2">같은 MediaElement로 오디오도 재생하며 동작을 통해 재생 위치를 보고합니다.</x:String>
    <x:String x:Key="Loc.P.MediaElement.CT3">재생 제어</x:String>
    <x:String x:Key="Loc.P.MediaElement.CC3">두 플레이어가 공유하는 재생 옵션을 조절합니다.</x:String>
    <x:String x:Key="Loc.P.MediaElement.CT4">지원 형식</x:String>
    <x:String x:Key="Loc.P.MediaElement.CC4">일반적인 비디오·오디오 컨테이너와 코덱을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.MediaElement.CC5">미디어 원본과 재생 옵션의 선언형 바인딩.</x:String>
    <x:String x:Key="Loc.P.MediaElement.CC6">미디어 원본, 옵션, 재생 명령은 모두 ViewModel이 갖습니다.</x:String>
    <x:String x:Key="Loc.P.MediaElement.Body1">비디오: MP4, WebM, AVI, WMV, MOV</x:String>
    <x:String x:Key="Loc.P.MediaElement.Body2">오디오: MP3, WAV, AAC, OGG, FLAC</x:String>

    <!-- Menu -->
    <x:String x:Key="Loc.P.Menu.Title1">Menu</x:String>
    <x:String x:Key="Loc.P.Menu.Sub1">가로 명령 막대로, 각 항목이 명령 드롭다운을 열며 키보드 단축키와 중첩 하위 메뉴를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.Menu.CT1">기본 메뉴</x:String>
    <x:String x:Key="Loc.P.Menu.CC1">여러 항목을 가진 표준 메뉴.</x:String>
    <x:String x:Key="Loc.P.Menu.CT2">키보드 단축키가 있는 메뉴</x:String>
    <x:String x:Key="Loc.P.Menu.CC2">메뉴 항목에 키보드 단축키를 표시할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Menu.CT3">중첩 하위 메뉴</x:String>
    <x:String x:Key="Loc.P.Menu.CC3">메뉴 항목에는 중첩 하위 메뉴를 둘 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Menu.CC4">위 메뉴들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Menu.CC5">코드 비하인드에서 메뉴를 만들고 항목 클릭 처리기를 연결합니다.</x:String>

    <!-- MenuBar -->
    <x:String x:Key="Loc.P.MenuBar.Title1">MenuBar</x:String>
    <x:String x:Key="Loc.P.MenuBar.Sub1">앱 명령을 최상위 메뉴로 묶고 플라이아웃 하위 메뉴를 여는 가로 막대입니다.</x:String>
    <x:String x:Key="Loc.P.MenuBar.CT1">기본 MenuBar</x:String>
    <x:String x:Key="Loc.P.MenuBar.CC1">파일·편집·보기·도움말 네 메뉴를 갖춘 표준 메뉴 막대이며 각 항목에 키보드 힌트가 붙습니다.</x:String>
    <x:String x:Key="Loc.P.MenuBar.CT2">메뉴 동작 로그</x:String>
    <x:String x:Key="Loc.P.MenuBar.CC2">메뉴 항목을 클릭하면 어떤 동작이 실행됐는지 확인할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.MenuBar.CC3">위 메뉴의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.MenuBar.CC4">코드 비하인드에서 메뉴를 만들고 클릭 처리기를 연결합니다.</x:String>

    <!-- MenuFlyout -->
    <x:String x:Key="Loc.P.MenuFlyout.Title1">MenuFlyout</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.Sub1">명령이나 옵션 목록을 보여 주는 플라이아웃 메뉴로, 보통 버튼 클릭으로 엽니다.</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CT1">기본 MenuFlyout</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CC1">버튼을 클릭하면 자주 쓰는 동작이 담긴 컨텍스트 메뉴가 열립니다.</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CT2">아이콘이 있는 MenuFlyout</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CC2">메뉴 항목은 레이블 옆에 아이콘을 표시해 빠르게 알아볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CT3">선택 가능한 항목이 있는 MenuFlyout</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CC3">메뉴 항목을 켜고 끄며 보기 옵션을 제어할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CC4">선언형 메뉴를 ViewModel의 명령과 상태에 직접 바인딩합니다.</x:String>
    <x:String x:Key="Loc.P.MenuFlyout.CC5">ViewModel이 ICommand 속성과 선택 가능한 옵션 상태를 노출합니다.</x:String>

    <!-- MiniMap -->
    <x:String x:Key="Loc.P.MiniMap.Title1">MiniMap</x:String>
    <x:String x:Key="Loc.P.MiniMap.Sub1">대상 요소의 전체 모습을 축소해 보여 주는 미니맵 컨트롤로, 끌 수 있는 뷰포트 사각형을 제공합니다.</x:String>
    <x:String x:Key="Loc.P.MiniMap.CT1">기본 MiniMap</x:String>
    <x:String x:Key="Loc.P.MiniMap.CC1">큰 콘텐츠를 담은 ScrollViewer와 보이는 영역을 따라가는 MiniMap. 미니맵을 클릭하면 이동합니다.</x:String>
    <x:String x:Key="Loc.P.MiniMap.CT2">지도와의 통합</x:String>
    <x:String x:Key="Loc.P.MiniMap.CC2">MapView를 대상으로 한 MiniMap으로, 뷰포트 표시가 있는 지리적 개요를 제공합니다.</x:String>
    <x:String x:Key="Loc.P.MiniMap.CT3">렌더 모드</x:String>
    <x:String x:Key="Loc.P.MiniMap.CC3">None, Outline, Simplified 세 렌더 모드를 여러 MiniMap으로 나란히 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.MiniMap.CC4">MiniMap을 ScrollViewer나 MapView 대상에 연결하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.MiniMap.CC5">ViewModel이 콘텐츠와 마커를 제공하고, 대상 연결과 렌더 모드는 XAML 선언입니다.</x:String>

    <!-- NavigationDemo -->
    <x:String x:Key="Loc.P.NavigationDemo.Title1">내비게이션</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.Sub1">WPF 호환 내비게이션으로 NavigationService, JournalEntry, NavigationWindow를 제공합니다.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CT1">NavigationService</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CC1">탐색 메서드를 제공하고 뒤로·앞으로 기록을 유지합니다.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CT2">JournalEntry</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CC2">탐색 기록의 각 항목을 나타내며 사용자 지정 상태도 담을 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CT3">NavigationWindow</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CC3">뒤로·앞으로 단추를 포함한 탐색 크롬을 갖춘 창.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CT4">CustomContentState</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CC4">탐색 중 페이지 상태를 저장하고 복원합니다. DictionaryContentState와 ScrollContentState도 포함합니다.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CC5">NavigationWindow, 탐색 단추, 내장 Frame의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.CC6">코드 비하인드에서 탐색을 수행하고 이벤트를 처리하며 NavigationWindow를 엽니다.</x:String>
    <x:String x:Key="Loc.P.NavigationDemo.Val1">사용 가능한 상태 형식:</x:String>

    <!-- NetworkGraph -->
    <x:String x:Key="Loc.P.NetworkGraph.Title1">NetworkGraph</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.Sub1">노드와 링크로 네트워크를 시각화하며 여러 레이아웃 알고리즘과 대화형 끌기를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CT1">힘 기반 레이아웃</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC1">노드 위치는 Fruchterman-Reingold 힘 기반 알고리즘으로 정해집니다.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CT2">원형 레이아웃</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC2">모든 노드를 원 둘레에 고르게 배치합니다.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CT3">대화형</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC3">노드를 대화형으로 끌 수 있습니다. 아무 노드나 클릭해 끌면 위치가 바뀝니다.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC4">위 세 그래프의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.NetworkGraph.CC5">노드와 링크 컬렉션은 ViewModel에 두고, 그래프 레이아웃은 XAML 선언입니다.</x:String>

    <!-- NotifyIcon -->
    <x:String x:Key="Loc.P.NotifyIcon.Title1">NotifyIcon</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.Sub1">시스템 알림 영역(트레이)에 아이콘을 표시하며 도구 설명, 풍선 알림, 컨텍스트 메뉴, 클릭 이벤트를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT1">기본 트레이 아이콘</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC1">도구 설명이 있는 아이콘을 시스템 트레이에 표시하거나 숨깁니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT2">풍선 알림</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC2">트레이 아이콘에서 여러 아이콘 종류의 풍선 알림을 표시합니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT3">이벤트</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC3">NotifyIcon은 클릭, 두 번 클릭, 풍선 알림 상호작용에 대해 이벤트를 발생시킵니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CT4">컨텍스트 메뉴</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC4">트레이 아이콘에 ContextMenu를 지정합니다. 트레이 아이콘을 오른쪽 클릭하면 메뉴가 나타납니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC5">View는 컨트롤을 선언하고 ViewModel 명령에 바인딩하기만 합니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.CC6">ViewModel은 주입된 트레이 서비스를 호출하고 바인딩 가능한 상태만 노출합니다.</x:String>
    <x:String x:Key="Loc.P.NotifyIcon.Cap1">컨텍스트 메뉴 구성: 창 표시, 설정, 정보, 종료</x:String>

    <!-- NumberBox -->
    <x:String x:Key="Loc.P.NumberBox.Title1">NumberBox</x:String>
    <x:String x:Key="Loc.P.NumberBox.Sub1">숫자 입력에 최적화된 텍스트 상자로, 스핀 단추·범위 제한·검증을 내장했습니다.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC1">네 가지 변형입니다. 기본 필드, 인라인 스핀 단추, 최소/최대 경계, 사용자 지정 단계 크기.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC2">NumberBox가 기본으로 제공하는 기능.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC3">위 NumberBox 변형들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.NumberBox.CC4">코드에서 NumberBox를 만들고 ValueChanged를 처리하며 범위와 단계를 설정합니다.</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body1">• 숫자 입력 검증</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body2">• 증감용 스핀 단추</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body3">• 최소 / 최대 값 제약</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body4">• 단계 크기 설정 가능</x:String>
    <x:String x:Key="Loc.P.NumberBox.Body5">• 수식 계산 지원</x:String>

    <!-- PasswordBox -->
    <x:String x:Key="Loc.P.PasswordBox.Title1">PasswordBox</x:String>
    <x:String x:Key="Loc.P.PasswordBox.Sub1">입력한 문자를 하나씩 가리는 안전한 텍스트 입력으로, 비밀번호가 화면에 드러나지 않게 합니다.</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CT1">기본 PasswordBox</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CC1">문자가 가려지는 표준 비밀번호 입력.</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CT2">PasswordBox 상태</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CC2">위 비밀번호 입력의 선언형 마크업과 로그인 폼 레이아웃.</x:String>
    <x:String x:Key="Loc.P.PasswordBox.CC3">코드 비하인드에서 PasswordChanged를 처리하고 일치 여부를 검증하며 비밀번호 강도를 평가합니다.</x:String>

    <!-- PieChart -->
    <x:String x:Key="Loc.P.PieChart.Title1">PieChart</x:String>
    <x:String x:Key="Loc.P.PieChart.Sub1">데이터를 원 그래프나 도넛 그래프로 표시하며 조각 분리, 레이블, 연결선을 선택할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.PieChart.CT1">기본 원 그래프</x:String>
    <x:String x:Key="Loc.P.PieChart.CC1">레이블이 붙은 조각으로 비율을 보여 주는 표준 원 그래프.</x:String>
    <x:String x:Key="Loc.P.PieChart.CT2">도넛 그래프</x:String>
    <x:String x:Key="Loc.P.PieChart.CC2">안쪽을 도려내 도넛 모양으로 만든 원 그래프.</x:String>
    <x:String x:Key="Loc.P.PieChart.CT3">분리된 조각</x:String>
    <x:String x:Key="Loc.P.PieChart.CC3">개별 조각을 중심에서 끌어내어 강조할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.PieChart.CC4">위 원 그래프와 도넛 그래프의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.PieChart.CC5">ViewModel이 조각 데이터를 제공하고 XAML이 차트와 계열 설정을 맡습니다.</x:String>

    <!-- Popup -->
    <x:String x:Key="Loc.P.Popup.Title1">Popup</x:String>
    <x:String x:Key="Loc.P.Popup.Sub1">상황에 맞는 콘텐츠를 페이지 위에 띄우는 가벼운 오버레이로, 대상 요소에 고정되며 필요할 때만 표시합니다.</x:String>
    <x:String x:Key="Loc.P.Popup.CT1">기본 팝업</x:String>
    <x:String x:Key="Loc.P.Popup.CC1">작은 팝업을 여닫습니다. 트리거 버튼 바로 아래에 열립니다.</x:String>
    <x:String x:Key="Loc.P.Popup.CT2">폼이 있는 팝업</x:String>
    <x:String x:Key="Loc.P.Popup.CC2">팝업에는 여러 필드로 된 폼 같은 더 풍부한 콘텐츠도 담을 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Popup.CT3">팝업 배치</x:String>
    <x:String x:Key="Loc.P.Popup.CC3">팝업을 대상의 위·오른쪽·아래·왼쪽 가장자리에 고정합니다.</x:String>
    <x:String x:Key="Loc.P.Popup.CC4">위 팝업들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Popup.CC5">코드 비하인드에서 각 팝업의 IsOpen 속성을 전환해 표시하거나 닫습니다.</x:String>

    <!-- Printing -->
    <x:String x:Key="Loc.P.Printing.Title1">인쇄</x:String>
    <x:String x:Key="Loc.P.Printing.Sub1">WPF 호환 인쇄 기능으로 PrintDialog, PrintQueue, DocumentPaginator를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.Printing.CT1">PrintDialog</x:String>
    <x:String x:Key="Loc.P.Printing.CC1">프린터와 인쇄 옵션을 고르는 표준 인쇄 대화 상자.</x:String>
    <x:String x:Key="Loc.P.Printing.CT2">PrintQueue</x:String>
    <x:String x:Key="Loc.P.Printing.CC2">프린터 한 대를 나타내며 인쇄 기능 조회를 제공합니다.</x:String>
    <x:String x:Key="Loc.P.Printing.CT3">PrintCapabilities</x:String>
    <x:String x:Key="Loc.P.Printing.CC3">용지 크기, 색상, 해상도 등 프린터 기능을 조회합니다.</x:String>
    <x:String x:Key="Loc.P.Printing.CT4">DocumentPaginator</x:String>
    <x:String x:Key="Loc.P.Printing.CC4">IDocumentPaginatorSource 인터페이스로 인쇄를 위해 문서를 쪽으로 나눕니다.</x:String>
    <x:String x:Key="Loc.P.Printing.CC5">위 인쇄 단추와 프린터 목록의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Printing.CC6">코드 비하인드에서 대화 상자를 표시하고 프린터를 열거하며 문서를 쪽으로 나눕니다.</x:String>
    <x:String x:Key="Loc.P.Printing.Body1">용지 크기: Letter, Legal, A3, A4, A5, Tabloid, Executive</x:String>
    <x:String x:Key="Loc.P.Printing.Body2">방향: 세로, 가로, 반전</x:String>
    <x:String x:Key="Loc.P.Printing.Body3">색상: 컬러, 회색조, 단색</x:String>
    <x:String x:Key="Loc.P.Printing.Body4">양면: 단면, 짧은 쪽 넘김, 긴 쪽 넘김</x:String>
    <x:String x:Key="Loc.P.Printing.Body5">품질: 초안, 보통, 높음, 사진</x:String>
    <x:String x:Key="Loc.P.Printing.Val1">지원하는 기능</x:String>

    <!-- ProgressBar -->
    <x:String x:Key="Loc.P.ProgressBar.Title1">ProgressBar</x:String>
    <x:String x:Key="Loc.P.ProgressBar.Sub1">작업 진행 상황을 시각화하는 컨트롤로, 확정 백분율이나 미확정 로딩 애니메이션으로 표현합니다.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC1">슬라이더로 진행 값을 바꿉니다.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CT1">진행률 변형</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC2">같은 ProgressBar를 여러 확정 값까지 채운 모습.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CT2">미확정 모드</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC3">구체적인 백분율 없이 작업이 진행 중임을 보여 주는 진행 막대.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC4">위 진행 막대의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ProgressBar.CC5">코드 비하인드에서 슬라이더를 막대에 연결하고 다운로드 진행을 애니메이션합니다.</x:String>

    <!-- PropertyGrid -->
    <x:String x:Key="Loc.P.PropertyGrid.Title1">PropertyGrid</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.Sub1">개체 속성을 표시하고 편집하는 컨트롤로, 범주별·알파벳순 정렬, 실시간 검색, 설명 표시를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CT1">기본 속성 표</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC1">범주 보기로 샘플 개체의 속성을 살펴보고 편집합니다.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CT2">범주별과 알파벳순</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC2">같은 개체에 대해 두 정렬 모드를 나란히 비교합니다.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CT3">사용자 지정 개체</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC3">열거형, 컬렉션, 중첩 개체 등 다양한 형식을 담은 더 풍부한 샘플 개체.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC4">위 PropertyGrid의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.CC5">코드 비하인드에서 샘플 개체를 바인딩하고 정렬 모드를 설정합니다.</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.Cap1">범주별:</x:String>
    <x:String x:Key="Loc.P.PropertyGrid.Cap2">알파벳순:</x:String>

    <!-- QRCode -->
    <x:String x:Key="Loc.P.QRCode.Title1">QRCode</x:String>
    <x:String x:Key="Loc.P.QRCode.Sub1">링크, 연락처, Wi-Fi 설정 문자열 등 간결한 텍스트로 QR 코드를 생성합니다.</x:String>
    <x:String x:Key="Loc.P.QRCode.CT1">대화형 생성기</x:String>
    <x:String x:Key="Loc.P.QRCode.CC1">내용과 오류 정정 수준을 바꾼 뒤 QR 코드를 다시 생성합니다.</x:String>
    <x:String x:Key="Loc.P.QRCode.CT2">자주 쓰는 페이로드</x:String>
    <x:String x:Key="Loc.P.QRCode.CC2">QRCode와 잘 어울리는 실용적인 형식 몇 가지.</x:String>
    <x:String x:Key="Loc.P.QRCode.CT3">QRCode 속성</x:String>
    <x:String x:Key="Loc.P.QRCode.CC3">인코딩과 표현을 제어하는 주요 속성.</x:String>
    <x:String x:Key="Loc.P.QRCode.CC4">위 QR 코드의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.QRCode.CC5">ViewModel 바인딩으로 QRCode를 생성하고 갱신합니다.</x:String>
    <x:String x:Key="Loc.P.QRCode.Body1">Text — QR 행렬에 인코딩할 내용</x:String>
    <x:String x:Key="Loc.P.QRCode.Body2">ErrorCorrectionLevel — 복원력 요구에 따라 L, M, Q, H 중 선택</x:String>
    <x:String x:Key="Loc.P.QRCode.Body3">QuietZoneModules — 행렬 주위 여백의 폭을 제어</x:String>
    <x:String x:Key="Loc.P.QRCode.Body4">Foreground / Background / Padding / CornerRadius — 표시 면의 스타일 지정</x:String>
    <x:String x:Key="Loc.P.QRCode.Cap1">모바일 친화적인 링크에 잘 맞습니다.</x:String>
    <x:String x:Key="Loc.P.QRCode.Cap2">설정 정보를 인코딩해 두면 스캔만으로 연결됩니다.</x:String>
    <x:String x:Key="Loc.P.QRCode.Cap3">간결한 연락처 정보를 공유합니다.</x:String>
    <x:String x:Key="Loc.P.QRCode.Val1">문서 URL</x:String>
    <x:String x:Key="Loc.P.QRCode.Val2">Wi-Fi 연결 설정</x:String>
    <x:String x:Key="Loc.P.QRCode.Val3">연락처 카드</x:String>

    <!-- RadioButton -->
    <x:String x:Key="Loc.P.RadioButton.Title1">RadioButton</x:String>
    <x:String x:Key="Loc.P.RadioButton.Sub1">사용자가 선택할 수는 있지만 해제할 수는 없는 버튼입니다. 같은 그룹의 RadioButton은 서로 배타적입니다.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC1">좋아하는 색을 고르세요. 같은 그룹의 선택지는 서로 배타적입니다.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CT1">그룹으로 묶은 RadioButton</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC2">서로 다른 그룹으로 나눈 RadioButton은 각자 독립적으로 선택 상태를 유지합니다.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC3">위 RadioButton 그룹의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.RadioButton.CC4">코드 비하인드에서 Checked 이벤트를 연결하고 라디오 그룹을 만듭니다.</x:String>
    <x:String x:Key="Loc.P.RadioButton.Val1">크기</x:String>
    <x:String x:Key="Loc.P.RadioButton.Val2">속도</x:String>

    <!-- RangeSlider -->
    <x:String x:Key="Loc.P.RangeSlider.Title1">RangeSlider</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Sub1">손잡이가 두 개인 슬라이더로, 숫자 범위 안에서 연속된 부분 구간을 고를 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC1">어느 손잡이를 끌어도 RangeStart / RangeEnd가 바뀝니다. 트랙을 클릭하면 가까운 손잡이가 이동하고 Tab 키로 두 손잡이 사이의 포커스를 옮깁니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CT1">최소 간격(MinimumRange)</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC2">두 손잡이는 MinimumRange보다 가까워지지 않습니다. 하한과 상한을 반드시 떨어뜨려야 하는 가격 필터에 유용합니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CT2">사용자 지정 범위</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC3">IsSnapToTickEnabled가 true이면 두 손잡이 모두 TickFrequency에 맞춰 붙습니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC4">TrackMode=&quot;Segmented&quot;는 트랙을 TickFrequency 간격의 알약 모양으로 나눕니다. 두 손잡이 사이의 구간에는 채움 브러시가 적용되고 SegmentGap이 간격을 정합니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC5">RangeSlider는 음수를 포함한 어떤 숫자 영역에도 쓸 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC6">위 RangeSlider의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.CC7">코드 비하인드에서 RangeStartChanged / RangeEndChanged를 연결하고 RangeSlider를 만듭니다.</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap1">MinimumRange = 10</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap2">TickFrequency = 20, 맞춤 적용</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap3">TickFrequency = 10과 SegmentGap = 2 — 구간이 간격을 유지할 수 있는 한 더 촘촘한 단계도 알아보기 쉽습니다</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap4">가격 필터($0 — $1000)</x:String>
    <x:String x:Key="Loc.P.RangeSlider.Cap5">쾌적 온도 구간(-20 — 40°C)</x:String>

    <!-- RazorDemo -->
    <x:String x:Key="Loc.P.RazorDemo.Title1">Razor 구문</x:String>
    <x:String x:Key="Loc.P.RazorDemo.Sub1">Razor 지시문은 C# 반복문, 조건문, 식을 JALXAML 마크업에 직접 넣어, 로드 시점에 실제 코드로 UI를 만들고 바인딩합니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC1">C# 식을 그 자리에서 계산합니다. 삼항 연산자, 산술, 메서드 호출을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC2">고전적인 C 스타일 for 반복문으로 요소를 반복 생성합니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC3">컬렉션을 순회하며 자식 요소를 생성합니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC4">switch 식에 따라 서로 다른 요소를 그립니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC5">지역 함수, 변수, 마크업 출력을 섞은 C# 코드 블록을 실행합니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC6">마크업 생성을 try/catch로 감싸 안전하게 실행합니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC7">for 반복문과 삼항 식을 결합해 스타일이 적용된 사각형을 만듭니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC8">do-while 반복문으로 요소를 생성합니다(최소 한 번은 실행).</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC9">$. 접두사로 컨트롤 자신의 속성에 접근합니다. RelativeSource Self 바인딩과 같습니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC10">#. 접두사로 DataContext 모델에 직접 접근합니다. 항목마다 DataContext를 갖는 ItemTemplate에 알맞습니다.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC11">위 모든 Razor 지시문을 담은 완전한 JALXAML 마크업.</x:String>
    <x:String x:Key="Loc.P.RazorDemo.CC12">독립된 ViewModel과 AOT에 안전한 속성 접근자.</x:String>

    <!-- RazorVirtualize -->
    <x:String x:Key="Loc.P.RazorVirtualize.Sub1">가상화 목록으로 낮춰지는 데이터 바인딩 반복문입니다. 요소는 전체 데이터가 아니라 보이는 창 만큼만 만들어지고, 스크롤 중에는 컨테이너를 재사용하며 컬렉션 변경도 따라갑니다.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CC1">원본에는 실제로 10만 행이 있습니다. 요소로 존재하는 것은 보이는 행뿐이라 목록이 즉시 나타나고 전속력으로 스크롤됩니다.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CT1">2. 컬렉션을 따라갑니다</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CT2">3. 숫자 형태</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CC2">세는 반복문도 가상화됩니다. 상한은 식이므로 바꾸면 시퀀스가 다시 게시되며 실체화되지 않습니다.</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CT3">4. 언제 무엇을 쓸까</x:String>
    <x:String x:Key="Loc.P.RazorVirtualize.CC3">기억해 둘 규칙이 두 가지 있습니다. 반복문 본문이 항목 템플릿이 되므로 단일 요소여야 합니다. 여러 개라면 컨테이너로 감싸세요. 또한 가상화에는 경계가 있는 스크롤 축이 필요합니다. 블록을 ScrollViewer 바로 안에 두거나 명시적인 Height를 주세요. 둘 다 아니면 렌더링은 올바르지만 가상화 이점이 없고, 그 사실이 추적 로그에 표시됩니다.</x:String>

    <!-- RepeatButton -->
    <x:String x:Key="Loc.P.RepeatButton.Title1">RepeatButton</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Sub1">누르고 있는 동안 Click 이벤트를 반복해서 일으키는 버튼입니다. 스테퍼, 스피너, 스크롤 반복에 알맞고 초기 지연과 반복 간격을 설정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC1">버튼을 누르고 있으면 동작이 계속 반복됩니다. 누르는 동안 카운터가 계속 바뀝니다.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC2">RepeatButton이 일반 버튼과 다른 점.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC3">카운터와 음량 조절 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.CC4">명령을 통해 반복 실행되는 동작을 독립된 ViewModel에 둡니다.</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body1">• 누르는 동안 클릭 이벤트가 계속 발생</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body2">• 초기 지연 설정 가능</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body3">• 반복 간격 설정 가능</x:String>
    <x:String x:Key="Loc.P.RepeatButton.Body4">• 스크롤 막대와 스피너에 적합</x:String>

    <!-- Ribbon -->
    <x:String x:Key="Loc.P.Ribbon.Title1">Ribbon</x:String>
    <x:String x:Key="Loc.P.Ribbon.Sub1">Office 스타일 리본 컨트롤로 탭, 그룹, 갤러리, 애플리케이션 메뉴, 빠른 실행 도구 모음을 갖췄습니다.</x:String>
    <x:String x:Key="Loc.P.Ribbon.CT1">실시간 Ribbon</x:String>
    <x:String x:Key="Loc.P.Ribbon.CC1">탭, 그룹, 버튼을 갖춘 완전한 리본입니다. 명령을 클릭하면 아래에 결과가 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.Ribbon.CT2">Ribbon 옵션</x:String>
    <x:String x:Key="Loc.P.Ribbon.CC2">실행 중에 리본의 각 기능을 전환합니다.</x:String>
    <x:String x:Key="Loc.P.Ribbon.CT3">Ribbon 구성 요소</x:String>
    <x:String x:Key="Loc.P.Ribbon.CC3">Ribbon 컨트롤은 여러 하위 컨트롤로 구성됩니다.</x:String>
    <x:String x:Key="Loc.P.Ribbon.CC4">리본과 탭·그룹을 구성하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Ribbon.CC5">코드 비하인드에서 리본 속성을 읽고 명령을 연결합니다.</x:String>
    <x:String x:Key="Loc.P.Ribbon.Body1">Ribbon — Title, ApplicationMenu, QuickAccessToolBar를 가진 최상위 컨테이너</x:String>
    <x:String x:Key="Loc.P.Ribbon.Body2">RibbonTab — 탭 페이지(Header, ContextualTabGroupHeader)</x:String>
    <x:String x:Key="Loc.P.Ribbon.Body3">RibbonGroup — 탭 안의 논리 그룹(Header, 이미지)</x:String>
    <x:String x:Key="Loc.P.Ribbon.Body4">RibbonApplicationMenu — 백스테이지 메뉴(FooterPane, AuxiliaryPane)</x:String>
    <x:String x:Key="Loc.P.Ribbon.Body5">RibbonQuickAccessToolBar — 자주 쓰는 명령 도구 모음</x:String>
    <x:String x:Key="Loc.P.Ribbon.Body6">RibbonGallery — 범주가 있는 시각적 선택 갤러리</x:String>

    <!-- RichTextBox -->
    <x:String x:Key="Loc.P.RichTextBox.Title1">RichTextBox</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Sub1">서식 있는 텍스트 문서를 편집하고 표시하는 컨트롤로, 굵게·기울임·글꼴·크기·색 같은 인라인 서식을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CT1">기본 RichTextBox</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC1">서식 있는 텍스트를 위한 리치 텍스트 편집기.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CT2">서식 도구 모음이 있는 RichTextBox</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC2">서식 도구 모음과 문서 영역을 짝지은 흔한 텍스트 편집기 구성.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC3">RichTextBox는 서식 있는 콘텐츠를 읽기 전용으로 표시하는 데도 쓸 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC4">RichTextBox는 다양한 작성 상황에서 유용합니다.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC5">위 RichTextBox 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.CC6">코드 비하인드에서 FlowDocument를 만들고 선택 영역에 서식을 적용합니다.</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Body1">• 문서 편집</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Body2">• 메일 작성</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Body3">• 메모 앱</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Body4">• 콘텐츠 관리 시스템</x:String>
    <x:String x:Key="Loc.P.RichTextBox.Body5">• 보고서 생성기</x:String>

    <!-- SankeyDiagram -->
    <x:String x:Key="Loc.P.SankeyDiagram.Title1">SankeyDiagram</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.Sub1">노드 크기를 양에 비례시키고 곡선 링크로 흐름을 시각화하는 다이어그램 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CT1">기본 생키 다이어그램</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CC1">공급, 변환, 소비 노드로 이루어진 간단한 에너지 흐름도.</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CT2">다층 흐름</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CC2">4개 층으로 웹사이트 사용자 여정 퍼널을 보여 주는 생키 다이어그램.</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CT3">사용자 지정</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CC3">노드 색과 레이블을 사용자 지정하고 값 표시를 켠 생키 다이어그램.</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CC4">마크업에서 SankeyDiagram을 선언하고 레이블·값·외형을 설정합니다.</x:String>
    <x:String x:Key="Loc.P.SankeyDiagram.CC5">ViewModel이 흐름 노드와 링크를 갖고 XAML이 표시 옵션을 맡습니다.</x:String>

    <!-- ScatterPlot -->
    <x:String x:Key="Loc.P.ScatterPlot.Title1">ScatterPlot</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.Sub1">데이터를 산점도로 표시하며 여러 점 모양, 버블 크기, 추세선을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CT1">기본 산점도</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CC1">원형 표식과 무작위 데이터 점으로 그린 산점도.</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CT2">버블 차트</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CC2">점 크기를 달리해 세 번째 데이터 차원을 나타내는 산점도.</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CT3">추세선</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CC3">선형 추세선을 겹쳐 데이터 상관관계를 보여 주는 산점도.</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CC4">계열, 버블 크기, 추세선을 포함한 산점도의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ScatterPlot.CC5">ViewModel이 결정적인 샘플 컬렉션을 갖고 XAML이 계열과 렌더링 옵션을 선언합니다.</x:String>

    <!-- ScrollViewer -->
    <x:String x:Key="Loc.P.ScrollViewer.Title1">ScrollViewer</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Sub1">콘텐츠를 고정 뷰포트로 잘라 내는 컨테이너로, 스크롤 막대·휠·터치로 넘치는 부분을 훑어볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.BounceHint">macOS에서 두 손가락으로 경계를 당겼다가 놓으면 제자리로 돌아옵니다. 아래 버튼으로 미리 볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.PullEdge">위쪽 경계 당기기</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.ReleaseEdge">놓아서 되돌리기</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.HorizontalTitle">가로 스크롤</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.HorizontalHint">두 손가락으로 좌우로 밀거나 아래 스크롤 막대를 드래그하세요. 버튼으로도 이동할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.ScrollLeft">왼쪽으로 스크롤</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.ScrollRight">오른쪽으로 스크롤</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CT1">세로 스크롤</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CC1">보이는 영역을 넘는 콘텐츠는 세로로 스크롤할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CT2">스크롤 막대 표시 옵션</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CC2">각 축에서 스크롤 막대가 언제 나타날지 제어합니다.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CT3">주요 속성</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CC3">스크롤 상태를 읽고 제어하는 데 중요한 ScrollViewer 속성.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CC4">흔한 ScrollViewer 설정을 보여 주는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.CC5">코드 비하인드에서 ScrollViewer를 만들고 스크롤 이벤트에 반응합니다.</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body1">Auto — 필요할 때만 스크롤 막대 표시</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body2">Visible — 항상 스크롤 막대 표시</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body3">Hidden — 스크롤은 가능하지만 막대는 숨김</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body4">Disabled — 스크롤 금지</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body5">세로 스크롤 막대 제어</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body6">가로 스크롤 막대 제어</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body7">현재 세로 스크롤 위치</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body8">현재 가로 스크롤 위치</x:String>
    <x:String x:Key="Loc.P.ScrollViewer.Body9">보이는 영역의 크기</x:String>

    <!-- SectionDemo -->
    <x:String x:Key="Loc.P.SectionDemo.Title1">Section</x:String>
    <x:String x:Key="Loc.P.SectionDemo.CT1">구역을 사용한 내비게이션 레이아웃</x:String>
    <x:String x:Key="Loc.P.SectionDemo.CC1">같은 구역을 여러 위치에 그릴 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.SectionDemo.CT2">구역을 여러 번 재사용하기</x:String>
    <x:String x:Key="Loc.P.SectionDemo.CC2">구역을 정의하고 내비게이션 레이아웃에 그리는 선언형 JALXAML.</x:String>
    <x:String x:Key="Loc.P.SectionDemo.CT3">구문 참고</x:String>
    <x:String x:Key="Loc.P.SectionDemo.CC3">마크업에서 선언한 구역은 자동으로 등록됩니다. 페이지 범위의 구역은 언로드 시 등록을 해제하세요.</x:String>

    <!-- Separator -->
    <x:String x:Key="Loc.P.Separator.Title1">Separator</x:String>
    <x:String x:Key="Loc.P.Separator.Sub1">메뉴, 도구 모음 등 레이아웃에서 내용을 나누는 시각적 구분선입니다.</x:String>
    <x:String x:Key="Loc.P.Separator.CT1">콘텐츠 사이에</x:String>
    <x:String x:Key="Loc.P.Separator.CC1">세로로 쌓인 블록 사이에 Separator를 두어 깔끔한 구분선을 그립니다.</x:String>
    <x:String x:Key="Loc.P.Separator.CT2">메뉴 안에서</x:String>
    <x:String x:Key="Loc.P.Separator.CC2">구분선은 메뉴, 플라이아웃, 명령 목록에서 관련 명령을 묶어 줍니다.</x:String>
    <x:String x:Key="Loc.P.Separator.CC3">Separator가 메뉴, 도구 모음, 세로 레이아웃에 더해 주는 것.</x:String>
    <x:String x:Key="Loc.P.Separator.CC4">콘텐츠 사이, 메뉴 안, 도구 모음 안 구분선의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Separator.CC5">코드 비하인드에서 구분선을 만들고 설정 패널을 구성합니다.</x:String>
    <x:String x:Key="Loc.P.Separator.Body1">• 콘텐츠를 시각적으로 나눔</x:String>
    <x:String x:Key="Loc.P.Separator.Body2">• 메뉴, 도구 모음, 상태 표시줄에서 사용 가능</x:String>
    <x:String x:Key="Loc.P.Separator.Body3">• 가로 또는 세로 방향 지원</x:String>

    <!-- ShaderEffects -->
    <x:String x:Key="Loc.P.ShaderEffects.Title1">셰이더 효과</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Sub1">WPF 호환 셰이더 효과 체계로 BlurEffect, DropShadowEffect, 사용자 지정 ShaderEffect를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CT1">BlurEffect</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CC1">가우시안 흐림을 적용하며 KernelType과 RenderingBias 설정을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CT2">DropShadowEffect</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CC2">요소 뒤에 그림자를 더합니다. 색, 흐림 반경, 방향, 깊이를 설정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CT3">사용자 지정 ShaderEffect</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CC3">SourceHlsl로 HLSL을 작성하고 실시간 미리보기를 조절합니다. 상수는 b0, 캡처한 콘텐츠는 t0와 s0를 사용합니다.</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui1">반전 강도</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui2">HLSL 미리보기</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui3">흐림 반경:</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui4">그림자 깊이:</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui5">흐림 미리보기</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui6">그림자 미리보기</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.Ui7">박스 블러</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CC4">위 효과 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ShaderEffects.CC5">효과 매개변수는 ViewModel에서 바인딩합니다.</x:String>

    <!-- Shapes -->
    <x:String x:Key="Loc.P.Shapes.Title1">도형</x:String>
    <x:String x:Key="Loc.P.Shapes.Sub1">벡터 기본 도형(직사각형, 타원, 선, 다각형, 꺾은선, 패스)으로 해상도에 구애받지 않는 선명한 그래픽을 그립니다.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT1">Rectangle</x:String>
    <x:String x:Key="Loc.P.Shapes.CC1">기본 직사각형이며 둥근 모서리와 선을 지정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT2">Ellipse</x:String>
    <x:String x:Key="Loc.P.Shapes.CC2">타원이며 너비와 높이가 같으면 원이 됩니다.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT3">Line</x:String>
    <x:String x:Key="Loc.P.Shapes.CC3">두 점을 잇는 직선이며 파선 패턴도 지정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT4">Polygon</x:String>
    <x:String x:Key="Loc.P.Shapes.CC4">이어진 점들로 만들어지는 닫힌 도형.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT5">Polyline</x:String>
    <x:String x:Key="Loc.P.Shapes.CC5">이어진 선분들의 연속이며 닫히지 않습니다.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT6">Path</x:String>
    <x:String x:Key="Loc.P.Shapes.CC6">패스 기하 데이터로 기술하는 복잡한 도형.</x:String>
    <x:String x:Key="Loc.P.Shapes.CT7">도형 조합 예제</x:String>
    <x:String x:Key="Loc.P.Shapes.CC7">도형을 캔버스 위에 겹쳐 더 풍부한 그래픽을 구성할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Shapes.CC8">위 도형들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Shapes.CC9">코드 비하인드에서 프로그래밍 방식으로 도형을 만들고 설정합니다.</x:String>

    <!-- ShellIntegration -->
    <x:String x:Key="Loc.P.ShellIntegration.Title1">셸 통합</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Sub1">Windows 셸과의 통합으로 WindowChrome, JumpList, 작업 표시줄 기능을 다룹니다.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT1">WindowChrome</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC1">DWM 합성을 지원하면서 창 프레임 외형을 사용자 지정합니다.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT2">JumpList</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC2">Windows 7 이상의 작업 표시줄 점프 목록으로, 작업과 최근 항목을 다룹니다.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT3">TaskbarItemInfo</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC3">작업 표시줄 축소판, 진행률 표시기, 오버레이 아이콘을 제어합니다.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CT4">SystemParameters2</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC4">시스템 메트릭과 DWM 상태 정보에 접근합니다.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC5">Window에 WindowChrome과 TaskbarItemInfo를 적용하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.CC6">코드 비하인드에서 창 프레임, 점프 목록, 작업 표시줄 진행률을 설정하고 시스템 매개변수를 읽습니다.</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body1">CaptionHeight: 제목 표시줄 높이</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body2">ResizeBorderThickness: 크기 조절 손잡이 두께</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body3">GlassFrameThickness: DWM 유리 프레임 범위</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body4">CornerRadius: 창 모서리 둥글기</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body5">UseAeroCaptionButtons: 시스템 단추 사용</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body6">JumpTask: 인수와 함께 앱 실행</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body7">JumpPath: 특정 파일 열기</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Body8">사용자 지정 범주: 항목을 함께 묶기</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Val1">JumpList 항목</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Val2">진행률</x:String>
    <x:String x:Key="Loc.P.ShellIntegration.Val3">진행 상태</x:String>

    <!-- Slider -->
    <x:String x:Key="Loc.P.Slider.Title1">Slider</x:String>
    <x:String x:Key="Loc.P.Slider.Sub1">손잡이를 트랙에서 끌어 범위 안의 값을 고르는 컨트롤로, 눈금과 맞춤도 지정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Slider.CC1">손잡이를 끌어 값을 바꾸면 표시가 즉시 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.Slider.CT1">눈금이 있는 Slider</x:String>
    <x:String x:Key="Loc.P.Slider.CC2">일정한 TickFrequency로 놓인 눈금이 트랙 위의 멈춤 지점을 알려 줍니다.</x:String>
    <x:String x:Key="Loc.P.Slider.CT2">사용자 지정 범위</x:String>
    <x:String x:Key="Loc.P.Slider.CC3">IsSnapToTickEnabled를 켜면 끄는 동안 손잡이가 가장 가까운 눈금에 달라붙습니다.</x:String>
    <x:String x:Key="Loc.P.Slider.CC4">TrackMode=&quot;Segmented&quot;는 트랙을 눈금 간격마다 알약 모양으로 나눕니다. 멈춤 지점은 Ticks가 있으면 그것을, 없으면 TickFrequency를 쓰며 간격은 SegmentGap이 정합니다.</x:String>
    <x:String x:Key="Loc.P.Slider.CC5">바인딩한 데이터에 맞춰 Minimum과 Maximum에 음수 범위를 포함한 어떤 값도 지정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Slider.CC6">위 슬라이더들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Slider.CC7">코드 비하인드에서 ValueChanged를 처리하고 슬라이더를 만듭니다.</x:String>
    <x:String x:Key="Loc.P.Slider.Cap1">TickFrequency = 20, 맞춤 적용 — 값은 항상 구간 경계에 놓입니다</x:String>
    <x:String x:Key="Loc.P.Slider.Cap2">맞춤을 끄면 손잡이가 있는 구간이 비례해서 채워집니다</x:String>
    <x:String x:Key="Loc.P.Slider.Cap3">Ticks = 10, 30, 60으로 불균등한 멈춤 지점을 두고 SegmentGap을 넓힌 예</x:String>
    <x:String x:Key="Loc.P.Slider.Val1">음량(0-100)</x:String>
    <x:String x:Key="Loc.P.Slider.Val2">온도(-10 ~ 40)</x:String>

    <!-- Sparkline -->
    <x:String x:Key="Loc.P.Sparkline.Title1">Sparkline</x:String>
    <x:String x:Key="Loc.P.Sparkline.Sub1">데이터 계열을 단어 크기로 압축하는 가벼운 인라인 차트로, 축·눈금선·범례를 그리지 않습니다.</x:String>
    <x:String x:Key="Loc.P.Sparkline.CT1">선형 스파크라인</x:String>
    <x:String x:Key="Loc.P.Sparkline.CC1">Line 유형을 쓰고 최고·최저점 표식을 붙인 여러 스파크라인.</x:String>
    <x:String x:Key="Loc.P.Sparkline.CT2">막대와 영역</x:String>
    <x:String x:Key="Loc.P.Sparkline.CC2">막대 차트와 영역 채우기로 그린 스파크라인.</x:String>
    <x:String x:Key="Loc.P.Sparkline.CT3">승패</x:String>
    <x:String x:Key="Loc.P.Sparkline.CC3">승패 스파크라인으로 긍정·부정 결과를 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.Sparkline.CC4">위 스파크라인 변형들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Sparkline.CC5">ViewModel이 결정적인 계열을 제공하고 모든 Sparkline 변형은 XAML에서 선언합니다.</x:String>

    <!-- SplitButton -->
    <x:String x:Key="Loc.P.SplitButton.Title1">SplitButton</x:String>
    <x:String x:Key="Loc.P.SplitButton.Sub1">주요 동작과 Flyout을 여는 드롭다운 단추를 함께 가진 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.SplitButton.CT1">기본 SplitButton</x:String>
    <x:String x:Key="Loc.P.SplitButton.CC1">주 영역을 클릭하면 동작을 실행하고 드롭다운에서 대상을 고릅니다.</x:String>
    <x:String x:Key="Loc.P.SplitButton.CT2">Command와 Flyout</x:String>
    <x:String x:Key="Loc.P.SplitButton.CC2">Command/CommandParameter와 플라이아웃 상태를 코드로 제어하는 방법을 보여 줍니다.</x:String>
    <x:String x:Key="Loc.P.SplitButton.CC3">위 SplitButton의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.SplitButton.CC4">주요 동작과 플라이아웃 동작은 각각 독립된 ViewModel 명령입니다.</x:String>

    <!-- Splitter -->
    <x:String x:Key="Loc.P.Splitter.Title1">Splitter</x:String>
    <x:String x:Key="Loc.P.Splitter.Sub1">격자 셀 사이의 GridSplitter를 끌어 인접 패널 크기를 조절합니다. 가변 열·행과 IDE 형태 레이아웃의 기본 구성 요소입니다.</x:String>
    <x:String x:Key="Loc.P.Splitter.CT1">가로 방향 분할선</x:String>
    <x:String x:Key="Loc.P.Splitter.CC1">세로 막대를 끌어 왼쪽과 오른쪽 패널 크기를 조절합니다.</x:String>
    <x:String x:Key="Loc.P.Splitter.CT2">세로 방향 분할선</x:String>
    <x:String x:Key="Loc.P.Splitter.CC2">가로 막대를 끌어 위아래 패널 크기를 조절합니다.</x:String>
    <x:String x:Key="Loc.P.Splitter.CT3">다중 패널 레이아웃</x:String>
    <x:String x:Key="Loc.P.Splitter.CC3">여러 분할선을 조합해 사이드바와 세로로 쌓은 콘텐츠·콘솔로 IDE 형태의 작업 공간을 만듭니다.</x:String>
    <x:String x:Key="Loc.P.Splitter.CC4">분할선은 일상적인 데스크톱 앱에서 흔히 보는 크기 조절 레이아웃을 뒷받침합니다.</x:String>
    <x:String x:Key="Loc.P.Splitter.CC5">위 분할 레이아웃의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Splitter.CC6">코드 비하인드에서 GridSplitter로 크기 조절 가능한 IDE 형태 레이아웃을 만듭니다.</x:String>

    <!-- StackPanel -->
    <x:String x:Key="Loc.P.StackPanel.Title1">StackPanel</x:String>
    <x:String x:Key="Loc.P.StackPanel.Sub1">자식 요소를 한 줄로 배치하는 패널로, 위에서 아래로 세로로 쌓거나 왼쪽에서 오른쪽으로 가로로 놓습니다.</x:String>
    <x:String x:Key="Loc.P.StackPanel.CT1">세로 StackPanel</x:String>
    <x:String x:Key="Loc.P.StackPanel.CC1">자식 요소를 위에서 아래로 배치합니다.</x:String>
    <x:String x:Key="Loc.P.StackPanel.CT2">가로 StackPanel</x:String>
    <x:String x:Key="Loc.P.StackPanel.CC2">자식 요소를 왼쪽에서 오른쪽으로 배치합니다.</x:String>
    <x:String x:Key="Loc.P.StackPanel.CT3">중첩 StackPanel</x:String>
    <x:String x:Key="Loc.P.StackPanel.CC3">세로와 가로 레이아웃을 조합합니다.</x:String>
    <x:String x:Key="Loc.P.StackPanel.CC4">위 레이아웃의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.StackPanel.CC5">코드 비하인드에서 StackPanel을 만들고 자식 요소를 추가합니다.</x:String>

    <!-- StandardUICommand -->
    <x:String x:Key="Loc.P.StandardUICommand.Title1">StandardUICommand</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.Sub1">자주 쓰는 동작을 위해 미리 정의된 명령으로, 표준 레이블·아이콘·단축키·설명을 갖췄습니다.</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.CT1">표준 명령</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.CC1">잘라내기, 복사, 붙여넣기, 삭제 등 기본 제공 명령 정의와 표준 속성.</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.CT2">명령 실행</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.CC2">위 명령 단추를 클릭하면 실행되고 결과가 아래에 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.CC3">표준 명령을 명령 막대에 바인딩하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.StandardUICommand.CC4">ViewModel에서 StandardUICommand를 만들고 실행을 애플리케이션 명령에 위임합니다.</x:String>

    <!-- StatusBar -->
    <x:String x:Key="Loc.P.StatusBar.Title1">StatusBar</x:String>
    <x:String x:Key="Loc.P.StatusBar.Sub1">창 아래쪽을 따라 상태 정보(커서 위치, 인코딩, 진행률 등)를 보여 주는 가로 막대입니다.</x:String>
    <x:String x:Key="Loc.P.StatusBar.CC1">구분선으로 나눈 상태 항목을 편집기 창 아래쪽에 두는 방식 그대로 배치했습니다.</x:String>
    <x:String x:Key="Loc.P.StatusBar.CC2">StatusBar 컨트롤이 기본으로 제공하는 것.</x:String>
    <x:String x:Key="Loc.P.StatusBar.CC3">위 상태 표시줄의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.StatusBar.CC4">편집기 캐럿 위치가 바뀔 때 코드 비하인드에서 상태 항목을 갱신합니다.</x:String>
    <x:String x:Key="Loc.P.StatusBar.Body1">• 구분선으로 나뉜 여러 상태 항목</x:String>
    <x:String x:Key="Loc.P.StatusBar.Body2">• 어떤 콘텐츠든 담을 수 있음</x:String>
    <x:String x:Key="Loc.P.StatusBar.Body3">• 보통 창 아래쪽에 배치</x:String>
    <x:String x:Key="Loc.P.StatusBar.Body4">• 진행률 표시기 지원</x:String>

    <!-- SwipeControl -->
    <x:String x:Key="Loc.P.SwipeControl.Title1">SwipeControl</x:String>
    <x:String x:Key="Loc.P.SwipeControl.Sub1">터치 친화적인 컨트롤로, 목록 항목을 밀어 보관·삭제·플래그 같은 상황별 동작을 드러냅니다.</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CT1">밀어서 표시</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CC1">항목을 좌우로 밀면 보관, 삭제 같은 상황별 동작이 나타납니다.</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CT2">밀기 동작 로그</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CC2">위 밀기 항목을 조작하면 결과가 여기에 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CC3">좌우 동작을 갖춘 밀기 컨트롤의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.SwipeControl.CC4">템플릿으로 만든 각 행이 서로 독립된 ViewModel 명령을 노출합니다.</x:String>

    <!-- SystemNotification -->
    <x:String x:Key="Loc.P.SystemNotification.Title1">SystemNotification</x:String>
    <x:String x:Key="Loc.P.SystemNotification.Sub1">SystemNotificationManager로 OS 네이티브 알림을 보냅니다. 제목, 본문, 동작 단추, 우선순위, 활성화 콜백을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CT1">기본 알림</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC1">제목과 본문만 담은 간단한 시스템 알림을 보냅니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CT2">우선순위</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC2">알림은 서로 다른 우선순위로 보낼 수 있고 그에 따라 전달 동작이 달라집니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CT3">동작이 있는 알림</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC3">알림에 동작 단추를 더합니다. 사용자가 알림이나 동작 단추를 클릭하면 Activated 이벤트가 발생합니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CT4">고급 옵션</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC4">알림 만료 시간, 무음 모드, 교체용 tag/group을 설정하고 기존 알림을 관리합니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CT5">플랫폼 지원</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC5">시스템 알림 사용 가능 여부는 현재 플랫폼에 달려 있습니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC6">알림은 코드로만 보낼 수 있습니다. 마크업에서는 트리거 단추를 선언하고 관리자는 코드 비하인드에서 다룹니다.</x:String>
    <x:String x:Key="Loc.P.SystemNotification.CC7">관리자를 초기화하고 NotificationContent를 구성해 보낸 뒤 활성화와 해제를 처리합니다.</x:String>

    <!-- TabControl -->
    <x:String x:Key="Loc.P.TabControl.Title1">TabControl</x:String>
    <x:String x:Key="Loc.P.TabControl.Sub1">여러 항목이 같은 영역을 공유하고 탭 줄로 전환할 수 있는 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.TabControl.CT1">기본 TabControl</x:String>
    <x:String x:Key="Loc.P.TabControl.CC1">여러 탭을 가진 간단한 TabControl.</x:String>
    <x:String x:Key="Loc.P.TabControl.CT2">탭을 아래에 배치</x:String>
    <x:String x:Key="Loc.P.TabControl.CC2">탭을 컨트롤 아래쪽에 배치합니다.</x:String>
    <x:String x:Key="Loc.P.TabControl.CC3">선택한 인덱스와 상태는 ViewModel이 갖습니다.</x:String>
    <x:String x:Key="Loc.P.TabControl.CC4">위 탭 컨트롤의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TabControl.CC5">탭은 마크업에서 선언하고 선택 상태와 상태 문구는 ViewModel에 바인딩합니다.</x:String>

    <!-- Terminal -->
    <x:String x:Key="Loc.P.Terminal.Title1">Terminal</x:String>
    <x:String x:Key="Loc.P.Terminal.Sub1">VT100/ANSI 이스케이프 시퀀스, 셸 프로세스 연동, 키보드와 IME 입력을 모두 지원하는 터미널 에뮬레이터 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.Terminal.CT1">대화형 터미널</x:String>
    <x:String x:Key="Loc.P.Terminal.CC1">완전한 셸 터미널입니다. 명령을 입력해 시스템 셸과 상호작용할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.Terminal.CC2">명령으로 표시 상태를 조절하고 터미널 동작을 실행합니다.</x:String>
    <x:String x:Key="Loc.P.Terminal.CT2">프로그래밍 방식 출력</x:String>
    <x:String x:Key="Loc.P.Terminal.CC3">ViewModel 요청으로 ANSI 콘텐츠를 쓰고 터미널 동작이 이를 이어 줍니다.</x:String>
    <x:String x:Key="Loc.P.Terminal.CC4">위 터미널의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Terminal.CC5">터미널 상태와 동작은 ViewModel이 구현합니다.</x:String>

    <!-- TextBlock -->
    <x:String x:Key="Loc.P.TextBlock.Title1">TextBlock</x:String>
    <x:String x:Key="Loc.P.TextBlock.Sub1">가벼운 읽기 전용 텍스트 표시 컨트롤로 글꼴 크기, 굵기, 줄 바꿈, 말줄임을 제어합니다.</x:String>
    <x:String x:Key="Loc.P.TextBlock.CT1">기본 TextBlock</x:String>
    <x:String x:Key="Loc.P.TextBlock.CC1">기본 스타일을 쓴 간단한 텍스트 표시.</x:String>
    <x:String x:Key="Loc.P.TextBlock.CT2">글꼴 크기</x:String>
    <x:String x:Key="Loc.P.TextBlock.CC2">캡션부터 디스플레이까지 다양한 글꼴 크기 변형.</x:String>
    <x:String x:Key="Loc.P.TextBlock.CT3">텍스트 줄 바꿈</x:String>
    <x:String x:Key="Loc.P.TextBlock.CC3">긴 텍스트는 사용 가능한 너비를 넘으면 자동으로 다음 줄로 넘어갑니다.</x:String>
    <x:String x:Key="Loc.P.TextBlock.CC4">위 텍스트 예제의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TextBlock.CC5">코드 비하인드에서 TextBlock을 만들고 갱신합니다.</x:String>

    <!-- TextBox -->
    <x:String x:Key="Loc.P.TextBox.Title1">TextBox</x:String>
    <x:String x:Key="Loc.P.TextBox.Sub1">일반 텍스트를 입력하고 편집하는 한 줄 컨트롤로, 미리 채운 값과 비활성 상태, 클립보드 조작, 표준 편집 단축키를 지원합니다.</x:String>
    <x:String x:Key="Loc.P.TextBox.CT1">기본 TextBox</x:String>
    <x:String x:Key="Loc.P.TextBox.CC1">비어 있거나 미리 채운 텍스트로 쓰는 표준 텍스트 입력.</x:String>
    <x:String x:Key="Loc.P.TextBox.CT2">TextBox 상태</x:String>
    <x:String x:Key="Loc.P.TextBox.CC2">{Shortcut.Copy}로 복사, {Shortcut.Cut}로 잘라내기, {Shortcut.Paste}로 붙여넣기, {Shortcut.SelectAll}로 모두 선택.</x:String>
    <x:String x:Key="Loc.P.TextBox.CT3">클립보드 조작</x:String>
    <x:String x:Key="Loc.P.TextBox.CC3">TextBox가 반응하는 표준 편집 단축키.</x:String>
    <x:String x:Key="Loc.P.TextBox.CC4">위 텍스트 입력의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TextBox.CC5">코드 비하인드에서 텍스트 변경을 처리하고 입력란을 제어합니다.</x:String>
    <x:String x:Key="Loc.P.TextBox.Body1">{Shortcut.SelectAll} — 텍스트 모두 선택</x:String>
    <x:String x:Key="Loc.P.TextBox.Body2">{Shortcut.Copy} — 선택한 텍스트 복사</x:String>
    <x:String x:Key="Loc.P.TextBox.Body3">{Shortcut.Cut} — 선택한 텍스트 잘라내기</x:String>
    <x:String x:Key="Loc.P.TextBox.Body4">{Shortcut.Paste} — 클립보드에서 붙여넣기</x:String>
    <x:String x:Key="Loc.P.TextBox.Body5">{Shortcut.Undo} — 실행 취소</x:String>
    <x:String x:Key="Loc.P.TextBox.Body6">{Shortcut.Redo} — 다시 실행</x:String>
    <x:String x:Key="Loc.P.TextBox.Cap1">원본 TextBox(텍스트를 선택해 복사):</x:String>
    <x:String x:Key="Loc.P.TextBox.CopySample">이 텍스트를 선택하고 {Shortcut.Copy}로 복사</x:String>
    <x:String x:Key="Loc.P.TextBox.Cap2">대상 TextBox({Shortcut.Paste}로 여기에 붙여넣기):</x:String>

    <!-- TextEffectPresenter -->
    <x:String x:Key="Loc.P.TextEffectPresenter.Title1">TextEffectPresenter</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.Sub1">문자 단위로 애니메이션되는 텍스트 면으로, 가사·자막·알림·재미있는 UI에 어울립니다.</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CT1">변경 API</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CC1">각 단추가 프레젠터를 한 번씩 호출합니다. 새 자소가 들어오고 기존 자소는 이동하거나 사라집니다.</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CT2">기본 제공 효과</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CC2">셀 단위 애니메이션 드라이버를 바꿉니다. 각 단추가 텍스트를 다시 등장시켜 전체 등장 애니메이션을 볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CT3">UIElement.Effect와의 합성</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CC3">셀 단위 애니메이션(TextEffect)이 먼저 CPU에서 실행되고, 이어서 면 전체가 GPU 픽셀 셰이더 패스(UIElement.Effect)를 거칩니다. BlurEffect를 켜면 두 계층이 합쳐지는 모습을 볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CC4">데모 호스트 면과 프레젠터에 연결한 변경 단추의 마크업.</x:String>
    <x:String x:Key="Loc.P.TextEffectPresenter.CC5">ViewModel이 텍스트와 명령을 갖고, 첨부 동작이 효과 선택을 프레젠터 API로 옮깁니다.</x:String>

    <!-- ThemeColors -->
    <x:String x:Key="Loc.P.ThemeColors.Title1">테마 색</x:String>
    <x:String x:Key="Loc.P.ThemeColors.Sub1">테마 사전에 등록된 모든 색과 브러시를 살펴봅니다. 미리 보기를 해도 애플리케이션 테마는 바뀌지 않습니다.</x:String>

    <!-- ThemeStudio -->
    <x:String x:Key="Loc.P.ThemeStudio.Eyebrow1">테마 도구</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Title1">테마 스튜디오</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Sub1">실제로 동작하는 컴포넌트 구성을 보며 시맨틱 색과 기하 값을 조정합니다. 각 편집기는 ThemeStudioViewModel과 양방향으로 바인딩됩니다.</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.CT1">실시간 구성</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.CT2">인스펙터</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.CT3">생성된 리소스</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Val1">강조 색</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Val2">표면 색</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Val3">모서리 반경</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Val4">간격</x:String>
    <x:String x:Key="Loc.P.ThemeStudio.Val5">미리 보기 불투명도</x:String>

    <!-- Thumb -->
    <x:String x:Key="Loc.P.Thumb.Title1">Thumb</x:String>
    <x:String x:Key="Loc.P.Thumb.Sub1">끌기 변화량을 알려 주는 끌 수 있는 기본 요소로, Slider와 ScrollBar 손잡이를 떠받치는 부품입니다.</x:String>
    <x:String x:Key="Loc.P.Thumb.CC1">트랙 안에서 손잡이를 가로로 끌면 아래의 위치 표시가 실시간으로 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.Thumb.CC2">Thumb 기본 요소가 제공하는 것.</x:String>
    <x:String x:Key="Loc.P.Thumb.CC3">위 손잡이 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Thumb.CC4">끌기 이벤트를 선언적으로 ViewModel 명령에 연결합니다.</x:String>
    <x:String x:Key="Loc.P.Thumb.Body1">• 마우스 끌기 상호작용</x:String>
    <x:String x:Key="Loc.P.Thumb.Body2">• DragStarted, DragDelta, DragCompleted 이벤트</x:String>
    <x:String x:Key="Loc.P.Thumb.Body3">• 슬라이더 손잡이의 기반</x:String>

    <!-- TimePicker -->
    <x:String x:Key="Loc.P.TimePicker.Title1">TimePicker</x:String>
    <x:String x:Key="Loc.P.TimePicker.Sub1">하루 중 시각을 고르게 하는 컨트롤로, 12시간제와 24시간제를 지원하고 분 단위 간격도 설정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CT1">기본 TimePicker</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC1">클릭하면 플라이아웃이 열려 시각을 고를 수 있습니다. 두 번째는 비활성 상태 예입니다.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CT2">시각 형식</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC2">ClockIdentifier 속성으로 12시간제와 24시간제를 전환합니다.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CT3">분 간격</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC3">MinuteIncrement 속성으로 선택 가능한 분을 일정 간격으로 제한합니다.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC4">시각을 고르면 서식이 적용된 결과가 즉시 갱신됩니다.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC5">알람, 회의, 알림 같은 전형적인 일정 상황.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC6">위 선택기들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TimePicker.CC7">코드 비하인드에서 TimePicker를 만들고 설정합니다.</x:String>

    <!-- TitleBar -->
    <x:String x:Key="Loc.P.TitleBar.Title1">TitleBar</x:String>
    <x:String x:Key="Loc.P.TitleBar.Sub1">사용자 지정 가능한 창 제목 표시줄로, 최소화·최대화·닫기 표준 캡션 단추를 갖추고 실제 창 동작에 연결할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.TitleBar.CC1">표시할 캡션 단추를 전환하고 최대화 상태를 뒤집은 뒤 제목 표시줄을 눌러 상태 줄을 갱신합니다.</x:String>
    <x:String x:Key="Loc.P.TitleBar.CT1">메모</x:String>
    <x:String x:Key="Loc.P.TitleBar.CC2">이 데모가 실제 애플리케이션 창에 어떻게 대응되는지.</x:String>
    <x:String x:Key="Loc.P.TitleBar.CC3">TitleBar와 캡션 단추의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TitleBar.CC4">코드 비하인드에서 TitleBar를 만들고 캡션 이벤트를 연결합니다.</x:String>
    <x:String x:Key="Loc.P.TitleBar.Body1">이 영역은 사용자 지정 제목 표시줄 아래의 창 콘텐츠를 나타냅니다.</x:String>
    <x:String x:Key="Loc.P.TitleBar.Body2">실제 창에서는 이 단추들이 보통 최소화·최대화·닫기 동작에 연결됩니다.</x:String>
    <x:String x:Key="Loc.P.TitleBar.Body3">Window.TitleBarStyle = Custom으로 설정하면 Window가 내장 TitleBar 통합을 사용합니다.</x:String>
    <x:String x:Key="Loc.P.TitleBar.Body4">이 갤러리 페이지는 모든 동작을 로컬에 두고 데모 상태만 갱신합니다.</x:String>

    <!-- ToastNotification -->
    <x:String x:Key="Loc.P.ToastNotification.Title1">ToastNotification</x:String>
    <x:String x:Key="Loc.P.ToastNotification.Sub1">창 모서리에 짧은 메시지를 띄우고 스스로 사라지는 일시적 오버레이 알림으로, 사용자를 방해하지 않습니다.</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CT1">기본 토스트 알림</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CC1">심각도별로 토스트를 띄워 오버레이 호스트에 나타나는 모습을 확인합니다.</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CT2">토스트 미리 보기</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CC2">각 심각도가 토스트 안에서 어떻게 보이는지 보여 주는 정적 예제.</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CT3">동작이 있는 토스트</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CC3">토스트에 동작 단추를 넣을 수 있습니다. 하나를 누르면 처리기의 반응을 볼 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CT4">토스트 설정</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CC4">호스트 위치와 지속 시간을 정하고 닫기 단추와 자동 사라짐을 전환한 뒤 사용자 지정 토스트를 표시합니다.</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CC5">위 토스트 호스트와 미리 보기 항목의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ToastNotification.CC6">토스트 상태와 명령은 ViewModel에 있고 오버레이 호스트는 동작이 이어 줍니다.</x:String>

    <!-- ToggleSwitch -->
    <x:String x:Key="Loc.P.ToggleSwitch.Title1">ToggleSwitch</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.Sub1">켜짐과 꺼짐을 오가는 스위치 컨트롤로, 머리글을 붙일 수 있고 켜짐/꺼짐 콘텐츠도 사용자 지정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.CC1">각 스위치를 조작하면 켜짐/꺼짐 상태가 바뀝니다.</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.CC2">ToggleSwitch 컨트롤이 기본으로 제공하는 기능.</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.CC3">위 스위치들의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.CC4">코드 비하인드에서 Toggled 이벤트를 처리하고 스위치를 만듭니다.</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.Body1">• 켜짐/꺼짐 두 가지 상태</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.Body2">• 켜짐/꺼짐 콘텐츠 사용자 지정 가능</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.Body3">• 머리글 텍스트 지원</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.Body4">• 상태 전환 애니메이션</x:String>
    <x:String x:Key="Loc.P.ToggleSwitch.Body5">• 터치와 마우스 조작 지원</x:String>

    <!-- ToolBar -->
    <x:String x:Key="Loc.P.ToolBar.Title1">ToolBar</x:String>
    <x:String x:Key="Loc.P.ToolBar.Sub1">관련 명령과 컨트롤을 하나의 띠에 모으고 구분선으로 논리 그룹을 나누는 컨테이너입니다.</x:String>
    <x:String x:Key="Loc.P.ToolBar.CT1">기본 ToolBar</x:String>
    <x:String x:Key="Loc.P.ToolBar.CC1">단추를 담은 도구 모음.</x:String>
    <x:String x:Key="Loc.P.ToolBar.CT2">여러 컨트롤을 섞은 ToolBar</x:String>
    <x:String x:Key="Loc.P.ToolBar.CC2">도구 모음에는 여러 종류의 컨트롤을 담을 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToolBar.CT3">ToolBarTray</x:String>
    <x:String x:Key="Loc.P.ToolBar.CC3">여러 도구 모음을 트레이 하나에 정리할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToolBar.CC4">도구 모음 단추를 클릭하면 해당 동작을 확인할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToolBar.CC5">위 도구 모음의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ToolBar.CC6">코드 비하인드에서 도구 모음을 만들고 단추 클릭을 연결합니다.</x:String>

    <!-- ToolTip -->
    <x:String x:Key="Loc.P.ToolTip.Title1">ToolTip</x:String>
    <x:String x:Key="Loc.P.ToolTip.Sub1">포인터를 컨트롤 위에 올렸을 때 도움말을 보여 주는 가벼운 팝업으로, 단순 문자열과 구조화된 풍부한 내용을 모두 지원합니다.</x:String>
    <x:String x:Key="Loc.P.ToolTip.CT1">기본 ToolTip</x:String>
    <x:String x:Key="Loc.P.ToolTip.CC1">단추에 마우스를 올리면 도구 설명이 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.ToolTip.CT2">여러 컨트롤의 ToolTip</x:String>
    <x:String x:Key="Loc.P.ToolTip.CC2">도구 설명은 어떤 컨트롤에도 붙일 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToolTip.CT3">풍부한 내용의 ToolTip</x:String>
    <x:String x:Key="Loc.P.ToolTip.CC3">도구 설명에는 여러 요소로 이루어진 풍부한 내용을 담을 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToolTip.CT4">ToolTip 배치</x:String>
    <x:String x:Key="Loc.P.ToolTip.CC4">도구 설명은 여러 위치에 배치할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.ToolTip.CC5">위 도구 설명의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.ToolTip.CC6">코드 비하인드에서 도구 설명을 지정하고 풍부한 내용을 만듭니다.</x:String>

    <!-- TransitionDemo -->
    <x:String x:Key="Loc.P.TransitionDemo.Title1">콘텐츠 전환</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.Sub1">TransitioningContentControl은 콘텐츠가 바뀔 때마다 애니메이션을 재생합니다. 전환 모드를 고른 뒤 콘텐츠를 바꿔 보세요.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CT1">전환 설정</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC1">전환 모드를 고른 뒤 콘텐츠를 한 번 바꾸거나 모든 모드를 순서대로 자동 재생합니다.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CT2">실시간 미리 보기</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC2">콘텐츠가 패널 A, B, C 사이를 오갈 때마다 선택한 전환이 재생됩니다.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC3">클리핑을 적용한 TransitioningContentControl의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TransitionDemo.CC4">콘텐츠 전환, 모드 선택, 자동 재생은 모두 ViewModel의 명령과 상태입니다.</x:String>

    <!-- TreeDataGrid -->
    <x:String x:Key="Loc.P.TreeDataGrid.Title1">TreeDataGrid</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Sub1">계층 데이터를 펼치기·접기가 되는 평평한 열 기반 격자로 표시하는 컨트롤입니다.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC1">화살표를 클릭해 펼치거나 접고, 행을 클릭해 선택하며, 열 머리글을 클릭해 정렬합니다.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC2">TreeDataGrid는 트리 계층과 열 기반 데이터 표시를 결합합니다.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC3">위 TreeDataGrid 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.CC4">ViewModel이 트리와 선택 상태를 제공하고, 동작이 펼치기·접기와 열 설정을 이어 줍니다.</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body1">* 들여쓰기가 있는 계층 펼치기·접기</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body2">* DataGrid 열 형식 재사용(텍스트, 확인란, 템플릿 등)</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body3">* 대용량 데이터를 위한 행 가상화</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body4">* 열 정렬(모든 수준에 재귀 적용)</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body5">* 열 너비 조절과 끌어서 순서 바꾸기</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body6">* 단일 및 확장 선택 모드</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body7">* 키보드 탐색(화살표, 왼쪽/오른쪽으로 펼치기·접기)</x:String>
    <x:String x:Key="Loc.P.TreeDataGrid.Body8">* ChildrenPropertyPath 또는 ChildrenSelector로 데이터 바인딩</x:String>

    <!-- TreeMap -->
    <x:String x:Key="Loc.P.TreeMap.Title1">TreeMap</x:String>
    <x:String x:Key="Loc.P.TreeMap.Sub1">계층 데이터를 값에 비례하는 중첩 사각형으로 공간을 채워 표시합니다.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CT1">기본 TreeMap</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC1">시가 총액에 따라 시장 부문을 배치한 평면 트리맵.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CT2">중첩 TreeMap</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC2">상위 범주와 하위 항목을 가진 계층적 트리맵.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CT3">Squarified 알고리즘</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC3">같은 데이터로 Squarified와 SliceAndDice 레이아웃 알고리즘을 비교합니다.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC4">위 트리맵을 구성하는 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TreeMap.CC5">ViewModel이 계층적 항목 컬렉션을 제공하고 알고리즘과 레이아웃은 XAML에 둡니다.</x:String>

    <!-- TreeSelector -->
    <x:String x:Key="Loc.P.TreeSelector.Title1">TreeSelector</x:String>
    <x:String x:Key="Loc.P.TreeSelector.Sub1">드롭다운 계층 선택기입니다. 트리거에는 현재 선택(단일 선택이면 조상 경로, 다중 선택이면 지울 수 있는 칩)이 표시되고 팝업에는 선택 가능한 트리가 들어갑니다. 계단식 적용과 실시간 검색도 지원합니다.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC1">SelectionMode = Single. 트리거에 조상 경로 전체가 표시되고 잎 노드를 고르면 팝업이 자동으로 닫힙니다.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC2">SelectionMode = Multiple이고 ShowCheckBoxes = True. 행 선택은 제거 가능한 칩으로 표시되고 체크 상태는 CheckedItems에서 별도로 관리됩니다.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC3">IsSearchEnabled = True. 입력하면 트리가 일치 항목과 그 조상만 남도록 걸러집니다.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC4">CheckCascadeMode = Cascade — 부모를 선택하면 자손에도 반영되고, 자식 상태가 섞이면 부모가 미정 상태로 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC5">위 TreeSelector의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TreeSelector.CC6">지역 데이터와 상태는 ViewModel에 있고, 동작이 API에 필요한 TreeSelectorItem 계층을 만들며 선택 및 체크 이벤트를 각각 전달합니다.</x:String>

    <!-- TreeView -->
    <x:String x:Key="Loc.P.TreeView.Title1">TreeView</x:String>
    <x:String x:Key="Loc.P.TreeView.Sub1">데이터를 트리 구조로 표시하는 계층 컨트롤이며 노드를 펼치고 접을 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.TreeView.CT1">기본 TreeView</x:String>
    <x:String x:Key="Loc.P.TreeView.CC1">계층적 항목을 가진 간단한 TreeView.</x:String>
    <x:String x:Key="Loc.P.TreeView.CC2">선택 변경은 동작을 통해 ViewModel에 전달됩니다.</x:String>
    <x:String x:Key="Loc.P.TreeView.CT2">미리 펼친 노드</x:String>
    <x:String x:Key="Loc.P.TreeView.CC3">일부 노드가 처음부터 펼쳐진 TreeView.</x:String>
    <x:String x:Key="Loc.P.TreeView.CC4">위 TreeView의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.TreeView.CC5">ViewModel이 트리 데이터와 선택 상태를 갖고, 동작이 TreeView의 컨테이너와 이벤트를 이어 줍니다.</x:String>

    <!-- UniformGrid -->
    <x:String x:Key="Loc.P.UniformGrid.Title1">UniformGrid</x:String>
    <x:String x:Key="Loc.P.UniformGrid.Sub1">모든 셀 크기가 같은 격자에 자식 요소를 배치하는 패널입니다. 행과 열 수는 자동 계산하거나 직접 지정할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT1">자동 레이아웃</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC1">Rows와 Columns가 모두 0이면 격자가 가장 알맞은 레이아웃을 자동으로 계산합니다.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT2">행과 열을 직접 지정</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC2">Rows와 Columns를 직접 지정해 격자 크기를 제어합니다.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT3">대화형 설정</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC3">Rows, Columns, FirstColumn을 바꾸며 레이아웃이 어떻게 달라지는지 확인합니다.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CT4">FirstColumn 속성</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC4">FirstColumn은 첫 행의 항목을 밀어 앞쪽 셀을 비웁니다. 달력 같은 레이아웃에 유용합니다.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC5">위 UniformGrid 레이아웃의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.UniformGrid.CC6">코드 비하인드에서 UniformGrid를 만들고 설정합니다.</x:String>

    <!-- Viewbox -->
    <x:String x:Key="Loc.P.Viewbox.Title1">Viewbox</x:String>
    <x:String x:Key="Loc.P.Viewbox.Sub1">하나뿐인 자식 요소를 사용 가능한 공간에 맞춰 배율 조정하는 데코레이터로, 늘이기 모드와 방향을 제어합니다.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CT1">Uniform 늘이기</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC1">가로세로 비율을 유지하면서 내용을 균등하게 배율 조정해 맞춥니다.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CT2">늘이기 모드</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC2">늘이기 모드에 따라 내용이 Viewbox를 채우는 방식이 달라집니다.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CT3">늘이기 방향</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC3">내용을 확대만, 축소만, 또는 둘 다 허용할지 제어합니다.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC4">슬라이더로 컨테이너 크기를 바꾸며 Viewbox가 자식을 어떻게 다시 배율 조정하는지 확인합니다.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC5">실제 레이아웃에서 Viewbox가 진가를 발휘하는 상황.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC6">위 Viewbox 예제의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.Viewbox.CC7">코드 비하인드에서 대화형 슬라이더를 연결하고 아이콘 배율을 조정합니다.</x:String>

    <!-- WebView -->
    <x:String x:Key="Loc.P.WebView.Title1">WebView</x:String>
    <x:String x:Key="Loc.P.WebView.Sub1">Microsoft Edge WebView2 런타임을 통해 앱에 실제 웹 콘텐츠를 삽입합니다. 뒤로·앞으로 탐색, 페이지 상태 이벤트, JavaScript 실행을 지원합니다.</x:String>
    <x:String x:Key="Loc.P.WebView.CT1">브라우저</x:String>
    <x:String x:Key="Loc.P.WebView.CC1">뒤로, 앞으로, 새로 고침 단추를 갖추고 어떤 URL로도 이동할 수 있습니다.</x:String>
    <x:String x:Key="Loc.P.WebView.CT2">페이지 정보</x:String>
    <x:String x:Key="Loc.P.WebView.CC2">현재 문서 제목과 탐색 상태를 표시합니다.</x:String>
    <x:String x:Key="Loc.P.WebView.CT3">JavaScript 실행</x:String>
    <x:String x:Key="Loc.P.WebView.CC3">웹 페이지에서 JavaScript를 실행하고 결과를 확인합니다.</x:String>
    <x:String x:Key="Loc.P.WebView.CT4">WebView 속성</x:String>
    <x:String x:Key="Loc.P.WebView.CC4">WebView 컨트롤이 노출하는 주요 속성.</x:String>
    <x:String x:Key="Loc.P.WebView.CC5">위 브라우저 데모의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.WebView.CC6">탐색과 스크립트 요청은 명령이며, 동작이 WebView 이벤트를 ViewModel 상태로 옮깁니다.</x:String>
    <x:String x:Key="Loc.P.WebView.Body1">Source — 이동할 URI(Uri)</x:String>
    <x:String x:Key="Loc.P.WebView.Body2">CanGoBack / CanGoForward — 탐색 기록 상태(bool, 읽기 전용)</x:String>
    <x:String x:Key="Loc.P.WebView.Body3">ZoomFactor — 확대 배율, 0.25에서 4.0(double)</x:String>
    <x:String x:Key="Loc.P.WebView.Body4">DefaultBackgroundColor — 콘텐츠가 로드되기 전의 배경색(Color)</x:String>
    <x:String x:Key="Loc.P.WebView.Body5">DocumentTitle — 현재 페이지 제목(string, 읽기 전용)</x:String>
    <x:String x:Key="Loc.P.WebView.Body6">CoreWebView2 — 고급 용도를 위한 하위 WebView2 인스턴스</x:String>

    <!-- WrapPanel -->
    <x:String x:Key="Loc.P.WrapPanel.Title1">WrapPanel</x:String>
    <x:String x:Key="Loc.P.WrapPanel.Sub1">자식 요소를 차례로 배치하다가 사용 가능한 공간의 끝에 닿으면 다음 줄로 넘기는 패널입니다.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT1">가로 WrapPanel</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC1">항목이 왼쪽에서 오른쪽으로 놓이다가 가득 차면 다음 행으로 넘어갑니다.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT2">세로 WrapPanel</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC2">항목이 위에서 아래로 놓이다가 가득 차면 다음 열로 넘어갑니다.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT3">고정 항목 크기</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC3">ItemWidth와 ItemHeight로 크기를 통일합니다.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CT4">태그 클라우드 예제</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC4">WrapPanel의 실용적인 사용 사례.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC5">위 WrapPanel의 선언형 마크업.</x:String>
    <x:String x:Key="Loc.P.WrapPanel.CC6">모든 줄 바꿈 레이아웃과 항목은 XAML에서 선언합니다.</x:String>

    <!-- XamlUICommand -->
    <x:String x:Key="Loc.P.XamlUICommand.Title1">XamlUICommand</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.Sub1">앱 고유 동작을 위해 레이블, 아이콘, 키보드 액셀러레이터를 직접 지정해 정의하는 사용자 지정 명령입니다.</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CT1">사용자 지정 XamlUICommand</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CC1">고유한 레이블, 아이콘, 액셀러레이터를 가진 앱 전용 명령을 도구 모음 단추에 연결했습니다.</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CT2">명령 출력</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CC2">명령 단추를 클릭하면 동작이 실행되고 가장 최근 결과와 기록이 아래에 표시됩니다.</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CC3">ViewModel의 XamlUICommand를 명령 막대에 바인딩하고 해당 키보드 단축키를 등록합니다.</x:String>
    <x:String x:Key="Loc.P.XamlUICommand.CC4">명령 정의와 실행은 각각 독립된 ViewModel에 둡니다.</x:String>

