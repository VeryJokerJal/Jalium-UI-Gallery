<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:converters="clr-namespace:Jalium.UI.Gallery.Modules.Main.Converters"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ThemeColorsPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      behaviors:ViewportHeightBehavior.IsEnabled="True"
      MinHeight="640"
      Title="Theme Colors">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InverseBooleanToVisibilityConverter
            x:Key="InverseBooleanToVisibility" />
        <Style x:Key="ThemeResourceListItem"
               TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </Page.Resources>

    <Grid x:Name="ThemeColorsRoot"
          Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource GalleryEyebrow}"
                       Text="{DynamicResource Loc.Shared.System}" />
            <TextBlock Style="{StaticResource GalleryPageTitle}"
                       Text="{DynamicResource Loc.P.ThemeColors.Title1}" />
            <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                       Text="{DynamicResource Loc.P.ThemeColors.Sub1}" />

            <Border Background="{DynamicResource GalleryCardBackground}"
                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="16"
                    Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <TextBlock Text="Preview:"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox Width="160"
                                  Height="32"
                                  Margin="0,0,16,0"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding PreviewThemeKey, Mode=TwoWay}"
                                  ToolTip="{DynamicResource Loc.P.ThemeColors.Ui1}" />
                        <TextBlock Text="{DynamicResource Loc.P.ThemeColors.Ui5}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBox Width="280"
                                 Height="32"
                                 Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=80}"
                                 ToolTip="{DynamicResource Loc.P.ThemeColors.Ui2}"
                                 Margin="0,0,16,0" />
                        <TextBlock Text="{Binding CountText}"
                                   FontSize="12"
                                   Opacity="0.7"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox Content="Colors"
                                  IsChecked="{Binding ShowColors, Mode=TwoWay}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Brushes"
                                  IsChecked="{Binding ShowBrushes, Mode=TwoWay}"
                                  Margin="0,0,16,0" />
                        <CheckBox Content="Gradients"
                                  IsChecked="{Binding ShowGradients, Mode=TwoWay}"
                                  Margin="0,0,16,0" />
                        <!-- Left in English on purpose: adding a DynamicResource to this row flips the
                             first-frame virtualization state the ThemeColorsPageFixture pins. -->
                        <TextBlock Text="(none checked = show all)"
                                   FontSize="11"
                                   Opacity="0.55"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource GalleryAccent}"
                    CornerRadius="8"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding IsCopyBannerVisible, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock Text="{Binding CopyBannerText}"
                           Foreground="{DynamicResource GalleryTextOnAccent}"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <ListBox x:Name="ResourceList"
                         ItemsSource="{Binding Resources}"
                         ItemContainerStyle="{StaticResource ThemeResourceListItem}"
                         Visibility="{Binding HasResources, Converter={StaticResource BooleanToVisibility}}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="0.5,0.5"
                         VirtualizingPanel.CacheLengthUnit="Page"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding RowBackground}"
                                    Padding="0"
                                    HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Background="{Binding Entry.Preview}"
                                            Width="40"
                                            Height="32"
                                            CornerRadius="6"
                                            Margin="12,8"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource GalleryBorderDefault}" />

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,8,12,8">
                                        <TextBlock Text="{Binding Entry.Key}"
                                                   Foreground="{DynamicResource GalleryTextPrimary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Entry.Detail}"
                                                   Foreground="{DynamicResource GalleryTextMuted}"
                                                   FontSize="11"
                                                   FontFamily="Cascadia Code,Consolas,Menlo,monospace"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <SplitButton Grid.Column="2"
                                                 Content="Copy"
                                                 Command="{Binding CopyKeyCommand}"
                                                 Width="104"
                                                 Margin="0,8,12,8"
                                                 FontSize="12"
                                                 Background="{DynamicResource GalleryAccent}"
                                                 BorderBrush="{DynamicResource GalleryAccent}"
                                                 Foreground="{DynamicResource GalleryTextOnAccent}">
                                        <SplitButton.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem
                                                    Text="{Binding Entry.CopyThemeResourceLabel}"
                                                    Command="{Binding CopyThemeResourceCommand}" />
                                                <MenuFlyoutItem
                                                    Text="{Binding Entry.CopyStaticResourceLabel}"
                                                    Command="{Binding CopyStaticResourceCommand}" />
                                                <Separator />
                                                <MenuFlyoutItem
                                                    Text="{Binding Entry.CopyValueLabel}"
                                                    Command="{Binding CopyValueCommand}" />
                                                <MenuFlyoutItem
                                                    Text="{DynamicResource Loc.P.ThemeColors.Ui4}"
                                                    Command="{Binding CopyKeyCommand}" />
                                            </MenuFlyout>
                                        </SplitButton.Flyout>
                                    </SplitButton>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding EmptyMessage}"
                           Foreground="{DynamicResource GalleryTextMuted}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="20,24"
                           Visibility="{Binding HasNoResources, Converter={StaticResource BooleanToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Page>
