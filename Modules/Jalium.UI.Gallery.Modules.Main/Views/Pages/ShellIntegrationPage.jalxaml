<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ShellIntegrationPage"
    Title="Shell Integration">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="SYSTEM" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Shell Integration" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Windows Shell integration with WindowChrome, JumpList, and Taskbar features." />

        <!-- WindowChrome -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="WindowChrome" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Customize window frame appearance with DWM composition support." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Properties" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="CaptionHeight: Height of the title bar" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="ResizeBorderThickness: Size of resize grips" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="GlassFrameThickness: DWM glass frame extent" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="CornerRadius: Window corner rounding" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="UseAeroCaptionButtons: Use system buttons" />
                        <Border Style="{StaticResource GalleryDivider}" />
                        <TextBlock Text="// Apply custom window chrome" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="var chrome = new WindowChrome" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="{" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    CaptionHeight = 30," FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    CornerRadius = new CornerRadius(8)," FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    GlassFrameThickness = new Thickness(-1)" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="};" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="WindowChrome.SetWindowChrome(window, chrome);" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- JumpList -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="JumpList" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Windows 7+ taskbar Jump Lists with tasks and recent items." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button x:Name="ApplyJumpListButton" Content="Apply Sample JumpList" Width="180" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="JumpList items" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="JumpTask: Launch application with arguments" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="JumpPath: Open a specific file" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="Custom Categories: Group items together" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- TaskbarItemInfo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="TaskbarItemInfo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Control taskbar thumbnail, progress indicator, and overlay icons." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Progress" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="TaskbarProgressSlider" Width="200" Minimum="0" Maximum="100" Value="50" VerticalAlignment="Center" />
                            <TextBlock x:Name="TaskbarProgressText" Style="{StaticResource GalleryValueLabel}" Text="50%" Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Progress state" Margin="0,18,0,10" />
                        <WrapPanel>
                            <Button x:Name="ProgressNoneButton" Content="None" Width="70" Margin="0,0,10,10" />
                            <Button x:Name="ProgressNormalButton" Content="Normal" Width="70" Margin="0,0,10,10" />
                            <Button x:Name="ProgressPausedButton" Content="Paused" Width="70" Margin="0,0,10,10" />
                            <Button x:Name="ProgressErrorButton" Content="Error" Width="70" Margin="0,0,10,10" />
                        </WrapPanel>

                        <TextBlock x:Name="TaskbarStatus" Style="{StaticResource GalleryCaptionText}" Text="Taskbar State: None" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- SystemParameters2 -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="SystemParameters2" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Access system metrics and DWM state information." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock x:Name="GlassEnabledText" Style="{StaticResource GalleryBodyText}" Text="DWM Glass Enabled: True" Margin="0,0,0,6" />
                        <TextBlock x:Name="GlassColorText" Style="{StaticResource GalleryBodyText}" Text="Glass Color: #6495ED" Margin="0,0,0,6" />
                        <TextBlock x:Name="CaptionHeightText" Style="{StaticResource GalleryBodyText}" Text="Caption Height: 30" Margin="0,0,0,6" />
                        <TextBlock x:Name="ResizeBorderText" Style="{StaticResource GalleryBodyText}" Text="Resize Border: 4,4,4,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup applying WindowChrome and TaskbarItemInfo to a Window." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Configuring window chrome, jump lists, taskbar progress, and reading system parameters in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
