<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ShellIntegrationPage"
    hosting:ViewModelLocator.AutoWireViewModel="True"
    Title="Shell Integration">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.System}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ShellIntegration.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ShellIntegration.Sub1}" />

        <!-- WindowChrome -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShellIntegration.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShellIntegration.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.Shared.Properties}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body1}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body2}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body3}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body4}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body5}" />
                        <Border Style="{StaticResource GalleryDivider}" />
                        <TextBlock Text="// Apply custom window chrome" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="var chrome = new WindowChrome" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="{" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    CaptionHeight = 30," FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    CornerRadius = new CornerRadius(8)," FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    GlassFrameThickness = new Thickness(-1)" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="};" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="WindowChrome.SetWindowChrome(window, chrome);" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- JumpList -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShellIntegration.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShellIntegration.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button Content="Apply Sample JumpList"
                                Command="{Binding ApplyJumpListCommand}"
                                Width="180"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.ShellIntegration.Val1}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body6}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body7}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ShellIntegration.Body8}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- TaskbarItemInfo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShellIntegration.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShellIntegration.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.ShellIntegration.Val2}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider Width="200"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding TaskbarProgress, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding TaskbarProgressText}"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.ShellIntegration.Val3}" Margin="0,18,0,10" />
                        <WrapPanel>
                            <Button Content="None" Command="{Binding SetProgressNoneCommand}" Width="70" Margin="0,0,10,10" />
                            <Button Content="Normal" Command="{Binding SetProgressNormalCommand}" Width="70" Margin="0,0,10,10" />
                            <Button Content="Paused" Command="{Binding SetProgressPausedCommand}" Width="70" Margin="0,0,10,10" />
                            <Button Content="Error" Command="{Binding SetProgressErrorCommand}" Width="70" Margin="0,0,10,10" />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding TaskbarStatus}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- SystemParameters2 -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShellIntegration.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShellIntegration.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{Binding GlassEnabledText}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{Binding GlassColorText}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{Binding CaptionHeightText}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{Binding ResizeBorderText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShellIntegration.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShellIntegration.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
