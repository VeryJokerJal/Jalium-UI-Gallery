<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RepeatButtonPage"
      hosting:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.RepeatButton.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.RepeatButton.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RepeatButton.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton x:Name="DecrementButton"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,8,0"
                                      ToolTip="Decrease"
                                      automation:AutomationProperties.Name="Decrease"
                                      Command="{Binding DecrementCommand}">
                            <SymbolIcon Symbol="Remove"
                                        Width="18"
                                        Height="18" />
                        </RepeatButton>
                        <TextBlock x:Name="CounterText"
                                   Text="{Binding Count}"
                                   Width="60"
                                   TextAlignment="Center"
                                   FontSize="24"
                                   VerticalAlignment="Center" />
                        <RepeatButton x:Name="IncrementButton"
                                      Width="40"
                                      Height="40"
                                      Margin="8,0,0,0"
                                      ToolTip="Increase"
                                      automation:AutomationProperties.Name="Increase"
                                      Command="{Binding IncrementCommand}">
                            <SymbolIcon Symbol="Add"
                                        Width="18"
                                        Height="18" />
                        </RepeatButton>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Features}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RepeatButton.CC2}" />
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RepeatButton.Body1}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RepeatButton.Body2}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RepeatButton.Body3}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RepeatButton.Body4}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RepeatButton.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RepeatButton.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
