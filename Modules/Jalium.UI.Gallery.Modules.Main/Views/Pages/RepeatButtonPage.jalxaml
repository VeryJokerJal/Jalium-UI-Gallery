<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RepeatButtonPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="RepeatButton" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A button that fires Click events repeatedly while it stays pressed — ideal for steppers, spinners and scroll repeat, with a configurable initial delay and repeat interval." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Hold a button to repeat the action continuously — the counter keeps changing while pressed." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <RepeatButton x:Name="DecrementButton" Content="-" Width="40" Height="40" Margin="0,0,8,0" />
                        <TextBlock x:Name="CounterText" Text="0" Width="60" TextAlignment="Center" FontSize="24" VerticalAlignment="Center" />
                        <RepeatButton x:Name="IncrementButton" Content="+" Width="40" Height="40" Margin="8,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="What sets RepeatButton apart from a standard button." />
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Continuous click events while pressed" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Configurable initial delay" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Configurable repeat interval" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Useful for scrollbars and spinners" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the counter and volume-control demos." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring Click handlers and creating RepeatButtons in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
