<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TerminalPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Terminal">

    <StackPanel Style="{StaticResource GalleryPageStack}">
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.System}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Terminal.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Terminal.Sub1}" />

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Terminal.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Terminal.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <Terminal Height="400"
                              HorizontalAlignment="Stretch"
                              FontSize="{Binding TerminalFontSize}"
                              AutoSize="True"
                              AutoStartShell="True"
                              CursorStyle="{Binding CursorStyle}"
                              MaxScrollbackLines="10000"
                              behaviors:TerminalBehavior.ObserveProcess="True"
                              behaviors:TerminalBehavior.Request="{Binding MainRequest}" />
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TerminalTitle}"
                               FontSize="12"
                               Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding ProcessStatus}"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Options}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Terminal.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Cursor Style:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox Width="140"
                                      ItemsSource="{Binding CursorStyles}"
                                      SelectedItem="{Binding CursorStyle, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Font Size:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Slider Width="200"
                                    Minimum="8"
                                    Maximum="24"
                                    Value="{Binding TerminalFontSize, Mode=TwoWay}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TerminalFontSize, StringFormat='{}{0:F0}'}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="Clear Terminal" Command="{Binding ClearCommand}" Margin="0,0,10,10"/>
                            <Button Content="Copy Selection" Command="{Binding CopyCommand}" Margin="0,0,10,10"/>
                            <Button Content="Paste" Command="{Binding PasteCommand}" Margin="0,0,10,10"/>
                            <Button Content="Restart Shell" Command="{Binding RestartCommand}" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Terminal.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Terminal.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <Terminal Height="200"
                              HorizontalAlignment="Stretch"
                              FontSize="14"
                              AutoSize="True"
                              AutoStartShell="False"
                              IsReadOnly="True"
                              CursorStyle="Bar"
                              behaviors:TerminalBehavior.Request="{Binding DemoRequest}" />
                </Border>
                <WrapPanel Margin="0,12,0,0">
                    <Button Content="Show ANSI Colors" Command="{Binding ShowAnsiColorsCommand}" Margin="0,0,10,10"/>
                    <Button Content="Show Text Styles" Command="{Binding ShowTextStylesCommand}" Margin="0,0,10,10"/>
                    <Button Content="Clear" Command="{Binding ClearDemoCommand}" Margin="0,0,10,10"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Terminal.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Terminal.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
