<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TerminalPage"
      Title="Terminal">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="SYSTEM" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Terminal" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A terminal emulator control with VT100/ANSI escape sequence support, shell process integration, and full keyboard/IME input." />

        <!-- Interactive terminal -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive Terminal" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A fully functional shell terminal. Type commands and interact with the system shell." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <Terminal x:Name="MainTerminal"
                             Height="400"
                             HorizontalAlignment="Stretch"
                             FontSize="14"
                             AutoSize="True"
                             AutoStartShell="True"
                             CursorStyle="Bar"
                             MaxScrollbackLines="10000"/>
                </Border>

                <!-- Status Bar -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="TitleText"
                               Text="Terminal"
                               FontSize="12"
                               Margin="0,0,16,0"/>
                    <TextBlock x:Name="ProcessStatusText"
                               Text="Running"
                               FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Options" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Adjust the cursor style and font size, or run terminal actions such as clear, copy, paste and restart." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Cursor Style:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <ComboBox x:Name="CursorStyleComboBox"
                                      Width="120">
                                <ComboBoxItem Content="Bar" IsSelected="True"/>
                                <ComboBoxItem Content="Block"/>
                                <ComboBoxItem Content="Underline"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Font Size:"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Slider x:Name="FontSizeSlider"
                                    Width="200"
                                    Minimum="8"
                                    Maximum="24"
                                    Value="14"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="FontSizeLabel"
                                       Text="14"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"/>
                        </StackPanel>

                        <WrapPanel>
                            <Button x:Name="ClearButton"
                                    Content="Clear Terminal"
                                    Margin="0,0,10,10"/>
                            <Button x:Name="CopyButton"
                                    Content="Copy Selection"
                                    Margin="0,0,10,10"/>
                            <Button x:Name="PasteButton"
                                    Content="Paste"
                                    Margin="0,0,10,10"/>
                            <Button x:Name="RestartButton"
                                    Content="Restart Shell"
                                    Margin="0,0,10,10"/>
                        </WrapPanel>

                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Programmatic output -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Programmatic Output" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Write text directly to a terminal control using ANSI escape sequences." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <Terminal x:Name="DemoTerminal"
                             Height="200"
                             HorizontalAlignment="Stretch"
                             FontSize="14"
                             AutoSize="True"
                             AutoStartShell="False"
                             IsReadOnly="True"
                             CursorStyle="Bar"/>
                </Border>

                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="AnsiColorsButton"
                            Content="Show ANSI Colors"
                            Margin="0,0,10,10"/>
                    <Button x:Name="AnsiStylesButton"
                            Content="Show Text Styles"
                            Margin="0,0,10,10"/>
                    <Button x:Name="ClearDemoButton"
                            Content="Clear"
                            Margin="0,0,10,10"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the terminals above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring terminal events and writing ANSI output in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
