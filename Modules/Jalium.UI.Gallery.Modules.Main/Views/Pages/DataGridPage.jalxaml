<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DataGridPage"
      Title="DataGrid">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="COLLECTIONS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="DataGrid" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that presents a collection of data in a customizable grid of rows and columns, with sorting, resizing, selection and auto-generated columns." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click a row to select it, and click a column header to sort." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <DataGrid x:Name="DemoDataGrid"
                                  Height="200"
                                  Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="Selected: "
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedItemText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="(none)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A quick tour of what the grid supports out of the box." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Auto-generate columns from the data source" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Column sorting (click headers)" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Column resizing (drag column edges)" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Single and Extended selection modes" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Row and column header visibility" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Alternating row backgrounds" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Grid lines customization" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="•  Keyboard navigation (Up / Down / Home / End)" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the grid above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Populating the grid and handling selection in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
