<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ButtonPage"
      Title="Button">

    <!--
        Reference layout for every gallery page. Structure:
          header (eyebrow + title + subtitle)  →  a stack of GalleryCard sections.
        Each card = title + caption + a GalleryDemoSurface holding the live demo.
        Control rows sit in a WrapPanel so they reflow on narrow / mobile widths.
        All visual tokens come from GalleryStyles.jalxaml — no inline style soup.
    -->

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Button" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A clickable command surface that triggers an action. Buttons carry text or custom content, come in multiple sizes and states, and repaint automatically with the accent theme." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Tap the button to increment the counter." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CounterButton"
                                Content="Click Me"
                                Height="40"
                                Padding="20,0" />
                        <TextBlock x:Name="CounterText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Count: 0"
                                   Margin="18,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Basic button -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Standard button with default styling, plus a disabled state." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Click Me" Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Disabled" Height="40" Padding="20,0" Margin="0,0,10,10" IsEnabled="False" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sizes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Sizes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Small, medium and large presets scale font and padding together." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Small"  Height="30" Padding="14,0" FontSize="12" Margin="0,0,10,10" />
                        <Button Content="Medium" Height="38" Padding="18,0" FontSize="14" Margin="0,0,10,10" />
                        <Button Content="Large"  Height="46" Padding="24,0" FontSize="16" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Accent theming -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Accent theming" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Buttons bound to the accent brushes via {ThemeResource} repaint automatically when the theme or accent color switches." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Accent"
                                Background="{ThemeResource AccentBrush}"
                                BorderBrush="{ThemeResource AccentBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Hover"
                                Background="{ThemeResource AccentBrushHover}"
                                BorderBrush="{ThemeResource AccentBrushHover}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Pressed"
                                Background="{ThemeResource AccentBrushPressed}"
                                BorderBrush="{ThemeResource AccentBrushPressed}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Outlined"
                                Background="Transparent"
                                BorderBrush="{ThemeResource AccentBrush}"
                                BorderThickness="1.5"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the buttons above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring click handlers and creating buttons in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
