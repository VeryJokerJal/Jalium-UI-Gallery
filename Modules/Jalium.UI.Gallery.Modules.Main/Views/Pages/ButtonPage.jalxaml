<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ButtonPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Button">

    <!--
        Reference layout for every gallery page. Structure:
          header (eyebrow + title + subtitle)  →  a stack of GalleryCard sections.
        Each card = title + caption + a GalleryDemoSurface holding the live demo.
        Control rows sit in a WrapPanel so they reflow on narrow / mobile widths.
        All visual tokens come from GalleryStyles.jalxaml — no inline style soup.
    -->

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Button.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Button.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Button.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CounterButton"
                                Content="Click Me"
                                Height="40"
                                Padding="20,0"
                                Command="{Binding IncrementCommand}" />
                        <TextBlock x:Name="CounterText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CounterText}"
                                   Margin="18,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Basic button -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Basic}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Button.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Click Me" Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Disabled" Height="40" Padding="20,0" Margin="0,0,10,10" IsEnabled="False" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sizes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Button.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Button.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Small"  Height="30" Padding="14,0" FontSize="12" Margin="0,0,10,10" />
                        <Button Content="Medium" Height="38" Padding="18,0" FontSize="14" Margin="0,0,10,10" />
                        <Button Content="Large"  Height="46" Padding="24,0" FontSize="16" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Accent theming -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Button.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Button.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Accent"
                                Background="{ThemeResource AccentBrush}"
                                BorderBrush="{ThemeResource AccentBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Hover"
                                Background="{ThemeResource AccentBrushHover}"
                                BorderBrush="{ThemeResource AccentBrushHover}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Pressed"
                                Background="{ThemeResource AccentBrushPressed}"
                                BorderBrush="{ThemeResource AccentBrushPressed}"
                                Foreground="{ThemeResource TextOnAccentFillColorSelectedTextBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                        <Button Content="Outlined"
                                Background="Transparent"
                                BorderBrush="{ThemeResource AccentBrush}"
                                BorderThickness="1.5"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Height="40" Padding="20,0" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Button.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Button.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
