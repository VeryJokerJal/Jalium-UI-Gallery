<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:models="clr-namespace:Jalium.UI.Gallery.Modules.Main.Models"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.BackdropEffectsPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Backdrop Effects">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Effects}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.BackdropEffects.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.BackdropEffects.Sub1}" />

        <!-- Blur Effect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="164">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#FF7F00"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#00822B"/>
                                <Border Width="40" Height="40" Background="#00D346"/>
                                <Border Width="40" Height="40" Background="#14FF62"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#14FF62"/>
                                <Border Width="40" Height="40" Background="#00D346"/>
                                <Border Width="40" Height="40" Background="#00822B"/>
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#FF7F00"/>
                                <Border Width="40" Height="40" Background="#FF0000"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#00CED1"/>
                                <Border Width="40" Height="40" Background="#FF6347"/>
                                <Border Width="40" Height="40" Background="#32CD32"/>
                                <Border Width="40" Height="40" Background="#FFD700"/>
                                <Border Width="40" Height="40" Background="#14DC57"/>
                                <Border Width="40" Height="40" Background="#00BFFF"/>
                                <Border Width="40" Height="40" Background="#69FF9B"/>
                                <Border Width="40" Height="40" Background="#7FFF00"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Blur effect overlay -->
                        <Border x:Name="BlurEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="Blur"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="BackdropBlurEffect (20px)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Acrylic Effect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="164">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#1EE962"/>
                                <Border Width="40" Height="40" Background="#27B055"/>
                                <Border Width="40" Height="40" Background="#3AB764"/>
                                <Border Width="40" Height="40" Background="#3F51B5"/>
                                <Border Width="40" Height="40" Background="#2196F3"/>
                                <Border Width="40" Height="40" Background="#03A9F4"/>
                                <Border Width="40" Height="40" Background="#00BCD4"/>
                                <Border Width="40" Height="40" Background="#009688"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#4CAF50"/>
                                <Border Width="40" Height="40" Background="#8BC34A"/>
                                <Border Width="40" Height="40" Background="#CDDC39"/>
                                <Border Width="40" Height="40" Background="#FFEB3B"/>
                                <Border Width="40" Height="40" Background="#FFC107"/>
                                <Border Width="40" Height="40" Background="#FF9800"/>
                                <Border Width="40" Height="40" Background="#FF5722"/>
                                <Border Width="40" Height="40" Background="#795548"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#F44336"/>
                                <Border Width="40" Height="40" Background="#1EE962"/>
                                <Border Width="40" Height="40" Background="#27B055"/>
                                <Border Width="40" Height="40" Background="#3AB764"/>
                                <Border Width="40" Height="40" Background="#3F51B5"/>
                                <Border Width="40" Height="40" Background="#2196F3"/>
                                <Border Width="40" Height="40" Background="#03A9F4"/>
                                <Border Width="40" Height="40" Background="#00BCD4"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Acrylic effect overlay -->
                        <Border x:Name="AcrylicEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="Acrylic"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="AcrylicEffect (Blue Tint)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Mica Effect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="164">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#1ABC9C"/>
                                <Border Width="40" Height="40" Background="#2ECC71"/>
                                <Border Width="40" Height="40" Background="#3498DB"/>
                                <Border Width="40" Height="40" Background="#59B678"/>
                                <Border Width="40" Height="40" Background="#34495E"/>
                                <Border Width="40" Height="40" Background="#16A085"/>
                                <Border Width="40" Height="40" Background="#27AE60"/>
                                <Border Width="40" Height="40" Background="#2980B9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#44AD67"/>
                                <Border Width="40" Height="40" Background="#2C3E50"/>
                                <Border Width="40" Height="40" Background="#F1C40F"/>
                                <Border Width="40" Height="40" Background="#E67E22"/>
                                <Border Width="40" Height="40" Background="#E74C3C"/>
                                <Border Width="40" Height="40" Background="#ECF0F1"/>
                                <Border Width="40" Height="40" Background="#95A5A6"/>
                                <Border Width="40" Height="40" Background="#F39C12"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#D35400"/>
                                <Border Width="40" Height="40" Background="#C0392B"/>
                                <Border Width="40" Height="40" Background="#BDC3C7"/>
                                <Border Width="40" Height="40" Background="#7F8C8D"/>
                                <Border Width="40" Height="40" Background="#1ABC9C"/>
                                <Border Width="40" Height="40" Background="#2ECC71"/>
                                <Border Width="40" Height="40" Background="#3498DB"/>
                                <Border Width="40" Height="40" Background="#59B678"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Mica effect overlay -->
                        <Border x:Name="MicaEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="Mica"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="MicaEffect"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Frosted Glass Effect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="164">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF6B6B"/>
                                <Border Width="40" Height="40" Background="#4ECDC4"/>
                                <Border Width="40" Height="40" Background="#45B7D1"/>
                                <Border Width="40" Height="40" Background="#96CEB4"/>
                                <Border Width="40" Height="40" Background="#FFEAA7"/>
                                <Border Width="40" Height="40" Background="#A0DDB4"/>
                                <Border Width="40" Height="40" Background="#98D8C8"/>
                                <Border Width="40" Height="40" Background="#F7DC6F"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#8FCEA4"/>
                                <Border Width="40" Height="40" Background="#85C1E9"/>
                                <Border Width="40" Height="40" Background="#82E0AA"/>
                                <Border Width="40" Height="40" Background="#F8B500"/>
                                <Border Width="40" Height="40" Background="#FF6B6B"/>
                                <Border Width="40" Height="40" Background="#4ECDC4"/>
                                <Border Width="40" Height="40" Background="#45B7D1"/>
                                <Border Width="40" Height="40" Background="#96CEB4"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#FFEAA7"/>
                                <Border Width="40" Height="40" Background="#A0DDB4"/>
                                <Border Width="40" Height="40" Background="#98D8C8"/>
                                <Border Width="40" Height="40" Background="#F7DC6F"/>
                                <Border Width="40" Height="40" Background="#8FCEA4"/>
                                <Border Width="40" Height="40" Background="#85C1E9"/>
                                <Border Width="40" Height="40" Background="#82E0AA"/>
                                <Border Width="40" Height="40" Background="#F8B500"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Frosted glass effect overlay -->
                        <Border x:Name="FrostedGlassEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="FrostedGlass"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="FrostedGlassEffect"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Grayscale (Color Adjustment) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="120">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FFFF"/>
                                <Border Width="40" Height="40" Background="#FF8000"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#80FF00"/>
                                <Border Width="40" Height="40" Background="#0080FF"/>
                                <Border Width="40" Height="40" Background="#FF8080"/>
                                <Border Width="40" Height="40" Background="#80FF80"/>
                                <Border Width="40" Height="40" Background="#8080FF"/>
                                <Border Width="40" Height="40" Background="#FFFF80"/>
                                <Border Width="40" Height="40" Background="#80FFFF"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Grayscale effect overlay -->
                        <Border x:Name="GrayscaleEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="Grayscale"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Grayscale (100%)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Sepia (Color Adjustment) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT6}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="120">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#E74C3C"/>
                                <Border Width="40" Height="40" Background="#3498DB"/>
                                <Border Width="40" Height="40" Background="#2ECC71"/>
                                <Border Width="40" Height="40" Background="#F39C12"/>
                                <Border Width="40" Height="40" Background="#59B678"/>
                                <Border Width="40" Height="40" Background="#1ABC9C"/>
                                <Border Width="40" Height="40" Background="#E67E22"/>
                                <Border Width="40" Height="40" Background="#34495E"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#16A085"/>
                                <Border Width="40" Height="40" Background="#27AE60"/>
                                <Border Width="40" Height="40" Background="#2980B9"/>
                                <Border Width="40" Height="40" Background="#44AD67"/>
                                <Border Width="40" Height="40" Background="#F1C40F"/>
                                <Border Width="40" Height="40" Background="#D35400"/>
                                <Border Width="40" Height="40" Background="#C0392B"/>
                                <Border Width="40" Height="40" Background="#7F8C8D"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Sepia effect overlay -->
                        <Border x:Name="SepiaEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="Sepia"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Sepia (80%)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Invert (Color Adjustment) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT7}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="120">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#0000FF"/>
                                <Border Width="40" Height="40" Background="#FFFFFF"/>
                                <Border Width="40" Height="40" Background="#000000"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#00FFFF"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#808080"/>
                                <Border Width="40" Height="40" Background="#D4D4D8"/>
                                <Border Width="40" Height="40" Background="#2B2742"/>
                                <Border Width="40" Height="40" Background="#FF8000"/>
                                <Border Width="40" Height="40" Background="#0080FF"/>
                                <Border Width="40" Height="40" Background="#80FF00"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                                <Border Width="40" Height="40" Background="#00FF55"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Invert effect overlay -->
                        <Border x:Name="InvertEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="Invert"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Invert (100%)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Hue Rotate (Color Adjustment) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT8}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC8}" />
                <Border Style="{StaticResource GalleryDemoSurface}" Height="120">
                    <Grid>
                        <!-- Colorful background pattern -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="40" Height="40" Background="#FF0000"/>
                                <Border Width="40" Height="40" Background="#FF4000"/>
                                <Border Width="40" Height="40" Background="#FF8000"/>
                                <Border Width="40" Height="40" Background="#FFC000"/>
                                <Border Width="40" Height="40" Background="#FFFF00"/>
                                <Border Width="40" Height="40" Background="#C0FF00"/>
                                <Border Width="40" Height="40" Background="#80FF00"/>
                                <Border Width="40" Height="40" Background="#40FF00"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="40" Height="40" Background="#00FF00"/>
                                <Border Width="40" Height="40" Background="#00FF40"/>
                                <Border Width="40" Height="40" Background="#00FF80"/>
                                <Border Width="40" Height="40" Background="#00FFC0"/>
                                <Border Width="40" Height="40" Background="#00FFFF"/>
                                <Border Width="40" Height="40" Background="#00C0FF"/>
                                <Border Width="40" Height="40" Background="#0080FF"/>
                                <Border Width="40" Height="40" Background="#0040FF"/>
                            </StackPanel>
                        </StackPanel>
                        <!-- Hue rotate effect overlay -->
                        <Border x:Name="HueRotateEffectDemo"
                                behaviors:BackdropEffectBehavior.Preset="HueRotate"
                                Margin="20"
                                CornerRadius="14"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <TextBlock Text="Hue Rotate (90°)"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Window System Backdrop -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.BackdropEffects.CT9}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC9}" />

                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="None"
                                    Command="{Binding SetBackdropCommand}"
                                    CommandParameter="{x:Static models:WindowBackdropMode.None}"
                                    Padding="16,8"
                                    Margin="0,0,10,10"/>
                            <Button Content="Mica"
                                    Command="{Binding SetBackdropCommand}"
                                    CommandParameter="{x:Static models:WindowBackdropMode.Mica}"
                                    Padding="16,8"
                                    Margin="0,0,10,10"/>
                            <Button Content="Mica Alt"
                                    Command="{Binding SetBackdropCommand}"
                                    CommandParameter="{x:Static models:WindowBackdropMode.MicaAlt}"
                                    Padding="16,8"
                                    Margin="0,0,10,10"/>
                            <Button Content="Acrylic"
                                    Command="{Binding SetBackdropCommand}"
                                    CommandParameter="{x:Static models:WindowBackdropMode.Acrylic}"
                                    Padding="16,8"
                                    Margin="0,0,10,10"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding SystemBackdropStatus}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GalleryDemoSurface}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="// Set window system backdrop" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="window.SystemBackdrop = WindowBackdropType.Mica;" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Usage -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Usage}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC10}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="// Simple blur effect" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="border.BackdropEffect = new BackdropBlurEffect(20f);" Margin="0,4,0,12" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="// Acrylic material" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="border.BackdropEffect = new AcrylicEffect(Color.FromArgb(200, 30, 30, 40), 0.6f, 30f);" Margin="0,4,0,12" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="// Color adjustment" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="border.BackdropEffect = ColorAdjustmentEffect.CreateGrayscale();" Margin="0,4,0,12" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="// Custom IBackdropEffect implementation" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="border.BackdropEffect = new MyCustomEffect();" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC11}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.BackdropEffects.CC12}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
