<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.XamlUICommandPage"
      Title="XamlUICommand">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="XamlUICommand" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Custom commands defined with user-specified labels, icons, and keyboard accelerators for application-specific actions." />

        <!-- Custom XamlUICommand -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Custom XamlUICommand" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Application-specific commands with custom labels, icons, and accelerators, wired to toolbar buttons." />
                <Border x:Name="XamlCommandContainer"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="200" />
            </StackPanel>
        </Border>

        <!-- Command output -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Command output" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click the command buttons to trigger actions. The most recent result and history appear below." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="CommandOutputText"
                                   Style="{StaticResource GalleryBodyText}"
                                   Text="No command executed yet."
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="CommandHistoryText"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Text="" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup that defines a XamlUICommand and binds it to a command bar button." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building the commands in code and wiring each to a toolbar button's Click handler." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
