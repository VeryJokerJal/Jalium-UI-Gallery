<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.StackPanelPage"
      Title="StackPanel">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="StackPanel" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A panel that arranges its children in a single line — stacked vertically from top to bottom, or horizontally from left to right." />

        <!-- Vertical StackPanel -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Vertical StackPanel" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Children arranged from top to bottom." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Border Background="{DynamicResource GalleryAccent}" Height="40" Margin="0,0,0,8">
                            <TextBlock Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Height="40" Margin="0,0,0,8">
                            <TextBlock Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Height="40">
                            <TextBlock Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Horizontal StackPanel -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Horizontal StackPanel" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Children arranged from left to right." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource GalleryAccent}" Width="100" Height="60" Margin="0,0,8,0">
                            <TextBlock Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Width="100" Height="60" Margin="0,0,8,0">
                            <TextBlock Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Width="100" Height="60">
                            <TextBlock Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested StackPanels -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Nested StackPanels" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Combining vertical and horizontal layouts." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#CA5010" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="#CA5010" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="#CA5010" Width="60" Height="40"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the layouts above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building StackPanels and adding children in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
