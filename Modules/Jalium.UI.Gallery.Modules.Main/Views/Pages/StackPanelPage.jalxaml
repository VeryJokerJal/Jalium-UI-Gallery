<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.StackPanelPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="StackPanel">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.StackPanel.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.StackPanel.Sub1}" />

        <!-- Vertical StackPanel -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.StackPanel.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.StackPanel.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Border Background="{DynamicResource GalleryAccent}" Height="40" Margin="0,0,0,8">
                            <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Height="40" Margin="0,0,0,8">
                            <TextBlock Foreground="Black" Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Height="40">
                            <TextBlock Foreground="Black" Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Horizontal StackPanel -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.StackPanel.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.StackPanel.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource GalleryAccent}" Width="100" Height="60" Margin="0,0,8,0">
                            <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="Item 1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#22C55E" Width="100" Height="60" Margin="0,0,8,0">
                            <TextBlock Foreground="Black" Text="Item 2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Background="#179842" Width="100" Height="60">
                            <TextBlock Foreground="Black" Text="Item 3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested StackPanels -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.StackPanel.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.StackPanel.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="40"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#CA5010" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="#CA5010" Width="60" Height="40" Margin="0,0,8,0"/>
                            <Border Background="#CA5010" Width="60" Height="40"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.StackPanel.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.StackPanel.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
