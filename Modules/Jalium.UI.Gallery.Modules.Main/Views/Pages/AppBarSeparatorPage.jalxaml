<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.AppBarSeparatorPage"
      Title="AppBarSeparator">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="AppBarSeparator" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A thin vertical rule that visually separates groups of related commands inside a CommandBar or toolbar." />

        <!-- Separator in a toolbar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="AppBarSeparator in toolbar" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Separators divide toolbar buttons into logical groups. On narrow widths the strip reflows onto multiple lines." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <!-- File operations group -->
                        <AppBarButton x:Name="NewButton"
                                      Label="New"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="OpenButton"
                                      Label="Open"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="SaveButton"
                                      Label="Save"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />

                        <!-- Separator between file and edit groups -->
                        <AppBarSeparator Height="40" Margin="0,0,10,10" />

                        <!-- Edit operations group -->
                        <AppBarButton x:Name="CutButton"
                                      Label="Cut"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="CopyButton"
                                      Label="Copy"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="PasteButton"
                                      Label="Paste"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />

                        <!-- Separator between edit and undo groups -->
                        <AppBarSeparator Height="40" Margin="0,0,10,10" />

                        <!-- Undo/Redo group -->
                        <AppBarButton x:Name="UndoButton"
                                      Label="Undo"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="RedoButton"
                                      Label="Redo"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="ToolbarStatusText"
                           Style="{StaticResource GalleryCaptionText}"
                           Text="Click a toolbar button to see its action."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the toolbar and its separators above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building the toolbar and wiring button click handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
