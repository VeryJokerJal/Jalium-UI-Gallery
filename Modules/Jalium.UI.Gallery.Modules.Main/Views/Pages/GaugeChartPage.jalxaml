<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GaugeChartPage"
      Title="GaugeChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="GaugeChart" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays a value on a radial gauge with colored ranges, tick marks, and a needle indicator." />

        <!-- Basic Gauge -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Gauge" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A gauge chart with a simple value, minimum, and maximum." />
                <Border x:Name="BasicGaugeContainer"
                        Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Colored Ranges -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Colored Ranges" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A gauge with green, yellow, and red range segments." />
                <Border x:Name="ColoredRangesContainer"
                        Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Multiple Gauges -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Multiple Gauges" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A row of three small gauges showing CPU, Memory, and Disk usage." />
                <Border x:Name="MultiGaugeContainer"
                        Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the gauges above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building and configuring gauges in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
