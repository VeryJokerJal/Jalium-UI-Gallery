<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GaugeChartPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="GaugeChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.GaugeChart.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.GaugeChart.Sub1}" />

        <!-- Basic Gauge -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.GaugeChart.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GaugeChart.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <GaugeChart Width="300"
                                Height="300"
                                Value="72"
                                Minimum="0"
                                Maximum="100"
                                ShowValueText="True"
                                ValueFormat="F0"
                                Title="Speed" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Colored Ranges -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.GaugeChart.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GaugeChart.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <GaugeChart Width="300"
                                Height="300"
                                Value="65"
                                Minimum="0"
                                Maximum="100"
                                ShowValueText="True"
                                ValueFormat="F0"
                                Title="Temperature">
                        <GaugeChart.Ranges>
                            <GaugeRange Minimum="0" Maximum="40" Brush="#4CAF50" InnerRadiusRatio="0.8" />
                            <GaugeRange Minimum="40" Maximum="70" Brush="#FFC107" InnerRadiusRatio="0.8" />
                            <GaugeRange Minimum="70" Maximum="100" Brush="#E03E3E" InnerRadiusRatio="0.8" />
                        </GaugeChart.Ranges>
                    </GaugeChart>
                </Border>
            </StackPanel>
        </Border>

        <!-- Multiple Gauges -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.GaugeChart.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GaugeChart.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                            <GaugeChart Width="180" Height="180" Value="45" Minimum="0" Maximum="100" ShowValueText="True" ValueFormat="F0" ValueFontSize="16" TrackThickness="14" MajorTickInterval="25" MinorTickInterval="5">
                                <GaugeChart.Ranges>
                                    <GaugeRange Minimum="0" Maximum="60" Brush="#4CAF50" InnerRadiusRatio="0.82" />
                                    <GaugeRange Minimum="60" Maximum="85" Brush="#FFC107" InnerRadiusRatio="0.82" />
                                    <GaugeRange Minimum="85" Maximum="100" Brush="#E03E3E" InnerRadiusRatio="0.82" />
                                </GaugeChart.Ranges>
                            </GaugeChart>
                            <TextBlock Text="CPU" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,16,0">
                            <GaugeChart Width="180" Height="180" Value="78" Minimum="0" Maximum="100" ShowValueText="True" ValueFormat="F0" ValueFontSize="16" TrackThickness="14" MajorTickInterval="25" MinorTickInterval="5">
                                <GaugeChart.Ranges>
                                    <GaugeRange Minimum="0" Maximum="60" Brush="#4CAF50" InnerRadiusRatio="0.82" />
                                    <GaugeRange Minimum="60" Maximum="85" Brush="#FFC107" InnerRadiusRatio="0.82" />
                                    <GaugeRange Minimum="85" Maximum="100" Brush="#E03E3E" InnerRadiusRatio="0.82" />
                                </GaugeChart.Ranges>
                            </GaugeChart>
                            <TextBlock Text="Memory" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical">
                            <GaugeChart Width="180" Height="180" Value="92" Minimum="0" Maximum="100" ShowValueText="True" ValueFormat="F0" ValueFontSize="16" TrackThickness="14" MajorTickInterval="25" MinorTickInterval="5">
                                <GaugeChart.Ranges>
                                    <GaugeRange Minimum="0" Maximum="60" Brush="#4CAF50" InnerRadiusRatio="0.82" />
                                    <GaugeRange Minimum="60" Maximum="85" Brush="#FFC107" InnerRadiusRatio="0.82" />
                                    <GaugeRange Minimum="85" Maximum="100" Brush="#E03E3E" InnerRadiusRatio="0.82" />
                                </GaugeChart.Ranges>
                            </GaugeChart>
                            <TextBlock Text="Disk" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GaugeChart.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GaugeChart.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
