<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.AppBarButtonPage"
      Title="AppBarButton">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="AppBarButton" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A button control designed for use in a CommandBar, pairing an icon with a label to expose common commands on a toolbar." />

        <!-- Basic AppBarButton -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic AppBarButton" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="AppBarButtons pair an icon with a label for common actions." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <AppBarButton x:Name="AddButton"
                                      Label="Add"
                                      Width="72"
                                      Height="60"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="EditButton"
                                      Label="Edit"
                                      Width="72"
                                      Height="60"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="DeleteButton"
                                      Label="Delete"
                                      Width="72"
                                      Height="60"
                                      Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="BasicStatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="Click any button to see its action."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Compact mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Compact mode" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="AppBarButtons in compact mode show only icons, without labels." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <AppBarButton x:Name="CompactAddButton"
                                      Label="Add"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="CompactEditButton"
                                      Label="Edit"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                        <AppBarButton x:Name="CompactDeleteButton"
                                      Label="Delete"
                                      IsCompact="True"
                                      Width="40"
                                      Height="40"
                                      Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
                <TextBlock x:Name="CompactStatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="Compact buttons show icon only, hover for tooltip with label."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the AppBarButtons above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating AppBarButtons and wiring click handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
