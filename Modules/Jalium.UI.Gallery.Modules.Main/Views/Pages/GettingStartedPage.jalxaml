<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GettingStartedPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Getting Started">

    <StackPanel Style="{StaticResource GalleryPageStack}">
        <TextBlock Style="{StaticResource GalleryEyebrow}"
                   Text="{DynamicResource Loc.P.GettingStarted.Eyebrow1}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}"
                   Text="{DynamicResource Loc.P.GettingStarted.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.GettingStarted.Sub1}" />

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.GettingStarted.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GettingStarted.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="72"
                                 IsReadOnly="True"
                                 ShowLineNumbers="False"
                                 Language="shell"
                                 Text="{Binding InstallCommand}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.GettingStarted.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GettingStarted.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="330"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding WindowExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.GettingStarted.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GettingStarted.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="270"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.GettingStarted.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GettingStarted.CC4}" />
                <WrapPanel>
                    <Border Width="220"
                            MinHeight="112"
                            Style="{StaticResource GalleryDemoSurface}"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="StackPanel" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{DynamicResource Loc.P.GettingStarted.Panel1}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Width="220"
                            MinHeight="112"
                            Style="{StaticResource GalleryDemoSurface}"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="Grid" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{DynamicResource Loc.P.GettingStarted.Panel2}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Width="220"
                            MinHeight="112"
                            Style="{StaticResource GalleryDemoSurface}"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="Canvas" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{DynamicResource Loc.P.GettingStarted.Panel3}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Width="220"
                            MinHeight="112"
                            Style="{StaticResource GalleryDemoSurface}"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="DockPanel" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{DynamicResource Loc.P.GettingStarted.Panel4}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Width="220"
                            MinHeight="112"
                            Style="{StaticResource GalleryDemoSurface}"
                            Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"
                                       Text="FlexPanel" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{DynamicResource Loc.P.GettingStarted.Panel5}"
                                       Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.GettingStarted.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GettingStarted.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="120"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding BindingExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}"
                           Text="{DynamicResource Loc.P.GettingStarted.CT6}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GettingStarted.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Css.StyleSheet="
                            .demo { background-color: #1e293b; border-radius: 8px;
                                    padding: 12px 16px; margin: 0 0 8px 0;
                                    transition: background-color 0.15s ease-out }
                            .demo:hover { background-color: #2563eb }
                            .demo TextBlock { color: #e2e8f0; font-size: 13px }">
                        <Border Css.Class="demo">
                            <TextBlock Text="{DynamicResource Loc.P.GettingStarted.Panel6}" />
                        </Border>
                        <Border Css.Style="background-color: #0f766e; border-radius: 8px; padding: 12px 16px">
                            <TextBlock Text="{DynamicResource Loc.P.GettingStarted.Panel7}"
                                       Foreground="#ccfbf1" FontSize="13" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Margin="0,12,0,0">
                    <EditControl Height="150"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding CssExample}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
