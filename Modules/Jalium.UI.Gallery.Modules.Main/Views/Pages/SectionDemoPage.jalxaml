<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SectionDemoPage"
      Title="Section Demo">

    @section PaneFooterSection {
        <StackPanel Margin="12,8,12,12">
            <Border Background="{DynamicResource GalleryAccent}" CornerRadius="8" Padding="10,6">
                <TextBlock Text="@@RenderSection" FontSize="11" TextAlignment="Center"/>
            </Border>
            <TextBlock Text="From SectionDemoPage" FontSize="10" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    }
    @section NavHeader {
        <Border Background="{DynamicResource GalleryAccent}" CornerRadius="8" Padding="12,8" Margin="0,0,0,4">
            <TextBlock Text="Jalium.UI" FontSize="16" FontWeight="Bold"/>
        </Border>
    }
    @section NavItems {
        <StackPanel Margin="0,4,0,4">
            <TextBlock Text="  Home" FontSize="13" Margin="0,4,0,4"/>
            <TextBlock Text="  Components" FontSize="13" Margin="0,4,0,4"/>
            <TextBlock Text="  Settings" FontSize="13" Margin="0,4,0,4"/>
        </StackPanel>
    }
    @section NavFooter {
        <Border Background="#2D7D2D" CornerRadius="8" Padding="10,6">
            <TextBlock Text="v1.0 - Section Demo" FontSize="11" TextAlignment="Center"/>
        </Border>
    }
    @section PageTitle {
        <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
    }
    @section PageContent {
        <StackPanel>
            <TextBlock Text="Welcome to the dashboard. This entire layout is built with @@section and @@RenderSection." FontSize="13" Margin="0,0,0,12"/>
            <Border Background="#1A3A5C" CornerRadius="8" Padding="16" Margin="0,0,0,8">
                <TextBlock Text="Card 1 - Rendered from @@RenderSection" FontSize="13"/>
            </Border>
            <Border Background="#1A5C30" CornerRadius="8" Padding="16">
                <TextBlock Text="Card 2 - Also from a section" FontSize="13"/>
            </Border>
        </StackPanel>
    }

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA &amp; BINDING" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Section" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Define reusable named blocks of markup with @@section, then render them anywhere in the page with @@RenderSection." />

        <!-- Navigation layout built from sections -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Navigation layout with sections" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A sidebar + content layout built entirely with @@section and @@RenderSection." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <StackPanel Orientation="Horizontal">
                        <!-- Simulated nav pane -->
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Width="200" Padding="12">
                            <StackPanel>
                                @RenderSection("NavHeader")
                                @RenderSection("NavItems")
                                <Border Margin="0,40,0,0">
                                    @RenderSection("NavFooter")
                                </Border>
                            </StackPanel>
                        </Border>
                        <!-- Simulated content area -->
                        <StackPanel Margin="20,12,20,12" Width="400">
                            @RenderSection("PageTitle")
                            @RenderSection("PageContent")
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Reuse the same section in several places -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Reuse sections multiple times" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The same section can be rendered in multiple locations." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        @RenderSection("NavHeader")
                        <TextBlock Text="--- separator ---" FontSize="11" Margin="0,8,0,8" TextAlignment="Center"/>
                        @RenderSection("NavHeader")
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Syntax reference -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Syntax reference" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The @@section directive declares a named block of markup; @@RenderSection emits it wherever you place the call." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="@@section NavHeader {" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock Text='    &lt;Border&gt;...&lt;/Border&gt;' FontSize="12" FontFamily="Consolas" Margin="8,2,0,0"/>
                        <TextBlock Text="}" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock Text="" FontSize="6"/>
                        <TextBlock Text="@@RenderSection(&quot;NavHeader&quot;)" FontSize="12" FontFamily="Consolas"/>
                        <TextBlock Text="@@RenderSection(&quot;NavFooter&quot;)" FontSize="12" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative JALXAML that defines the sections and renders them into a nav layout." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Sections declared in markup register automatically; unregister page-scoped ones on unload." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
