<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TimePickerPage"
      Title="TimePicker">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATE &amp; TIME" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="TimePicker" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that lets users pick a time of day, with support for 12- or 24-hour clocks and configurable minute increments." />

        <!-- Basic TimePicker -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic TimePicker" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click to open the flyout and choose a time; the second picker shows the disabled state." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <TimePicker Width="150" Margin="0,0,10,10" />
                        <TimePicker Width="150" IsEnabled="False" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Time formats -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Time Formats" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Switch between 12-hour and 24-hour clocks with the ClockIdentifier property." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="12-hour format:" Width="140" VerticalAlignment="Center"/>
                            <TimePicker Width="150" ClockIdentifier="12HourClock"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="24-hour format:" Width="140" VerticalAlignment="Center"/>
                            <TimePicker Width="150" ClockIdentifier="24HourClock"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Minute increment -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Minute Increment" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Constrain selectable minutes to fixed steps using the MinuteIncrement property." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="1 minute steps:" Width="140" VerticalAlignment="Center"/>
                            <TimePicker Width="150" MinuteIncrement="1"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="5 minute steps:" Width="140" VerticalAlignment="Center"/>
                            <TimePicker Width="150" MinuteIncrement="5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="15 minute steps:" Width="140" VerticalAlignment="Center"/>
                            <TimePicker Width="150" MinuteIncrement="15"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="30 minute steps:" Width="140" VerticalAlignment="Center"/>
                            <TimePicker Width="150" MinuteIncrement="30"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive Demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Pick a time and see the formatted result update live." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Select time:" Width="120" VerticalAlignment="Center"/>
                            <TimePicker x:Name="DemoTimePicker" Width="150"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectedTimeText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="No time selected" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Common Use Cases" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Typical scheduling scenarios such as alarms, meetings and reminders." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Alarm Time" FontSize="12" Margin="0,0,0,4"/>
                        <TimePicker Width="150" Margin="0,0,0,16"/>

                        <TextBlock Text="Meeting Start Time" FontSize="12" Margin="0,0,0,4"/>
                        <TimePicker Width="150" MinuteIncrement="15" Margin="0,0,0,16"/>

                        <TextBlock Text="Reminder Time" FontSize="12" Margin="0,0,0,4"/>
                        <TimePicker Width="150" MinuteIncrement="5"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the pickers shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating and configuring a TimePicker in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
