<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TextEffectPresenterPage"
      Title="TextEffectPresenter">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="TEXT &amp; TYPOGRAPHY" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="TextEffectPresenter" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Per-character animated text surface for lyrics, subtitles, notifications, and playful UI." />

        <!-- Card 1: Mutation API — Append / Insert / Remove / Clear -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Mutation API" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Each button triggers a call on the presenter — new graphemes enter, existing ones shift or dissipate." />

                <!-- Buttons are placed BEFORE MutationDemoHost on purpose: the demo host
                     grows with its content (AppendLine etc. add lines), and a vertical stack
                     would push anything below it downward each time content grows — which
                     breaks rapid re-clicking, since a second click lands where the button used
                     to be. Hosting the buttons above pins their on-screen position no matter
                     how tall the presenter gets. -->
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Append 'lyric '"
                            Click="OnAppendClick"
                            Margin="0,0,10,10" />
                    <Button Content="AppendLine"
                            Click="OnAppendLineClick"
                            Margin="0,0,10,10" />
                    <Button Content="Insert @3"
                            Click="OnInsertClick"
                            Margin="0,0,10,10" />
                    <Button Content="Remove 2 @3"
                            Click="OnRemoveClick"
                            Margin="0,0,10,10" />
                    <Button Content="Clear"
                            Click="OnClearClick"
                            Margin="0,0,10,10" />
                    <Button Content="Reset text"
                            Click="OnResetClick"
                            Margin="0,0,10,10" />
                </WrapPanel>

                <Border x:Name="MutationDemoHost"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="100" />
            </StackPanel>
        </Border>

        <!-- Card 2: Built-in effects -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Built-in Effects" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Swap the per-cell animation driver. Each button re-enters the text so you see the full enter animation." />

                <Border x:Name="EffectSwitchDemoHost"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="80" />

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="RiseSettle (default)"
                            Click="OnUseRiseSettleClick"
                            Margin="0,0,10,10" />
                    <Button Content="FadeIn"
                            Click="OnUseFadeInClick"
                            Margin="0,0,10,10" />
                    <Button Content="Typewriter"
                            Click="OnUseTypewriterClick"
                            Margin="0,0,10,10" />
                    <Button Content="WaveBounce"
                            Click="OnUseWaveBounceClick"
                            Margin="0,0,10,10" />
                    <Button Content="PulsingBlur (GPU shader)"
                            Click="OnUsePulsingBlurClick"
                            Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Card 3: Compose with UIElement.Effect (GPU pass) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Composition with UIElement.Effect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The per-cell animation (TextEffect) runs first on CPU, then the whole surface goes through a GPU pixel-shader pass (UIElement.Effect). Toggle a BlurEffect on top to see the two layers compose." />

                <Border x:Name="EffectComposeDemoHost"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="80" />

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="No GPU effect"
                            Click="OnNoGpuEffectClick"
                            Margin="0,0,10,10" />
                    <Button Content="BlurEffect 4px"
                            Click="OnBlur4Click"
                            Margin="0,0,10,10" />
                    <Button Content="BlurEffect 10px"
                            Click="OnBlur10Click"
                            Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Markup for the demo host surface and the mutation buttons wired to the presenter." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="220"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating the presenter, wiring the mutation handlers, swapping drivers, and composing a GPU blur." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="320"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
