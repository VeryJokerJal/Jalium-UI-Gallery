<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TextEffectPresenterPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="TextEffectPresenter">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.TextAndTypography}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.TextEffectPresenter.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.TextEffectPresenter.Sub1}" />

        <!-- Card 1: Mutation API — Append / Insert / Remove / Clear -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TextEffectPresenter.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TextEffectPresenter.CC1}" />

                <!-- Buttons are placed BEFORE MutationDemoHost on purpose: the demo host
                     grows with its content (AppendLine etc. add lines), and a vertical stack
                     would push anything below it downward each time content grows — which
                     breaks rapid re-clicking, since a second click lands where the button used
                     to be. Hosting the buttons above pins their on-screen position no matter
                     how tall the presenter gets. -->
                <WrapPanel Margin="0,0,0,6">
                    <Button Content="Append 'lyric '"
                            Command="{Binding AppendCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="AppendLine"
                            Command="{Binding AppendLineCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Insert @3"
                            Command="{Binding InsertCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Remove 2 @3"
                            Command="{Binding RemoveCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Reset text"
                            Command="{Binding ResetCommand}"
                            Margin="0,0,10,10" />
                </WrapPanel>

                <Border x:Name="MutationDemoHost"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="100">
                    <TextEffectPresenter Text="{Binding MutationText}"
                                         FontSize="28"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource GalleryTextPrimary}"
                                         behaviors:TextEffectPresenterBehavior.AnimationEffect="RiseSettle" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Card 2: Built-in effects -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TextEffectPresenter.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TextEffectPresenter.CC2}" />

                <Border x:Name="EffectSwitchDemoHost"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="80">
                    <TextEffectPresenter Text="{Binding EffectText}"
                                         FontSize="28"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource GalleryTextPrimary}"
                                         behaviors:TextEffectPresenterBehavior.AnimationEffect="{Binding AnimationEffect}" />
                </Border>

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="RiseSettle (default)"
                            Command="{Binding UseRiseSettleCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="FadeIn"
                            Command="{Binding UseFadeInCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Typewriter"
                            Command="{Binding UseTypewriterCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="WaveBounce"
                            Command="{Binding UseWaveBounceCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="PulsingBlur (GPU shader)"
                            Command="{Binding UsePulsingBlurCommand}"
                            Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Card 3: Compose with UIElement.Effect (GPU pass) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TextEffectPresenter.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TextEffectPresenter.CC3}" />

                <Border x:Name="EffectComposeDemoHost"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="80">
                    <TextEffectPresenter Text="{Binding ComposeText}"
                                         FontSize="28"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource GalleryTextPrimary}"
                                         behaviors:TextEffectPresenterBehavior.AnimationEffect="WaveBounce"
                                         behaviors:TextEffectPresenterBehavior.GpuEffect="{Binding GpuEffect}" />
                </Border>

                <WrapPanel Margin="0,16,0,0">
                    <Button Content="No GPU effect"
                            Command="{Binding UseNoGpuEffectCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="BlurEffect 4px"
                            Command="{Binding UseBlur4Command}"
                            Margin="0,0,10,10" />
                    <Button Content="BlurEffect 10px"
                            Command="{Binding UseBlur10Command}"
                            Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TextEffectPresenter.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="220"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TextEffectPresenter.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="320"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
