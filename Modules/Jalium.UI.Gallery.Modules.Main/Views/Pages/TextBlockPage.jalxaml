<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TextBlockPage"
      Title="TextBlock">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="TEXT &amp; TYPOGRAPHY" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="TextBlock" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A lightweight, read-only control for displaying text, with control over font size, weight, wrapping and trimming." />

        <!-- Basic TextBlock -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic TextBlock" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Simple text display with default styling." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="This is a basic TextBlock"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="TextBlock displays read-only text content" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Font Sizes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Font Sizes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Different font size variations from caption to display." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Caption (12px)"
                                   FontSize="12"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Body (14px)"
                                   FontSize="14"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Subtitle (18px)"
                                   FontSize="18"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Title (24px)"
                                   FontSize="24"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Display (32px)"
                                   FontSize="32" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Text Wrapping -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Text Wrapping" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Long text automatically wraps to the next line when it exceeds the available width." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TextBlock Text="This is a longer piece of text that demonstrates how TextBlock handles text wrapping. When the text exceeds the available width, it automatically wraps to the next line, ensuring all content remains visible and readable."
                               FontSize="14"
                               TextWrapping="Wrap"
                               Width="400" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the text samples above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating and updating TextBlocks in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
