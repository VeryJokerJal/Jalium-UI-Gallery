<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.NetworkGraphPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="NetworkGraph">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.NetworkGraph.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.NetworkGraph.Sub1}" />

        <!-- Force-Directed Layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NetworkGraph.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NetworkGraph.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <NetworkGraph Width="600"
                                  Height="450"
                                  LayoutAlgorithm="ForceDirected"
                                  ShowLabels="True"
                                  NodeRadius="12"
                                  IsNodeDraggable="False"
                                  Title="Social Network"
                                  Nodes="{Binding ForceNodes}"
                                  Links="{Binding ForceLinks}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Circular Layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NetworkGraph.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NetworkGraph.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <NetworkGraph Width="600"
                                  Height="450"
                                  LayoutAlgorithm="Circular"
                                  ShowLabels="True"
                                  NodeRadius="14"
                                  IsNodeDraggable="False"
                                  Title="Module Dependencies"
                                  Nodes="{Binding CircularNodes}"
                                  Links="{Binding CircularLinks}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NetworkGraph.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NetworkGraph.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <NetworkGraph Width="600"
                                  Height="450"
                                  LayoutAlgorithm="ForceDirected"
                                  ShowLabels="True"
                                  NodeRadius="16"
                                  IsNodeDraggable="True"
                                  Title="Drag Nodes to Rearrange"
                                  Nodes="{Binding InteractiveNodes}"
                                  Links="{Binding InteractiveLinks}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NetworkGraph.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NetworkGraph.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
