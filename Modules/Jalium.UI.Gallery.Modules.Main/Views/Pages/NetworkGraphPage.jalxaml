<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.NetworkGraphPage"
      Title="NetworkGraph">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="NetworkGraph" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays a network visualization with nodes and links, supporting multiple layout algorithms and interactive dragging." />

        <!-- Force-Directed Layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Force-Directed Layout" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Nodes are positioned using a Fruchterman-Reingold force-directed algorithm." />
                <Border x:Name="ForceDirectedContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Circular Layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Circular Layout" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="All nodes are evenly distributed around a circle." />
                <Border x:Name="CircularContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Interactive -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Nodes can be dragged interactively. Click and drag any node to reposition it." />
                <Border x:Name="InteractiveContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the three graphs above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building nodes, links, and the graph in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
