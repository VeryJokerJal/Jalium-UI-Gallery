<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PieChartPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="PieChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.PieChart.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.PieChart.Sub1}" />

        <!-- Basic Pie Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.PieChart.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PieChart.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PieChart Height="350"
                              Title="Market Share"
                              IsLegendVisible="True"
                              ShowLabels="True"
                              LabelPosition="Outside">
                        <PieChart.Series>
                            <PieSeries Title="Market Share"
                                       DataPoints="{Binding MarketShare}" />
                        </PieChart.Series>
                    </PieChart>
                </Border>
            </StackPanel>
        </Border>

        <!-- Donut Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.PieChart.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PieChart.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PieChart Height="350"
                              Title="Storage Usage"
                              IsLegendVisible="True"
                              ShowLabels="True"
                              InnerRadiusRatio="0.5">
                        <PieChart.Series>
                            <PieSeries Title="Storage"
                                       DataPoints="{Binding StorageUsage}" />
                        </PieChart.Series>
                    </PieChart>
                </Border>
            </StackPanel>
        </Border>

        <!-- Exploded Slices -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.PieChart.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PieChart.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PieChart Height="350"
                              Title="Browser Usage"
                              IsLegendVisible="True"
                              ShowLabels="True"
                              ExplodeOffset="12">
                        <PieChart.Series>
                            <PieSeries Title="Browsers"
                                       DataPoints="{Binding BrowserUsage}" />
                        </PieChart.Series>
                    </PieChart>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PieChart.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PieChart.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
