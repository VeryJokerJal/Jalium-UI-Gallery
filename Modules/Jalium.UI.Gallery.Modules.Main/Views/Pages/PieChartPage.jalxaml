<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PieChartPage"
      Title="PieChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="PieChart" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays data as a pie or donut chart with optional slice explosion, labels, and connectors." />

        <!-- Basic Pie Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Pie Chart" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A standard pie chart with labeled slices showing proportional data." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicPieContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Donut Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Donut Chart" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A pie chart with an inner radius cut-out, creating a donut shape." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="DonutContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Exploded Slices -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Exploded Slices" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Individual slices can be pulled out from the center for emphasis." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="ExplodedPieContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the pie and donut charts above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building pie charts and configuring slices in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
