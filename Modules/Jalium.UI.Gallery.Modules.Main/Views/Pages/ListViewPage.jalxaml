<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ListViewPage"
      Title="ListView">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="COLLECTIONS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ListView" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A scrollable collection control that presents items as a plain list or as multi-column rows, with single, multiple, or extended selection." />

        <!-- Basic ListView -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic ListView" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A vertical list of selectable items." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ListView x:Name="BasicListView" Width="300" Height="200">
                        <ListViewItem Content="Item 1"/>
                        <ListViewItem Content="Item 2"/>
                        <ListViewItem Content="Item 3"/>
                        <ListViewItem Content="Item 4"/>
                        <ListViewItem Content="Item 5"/>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>

        <!-- ListView with columns -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="ListView with columns" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Switch to a GridView to lay items out across labelled columns." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ListView x:Name="GridListView" Width="500" Height="200">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="150"/>
                                <GridViewColumn Header="Type" Width="100"/>
                                <GridViewColumn Header="Size" Width="80"/>
                                <GridViewColumn Header="Modified" Width="120"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>

        <!-- Selection modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Selection modes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Single, multiple, and extended selection each behave differently on click and drag." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Single Selection" Margin="0,0,0,8" />
                            <ListView Width="150" Height="120" SelectionMode="Single">
                                <ListViewItem Content="Apple"/>
                                <ListViewItem Content="Banana"/>
                                <ListViewItem Content="Cherry"/>
                            </ListView>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Multiple Selection" Margin="0,0,0,8" />
                            <ListView Width="150" Height="120" SelectionMode="Multiple">
                                <ListViewItem Content="Red"/>
                                <ListViewItem Content="Green"/>
                                <ListViewItem Content="Blue"/>
                            </ListView>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Extended Selection" Margin="0,0,0,8" />
                            <ListView Width="150" Height="120" SelectionMode="Extended">
                                <ListViewItem Content="One"/>
                                <ListViewItem Content="Two"/>
                                <ListViewItem Content="Three"/>
                            </ListView>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Add and remove items, and watch the selection readout update." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,6">
                            <TextBox x:Name="NewItemTextBox" Width="200" Height="28" ToolTip="Enter item text" Margin="0,0,10,10"/>
                            <Button x:Name="AddItemButton" Content="Add" Width="60" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="RemoveItemButton" Content="Remove" Width="70" Height="28" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <ListView x:Name="InteractiveListView" Width="350" Height="150">
                            <ListViewItem Content="Sample Item 1"/>
                            <ListViewItem Content="Sample Item 2"/>
                            <ListViewItem Content="Sample Item 3"/>
                        </ListView>
                        <TextBlock x:Name="SelectionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="No item selected"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Common use cases" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Patterns where a list-based layout fits naturally." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="File explorers" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="Email lists" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="Contact lists" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="Task managers" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="Log viewers" />
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the lists above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Populating, editing, and observing selection in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
