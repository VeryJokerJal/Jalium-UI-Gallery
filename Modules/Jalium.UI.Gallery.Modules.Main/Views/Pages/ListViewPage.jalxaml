<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ListViewPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ListView">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Collections}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ListView.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ListView.Sub1}" />

        <!-- Basic ListView -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ListView.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ListView x:Name="BasicListView" Width="300" Height="200">
                        <ListViewItem Content="Item 1"/>
                        <ListViewItem Content="Item 2"/>
                        <ListViewItem Content="Item 3"/>
                        <ListViewItem Content="Item 4"/>
                        <ListViewItem Content="Item 5"/>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>

        <!-- ListView with columns -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ListView.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ListView x:Name="GridListView"
                              Width="500"
                              Height="200"
                              ItemsSource="{Binding Files}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="150" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/>
                                <GridViewColumn Header="Modified" Width="120" DisplayMemberBinding="{Binding Modified}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </StackPanel>
        </Border>

        <!-- Selection modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ListView.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.ListView.Cap1}" Margin="0,0,0,8" />
                            <ListView Width="150" Height="120" SelectionMode="Single">
                                <ListViewItem Content="Apple"/>
                                <ListViewItem Content="Banana"/>
                                <ListViewItem Content="Cherry"/>
                            </ListView>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.ListView.Cap2}" Margin="0,0,0,8" />
                            <ListView Width="150" Height="120" SelectionMode="Multiple">
                                <ListViewItem Content="Red"/>
                                <ListViewItem Content="Green"/>
                                <ListViewItem Content="Blue"/>
                            </ListView>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.ListView.Cap3}" Margin="0,0,0,8" />
                            <ListView Width="150" Height="120" SelectionMode="Extended">
                                <ListViewItem Content="One"/>
                                <ListViewItem Content="Two"/>
                                <ListViewItem Content="Three"/>
                            </ListView>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,6">
                            <TextBox x:Name="NewItemTextBox"
                                     Width="200"
                                     Height="28"
                                     ToolTip="{DynamicResource Loc.P.ListView.Ui1}"
                                     Margin="0,0,10,10"
                                     Text="{Binding NewItemText, Mode=TwoWay}"/>
                            <Button x:Name="AddItemButton"
                                    Content="Add"
                                    Width="60"
                                    Height="28"
                                    Margin="0,0,10,10"
                                    Command="{Binding AddItemCommand}"/>
                            <Button x:Name="RemoveItemButton"
                                    Content="Remove"
                                    Width="70"
                                    Height="28"
                                    Margin="0,0,10,10"
                                    Command="{Binding RemoveItemCommand}"/>
                        </WrapPanel>
                        <ListView x:Name="InteractiveListView"
                                  Width="350"
                                  Height="150"
                                  ItemsSource="{Binding Items}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"/>
                        <TextBlock x:Name="SelectionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding SelectionText}"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CommonUseCases2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.ListView.Chip1}" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.ListView.Chip2}" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.ListView.Chip3}" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.ListView.Chip4}" />
                        </Border>
                        <Border Style="{StaticResource GalleryChip}" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.ListView.Chip5}" />
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ListView.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
