<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:converters="clr-namespace:Jalium.UI.Gallery.Modules.Main.Converters"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      xmlns:models="clr-namespace:Jalium.UI.Gallery.Modules.Main.Models"
      xmlns:presentation="clr-namespace:Jalium.UI.Gallery.Modules.Main.Presentation"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.HomePage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Components">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:InverseBooleanToVisibilityConverter
            x:Key="InverseBooleanToVisibility" />
        <converters:StringEqualsConverter
            x:Key="StringEquals" />

        <ControlTemplate x:Key="HomeCatalogEmbeddedScrollTemplate"
                         TargetType="ListBox">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>

        <ControlTemplate x:Key="HomeCatalogPageScrollTemplate"
                         TargetType="ListBox">
            <ItemsPresenter />
        </ControlTemplate>

        <ItemsPanelTemplate x:Key="HomeCatalogEmbeddedScrollItemsPanel">
            <presentation:HomeCatalogPanel />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="HomeCatalogPageScrollItemsPanel">
            <presentation:HomeCatalogPanel
                UseAncestorScrollViewer="True" />
        </ItemsPanelTemplate>

        <Style x:Key="HomeFilterButton"
               TargetType="RadioButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Background"
                    Value="{DynamicResource GalleryCardBackground}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GalleryBorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Foreground"
                    Value="{DynamicResource GalleryTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="FilterRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FilterRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryAccentLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="FilterRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryBackgroundPressed}" />
                            <Setter TargetName="FilterRoot"
                                    Property="Opacity"
                                    Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="FilterRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryAccent}" />
                            <Setter TargetName="FilterRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeDeviceButton"
               TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GalleryBorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground"
                    Value="{DynamicResource GalleryTextTertiary}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="DeviceRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DeviceRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryBackgroundHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="DeviceRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryBackgroundPressed}" />
                            <Setter TargetName="DeviceRoot"
                                    Property="Opacity"
                                    Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DeviceRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryAccentSoft}" />
                            <Setter TargetName="DeviceRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource GalleryAccentDark}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HomeComponentCardItem"
               TargetType="ListBoxItem">
            <Setter Property="Height" Value="198" />
            <Setter Property="Background"
                    Value="{DynamicResource GalleryCardBackground}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GalleryBorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="CardRoot"
                            Height="{TemplateBinding Height}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True">
                        <Grid>
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <Border Name="SelectedBadge"
                                    Width="24"
                                    Height="24"
                                    Background="{DynamicResource GalleryAccent}"
                                    CornerRadius="8"
                                    Margin="0,10,10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Visibility="Collapsed"
                                    IsHitTestVisible="False">
                                <SymbolIcon Symbol="Accept"
                                            Width="13"
                                            Height="13"
                                            Foreground="#FFFFFFFF"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CardRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryCardAltBackground}" />
                            <Setter TargetName="CardRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryAccentLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CardRoot"
                                    Property="Opacity"
                                    Value="0.86" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="CardRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryAccent}" />
                            <Setter TargetName="CardRoot"
                                    Property="BorderThickness"
                                    Value="2" />
                            <Setter TargetName="SelectedBadge"
                                    Property="Visibility"
                                    Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
        </Style>
    </Page.Resources>

    <presentation:HomeWorkspaceGrid x:Name="HomeWorkspace"
                                    Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DetailColumn" Width="376" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="CatalogPanel"
              Grid.Column="0"
              Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{DynamicResource Loc.Home.Title}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="{DynamicResource GalleryTextPrimary}"
                               Margin="0,0,0,4" />
                    <TextBlock x:Name="CatalogPreviewSubtitle"
                        Text="{DynamicResource Loc.Home.Subtitle}"
                        FontSize="13"
                        Foreground="{DynamicResource GalleryTextTertiary}"
                        TextWrapping="Wrap" />
                    <TextBlock x:Name="CatalogDirectOpenSubtitle"
                               Text="{DynamicResource Loc.Home.DirectOpenSubtitle}"
                               FontSize="13"
                               Foreground="{DynamicResource GalleryTextTertiary}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Border Grid.Column="1"
                        Background="{DynamicResource GalleryAccentSoft}"
                        BorderBrush="{DynamicResource GalleryBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10,6"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding ResultCountText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GalleryAccentDark}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>

            <ScrollViewer x:Name="FilterScrollViewer"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                <RadioButton Content="{DynamicResource Loc.Home.FilterAll}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=All}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="All" />
                <RadioButton Content="{DynamicResource Loc.Category.Controls}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Controls}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Controls" />
                <RadioButton Content="{DynamicResource Loc.Category.Text}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Text}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Text" />
                <RadioButton Content="{DynamicResource Loc.Category.Layout}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Layout}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Layout" />
                <RadioButton Content="{DynamicResource Loc.Category.Styling}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Styling}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Styling" />
                <RadioButton Content="{DynamicResource Loc.Category.Navigation}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Navigation}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Navigation" />
                <RadioButton Content="{DynamicResource Loc.Category.Data}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Data}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Data" />
                <RadioButton Content="{DynamicResource Loc.Category.Media}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Media}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Media" />
                <RadioButton Content="{DynamicResource Loc.Category.Visuals}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Visuals}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="Visuals" />
                <RadioButton Content="{DynamicResource Loc.Category.System}"
                             GroupName="HomeFilters"
                             Style="{StaticResource HomeFilterButton}"
                             IsChecked="{Binding ActiveFilter, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=System}"
                             Command="{Binding SetFilterCommand}"
                             CommandParameter="System" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <presentation:HomeCatalogListBox
                    x:Name="ComponentList"
                    ItemsSource="{Binding VisibleItems}"
                    SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                    ActivateItemCommand="{Binding OpenItemCommand}"
                    ItemContainerStyle="{StaticResource HomeComponentCardItem}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    HorizontalContentAlignment="Stretch"
                    Template="{StaticResource HomeCatalogEmbeddedScrollTemplate}"
                    ItemsPanel="{StaticResource HomeCatalogEmbeddedScrollItemsPanel}"
                    VirtualizingPanel.CacheLength="0.5,0.5"
                    VirtualizingPanel.CacheLengthUnit="Page"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    ScrollViewer.CanContentScroll="True"
                    Visibility="{Binding HasVisibleItems, Converter={StaticResource BooleanToVisibility}}">
                    <presentation:HomeCatalogListBox.ItemTemplate>
                        <DataTemplate DataType="models:HomeCatalogItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="148" />
                                    <RowDefinition Height="50" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource GalleryCardInnerBackground}"
                                        BorderBrush="{DynamicResource GalleryBorderSubtle}"
                                        BorderThickness="0,0,0,1"
                                        IsHitTestVisible="False">
                                    <Image Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           IsHitTestVisible="False"
                                           behaviors:SaasCardImageBehavior.PageTag="{Binding PageTag}" />
                                </Border>

                                <Grid Grid.Row="1"
                                      Background="Transparent"
                                      Margin="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Vertical"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource GalleryTextPrimary}" />
                                        <TextBlock Text="{Binding CategoryLabel}"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource GalleryTextMuted}" />
                                    </StackPanel>
                                    <SymbolIcon Grid.Column="1"
                                                Symbol="ChevronRight"
                                                Width="14"
                                                Height="14"
                                                Foreground="{DynamicResource GalleryTextTertiary}"
                                                VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </presentation:HomeCatalogListBox.ItemTemplate>
                </presentation:HomeCatalogListBox>

                <Border Height="150"
                        Background="{DynamicResource GalleryCardBackground}"
                        BorderBrush="{DynamicResource GalleryBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{Binding HasVisibleItems, Converter={StaticResource InverseBooleanToVisibility}}">
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.Home.EmptyTitle}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource GalleryTextPrimary}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Loc.Home.EmptyHint}"
                                   FontSize="11"
                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Grid x:Name="DetailHost"
              Grid.Column="1"
              Grid.Row="0">
            <Border x:Name="DetailPanel"
                    Background="{DynamicResource GalleryCardBackground}"
                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Margin="16,0,0,0"
                    Padding="20,18,12,20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="{Binding HasVisibleItems, Converter={StaticResource BooleanToVisibility}}">
            <ScrollViewer x:Name="DetailScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedItem.Title}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GalleryTextPrimary}"
                               VerticalAlignment="Center" />
                    <Border Grid.Column="1"
                            Background="{DynamicResource GalleryAccentSoft}"
                            CornerRadius="8"
                            Padding="8,4">
                        <TextBlock Text="{Binding SelectedCategoryLabel}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryAccentDark}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <TextBlock Text="{Binding SelectedItem.Description}"
                           FontSize="12"
                           Foreground="{DynamicResource GalleryTextTertiary}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,10">
                    <RadioButton Content="{DynamicResource Loc.Home.DeviceDesktop}"
                                 GroupName="HomeDevices"
                                 Style="{StaticResource HomeDeviceButton}"
                                 ToolTip="{DynamicResource Loc.Home.DeviceDesktopTooltip}"
                                 IsChecked="{Binding ActiveDevice, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Desktop}"
                                 Command="{Binding SetDeviceCommand}"
                                 CommandParameter="Desktop" />
                    <RadioButton Content="{DynamicResource Loc.Home.DeviceTablet}"
                                 GroupName="HomeDevices"
                                 Style="{StaticResource HomeDeviceButton}"
                                 ToolTip="{DynamicResource Loc.Home.DeviceTabletTooltip}"
                                 IsChecked="{Binding ActiveDevice, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Tablet}"
                                 Command="{Binding SetDeviceCommand}"
                                 CommandParameter="Tablet" />
                    <RadioButton Content="{DynamicResource Loc.Home.DeviceMobile}"
                                 GroupName="HomeDevices"
                                 Style="{StaticResource HomeDeviceButton}"
                                 ToolTip="{DynamicResource Loc.Home.DeviceMobileTooltip}"
                                 IsChecked="{Binding ActiveDevice, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Mobile}"
                                 Command="{Binding SetDeviceCommand}"
                                 CommandParameter="Mobile" />
                </StackPanel>

                <Border x:Name="PreviewViewport"
                        Width="{Binding PreviewWidth}"
                        MinHeight="220"
                        Background="{DynamicResource GalleryCardInnerBackground}"
                        BorderBrush="{DynamicResource GalleryBorderDefault}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="18"
                        HorizontalAlignment="Center"
                        ClipToBounds="True">
                    <presentation:HomeComponentPreview
                        Item="{Binding SelectedItem}"
                        IsDetailed="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center" />
                </Border>

                <Button Command="{Binding OpenSelectedCommand}"
                        Style="{StaticResource GalleryPrimaryButton}"
                        automation:AutomationProperties.Name="{Binding OpenSelectedLabel}"
                        Height="44"
                        HorizontalAlignment="Stretch"
                        Margin="0,14,0,22"
                        FontSize="13"
                        FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{Binding OpenSelectedLabel}"
                                   VerticalAlignment="Center" />
                        <SymbolIcon Symbol="ChevronRight"
                                    Width="12"
                                    Height="12"
                                    Margin="6,0,0,0"
                                    Foreground="{DynamicResource GalleryTextOnAccent}" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{DynamicResource Loc.Home.MarkupHeading}"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{DynamicResource GalleryAccent}"
                           Margin="2,0,0,8" />
                <Border Background="{DynamicResource GalleryCodeSurface}"
                        BorderBrush="{DynamicResource GalleryCodeBorder}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,20">
                    <TextBlock Text="{Binding SelectedItem.Snippet}"
                               FontFamily="Cascadia Code"
                               FontSize="11"
                               Foreground="#FFD7E0E5"
                               TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="{DynamicResource Loc.Home.TokensHeading}"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="{DynamicResource GalleryTextPrimary}"
                           Margin="0,0,0,10" />
                <UniformGrid Columns="6"
                             ColumnSpacing="7">
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                Background="#FF08948A"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource Loc.Home.TokenTeal}"
                                   FontSize="8"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                Background="#FF4F46E5"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource Loc.Home.TokenIndigo}"
                                   FontSize="8"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                Background="#FF0EA5E9"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource Loc.Home.TokenSky}"
                                   FontSize="8"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                Background="#FF10B981"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource Loc.Home.TokenGreen}"
                                   FontSize="8"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                Background="#FFF59E0B"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource Loc.Home.TokenAmber}"
                                   FontSize="8"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                Background="#FFF43F5E"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Margin="0,0,0,5" />
                        <TextBlock Text="{DynamicResource Loc.Home.TokenRose}"
                                   FontSize="8"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </UniformGrid>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>
    </presentation:HomeWorkspaceGrid>
</Page>
