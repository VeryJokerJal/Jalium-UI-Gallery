<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ThumbPage"
      hosting:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.StatusAndInfo}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Thumb.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Thumb.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Thumb.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border Background="{DynamicResource GalleryCardBackground}"
                                Height="40"
                                CornerRadius="8"
                                Margin="0,0,0,16">
                            <Canvas>
                                <Thumb x:Name="DemoThumb"
                                       Width="20"
                                       Height="36"
                                       Canvas.Left="{Binding Left}"
                                       Canvas.Top="{Binding Top}"
                                       behaviors:ThumbCommandBehavior.DragStartedCommand="{Binding DragStartedCommand}"
                                       behaviors:ThumbCommandBehavior.DragDeltaCommand="{Binding DragDeltaCommand}"
                                       behaviors:ThumbCommandBehavior.DragCompletedCommand="{Binding DragCompletedCommand}" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="ThumbPositionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding PositionText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Features}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Thumb.CC2}" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Thumb.Body1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Thumb.Body2}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Thumb.Body3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.Shared.CustomizableAppearance}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Thumb.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Thumb.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
