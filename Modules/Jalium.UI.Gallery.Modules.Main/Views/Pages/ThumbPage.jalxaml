<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ThumbPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="STATUS &amp; INFO" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Thumb" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A draggable primitive that reports drag deltas — the building block behind Slider and ScrollBar thumbs." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag the thumb horizontally within the track — the position readout below updates live." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border Background="{DynamicResource GalleryCardBackground}"
                                Height="40"
                                CornerRadius="8"
                                Margin="0,0,0,16">
                            <Canvas>
                                <Thumb x:Name="DemoThumb" Width="20" Height="36" />
                            </Canvas>
                        </Border>
                        <TextBlock x:Name="ThumbPositionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Position: 0, 0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="What the Thumb primitive gives you." />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Mouse drag interaction" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• DragStarted, DragDelta, DragCompleted events" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Base for slider thumbs" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Customizable appearance" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the thumb demo above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring DragStarted, DragDelta and DragCompleted in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
