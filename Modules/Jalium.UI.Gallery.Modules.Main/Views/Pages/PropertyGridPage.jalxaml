<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PropertyGridPage"
      Title="PropertyGrid">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VIEWERS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="PropertyGrid" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays the properties of an object for viewing and editing, with categorized and alphabetical sort modes, live search and descriptions." />

        <!-- Basic property grid -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Property Grid" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Inspect and edit the properties of a sample object with the categorized view." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PropertyGrid x:Name="BasicPropertyGrid"
                                  Height="350"
                                  SortMode="Categorized"
                                  ShowSearchBox="True"
                                  ShowDescription="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Categorized vs Alphabetical -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Categorized vs Alphabetical" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Compare the two sort modes side by side on the same object." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Categorized:" Margin="0,0,0,6"/>
                            <PropertyGrid x:Name="CategorizedGrid"
                                          Height="300"
                                          SortMode="Categorized"
                                          ShowSearchBox="False"
                                          ShowDescription="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Alphabetical:" Margin="0,0,0,6"/>
                            <PropertyGrid x:Name="AlphabeticalGrid"
                                          Height="300"
                                          SortMode="Alphabetical"
                                          ShowSearchBox="False"
                                          ShowDescription="False"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom object -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Custom Object" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A richer sample object with various property types including enums, collections and nested objects." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PropertyGrid x:Name="CustomObjectGrid"
                                  Height="400"
                                  SortMode="Categorized"
                                  ShowSearchBox="True"
                                  ShowDescription="True"
                                  ShowToolBar="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the PropertyGrids shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Binding a sample object and configuring sort modes in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
