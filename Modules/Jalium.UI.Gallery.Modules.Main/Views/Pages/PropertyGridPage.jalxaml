<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PropertyGridPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="PropertyGrid">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataViewers}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.PropertyGrid.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.PropertyGrid.Sub1}" />

        <!-- Basic property grid -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.PropertyGrid.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PropertyGrid.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PropertyGrid x:Name="BasicPropertyGrid"
                                  Height="350"
                                  SelectedObject="{Binding BasicSample}"
                                  SortMode="Categorized"
                                  ShowSearchBox="True"
                                  ShowDescription="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Categorized vs Alphabetical -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.PropertyGrid.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PropertyGrid.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.PropertyGrid.Cap1}" Margin="0,0,0,6"/>
                            <PropertyGrid x:Name="CategorizedGrid"
                                          Height="300"
                                          SelectedObject="{Binding BasicSample}"
                                          SortMode="Categorized"
                                          ShowSearchBox="False"
                                          ShowDescription="False"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.PropertyGrid.Cap2}" Margin="0,0,0,6"/>
                            <PropertyGrid x:Name="AlphabeticalGrid"
                                          Height="300"
                                          SelectedObject="{Binding BasicSample}"
                                          SortMode="Alphabetical"
                                          ShowSearchBox="False"
                                          ShowDescription="False"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom object -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.PropertyGrid.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PropertyGrid.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <PropertyGrid x:Name="CustomObjectGrid"
                                  Height="400"
                                  SelectedObject="{Binding WindowSample}"
                                  SortMode="Categorized"
                                  ShowSearchBox="True"
                                  ShowDescription="True"
                                  ShowToolBar="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PropertyGrid.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.PropertyGrid.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
