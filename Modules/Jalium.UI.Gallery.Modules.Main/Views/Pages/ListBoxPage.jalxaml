<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ListBoxPage"
      Title="ListBox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="COLLECTIONS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ListBox" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A scrollable container that presents a collection of items and lets the user select one or many." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click an item to select it." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ListBox x:Name="DemoListBox"
                                 Height="150"
                                 Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="Selected: "
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedItemText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="(none)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="ListBox supports several selection modes, keyboard navigation and data binding." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="• Single selection mode (default)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="• Multiple selection mode"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="• Extended selection mode (Ctrl/Shift)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="• Keyboard navigation (Up/Down/Home/End)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="• ItemsSource binding"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="• ItemTemplate support" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for creating and populating a ListBox." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Populating items and handling selection in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
