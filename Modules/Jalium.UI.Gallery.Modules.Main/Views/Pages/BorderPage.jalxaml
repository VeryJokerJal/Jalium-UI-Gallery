<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.BorderPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Border">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Border.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Border.Sub1}" />

        <!-- Basic border -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Border.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Border.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border Width="100" Height="80"
                                Background="{DynamicResource GalleryAccent}"
                                Margin="0,0,10,10">
                            <TextBlock Text="Background"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Border>
                        <Border Width="100" Height="80"
                                BorderBrush="{DynamicResource GalleryAccent}"
                                BorderThickness="2"
                                Margin="0,0,10,10">
                            <TextBlock Text="Border Only"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Border>
                        <Border Width="100" Height="80"
                                Background="#1E3A5F"
                                BorderBrush="{DynamicResource GalleryAccent}"
                                BorderThickness="2"
                                Margin="0,0,10,10">
                            <TextBlock Text="Both"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="12"/>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Corner radius -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Border.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Border.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border Width="80" Height="80"
                                Background="#22C55E"
                                CornerRadius="0"
                                Margin="0,0,10,10">
                            <TextBlock Text="0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="80"
                                Background="#22C55E"
                                CornerRadius="14"
                                Margin="0,0,10,10">
                            <TextBlock Text="8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="80"
                                Background="#22C55E"
                                CornerRadius="16"
                                Margin="0,0,10,10">
                            <TextBlock Text="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="80"
                                Background="#22C55E"
                                CornerRadius="40"
                                Margin="0,0,10,10">
                            <TextBlock Text="40"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Border thickness -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Border.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Border.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border Width="80" Height="80"
                                BorderBrush="#179842"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,10,10">
                            <TextBlock Text="1px"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="80"
                                BorderBrush="#179842"
                                BorderThickness="2"
                                CornerRadius="8"
                                Margin="0,0,10,10">
                            <TextBlock Text="2px"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="80"
                                BorderBrush="#179842"
                                BorderThickness="4"
                                CornerRadius="8"
                                Margin="0,0,10,10">
                            <TextBlock Text="4px"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="80" Height="80"
                                BorderBrush="#179842"
                                BorderThickness="8"
                                CornerRadius="8"
                                Margin="0,0,10,10">
                            <TextBlock Text="8px"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Padding -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Border.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Border.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border Background="#CA5010"
                                BorderBrush="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="4"
                                Margin="0,0,10,10">
                            <TextBlock Text="4px" FontSize="12"/>
                        </Border>
                        <Border Background="#CA5010"
                                BorderBrush="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8"
                                Margin="0,0,10,10">
                            <TextBlock Text="8px" FontSize="12"/>
                        </Border>
                        <Border Background="#CA5010"
                                BorderBrush="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16"
                                Margin="0,0,10,10">
                            <TextBlock Text="16px" FontSize="12"/>
                        </Border>
                        <Border Background="#CA5010"
                                BorderBrush="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="24"
                                Margin="0,0,10,10">
                            <TextBlock Text="24px" FontSize="12"/>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Border.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Border.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
