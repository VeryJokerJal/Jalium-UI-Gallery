<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.QRCodePage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="QRCode">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Media}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.QRCode.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.QRCode.Sub1}" />

        <!-- Interactive generator -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.QRCode.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.QRCode.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBox x:Name="PayloadTextBox"
                                 Height="32"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,0,0,12"
                                 Text="{Binding PayloadInput, Mode=TwoWay}"
                                 ToolTip="Enter a URL or other payload..." />

                        <WrapPanel Margin="0,0,0,12">
                            <Button Content="Generate"
                                    Width="96"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding GenerateCommand}"/>
                            <Button Content="ECC L"
                                    Tag="L"
                                    Width="72"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SetErrorCorrectionCommand}"
                                    CommandParameter="L"/>
                            <Button Content="ECC M"
                                    Tag="M"
                                    Width="72"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SetErrorCorrectionCommand}"
                                    CommandParameter="M"/>
                            <Button Content="ECC Q"
                                    Tag="Q"
                                    Width="72"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SetErrorCorrectionCommand}"
                                    CommandParameter="Q"/>
                            <Button Content="ECC H"
                                    Tag="H"
                                    Width="72"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SetErrorCorrectionCommand}"
                                    CommandParameter="H"/>
                        </WrapPanel>

                        <TextBlock x:Name="GeneratorStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding GeneratorStatusText}"
                                   Margin="0,0,0,12"/>

                        <Border Background="#101010"
                                CornerRadius="14"
                                Padding="20"
                                HorizontalAlignment="Left">
                            <QRCode x:Name="DemoQRCode"
                                    Width="220"
                                    Height="220"
                                    Text="{Binding Payload}"
                                    ErrorCorrectionLevel="{Binding ErrorCorrectionLevel}" />
                        </Border>

                        <TextBlock x:Name="PayloadSummaryText"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding PayloadSummaryText}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common payloads -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.QRCode.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.QRCode.CC2}" />
                <WrapPanel>
                    <Border Style="{StaticResource GalleryDemoSurface}" Margin="0,0,10,10">
                        <StackPanel Orientation="Vertical">
                            <QRCode Text="https://jalium.dev/docs"
                                    Width="140"
                                    Height="140"
                                    QuietZoneModules="2"
                                    Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource GalleryValueLabel}"
                                       Text="{DynamicResource Loc.P.QRCode.Val1}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.QRCode.Cap1}"
                                       Width="140"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GalleryDemoSurface}" Margin="0,0,10,10">
                        <StackPanel Orientation="Vertical">
                            <QRCode Text="WIFI:T:WPA;S:JaliumGuest;P:guest12345;;"
                                    Width="140"
                                    Height="140"
                                    QuietZoneModules="2"
                                    ErrorCorrectionLevel="H"
                                    Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource GalleryValueLabel}"
                                       Text="{DynamicResource Loc.P.QRCode.Val2}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.QRCode.Cap2}"
                                       Width="140"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GalleryDemoSurface}" Margin="0,0,10,10">
                        <StackPanel Orientation="Vertical">
                            <QRCode Text="BEGIN:VCARD;FN:Jalium Team;EMAIL:hello@jalium.dev;END:VCARD;"
                                    Width="140"
                                    Height="140"
                                    QuietZoneModules="2"
                                    Margin="0,0,0,12"/>
                            <TextBlock Style="{StaticResource GalleryValueLabel}"
                                       Text="{DynamicResource Loc.P.QRCode.Val3}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.QRCode.Cap3}"
                                       Width="140"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Properties -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.QRCode.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.QRCode.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.QRCode.Body1}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.QRCode.Body2}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.QRCode.Body3}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.QRCode.Body4}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.QRCode.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.QRCode.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
