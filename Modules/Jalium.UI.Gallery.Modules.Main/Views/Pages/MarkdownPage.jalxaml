<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MarkdownPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Markdown">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.TextAndTypography}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Markdown.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Markdown.Sub1}" />

        <!-- Interactive preview -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Markdown.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button Content="{DynamicResource Loc.P.Markdown.Cmd1}"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SelectSampleCommand}"
                                    CommandParameter="Docs"/>
                            <Button Content="{DynamicResource Loc.P.Markdown.Cmd2}"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SelectSampleCommand}"
                                    CommandParameter="ReleaseNotes"/>
                            <Button Content="Checklist"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SelectSampleCommand}"
                                    CommandParameter="Checklist"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding PreviewStatus}"
                                   Margin="0,2,0,14"/>

                        <Markdown
                                  Height="360"
                                  BaseUri="https://jalium.dev/docs/"
                                  Text="{Binding InteractiveText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Live editor -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.LiveEditor}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical"
                                    Width="400"
                                    Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Markdown.Cap1}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="MarkdownInput"
                                     AcceptsReturn="True"
                                     Height="360"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Text="{Binding LiveText, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical"
                                    Width="400"
                                    Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{DynamicResource Loc.P.Markdown.Cap2}"
                                       Margin="0,0,0,6"/>
                            <Markdown Height="360"
                                      Text="{Binding LiveText}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom styling -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Markdown.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Markdown Height="280"
                              LinkForeground="#7DD3FC"
                              InlineCodeForeground="#E2E8F0"
                              InlineCodeBackground="#162133"
                              Text="{Binding StyledText}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Mermaid diagrams -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Markdown.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Markdown Height="520"
                              Text="{Binding MermaidText}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Markdown properties -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Markdown.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Markdown.Body1}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Markdown.Body2}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Markdown.Body3}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Markdown.Body4}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Selection and copy -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Markdown.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Markdown Height="240"
                                  Text="{Binding CopyDemoText}"
                                  behaviors:MarkdownBehavior.Request="{Binding CopyRequest}"/>

                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{DynamicResource Loc.P.Markdown.Cmd3}"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding CopyPlainTextCommand}"/>
                            <Button Content="{DynamicResource Loc.P.Markdown.Cmd4}"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding CopyMarkdownCommand}"/>
                            <Button Content="{DynamicResource Loc.P.Markdown.Cmd5}"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding CopyRichTextCommand}"/>
                            <Button Content="{DynamicResource Loc.P.Markdown.Cmd6}"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SelectAllCommand}"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding CopyStatus}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Markdown.CC8}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
