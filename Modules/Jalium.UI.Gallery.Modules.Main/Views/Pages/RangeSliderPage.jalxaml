<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RangeSliderPage"
      Title="RangeSlider">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="RangeSlider" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A slider with two thumbs that lets the user pick a continuous sub-range from a numeric range." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag either thumb to change RangeStart / RangeEnd. Click the track to jump the closest thumb. Tab switches keyboard focus between thumbs." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <RangeSlider x:Name="DemoRangeSlider"
                                     Minimum="0"
                                     Maximum="100"
                                     RangeStart="20"
                                     RangeEnd="80"
                                     Height="24"
                                     Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Range: " />
                            <TextBlock x:Name="RangeStartLabel" Style="{StaticResource GalleryValueLabel}" Text="20" />
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text=" — " />
                            <TextBlock x:Name="RangeEndLabel" Style="{StaticResource GalleryValueLabel}" Text="80" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Minimum gap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Minimum gap (MinimumRange)" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The two thumbs cannot get closer than MinimumRange — useful for price filters where the lower and upper bound must stay separated." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="MinimumRange = 10" Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="35"
                                     RangeEnd="65"
                                     MinimumRange="10"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Snap to ticks -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Snap to ticks" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Both thumbs snap to TickFrequency when IsSnapToTickEnabled is true." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="25"
                                     RangeEnd="75"
                                     TickFrequency="25"
                                     IsSnapToTickEnabled="True"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom bounds -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Custom bounds" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="RangeSliders can address any numeric domain, including negative numbers." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Price Filter ($0 — $1000)" Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="1000"
                                     RangeStart="100"
                                     RangeEnd="600"
                                     Height="24"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Temperature Comfort Zone (-20 — 40°C)" Margin="0,0,0,4" />
                        <RangeSlider Minimum="-20"
                                     Maximum="40"
                                     RangeStart="18"
                                     RangeEnd="24"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the RangeSliders above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring the RangeStartChanged / RangeEndChanged events and creating RangeSliders in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
