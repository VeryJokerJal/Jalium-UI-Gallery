<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RangeSliderPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="RangeSlider">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.RangeSlider.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.RangeSlider.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <RangeSlider x:Name="DemoRangeSlider"
                                     Minimum="0"
                                     Maximum="100"
                                     RangeStart="{Binding RangeStart, Mode=TwoWay}"
                                     RangeEnd="{Binding RangeEnd, Mode=TwoWay}"
                                     Height="24"
                                     Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Range: " />
                            <TextBlock x:Name="RangeStartLabel" Style="{StaticResource GalleryValueLabel}" Text="{Binding RangeStartText}" />
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text=" — " />
                            <TextBlock x:Name="RangeEndLabel" Style="{StaticResource GalleryValueLabel}" Text="{Binding RangeEndText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Minimum gap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.RangeSlider.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.RangeSlider.Cap1}" Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="35"
                                     RangeEnd="65"
                                     MinimumRange="10"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Snap to ticks -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.SnapToTicks}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="25"
                                     RangeEnd="75"
                                     TickFrequency="25"
                                     IsSnapToTickEnabled="True"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Segmented track -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.SegmentedTrack}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.RangeSlider.Cap2}"
                                   Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="20"
                                     RangeEnd="80"
                                     TickFrequency="20"
                                     IsSnapToTickEnabled="True"
                                     TrackMode="Segmented"
                                     Height="24"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.RangeSlider.Cap3}"
                                   Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="100"
                                     RangeStart="30"
                                     RangeEnd="70"
                                     TickFrequency="10"
                                     IsSnapToTickEnabled="True"
                                     SegmentGap="2"
                                     TrackMode="Segmented"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom bounds -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.RangeSlider.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.RangeSlider.Cap4}" Margin="0,0,0,4" />
                        <RangeSlider Minimum="0"
                                     Maximum="1000"
                                     RangeStart="100"
                                     RangeEnd="600"
                                     Height="24"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.RangeSlider.Cap5}" Margin="0,0,0,4" />
                        <RangeSlider Minimum="-20"
                                     Maximum="40"
                                     RangeStart="18"
                                     RangeEnd="24"
                                     Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RangeSlider.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
