<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SparklinePage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Sparkline">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Sparkline.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Sparkline.Sub1}" />

        <!-- Line Sparklines -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Sparkline.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Sparkline.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Revenue" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Revenue}" LineBrush="#417EE0" ShowHighLowPoints="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Users" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Users}" LineBrush="#4CAF50" ShowHighLowPoints="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Latency" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="80" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="Line" Values="{Binding Latency}" LineBrush="#FF9E22" ShowHighLowPoints="True" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bar & Area -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Sparkline.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Sparkline.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Sales (Bar)" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="40" SparklineType="Bar" Values="{Binding Sales}" LineBrush="#417EE0" NegativeBarBrush="#E0593E" BaselineValue="50" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Traffic (Area)" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="40" SparklineType="Area" Values="{Binding Traffic}" LineBrush="#4CAF50" FillBrush="#3C4CAF50" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Win/Loss -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Sparkline.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Sparkline.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Team Alpha" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="WinLoss" Values="{Binding TeamAlpha}" WinColor="#4CAF50" LossColor="#E0593E" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Team Beta" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="WinLoss" Values="{Binding TeamBeta}" WinColor="#4CAF50" LossColor="#E0593E" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Team Gamma" Foreground="{DynamicResource GalleryTextSecondary}" FontSize="13" Width="100" VerticalAlignment="Center" />
                            <Sparkline Width="200" Height="32" SparklineType="WinLoss" Values="{Binding TeamGamma}" WinColor="#4CAF50" LossColor="#E0593E" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Sparkline.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Sparkline.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
