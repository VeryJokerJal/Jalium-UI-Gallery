<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SparklinePage"
      Title="Sparkline">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Sparkline" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A lightweight inline chart that condenses a data series into a compact, word-sized graphic — rendered without axes, gridlines, or legends." />

        <!-- Line Sparklines -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Line Sparklines" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Multiple sparklines using the Line type with high/low point markers." />
                <Border x:Name="LineSparklineContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Bar & Area -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Bar &amp; Area" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Sparklines rendered as bar charts and area fills." />
                <Border x:Name="BarAreaContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Win/Loss -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Win/Loss" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Win/Loss sparklines showing positive and negative outcomes." />
                <Border x:Name="WinLossContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the sparkline variants shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Generating random-walk data and building sparklines in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
