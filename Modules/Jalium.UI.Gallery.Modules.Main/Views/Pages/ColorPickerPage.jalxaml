<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ColorPickerPage"
      Title="ColorPicker">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="PICKERS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ColorPicker" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that lets users pick a color from a spectrum and sliders, with an optional alpha channel and a compact layout for tight spaces." />

        <!-- Basic ColorPicker -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic ColorPicker" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A full-featured color picker with spectrum and sliders." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ColorPicker x:Name="BasicColorPicker" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Compact ColorPicker -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Compact ColorPicker" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A more compact version for space-limited scenarios." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ColorPicker IsCompact="True" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ColorPicker options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="ColorPicker options" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Configure which components are visible, such as the alpha channel." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="With Alpha Channel:" Margin="0,0,0,8" />
                        <ColorPicker IsAlphaEnabled="True" Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Without Alpha Channel:" Margin="0,0,0,8" />
                        <ColorPicker IsAlphaEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Select a color and see it applied to the live preview swatch." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <ColorPicker x:Name="DemoColorPicker" Width="300" Margin="0,0,10,10" />
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Preview:" Margin="0,0,0,8" />
                            <Border x:Name="ColorPreview"
                                    Width="100"
                                    Height="100"
                                    Background="{DynamicResource GalleryAccent}"
                                    CornerRadius="14"
                                    Margin="0,0,0,12" />
                            <TextBlock x:Name="ColorHexText"
                                       Text="#FFD60A"
                                       FontFamily="Consolas"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Common use cases" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Examples of ColorPicker paired with a swatch and a trigger button." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Text Color:" Width="120" />
                            <Border Background="#FF0000" Width="32" Height="32" CornerRadius="8" Margin="0,0,8,0" />
                            <Button Content="Choose..." Width="80" Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Background:" Width="120" />
                            <Border Background="#00FF00" Width="32" Height="32" CornerRadius="8" Margin="0,0,8,0" />
                            <Button Content="Choose..." Width="80" Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Border Color:" Width="120" />
                            <Border Background="#0000FF" Width="32" Height="32" CornerRadius="8" Margin="0,0,8,0" />
                            <Button Content="Choose..." Width="80" Height="28" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the color pickers above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Handling ColorChanged and reading the selected color in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
