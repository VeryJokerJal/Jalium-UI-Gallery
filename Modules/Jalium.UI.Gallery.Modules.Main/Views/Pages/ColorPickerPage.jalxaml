<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ColorPickerPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ColorPicker">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.P.ColorPicker.Eyebrow1}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ColorPicker.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ColorPicker.Sub1}" />

        <!-- Basic ColorPicker -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ColorPicker.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ColorPicker x:Name="BasicColorPicker" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Compact ColorPicker -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ColorPicker.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ColorPicker IsCompact="True" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ColorPicker options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ColorPicker.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.ColorPicker.Cap1}" Margin="0,0,0,8" />
                        <ColorPicker IsAlphaEnabled="True" Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.ColorPicker.Cap2}" Margin="0,0,0,8" />
                        <ColorPicker IsAlphaEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <ColorPicker x:Name="DemoColorPicker"
                                     Width="300"
                                     Color="{Binding SelectedColor, Mode=TwoWay}"
                                     Margin="0,0,10,10" />
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.ColorPicker.Cap3}" Margin="0,0,0,8" />
                            <Border x:Name="ColorPreview"
                                    Width="100"
                                    Height="100"
                                    Background="{Binding SelectedColorBrush}"
                                    CornerRadius="14"
                                    Margin="0,0,0,12" />
                            <TextBlock x:Name="ColorHexText"
                                       Text="{Binding SelectedColorText}"
                                       FontFamily="Consolas"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CommonUseCases2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.ColorPicker.Val1}" Width="120" />
                            <Border Background="#FF0000" Width="32" Height="32" CornerRadius="8" Margin="0,0,8,0" />
                            <Button Content="Choose..." Width="80" Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.ColorPicker.Val2}" Width="120" />
                            <Border Background="#00FF00" Width="32" Height="32" CornerRadius="8" Margin="0,0,8,0" />
                            <Button Content="Choose..." Width="80" Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.ColorPicker.Val3}" Width="120" />
                            <Border Background="#0000FF" Width="32" Height="32" CornerRadius="8" Margin="0,0,8,0" />
                            <Button Content="Choose..." Width="80" Height="28" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ColorPicker.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
