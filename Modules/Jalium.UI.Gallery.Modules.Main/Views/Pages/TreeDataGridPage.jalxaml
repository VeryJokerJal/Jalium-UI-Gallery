<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TreeDataGridPage"
      Title="TreeDataGrid">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="COLLECTIONS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="TreeDataGrid" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that displays hierarchical data in a flat, column-based grid with expand/collapse support." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click arrows to expand/collapse, click rows to select, click column headers to sort." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <Button x:Name="ExpandAllButton"
                                    Content="Expand All"
                                    Margin="0,0,10,10" />
                            <Button x:Name="CollapseAllButton"
                                    Content="Collapse All"
                                    Margin="0,0,10,10" />
                        </WrapPanel>
                        <TreeDataGrid x:Name="DemoTreeDataGrid"
                                      Height="280"
                                      Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="Selected: "
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="SelectedItemText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="(none)" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="TreeDataGrid combines tree hierarchy with column-based data display." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Hierarchical expand/collapse with indentation"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Reuses DataGrid column types (Text, CheckBox, Template, etc.)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Row virtualization for large datasets"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Column sorting (recursive across all levels)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Column resizing and drag reorder"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Single and Extended selection modes"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* Keyboard navigation (arrows, Left/Right expand/collapse)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="* ChildrenPropertyPath or ChildrenSelector for data binding" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the TreeDataGrid demo above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Configuring columns, binding data and wiring events in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
