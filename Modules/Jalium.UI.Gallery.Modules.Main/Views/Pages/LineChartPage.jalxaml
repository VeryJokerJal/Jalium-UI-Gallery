<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.LineChartPage"
      Title="LineChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="LineChart" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays data as connected line segments with optional smoothing, area fill, and data point markers." />

        <!-- Basic line chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Line Chart" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A single data series rendered as a line chart with data point markers." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicChartContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Multiple series -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Multiple Series" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Overlay multiple data series on the same chart with a legend." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="MultiSeriesContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Smoothed line & area -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Smoothed Line &amp; Area" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Catmull-Rom spline smoothing with a filled area beneath the line." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="SmoothedChartContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a line chart with a single series." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a multi-series line chart with smoothing and area fill in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
