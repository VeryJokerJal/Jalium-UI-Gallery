<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ToggleSwitchPage"
      hosting:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ToggleSwitch.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ToggleSwitch.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToggleSwitch.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToggleSwitch x:Name="WifiSwitch" Header="Wi-Fi" OnContent="On" OffContent="Off" Margin="0,0,0,16" />
                        <ToggleSwitch Header="Bluetooth" IsOn="True" OnContent="Enabled" OffContent="Disabled" Margin="0,0,0,16" />
                        <ToggleSwitch Header="Airplane Mode" Margin="0,0,0,16">
                            <ToggleSwitch.OnContent>
                                <SymbolIcon Symbol="Accept" Width="14" Height="14" />
                            </ToggleSwitch.OnContent>
                            <ToggleSwitch.OffContent>
                                <SymbolIcon Symbol="Cancel" Width="14" Height="14" />
                            </ToggleSwitch.OffContent>
                        </ToggleSwitch>
                        <ToggleSwitch Header="Dark Mode" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Features}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToggleSwitch.CC2}" />
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ToggleSwitch.Body1}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ToggleSwitch.Body2}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ToggleSwitch.Body3}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ToggleSwitch.Body4}" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.ToggleSwitch.Body5}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToggleSwitch.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToggleSwitch.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
