<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.LabelPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="TEXT &amp; TYPOGRAPHY" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Label" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that displays text and can be associated with a target element, so clicking the label or pressing its access key focuses the partner control and improves form accessibility." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Each caption is a Label paired with its input; click a label to focus the field beside it." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Label Content="Username:" Width="100"/>
                            <TextBox x:Name="UsernameBox" Width="200" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Label Content="Password:" Width="100"/>
                            <PasswordBox Width="200" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Label Content="Email:" Width="100"/>
                            <TextBox Width="200" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="What the Label control brings to a form." />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Associates label with target control" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Click label to focus target" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Access key support (Alt+Key)" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Improves form accessibility" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup binding each label to its target through an access key." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating labels and wiring their Target in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
