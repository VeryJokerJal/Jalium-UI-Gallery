<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.FlowchartPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Flowchart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Flowchart.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Flowchart.Sub1}" />

        <!-- Decision flow -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Flowchart.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Flowchart.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Border Background="{DynamicResource GalleryDiagramPaper}"
                            CornerRadius="8"
                            Padding="8">
                        <MermaidDiagram Source="{Binding DecisionSource}"
                                        Height="460"
                                        HorizontalAlignment="Stretch" />
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <!-- Node shapes & edge styles -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Flowchart.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Flowchart.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Border Background="{DynamicResource GalleryDiagramPaper}"
                            CornerRadius="8"
                            Padding="8">
                        <MermaidDiagram Source="{Binding ShapesSource}"
                                        Height="240"
                                        HorizontalAlignment="Stretch" />
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <!-- Live editor -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.LiveEditor}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Flowchart.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Width="380" Margin="0,0,10,10">
                            <TextBlock Text="Flowchart Source:"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <TextBox x:Name="MermaidInput"
                                     AcceptsReturn="True"
                                     Height="320"
                                     FontFamily="Consolas"
                                     FontSize="13"
                                     Text="{Binding LiveSource, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="380" Margin="0,0,10,10">
                            <TextBlock Text="Rendered Diagram:"
                                       FontSize="12"
                                       Margin="0,0,0,4" />
                            <Border x:Name="LiveDiagramHost"
                                    Background="{DynamicResource GalleryDiagramPaper}"
                                    CornerRadius="8"
                                    Padding="8"
                                    Height="320">
                                <MermaidDiagram Source="{Binding LiveSource}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Flowchart.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Flowchart.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
