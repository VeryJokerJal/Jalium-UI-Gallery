<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.FlowchartPage"
      Title="Flowchart">

    <StackPanel Orientation="Vertical">
        <!-- Page Title -->
        <TextBlock Text="Flowchart"
                   FontSize="32"
                   Margin="0,0,0,8"/>

        <!-- Description -->
        <TextBlock Text="Lay out directed flowcharts automatically. FlowchartDiagram ranks nodes into layers and draws shapes, arrows, and edge labels; diagrams can be authored concisely as mermaid text."
                   FontSize="14"
                   TextWrapping="Wrap"
                   Margin="0,0,0,24"/>

        <!-- Flowchart Card -->
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Decision Flow"
                           FontSize="16"
                           Margin="0,0,0,4"/>
                <TextBlock Text="A flowchart with decision nodes, branch labels, and a hierarchical (top-to-bottom) layout."
                           FontSize="12"
                           Margin="0,0,0,16"/>

                <Border Background="{DynamicResource GalleryCardInnerBackground}"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel x:Name="FlowchartContainer" Orientation="Vertical"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Node Shapes Card -->
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Node Shapes &amp; Edge Styles"
                           FontSize="16"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Rectangle, rounded, stadium, circle, rhombus, hexagon, cylinder and more — with solid, dotted, and thick edges in a left-to-right layout."
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <Border Background="{DynamicResource GalleryCardInnerBackground}"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel x:Name="ShapesContainer" Orientation="Vertical"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Live Editor Card -->
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Live Editor"
                           FontSize="16"
                           Margin="0,0,0,4"/>
                <TextBlock Text="Edit the mermaid flowchart source on the left and see the diagram update on the right."
                           FontSize="12"
                           Margin="0,0,0,16"/>

                <Border Background="{DynamicResource GalleryCardInnerBackground}"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Orientation="Vertical" Width="380" Margin="0,0,16,0">
                            <TextBlock Text="Flowchart Source:"
                                       FontSize="12"
                                       Margin="0,0,0,4"/>
                            <TextBox x:Name="MermaidInput"
                                     AcceptsReturn="True"
                                     Height="320"
                                     FontFamily="Consolas"
                                     FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="380">
                            <TextBlock Text="Rendered Diagram:"
                                       FontSize="12"
                                       Margin="0,0,0,4"/>
                            <Border x:Name="LiveDiagramHost"
                                    Background="#FAFBFE"
                                    CornerRadius="8"
                                    Padding="8"
                                    Height="320"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML Code Example -->
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="XAML Code Example"
                           FontSize="16"
                           Margin="0,0,0,16"/>
                <Border Background="{DynamicResource GalleryCardInnerBackground}"
                        CornerRadius="8"
                        Padding="0"
                        HorizontalAlignment="Stretch">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# Code Example -->
        <Border Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,16">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="C# Code Example"
                           FontSize="16"
                           Margin="0,0,0,16"/>
                <Border Background="{DynamicResource GalleryCardInnerBackground}"
                        CornerRadius="8"
                        Padding="0"
                        HorizontalAlignment="Stretch">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
