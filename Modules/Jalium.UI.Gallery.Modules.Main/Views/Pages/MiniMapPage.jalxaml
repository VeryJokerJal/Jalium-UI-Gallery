<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MiniMapPage"
      Title="MiniMap">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MAPS &amp; GEO" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="MiniMap" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A mini-map control that shows a scaled-down overview of a target element with a draggable viewport rectangle." />

        <!-- Basic MiniMap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic MiniMap" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A ScrollViewer with large content and a MiniMap that tracks the visible area. Click the mini-map to navigate." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicMiniMapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Map Integration -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Map Integration" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A MiniMap targeting a MapView to provide a geographic overview with viewport indicator." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="MapMiniMapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Render Modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Render Modes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Multiple MiniMaps showing the None, Outline, and Simplified render modes side by side." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="RenderModesMiniMapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for wiring a MiniMap to a ScrollViewer or MapView target." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building mini-maps, setting render modes and highlight markers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
