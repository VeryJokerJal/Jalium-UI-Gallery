<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SankeyDiagramPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="SankeyDiagram">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.SankeyDiagram.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.SankeyDiagram.Sub1}" />

        <!-- Basic Sankey -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SankeyDiagram.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SankeyDiagram.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <SankeyDiagram Height="300"
                                   ShowLabels="True"
                                   ShowValues="False"
                                   Nodes="{Binding BasicNodes}"
                                   Links="{Binding BasicLinks}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Multi-Layer Flow -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SankeyDiagram.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SankeyDiagram.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <SankeyDiagram Height="320"
                                   ShowLabels="True"
                                   ShowValues="True"
                                   Nodes="{Binding TrafficNodes}"
                                   Links="{Binding TrafficLinks}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Customized -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SankeyDiagram.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SankeyDiagram.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <SankeyDiagram Height="280"
                                   ShowLabels="True"
                                   ShowValues="True"
                                   NodeWidth="24"
                                   NodeSpacing="14"
                                   LinkOpacity="0.5"
                                   LabelPosition="Right"
                                   Nodes="{Binding BudgetNodes}"
                                   Links="{Binding BudgetLinks}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SankeyDiagram.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SankeyDiagram.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
