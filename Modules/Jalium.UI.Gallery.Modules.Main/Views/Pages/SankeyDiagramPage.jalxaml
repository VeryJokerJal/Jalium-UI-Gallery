<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SankeyDiagramPage"
      Title="SankeyDiagram">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="SankeyDiagram" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A diagram control that visualizes flow data with proportionally-sized nodes and curved links." />

        <!-- Basic Sankey -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Sankey" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A simple energy flow diagram with source, conversion, and consumption nodes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicSankeyContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Multi-Layer Flow -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Multi-Layer Flow" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A Sankey diagram with 4 layers showing a website user journey funnel." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="MultiLayerSankeyContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Customized -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Customized" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A Sankey diagram with custom node colors, labels, and value display enabled." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="CustomSankeyContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declaring SankeyDiagram controls in markup with labels, values, and custom appearance." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Populating nodes and links, then applying custom node colors in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
