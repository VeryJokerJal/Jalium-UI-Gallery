<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GeographicHeatmapPage"
      Title="GeographicHeatmap">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MAPS &amp; GEO" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="GeographicHeatmap" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that renders a geographic heatmap visualization with Gaussian-blurred intensity fields and configurable gradients." />

        <!-- Basic heatmap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Heatmap" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A GeographicHeatmap with scattered heat points around a metropolitan area." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicHeatmapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Radius & intensity -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Radius &amp; Intensity" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Multiple heatmaps demonstrating different Radius and Intensity values." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="RadiusIntensityContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Color gradients -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Color Gradients" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Heatmaps with different color gradient options: default, warm, and cool." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="GradientContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the heatmaps above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building heat points and heatmaps in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
