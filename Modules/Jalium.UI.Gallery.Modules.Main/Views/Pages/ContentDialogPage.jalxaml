<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ContentDialogPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ContentDialog">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Dialogs}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ContentDialog.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ContentDialog.Sub1}" />

        <!-- Popup dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ContentDialog.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContentDialog.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="{DynamicResource Loc.P.ContentDialog.Ui1}"
                                    Command="{Binding ShowBasicDialogCommand}"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.ContentDialog.Ui2}"
                                    Command="{Binding ShowFullSizeDialogCommand}"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding PopupResult}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- In-place dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ContentDialog.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContentDialog.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Content="{DynamicResource Loc.P.ContentDialog.Ui3}"
                                    Command="{Binding ShowInlineDialogCommand}"
                                    Width="130"
                                    Height="32"/>
                        </StackPanel>

                        <Grid x:Name="InlineDialogHost"
                              Width="720"
                              Height="320">
                            <Border Background="{DynamicResource GalleryCardBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{DynamicResource Loc.P.ContentDialog.Demo1}"
                                               FontSize="18"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="{DynamicResource Loc.P.ContentDialog.Demo2}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="{DynamicResource Loc.P.ContentDialog.Demo3}"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{DynamicResource Loc.P.ContentDialog.Demo4}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ContentDialog x:Name="InlineContentDialog"
                                           Title="Apply preset to preview area"
                                           PrimaryButtonText="Apply"
                                           SecondaryButtonText="Preview Only"
                                           CloseButtonText="Cancel"
                                           DefaultButton="Primary"
                                           behaviors:ContentDialogBehavior.Request="{Binding InlineRequest}">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{DynamicResource Loc.P.ContentDialog.Demo5}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="{DynamicResource Loc.P.ContentDialog.Demo6}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <CheckBox Content="{DynamicResource Loc.P.ContentDialog.Ui4}"
                                              IsChecked="True"
                                              Margin="0,0,0,8"/>
                                    <CheckBox Content="{DynamicResource Loc.P.ContentDialog.Ui5}"
                                              IsChecked="True"
                                              Margin="0,0,0,8"/>
                                    <CheckBox Content="{DynamicResource Loc.P.ContentDialog.Ui6}"
                                              IsChecked="False"/>
                                </StackPanel>
                            </ContentDialog>
                        </Grid>

                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding InlineResult}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Deferred validation -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ContentDialog.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContentDialog.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button Content="{DynamicResource Loc.P.ContentDialog.Ui7}"
                                Command="{Binding ShowDeferredDialogCommand}"
                                Width="120"
                                Height="32"
                                Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding DeferredStatus}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContentDialog.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContentDialog.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
