<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ContentDialogPage"
      Title="ContentDialog">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DIALOGS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ContentDialog" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Modal dialogs for confirmations, inline review flows, and async validation without requiring XamlRoot." />

        <!-- Popup dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Popup ContentDialog" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Shows a classic modal dialog over the current window. Enter triggers the default button and Escape closes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="ShowBasicDialogButton"
                                    Content="Show Dialog"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10" />
                            <Button x:Name="ShowFullSizeDialogButton"
                                    Content="Full Size"
                                    Width="100"
                                    Height="32"
                                    Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="PopupDialogResultText"
                                   Style="{StaticResource GalleryBodyText}"
                                   Text="Open a dialog to see the result here." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- In-place dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="In-Place ContentDialog" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="This example keeps the dialog inside a host region to preview embedded review flows." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button x:Name="ShowInlineDialogButton"
                                    Content="Review Changes"
                                    Width="130"
                                    Height="32"/>
                        </StackPanel>

                        <Grid x:Name="InlineDialogHost"
                              Width="720"
                              Height="320">
                            <Border Background="#262626"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Theme Preset Preview"
                                               FontSize="18"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="The inline dialog below stays inside this card instead of covering the whole window, so you can review changes inline without losing surrounding context."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="Preset: Studio Contrast"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="Highlights focused elements with stronger borders, denser surfaces, and a slightly larger review region for modal content."
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <ContentDialog x:Name="InlineContentDialog"
                                           Title="Apply preset to preview area"
                                           PrimaryButtonText="Apply"
                                           SecondaryButtonText="Preview Only"
                                           CloseButtonText="Cancel"
                                           DefaultButton="Primary">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="This dialog is shown with ContentDialogPlacement.InPlace."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="It uses the surrounding card as the host surface, which makes it useful for review and configuration flows embedded in a page."
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>
                                    <CheckBox Content="Enable acrylic backdrop"
                                              IsChecked="True"
                                              Margin="0,0,0,8"/>
                                    <CheckBox Content="Use compact density"
                                              IsChecked="True"
                                              Margin="0,0,0,8"/>
                                    <CheckBox Content="Promote accent actions to title area"
                                              IsChecked="False"/>
                                </StackPanel>
                            </ContentDialog>
                        </Grid>

                        <TextBlock x:Name="InlineDialogResultText"
                                   Style="{StaticResource GalleryBodyText}"
                                   Text="The inline host is idle."
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Deferred validation -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Deferred Validation" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Primary button deferrals can run async work before the dialog is allowed to close." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button x:Name="ShowDeferredDialogButton"
                                Content="Validate Name"
                                Width="120"
                                Height="32"
                                Margin="0,0,0,12"/>
                        <TextBlock x:Name="DeferredDialogStatusText"
                                   Style="{StaticResource GalleryBodyText}"
                                   Text="Try confirming with an empty field to keep the dialog open."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declaring an in-place ContentDialog directly in markup." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building and showing popup and in-place dialogs from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
