<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.BindingPage"
      Title="Data Binding">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA &amp; BINDING" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Binding" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Connect one element's property to another element or a data source so their values stay in sync automatically, with no glue code." />

        <!-- ElementName binding -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="ElementName binding" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Bind one control directly to another element's property with ElementName. Drag the slider and the readout updates live." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="Slider value (source):"
                                   Margin="0,0,0,8" />
                        <Slider x:Name="ValueSlider"
                                Width="300"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="TextBlock bound to Slider.Value:"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="ValueDisplay"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding Value, ElementName=ValueSlider, StringFormat='Value: {0:F0}'}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Two-way binding -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Two-way ElementName binding" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="With Mode=TwoWay the value flows both ways — edit either box and the other follows instantly." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="Source TextBox:"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="SourceTextBox"
                                 Width="300"
                                 Height="32"
                                 Text="Type here..."
                                 Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="Target TextBox (bound to SourceTextBox.Text):"
                                   Margin="0,0,0,8" />
                        <TextBox x:Name="TargetTextBox"
                                 Width="300"
                                 Height="32"
                                 Text="{Binding Text, ElementName=SourceTextBox, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- JALXAML syntax -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="JALXAML syntax" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="How ElementName binding reads in JALXAML markup." />

                <Border Style="{StaticResource GalleryDemoSurface}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="&lt;!-- One-way binding to another element --&gt;"
                                   FontSize="13"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="&lt;Slider x:Name=&quot;mySlider&quot; Value=&quot;50&quot;/&gt;"
                                   FontSize="13"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="&lt;TextBlock Text=&quot;{Binding Value, ElementName=mySlider}&quot;/&gt;"
                                   FontSize="13"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="&lt;!-- Two-way binding between controls --&gt;"
                                   FontSize="13"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="&lt;TextBox x:Name=&quot;source&quot;/&gt;"
                                   FontSize="13"
                                   FontFamily="Consolas"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="&lt;TextBox Text=&quot;{Binding Text, ElementName=source, Mode=TwoWay}&quot;/&gt;"
                                   FontSize="13"
                                   FontFamily="Consolas" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Binding modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Binding modes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The direction data flows between the binding source and its target." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="OneWay — Source to target only (default)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="TwoWay — Source to target and target to source"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="OneWayToSource — Target to source only"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="OneTime — Source to target once at binding time" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Full markup for the bindings demonstrated above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating and applying the same bindings in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
