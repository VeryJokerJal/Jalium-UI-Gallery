<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MediaElementPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="MediaElement">

    <StackPanel Style="{StaticResource GalleryPageStack}">
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Media}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.MediaElement.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.MediaElement.Sub1}" />

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MediaElement.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MediaElement.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Loc.P.MediaElement.Ui1}" VerticalAlignment="Center" Width="80" Margin="0,0,10,10" />
                            <TextBox Width="320"
                                     Height="28"
                                     Margin="0,0,10,10"
                                     Text="{Binding VideoPath, Mode=TwoWay}"
                                     behaviors:SearchBoxCommandBehavior.SubmitCommand="{Binding LoadVideoCommand}"
                                     ToolTip="{DynamicResource Loc.P.MediaElement.Ui2}" />
                            <Button Content="Browse..." Command="{Binding BrowseVideoCommand}" Width="80" Height="28" Margin="0,0,10,10" />
                            <Button Content="Load" Command="{Binding LoadVideoCommand}" Width="60" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                        <Border Background="{DynamicResource GalleryMediaMat}" Width="480" Height="270" CornerRadius="8" Margin="0,0,0,16">
                            <MediaElement Width="480"
                                          Height="270"
                                          Source="{Binding VideoSource}"
                                          Volume="{Binding Volume}"
                                          SpeedRatio="{Binding SpeedRatio}"
                                          IsMuted="{Binding IsMuted}"
                                          behaviors:MediaElementBehavior.IsLooping="{Binding IsLooping}"
                                          behaviors:MediaElementBehavior.Request="{Binding VideoRequest}" />
                        </Border>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="Play" Command="{Binding PlayVideoCommand}" Width="70" Height="28" Margin="0,0,10,10" />
                            <Button Content="Pause" Command="{Binding PauseVideoCommand}" Width="70" Height="28" Margin="0,0,10,10" />
                            <Button Content="Stop" Command="{Binding StopVideoCommand}" Width="70" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MediaElement.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MediaElement.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Loc.P.MediaElement.Ui3}" VerticalAlignment="Center" Width="80" Margin="0,0,10,10" />
                            <TextBox Width="320"
                                     Height="28"
                                     Margin="0,0,10,10"
                                     Text="{Binding AudioPath, Mode=TwoWay}"
                                     behaviors:SearchBoxCommandBehavior.SubmitCommand="{Binding LoadAudioCommand}"
                                     ToolTip="{DynamicResource Loc.P.MediaElement.Ui4}" />
                            <Button Content="Browse..." Command="{Binding BrowseAudioCommand}" Width="80" Height="28" Margin="0,0,10,10" />
                            <Button Content="Load" Command="{Binding LoadAudioCommand}" Width="60" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                        <Border Background="{DynamicResource GalleryCardAltBackground}" CornerRadius="14" Padding="24" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <Ellipse Width="80" Height="80" Fill="{DynamicResource GalleryAccent}" Margin="0,0,0,16" />
                                <TextBlock Text="{Binding AudioTitle}" FontSize="16" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding AudioArtist}" FontSize="12" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <MediaElement Width="0"
                                      Height="0"
                                      Source="{Binding AudioSource}"
                                      Volume="{Binding Volume}"
                                      SpeedRatio="{Binding SpeedRatio}"
                                      IsMuted="{Binding IsMuted}"
                                      behaviors:MediaElementBehavior.IsLooping="{Binding IsLooping}"
                                      behaviors:MediaElementBehavior.TrackProgress="True"
                                      behaviors:MediaElementBehavior.Progress="{Binding AudioProgress, Mode=TwoWay}"
                                      behaviors:MediaElementBehavior.Request="{Binding AudioRequest}" />
                        <Slider Minimum="0"
                                Maximum="100"
                                Value="{Binding AudioProgress, Mode=TwoWay}"
                                Margin="0,0,0,16" />
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="Play" Command="{Binding PlayAudioCommand}" Width="55" Height="28" Margin="0,0,10,10" />
                            <Button Content="Pause" Command="{Binding PauseAudioCommand}" Width="60" Height="28" Margin="0,0,10,10" />
                            <Button Content="Stop" Command="{Binding StopAudioCommand}" Width="55" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MediaElement.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MediaElement.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Volume:" Width="100" VerticalAlignment="Center" />
                            <Slider Minimum="0"
                                    Maximum="100"
                                    Value="{Binding VolumePercent, Mode=TwoWay}"
                                    Width="200"
                                    Margin="0,0,8,0" />
                            <TextBlock Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding VolumePercent, StringFormat='{}{0:F0}%'}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Speed:" Width="100" VerticalAlignment="Center" />
                            <ComboBox Width="120"
                                      Height="28"
                                      ItemsSource="{Binding SpeedOptions}"
                                      SelectedItem="{Binding SpeedRatio, Mode=TwoWay}" />
                        </StackPanel>
                        <WrapPanel>
                            <CheckBox Content="Loop" IsChecked="{Binding IsLooping, Mode=TwoWay}" Margin="0,0,10,10" />
                            <CheckBox Content="Mute" IsChecked="{Binding IsMuted, Mode=TwoWay}" Margin="0,0,10,10" />
                            <CheckBox Content="Auto-play" IsChecked="{Binding IsAutoPlayEnabled, Mode=TwoWay}" Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MediaElement.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MediaElement.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <TextBlock Text="{DynamicResource Loc.P.MediaElement.Body1}"
                                   Style="{StaticResource GalleryBodyText}"
                                   Margin="0,0,48,12" />
                        <TextBlock Text="{DynamicResource Loc.P.MediaElement.Body2}"
                                   Style="{StaticResource GalleryBodyText}" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MediaElement.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MediaElement.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
