<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.HyperlinkButtonPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="HyperlinkButton" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A button styled as a hyperlink that navigates to a URI or runs a click handler, with automatic hover, pressed and underline states." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Standalone links navigate to a URI; links can also flow inline inside a sentence." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Vertical">
                            <HyperlinkButton Content="Visit Microsoft" NavigateUri="https://www.microsoft.com" Margin="0,0,0,8"/>
                            <HyperlinkButton Content="Open GitHub" NavigateUri="https://www.github.com" Margin="0,0,0,8"/>
                            <HyperlinkButton Content="Learn More" IsUnderlined="False" Margin="0,0,0,8"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="In paragraph context:" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="For more information, " VerticalAlignment="Center" />
                            <HyperlinkButton Content="click here" VerticalAlignment="Center"/>
                            <TextBlock Text=" or visit our " VerticalAlignment="Center" />
                            <HyperlinkButton Content="documentation" VerticalAlignment="Center"/>
                            <TextBlock Text="." VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Key capabilities provided by the control out of the box." />
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Navigate to external URLs" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Hyperlink styling (underline, color)" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Hover and pressed states" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Opens in default browser" Margin="0,0,0,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the links above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating and wiring links in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
