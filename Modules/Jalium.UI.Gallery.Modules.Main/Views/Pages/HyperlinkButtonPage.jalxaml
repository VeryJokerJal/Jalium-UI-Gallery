<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.HyperlinkButtonPage"
      hosting:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.HyperlinkButton.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.HyperlinkButton.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HyperlinkButton.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Vertical">
                            <HyperlinkButton Content="{DynamicResource Loc.P.HyperlinkButton.Ui1}" NavigateUri="https://www.microsoft.com" Margin="0,0,0,8"/>
                            <HyperlinkButton Content="{DynamicResource Loc.P.HyperlinkButton.Ui2}" NavigateUri="https://www.github.com" Margin="0,0,0,8"/>
                            <HyperlinkButton Content="{DynamicResource Loc.P.HyperlinkButton.Ui3}" IsUnderlined="False" Margin="0,0,0,8"/>
                        </StackPanel>

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.HyperlinkButton.Cap1}" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="For more information, " VerticalAlignment="Center" />
                            <HyperlinkButton Content="click here" VerticalAlignment="Center"/>
                            <TextBlock Text=" or visit our " VerticalAlignment="Center" />
                            <HyperlinkButton Content="documentation" VerticalAlignment="Center"/>
                            <TextBlock Text="." VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Features}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HyperlinkButton.CC2}" />
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.HyperlinkButton.Body1}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.HyperlinkButton.Body2}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.HyperlinkButton.Body3}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.HyperlinkButton.Body4}" Margin="0,0,0,4" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HyperlinkButton.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HyperlinkButton.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
