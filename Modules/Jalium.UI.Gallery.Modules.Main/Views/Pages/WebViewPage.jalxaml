<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.WebViewPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="WebView">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Media}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.WebView.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.WebView.Sub1}" />

        <!-- Browser demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.WebView.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.WebView.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" ClipToBounds="True">
                    <StackPanel Orientation="Vertical">
                        <!-- Address / navigation toolbar -->
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="8">
                            <WrapPanel>
                                <Button Command="{Binding BackCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Back"
                                        automation:AutomationProperties.Name="Back"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="Back" />
                                </Button>
                                <Button Command="{Binding ForwardCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Forward"
                                        automation:AutomationProperties.Name="Forward"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="Forward" />
                                </Button>
                                <Button Command="{Binding RefreshCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Refresh"
                                        automation:AutomationProperties.Name="Refresh"
                                        Margin="0,0,12,8">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                                <TextBox Height="32"
                                         Width="300"
                                         FontSize="13"
                                         Text="{Binding Address, Mode=TwoWay}"
                                         behaviors:SearchBoxCommandBehavior.SubmitCommand="{Binding NavigateCommand}"
                                         Margin="0,0,10,8" />
                                <Button Content="Go"
                                        Command="{Binding NavigateCommand}"
                                        Width="48"
                                        Height="32"
                                        Margin="0,0,10,10" />
                            </WrapPanel>
                        </Border>

                        <!-- WebView viewport -->
                        <Border Height="500"
                                ClipToBounds="True">
                            <WebView Source="{Binding InitialSource}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     behaviors:WebViewBehavior.IsEnabled="True"
                                     behaviors:WebViewBehavior.Request="{Binding RequestValue}" />
                        </Border>

                        <!-- Status strip -->
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="10,8">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="{Binding Status}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Page info -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.WebView.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.WebView.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding DocumentTitle}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding Status}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- JavaScript execution -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.WebView.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.WebView.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBox Height="32"
                                 FontSize="13"
                                 Text="{Binding Script, Mode=TwoWay}"
                                 Margin="0,0,0,8" />
                        <Button Content="Execute"
                                Command="{Binding ExecuteScriptCommand}"
                                Height="32"
                                Width="100"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding ScriptResult}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Properties -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.WebView.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.WebView.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.WebView.Body1}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.WebView.Body2}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.WebView.Body3}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.WebView.Body4}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.WebView.Body5}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.WebView.Body6}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.WebView.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.WebView.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
