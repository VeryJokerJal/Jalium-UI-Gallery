<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.StandardUICommandPage"
      Title="StandardUICommand">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="StandardUICommand" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Predefined commands with standard labels, icons, keyboard shortcuts, and descriptions for common operations." />

        <!-- Standard commands -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Standard commands" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Built-in command definitions for Cut, Copy, Paste, Delete, and more with their standard properties." />
                <Border x:Name="CommandContainer"
                        Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="200" />
            </StackPanel>
        </Border>

        <!-- Command execution -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Command execution" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click the command buttons above to execute them. The result is shown below." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TextBlock x:Name="CommandStatusText"
                               Style="{StaticResource GalleryBodyText}"
                               Text="No command executed yet." />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup that binds standard commands to a command bar." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Defining standard commands and wiring their execution in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
