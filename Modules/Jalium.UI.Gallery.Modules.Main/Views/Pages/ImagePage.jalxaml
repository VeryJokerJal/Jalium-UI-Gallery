<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ImagePage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Image">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Media}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Image.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Image.Sub1}" />

        <!-- Remote image -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Image.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border Height="300"
                                CornerRadius="8"
                                Background="{DynamicResource GalleryMediaMat}"
                                ClipToBounds="True"
                                Margin="0,0,0,12">
                            <Image Source="{Binding RasterSource}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Border>
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding RasterStatus}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stretch modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Image.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <!-- 2x2 grid comparing every stretch mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Stretch.None -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val1}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap1}" Margin="0,0,0,8" />
                            <Border Height="160"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Stretch.Fill -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val2}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap2}" Margin="0,0,0,8" />
                            <Border Height="160"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="Fill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>

                        <!-- Stretch.Uniform -->
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val3}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap3}" Margin="0,0,0,8" />
                            <Border Height="160"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>

                        <!-- Stretch.UniformToFill -->
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val4}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap4}" Margin="0,0,0,8" />
                            <Border Height="160"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- SVG image -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Image.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border Height="400"
                                CornerRadius="8"
                                Background="{DynamicResource GalleryMediaMat}"
                                ClipToBounds="True"
                                Margin="0,0,0,12">
                            <Image Source="{Binding SvgSource}"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Border>
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding SvgStatus}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- SVG stretch modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Image.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Stretch.None -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val1}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap1}" Margin="0,0,0,8" />
                            <Border Height="200"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding SvgSource}"
                                       Stretch="None"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <!-- Stretch.Fill -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val2}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap2}" Margin="0,0,0,8" />
                            <Border Height="200"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding SvgSource}"
                                       Stretch="Fill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>

                        <!-- Stretch.Uniform -->
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val3}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap3}" Margin="0,0,0,8" />
                            <Border Height="200"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding SvgSource}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>

                        <!-- Stretch.UniformToFill -->
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.Image.Val4}" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap4}" Margin="0,0,0,8" />
                            <Border Height="200"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding SvgSource}"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Styled images -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Image.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel HorizontalAlignment="Center">
                        <!-- Rounded corners -->
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap5}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border Width="150"
                                    Height="150"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="UniformToFill" />
                            </Border>
                        </StackPanel>

                        <!-- Circle -->
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap6}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border Width="150"
                                    Height="150"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    CornerRadius="75"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="UniformToFill" />
                            </Border>
                        </StackPanel>

                        <!-- Bordered -->
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Image.Cap7}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border Width="150"
                                    Height="150"
                                    Background="{DynamicResource GalleryMediaMat}"
                                    BorderBrush="#0078D4"
                                    BorderThickness="3"
                                    CornerRadius="8"
                                    ClipToBounds="True">
                                <Image Source="{Binding RasterSource}"
                                       Stretch="UniformToFill" />
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Properties -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Properties}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Image.Body1}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Image.Body2}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Image.Body3}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Image.Body4}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Image.Body5}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Image.Body6}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Image.CC8}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
