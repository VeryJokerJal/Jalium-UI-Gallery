<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ImagePage"
      Title="Image">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MEDIA" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Image" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays raster and vector images with four stretch modes, plus corner rounding, borders and clipping supplied through its ControlTemplate." />

        <!-- Remote image -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Remote image" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Image loaded from a remote URL with Stretch.Uniform." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border x:Name="ImageContainer"
                                Height="300"
                                CornerRadius="8"
                                Background="#08140C"
                                Margin="0,0,0,12" />
                        <TextBlock x:Name="ImageStatusText"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Text="Loading image..."
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stretch modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stretch modes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Compare the four stretch modes side-by-side using the same image." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <!-- 2x2 grid comparing every stretch mode -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Stretch.None -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.None" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Original size, no scaling" Margin="0,0,0,8" />
                            <Border x:Name="StretchNoneContainer"
                                    Height="160"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>

                        <!-- Stretch.Fill -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.Fill" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Fills container, may distort" Margin="0,0,0,8" />
                            <Border x:Name="StretchFillContainer"
                                    Height="160"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>

                        <!-- Stretch.Uniform -->
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.Uniform" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Fits inside, preserves ratio" Margin="0,0,0,8" />
                            <Border x:Name="StretchUniformContainer"
                                    Height="160"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>

                        <!-- Stretch.UniformToFill -->
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.UniformToFill" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Fills container, clips overflow" Margin="0,0,0,8" />
                            <Border x:Name="StretchUniformToFillContainer"
                                    Height="160"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- SVG image -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="SVG image" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A vector image rendered as true vector graphics — sharp at any resolution, with no quality loss when scaled." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border x:Name="SvgImageContainer"
                                Height="400"
                                CornerRadius="8"
                                Background="#08140C"
                                Margin="0,0,0,12" />
                        <TextBlock x:Name="SvgStatusText"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Text="Loading SVG..."
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- SVG stretch modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="SVG stretch modes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Compare the four stretch modes with an SVG vector image." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Stretch.None -->
                        <StackPanel Grid.Column="0" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.None" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Original size, no scaling" Margin="0,0,0,8" />
                            <Border x:Name="SvgStretchNoneContainer"
                                    Height="200"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>

                        <!-- Stretch.Fill -->
                        <StackPanel Grid.Column="2" Grid.Row="0">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.Fill" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Fills container, may distort" Margin="0,0,0,8" />
                            <Border x:Name="SvgStretchFillContainer"
                                    Height="200"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>

                        <!-- Stretch.Uniform -->
                        <StackPanel Grid.Column="0" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.Uniform" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Fits inside, preserves ratio" Margin="0,0,0,8" />
                            <Border x:Name="SvgStretchUniformContainer"
                                    Height="200"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>

                        <!-- Stretch.UniformToFill -->
                        <StackPanel Grid.Column="2" Grid.Row="2">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Stretch.UniformToFill" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Fills container, clips overflow" Margin="0,0,0,8" />
                            <Border x:Name="SvgStretchUniformToFillContainer"
                                    Height="200"
                                    Background="#08140C"
                                    CornerRadius="8"
                                    ClipToBounds="True" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Styled images -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Styled images" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The Image control supports CornerRadius, a border and a background brush through its ControlTemplate." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel HorizontalAlignment="Center">
                        <!-- Rounded corners -->
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Rounded" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border x:Name="RoundedImageContainer"
                                    Width="150"
                                    Height="150"
                                    Background="#08140C"
                                    CornerRadius="8" />
                        </StackPanel>

                        <!-- Circle -->
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Circle" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border x:Name="CircleImageContainer"
                                    Width="150"
                                    Height="150"
                                    Background="#08140C"
                                    CornerRadius="8" />
                        </StackPanel>

                        <!-- Bordered -->
                        <StackPanel Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}" Text="Bordered" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Border x:Name="BorderedImageContainer"
                                    Width="150"
                                    Height="150"
                                    Background="#08140C"
                                    CornerRadius="8" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Properties -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Properties" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The key properties the Image control exposes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="Source - The ImageSource to display (BitmapImage or SvgImage)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="Stretch - How the image fills its area (None, Fill, Uniform, UniformToFill)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="StretchDirection - Limits scaling direction (UpOnly, DownOnly, Both)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="Background - Background brush behind the image (via ControlTemplate)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="CornerRadius - Rounded corners with clipping (via ControlTemplate)"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="BorderBrush / BorderThickness - Border around the image (via ControlTemplate)" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for loading and styling images." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating BitmapImage and SvgImage sources and Image controls in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
