<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GanttChartPage"
      Title="GanttChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="GanttChart" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A chart control that displays tasks on a timeline with support for dependencies, milestones, and progress tracking." />

        <!-- Basic Gantt Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Gantt Chart" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A simple Gantt chart with several tasks spanning different date ranges." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicGanttContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Dependencies & Milestones -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Dependencies &amp; Milestones" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Gantt chart with dependency arrows between tasks and milestone markers." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="DependenciesGanttContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Progress Tracking -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Progress Tracking" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Gantt chart showing partial task completion with progress indicators." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="ProgressGanttContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the Gantt charts above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building tasks, dependencies and milestones in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
