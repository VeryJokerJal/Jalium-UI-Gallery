<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MenuBarPage"
      Title="MenuBar">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="MenuBar" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A horizontal bar that organizes application commands into top-level menus with flyout submenus." />

        <!-- Basic MenuBar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic MenuBar" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A standard menu bar with File, Edit, View, and Help menus, each with keyboard-gesture hints." />
                <Border x:Name="MenuBarContainer"
                        Style="{StaticResource GalleryDemoSurfaceFlush}"
                        MinHeight="28" />
            </StackPanel>
        </Border>

        <!-- Menu action log -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Menu Action Log" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click menu items to see which action was triggered." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TextBlock x:Name="MenuStatusText"
                               Style="{StaticResource GalleryBodyText}"
                               Text="No menu action yet." />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the menu shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building the menu and wiring click handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
