<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MenuFlyoutPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="MenuFlyout">

    <StackPanel Style="{StaticResource GalleryPageStack}">
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.MenusAndToolbars}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.MenuFlyout.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.MenuFlyout.Sub1}" />

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MenuFlyout.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MenuFlyout.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button Content="Show Menu"
                            Width="120"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" Command="{Binding ExecuteBasicCommand}" CommandParameter="Open" />
                                <MenuItem Header="Edit" Command="{Binding ExecuteBasicCommand}" CommandParameter="Edit" />
                                <MenuItem Header="Rename" Command="{Binding ExecuteBasicCommand}" CommandParameter="Rename" />
                                <Separator />
                                <MenuItem Header="Share" Command="{Binding ExecuteBasicCommand}" CommandParameter="Share" />
                                <MenuItem Header="Delete" Command="{Binding ExecuteBasicCommand}" CommandParameter="Delete" />
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>
                </Border>
                <TextBlock Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding BasicStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MenuFlyout.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MenuFlyout.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button Content="Show Icon Menu"
                            Width="140"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Cut"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Cut}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Cut">
                                    <MenuItem.Icon><SymbolIcon Symbol="Cut" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Copy"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Copy}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Copy">
                                    <MenuItem.Icon><SymbolIcon Symbol="Copy" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Paste"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Paste}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Paste">
                                    <MenuItem.Icon><SymbolIcon Symbol="Paste" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Undo"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Undo}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Undo">
                                    <MenuItem.Icon><SymbolIcon Symbol="Undo" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Redo"
                                          InputGestureText="{DynamicResource Loc.Shortcut.Redo}"
                                          Command="{Binding ExecuteIconCommand}"
                                          CommandParameter="Redo">
                                    <MenuItem.Icon><SymbolIcon Symbol="Redo" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>
                </Border>
                <TextBlock Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding IconStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MenuFlyout.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MenuFlyout.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button Content="View Options"
                            Width="120"
                            Height="32"
                            behaviors:ContextMenuButtonBehavior.OpenOnClick="True">
                        <ContextMenuService.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Toolbar"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsToolbarVisible, Mode=TwoWay}" />
                                <MenuItem Header="Status Bar"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsStatusBarVisible, Mode=TwoWay}" />
                                <MenuItem Header="Sidebar"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsSidebarVisible, Mode=TwoWay}" />
                                <Separator />
                                <MenuItem Header="Minimap"
                                          IsCheckable="True"
                                          IsChecked="{Binding IsMiniMapVisible, Mode=TwoWay}" />
                                <MenuItem Header="Breadcrumbs"
                                          IsCheckable="True"
                                          IsChecked="{Binding AreBreadcrumbsVisible, Mode=TwoWay}" />
                            </ContextMenu>
                        </ContextMenuService.ContextMenu>
                    </Button>
                </Border>
                <TextBlock Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding CheckStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MenuFlyout.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MenuFlyout.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
