<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MenuFlyoutPage"
      Title="MenuFlyout">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="MenuFlyout" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A flyout menu that displays a list of commands or options, typically opened from a button click." />

        <!-- Basic MenuFlyout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic MenuFlyout" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click the button to open a context menu with common actions." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button x:Name="ShowMenuButton"
                            Content="Show Menu"
                            Width="120"
                            Height="32" />
                </Border>
                <TextBlock x:Name="BasicMenuStatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="Click the button to open the menu."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- MenuFlyout with Icons -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="MenuFlyout with Icons" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Menu items can display icons alongside their labels for quick identification." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button x:Name="ShowIconMenuButton"
                            Content="Show Icon Menu"
                            Width="140"
                            Height="32" />
                </Border>
                <TextBlock x:Name="IconMenuStatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="Click the button to open the icon menu."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- MenuFlyout with Checkable Items -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="MenuFlyout with Checkable Items" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Menu items can be toggled on and off to control view options." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button x:Name="ShowCheckMenuButton"
                            Content="View Options"
                            Width="120"
                            Height="32" />
                </Border>
                <TextBlock x:Name="CheckMenuStatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="Toggle view options on/off."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the buttons that trigger each menu." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building the ContextMenu, items and click handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
