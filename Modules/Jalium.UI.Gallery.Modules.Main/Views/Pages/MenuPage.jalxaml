<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MenuPage"
      Title="Menu">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="NAVIGATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Menu" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A horizontal command bar whose items open drop-down lists of commands, keyboard shortcuts and nested submenus." />

        <!-- Basic menu -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Menu" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A standard menu with multiple items." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Menu>
                        <MenuItem Header="File">
                            <MenuItem Header="New"/>
                            <MenuItem Header="Open"/>
                            <MenuItem Header="Save"/>
                            <Separator/>
                            <MenuItem Header="Exit"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo"/>
                            <MenuItem Header="Redo"/>
                            <Separator/>
                            <MenuItem Header="Cut"/>
                            <MenuItem Header="Copy"/>
                            <MenuItem Header="Paste"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem Header="Zoom In"/>
                            <MenuItem Header="Zoom Out"/>
                            <MenuItem Header="Reset Zoom"/>
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="About"/>
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>
        </Border>

        <!-- Menu with keyboard shortcuts -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Menu with Keyboard Shortcuts" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Menu items can display keyboard shortcuts." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Menu>
                        <MenuItem Header="File">
                            <MenuItem Header="New" InputGestureText="Ctrl+N"/>
                            <MenuItem Header="Open" InputGestureText="Ctrl+O"/>
                            <MenuItem Header="Save" InputGestureText="Ctrl+S"/>
                            <MenuItem Header="Save As" InputGestureText="Ctrl+Shift+S"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo" InputGestureText="Ctrl+Z"/>
                            <MenuItem Header="Redo" InputGestureText="Ctrl+Y"/>
                            <Separator/>
                            <MenuItem Header="Cut" InputGestureText="Ctrl+X"/>
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C"/>
                            <MenuItem Header="Paste" InputGestureText="Ctrl+V"/>
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested submenus -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Nested Submenus" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Menu items can contain nested submenus." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Menu>
                        <MenuItem Header="Settings">
                            <MenuItem Header="Appearance">
                                <MenuItem Header="Theme">
                                    <MenuItem Header="Light"/>
                                    <MenuItem Header="Dark"/>
                                    <MenuItem Header="System"/>
                                </MenuItem>
                                <MenuItem Header="Font Size">
                                    <MenuItem Header="Small"/>
                                    <MenuItem Header="Medium"/>
                                    <MenuItem Header="Large"/>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="Language">
                                <MenuItem Header="English"/>
                                <MenuItem Header="中文"/>
                                <MenuItem Header="日本語"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the menus above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a menu and wiring item click handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
