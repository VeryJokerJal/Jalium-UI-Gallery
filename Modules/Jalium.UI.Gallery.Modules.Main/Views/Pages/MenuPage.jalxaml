<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MenuPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Menu">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Navigation}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Menu.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Menu.Sub1}" />

        <!-- Basic menu -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Menu.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Menu.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Menu>
                        <MenuItem Header="File">
                            <MenuItem Header="New"/>
                            <MenuItem Header="Open"/>
                            <MenuItem Header="Save"/>
                            <Separator/>
                            <MenuItem Header="Exit"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo"/>
                            <MenuItem Header="Redo"/>
                            <Separator/>
                            <MenuItem Header="Cut"/>
                            <MenuItem Header="Copy"/>
                            <MenuItem Header="Paste"/>
                        </MenuItem>
                        <MenuItem Header="View">
                            <MenuItem Header="Zoom In"/>
                            <MenuItem Header="Zoom Out"/>
                            <MenuItem Header="Reset Zoom"/>
                        </MenuItem>
                        <MenuItem Header="Help">
                            <MenuItem Header="About"/>
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>
        </Border>

        <!-- Menu with keyboard shortcuts -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Menu.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Menu.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Menu>
                        <MenuItem Header="File">
                            <MenuItem Header="New" InputGestureText="{DynamicResource Loc.Shortcut.New}"/>
                            <MenuItem Header="Open" InputGestureText="{DynamicResource Loc.Shortcut.Open}"/>
                            <MenuItem Header="Save" InputGestureText="{DynamicResource Loc.Shortcut.Save}"/>
                            <MenuItem Header="Save As" InputGestureText="{DynamicResource Loc.Shortcut.SaveAs}"/>
                        </MenuItem>
                        <MenuItem Header="Edit">
                            <MenuItem Header="Undo" InputGestureText="{DynamicResource Loc.Shortcut.Undo}"/>
                            <MenuItem Header="Redo" InputGestureText="{DynamicResource Loc.Shortcut.Redo}"/>
                            <Separator/>
                            <MenuItem Header="Cut" InputGestureText="{DynamicResource Loc.Shortcut.Cut}"/>
                            <MenuItem Header="Copy" InputGestureText="{DynamicResource Loc.Shortcut.Copy}"/>
                            <MenuItem Header="Paste" InputGestureText="{DynamicResource Loc.Shortcut.Paste}"/>
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested submenus -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Menu.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Menu.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Menu>
                        <MenuItem Header="Settings">
                            <MenuItem Header="Appearance">
                                <MenuItem Header="Theme">
                                    <MenuItem Header="Light"/>
                                    <MenuItem Header="Dark"/>
                                    <MenuItem Header="System"/>
                                </MenuItem>
                                <MenuItem Header="Font Size">
                                    <MenuItem Header="Small"/>
                                    <MenuItem Header="Medium"/>
                                    <MenuItem Header="Large"/>
                                </MenuItem>
                            </MenuItem>
                            <MenuItem Header="Language">
                                <MenuItem Header="English"/>
                                <MenuItem Header="中文"/>
                                <MenuItem Header="日本語"/>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Menu.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Menu.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
