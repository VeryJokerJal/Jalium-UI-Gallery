<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RichTextBoxPage"
      Title="RichTextBox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="TEXT &amp; TYPOGRAPHY" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="RichTextBox" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control for editing and displaying rich text documents with inline formatting such as bold, italic, fonts, sizes and colors." />

        <!-- Basic RichTextBox -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic RichTextBox" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A rich text editor for formatted text." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <RichTextBox Width="500" Height="150" />
                </Border>
            </StackPanel>
        </Border>

        <!-- RichTextBox with formatting toolbar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="RichTextBox with Formatting Toolbar" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A common text editor pairing a formatting toolbar with the document surface." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToolBar Margin="0,0,0,8">
                            <Button x:Name="BoldButton" Content="B" Width="32" Height="28" FontWeight="Bold"/>
                            <Button x:Name="ItalicButton" Content="I" Width="32" Height="28" FontStyle="Italic"/>
                            <Button x:Name="UnderlineButton" Content="U" Width="32" Height="28"/>
                            <Separator/>
                            <ComboBox Width="120" Height="28">
                                <ComboBoxItem Content="Arial"/>
                                <ComboBoxItem Content="Times New Roman"/>
                                <ComboBoxItem Content="Consolas"/>
                                <ComboBoxItem Content="Segoe UI" IsSelected="True"/>
                            </ComboBox>
                            <ComboBox Width="60" Height="28">
                                <ComboBoxItem Content="8"/>
                                <ComboBoxItem Content="10"/>
                                <ComboBoxItem Content="12" IsSelected="True"/>
                                <ComboBoxItem Content="14"/>
                                <ComboBoxItem Content="16"/>
                                <ComboBoxItem Content="18"/>
                                <ComboBoxItem Content="24"/>
                            </ComboBox>
                            <Separator/>
                            <Button Content="Color" Width="50" Height="28"/>
                        </ToolBar>
                        <RichTextBox x:Name="FormattedRichTextBox" Width="500" Height="200"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Read-only mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Read-Only Mode" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="RichTextBox can be used to display read-only formatted content." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <RichTextBox Width="500" Height="150" IsReadOnly="True" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Common Use Cases" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="RichTextBox is useful across a range of authoring scenarios." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Document editing" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Email composition" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Note-taking applications" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Content management systems" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Report generators"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the RichTextBox demos above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a FlowDocument and applying formatting to the selection in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
