<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RichTextBoxPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="RichTextBox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.TextAndTypography}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.RichTextBox.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.RichTextBox.Sub1}" />

        <!-- Basic RichTextBox -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.RichTextBox.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RichTextBox.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <RichTextBox Width="500" Height="150" />
                </Border>
            </StackPanel>
        </Border>

        <!-- RichTextBox with formatting toolbar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.RichTextBox.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RichTextBox.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToolBar Margin="0,0,0,8">
                            <Button Width="36"
                                    Height="36"
                                    ToolTip="Bold"
                                    Command="{x:Static EditingCommands.ToggleBold}"
                                    CommandTarget="{Binding ElementName=FormattedRichTextBox}"
                                    automation:AutomationProperties.Name="Bold">
                                <SymbolIcon Symbol="Bold" Width="16" Height="16" />
                            </Button>
                            <Button Width="36"
                                    Height="36"
                                    ToolTip="Italic"
                                    Command="{x:Static EditingCommands.ToggleItalic}"
                                    CommandTarget="{Binding ElementName=FormattedRichTextBox}"
                                    automation:AutomationProperties.Name="Italic">
                                <SymbolIcon Symbol="Italic" Width="16" Height="16" />
                            </Button>
                            <Button Width="36"
                                    Height="36"
                                    ToolTip="Underline"
                                    Command="{x:Static EditingCommands.ToggleUnderline}"
                                    CommandTarget="{Binding ElementName=FormattedRichTextBox}"
                                    automation:AutomationProperties.Name="Underline">
                                <SymbolIcon Symbol="Underline" Width="16" Height="16" />
                            </Button>
                        </ToolBar>
                        <RichTextBox x:Name="FormattedRichTextBox" Width="500" Height="200"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Read-only mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.ReadOnlyMode}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RichTextBox.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <RichTextBox Width="500" Height="150" IsReadOnly="True" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CommonUseCases}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RichTextBox.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RichTextBox.Body1}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RichTextBox.Body2}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RichTextBox.Body3}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RichTextBox.Body4}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.RichTextBox.Body5}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RichTextBox.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.RichTextBox.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
