<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DiffViewerPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="DiffViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataViewers}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.DiffViewer.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.DiffViewer.Sub1}" />

        <!-- Side-by-Side Diff -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DiffViewer.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DiffViewer.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <DiffViewer x:Name="SideBySideDiff"
                                ViewMode="SideBySide"
                                Height="300"
                                ShowLineNumbers="True"
                                ShowMinimap="True"
                                OriginalText="{Binding SampleOriginalText}"
                                ModifiedText="{Binding SampleModifiedText}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Unified View -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DiffViewer.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DiffViewer.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <DiffViewer x:Name="UnifiedDiff"
                                ViewMode="Unified"
                                Height="300"
                                ShowLineNumbers="True"
                                OriginalText="{Binding SampleOriginalText}"
                                ModifiedText="{Binding SampleModifiedText}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive Demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DiffViewer.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Width="400" Margin="0,0,10,10">
                                <TextBlock Text="Original Text:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="OriginalTextInput"
                                         AcceptsReturn="True"
                                         Height="120"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Text="{Binding InteractiveOriginalText, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Width="400" Margin="0,0,10,10">
                                <TextBlock Text="Modified Text:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="ModifiedTextInput"
                                         AcceptsReturn="True"
                                         Height="120"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Text="{Binding InteractiveModifiedText, Mode=TwoWay}" />
                            </StackPanel>
                        </WrapPanel>
                        <DiffViewer x:Name="InteractiveDiff"
                                    ViewMode="SideBySide"
                                    Height="250"
                                    ShowLineNumbers="True"
                                    OriginalText="{Binding InteractiveOriginalText}"
                                    ModifiedText="{Binding InteractiveModifiedText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DiffViewer.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DiffViewer.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
