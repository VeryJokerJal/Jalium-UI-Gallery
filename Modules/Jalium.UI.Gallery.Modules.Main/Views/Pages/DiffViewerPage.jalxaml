<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DiffViewerPage"
      Title="DiffViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VIEWERS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="DiffViewer" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that displays side-by-side or unified text diffs with line-level and word-level highlighting." />

        <!-- Side-by-Side Diff -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Side-by-Side Diff" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Compare two text documents with additions and removals highlighted in separate panels." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <DiffViewer x:Name="SideBySideDiff"
                                ViewMode="SideBySide"
                                Height="300"
                                ShowLineNumbers="True"
                                ShowMinimap="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Unified View -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Unified View" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Display the diff in a single unified view, similar to git diff output." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <DiffViewer x:Name="UnifiedDiff"
                                ViewMode="Unified"
                                Height="300"
                                ShowLineNumbers="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive Demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive Demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Edit the original and modified text to see the diff update in real time." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Width="400" Margin="0,0,10,10">
                                <TextBlock Text="Original Text:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="OriginalTextInput"
                                         AcceptsReturn="True"
                                         Height="120"
                                         FontFamily="Consolas"
                                         FontSize="12"/>
                            </StackPanel>
                            <StackPanel Width="400" Margin="0,0,10,10">
                                <TextBlock Text="Modified Text:" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="ModifiedTextInput"
                                         AcceptsReturn="True"
                                         Height="120"
                                         FontFamily="Consolas"
                                         FontSize="12"/>
                            </StackPanel>
                        </WrapPanel>
                        <DiffViewer x:Name="InteractiveDiff"
                                    ViewMode="SideBySide"
                                    Height="250"
                                    ShowLineNumbers="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the diff viewers above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Setting the diff text and wiring live updates from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
