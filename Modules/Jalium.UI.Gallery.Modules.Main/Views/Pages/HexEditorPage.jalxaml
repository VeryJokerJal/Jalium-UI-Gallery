<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.HexEditorPage"
      Title="HexEditor">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VIEWERS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="HexEditor" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A hex editor control that displays and edits binary data in hexadecimal format with offset, hex, and ASCII columns." />

        <!-- Basic hex editor -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Hex Editor" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Display and edit binary data with offset, hex, and ASCII columns." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <HexEditor x:Name="BasicHexEditor"
                               Height="300"
                               BytesPerRow="16"
                               ShowOffsetColumn="True"
                               ShowAsciiColumn="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Configuration options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Configuration Options" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Toggle columns and adjust bytes per row using the controls below." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="ShowAsciiCheckBox"
                                      Content="Show ASCII Column"
                                      IsChecked="True"
                                      Margin="0,0,10,10"/>
                            <CheckBox x:Name="ShowOffsetCheckBox"
                                      Content="Show Offset Column"
                                      IsChecked="True"
                                      Margin="0,0,10,10"/>
                            <CheckBox x:Name="ShowDataInterpretCheckBox"
                                      Content="Show Data Interpretation"
                                      IsChecked="False"
                                      Margin="0,0,10,10"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Bytes Per Row:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Slider x:Name="BytesPerRowSlider"
                                    Minimum="8"
                                    Maximum="32"
                                    Value="16"
                                    Width="200"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="BytesPerRowLabel"
                                       Text="16"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <HexEditor x:Name="ConfigHexEditor"
                                   Height="250"
                                   BytesPerRow="16"
                                   ShowOffsetColumn="True"
                                   ShowAsciiColumn="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Read-only mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Read-Only Mode" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A read-only hex viewer for inspecting binary data without modification." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <HexEditor x:Name="ReadOnlyHexEditor"
                               Height="200"
                               IsReadOnly="True"
                               BytesPerRow="16"
                               ShowOffsetColumn="True"
                               ShowAsciiColumn="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the hex editors above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Loading binary data and reacting to configuration changes in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
