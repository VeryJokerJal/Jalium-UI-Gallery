<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.HexEditorPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="HexEditor">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataViewers}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.HexEditor.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.HexEditor.Sub1}" />

        <!-- Basic hex editor -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.HexEditor.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HexEditor.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <HexEditor x:Name="BasicHexEditor"
                               Height="300"
                               Data="{Binding SampleData}"
                               BytesPerRow="16"
                               ShowOffsetColumn="True"
                               ShowAsciiColumn="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Configuration options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.HexEditor.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HexEditor.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox x:Name="ShowAsciiCheckBox"
                                      Content="Show ASCII Column"
                                      IsChecked="{Binding ShowAsciiColumn, Mode=TwoWay}"
                                      Margin="0,0,10,10"/>
                            <CheckBox x:Name="ShowOffsetCheckBox"
                                      Content="Show Offset Column"
                                      IsChecked="{Binding ShowOffsetColumn, Mode=TwoWay}"
                                      Margin="0,0,10,10"/>
                            <CheckBox x:Name="ShowDataInterpretCheckBox"
                                      Content="Show Data Interpretation"
                                      IsChecked="{Binding ShowDataInterpretation, Mode=TwoWay}"
                                      Margin="0,0,10,10"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Bytes Per Row:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Slider x:Name="BytesPerRowSlider"
                                    Minimum="8"
                                    Maximum="32"
                                    Value="{Binding BytesPerRow, Mode=TwoWay}"
                                    Width="200"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="BytesPerRowLabel"
                                       Text="{Binding BytesPerRow, StringFormat='{}{0:F0}'}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <HexEditor x:Name="ConfigHexEditor"
                                   Height="250"
                                   Data="{Binding SampleData}"
                                   BytesPerRow="{Binding BytesPerRow}"
                                   ShowOffsetColumn="{Binding ShowOffsetColumn}"
                                   ShowAsciiColumn="{Binding ShowAsciiColumn}"
                                   ShowDataInterpretation="{Binding ShowDataInterpretation}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Read-only mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.ReadOnlyMode}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HexEditor.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <HexEditor x:Name="ReadOnlyHexEditor"
                               Height="200"
                               Data="{Binding ReadOnlyData}"
                               IsReadOnly="True"
                               BytesPerRow="16"
                               ShowOffsetColumn="True"
                               ShowAsciiColumn="True"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HexEditor.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.HexEditor.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
