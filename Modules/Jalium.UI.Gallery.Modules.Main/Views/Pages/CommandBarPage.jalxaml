<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.CommandBarPage"
      Title="CommandBar">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="CommandBar" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A toolbar that lays out AppBarButton and related command elements, with primary commands inline and overflow support for the rest." />

        <!-- Basic CommandBar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic CommandBar" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A CommandBar with primary commands. Built programmatically in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicCommandBarContainer" Orientation="Vertical" />
                </Border>
                <TextBlock x:Name="BasicCommandBarStatus"
                           Style="{StaticResource GalleryCaptionText}"
                           Text="Click a command to see its action."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- CommandBar with Secondary Commands -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="CommandBar with Secondary Commands" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A CommandBar with primary and secondary (overflow) commands. Click the overflow button to see more." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="SecondaryCommandBarContainer" Orientation="Vertical" />
                </Border>
                <TextBlock x:Name="SecondaryCommandBarStatus"
                           Style="{StaticResource GalleryCaptionText}"
                           Text="Click the overflow (⋯) button to see secondary commands."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a CommandBar with primary and secondary commands." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a CommandBar and wiring command handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
