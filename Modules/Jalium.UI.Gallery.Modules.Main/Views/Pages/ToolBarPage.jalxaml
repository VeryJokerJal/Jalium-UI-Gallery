<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ToolBarPage"
      Title="ToolBar">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="NAVIGATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ToolBar" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A container that groups related commands and controls into a single band, using separators to cluster them into logical groups." />

        <!-- Basic ToolBar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic ToolBar" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="A toolbar with buttons." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ToolBar>
                        <Button Content="New" Width="60" Height="28"/>
                        <Button Content="Open" Width="60" Height="28"/>
                        <Button Content="Save" Width="60" Height="28"/>
                        <Separator/>
                        <Button Content="Cut" Width="50" Height="28"/>
                        <Button Content="Copy" Width="50" Height="28"/>
                        <Button Content="Paste" Width="50" Height="28"/>
                    </ToolBar>
                </Border>
            </StackPanel>
        </Border>

        <!-- ToolBar with Mixed Controls -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="ToolBar with Mixed Controls" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="Toolbars can contain various types of controls." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ToolBar>
                        <Button Content="File" Width="50" Height="28"/>
                        <Separator/>
                        <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox Width="80" Height="28">
                            <ComboBoxItem Content="50%"/>
                            <ComboBoxItem Content="75%"/>
                            <ComboBoxItem Content="100%" IsSelected="True"/>
                            <ComboBoxItem Content="150%"/>
                            <ComboBoxItem Content="200%"/>
                        </ComboBox>
                        <Separator/>
                        <CheckBox Content="Bold" Margin="4,0"/>
                        <CheckBox Content="Italic" Margin="4,0"/>
                        <Separator/>
                        <TextBox Width="150" Height="28" ToolTip="Search..."/>
                    </ToolBar>
                </Border>
            </StackPanel>
        </Border>

        <!-- ToolBar Tray -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="ToolBar Tray" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="Multiple toolbars can be organized in a tray." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToolBar Margin="0,0,0,4">
                            <Button Content="New" Width="50" Height="26"/>
                            <Button Content="Open" Width="50" Height="26"/>
                            <Button Content="Save" Width="50" Height="26"/>
                            <Button Content="Print" Width="50" Height="26"/>
                        </ToolBar>
                        <ToolBar>
                            <Button Content="Undo" Width="50" Height="26"/>
                            <Button Content="Redo" Width="50" Height="26"/>
                            <Separator/>
                            <Button Content="Find" Width="50" Height="26"/>
                            <Button Content="Replace" Width="60" Height="26"/>
                        </ToolBar>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive Demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="Click toolbar buttons to see the action." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToolBar Margin="0,0,0,16">
                            <Button x:Name="NewButton" Content="New" Width="50" Height="28"/>
                            <Button x:Name="OpenButton" Content="Open" Width="50" Height="28"/>
                            <Button x:Name="SaveButton" Content="Save" Width="50" Height="28"/>
                            <Separator/>
                            <Button x:Name="UndoButton" Content="Undo" Width="50" Height="28"/>
                            <Button x:Name="RedoButton" Content="Redo" Width="50" Height="28"/>
                        </ToolBar>
                        <TextBlock x:Name="ActionText"
                                   Text="No action performed"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="Declarative markup for the toolbars above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="Creating a toolbar and wiring button clicks in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
