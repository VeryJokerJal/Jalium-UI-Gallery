<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ToolBarPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ToolBar">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Navigation}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ToolBar.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ToolBar.Sub1}" />

        <!-- Basic ToolBar -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolBar.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.ToolBar.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ToolBar>
                        <Button Content="New" Width="60" Height="28"/>
                        <Button Content="Open" Width="60" Height="28"/>
                        <Button Content="Save" Width="60" Height="28"/>
                        <Separator/>
                        <Button Content="Cut" Width="50" Height="28"/>
                        <Button Content="Copy" Width="50" Height="28"/>
                        <Button Content="Paste" Width="50" Height="28"/>
                    </ToolBar>
                </Border>
            </StackPanel>
        </Border>

        <!-- ToolBar with Mixed Controls -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolBar.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.ToolBar.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ToolBar>
                        <Button Content="File" Width="50" Height="28"/>
                        <Separator/>
                        <TextBlock Text="Zoom:" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox Width="80" Height="28">
                            <ComboBoxItem Content="50%"/>
                            <ComboBoxItem Content="75%"/>
                            <ComboBoxItem Content="100%" IsSelected="True"/>
                            <ComboBoxItem Content="150%"/>
                            <ComboBoxItem Content="200%"/>
                        </ComboBox>
                        <Separator/>
                        <CheckBox Content="Bold" Margin="4,0"/>
                        <CheckBox Content="Italic" Margin="4,0"/>
                        <Separator/>
                        <TextBox Width="150" Height="28" ToolTip="Search..."/>
                    </ToolBar>
                </Border>
            </StackPanel>
        </Border>

        <!-- ToolBar Tray -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolBar.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.ToolBar.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToolBar Margin="0,0,0,4">
                            <Button Content="New" Width="50" Height="26"/>
                            <Button Content="Open" Width="50" Height="26"/>
                            <Button Content="Save" Width="50" Height="26"/>
                            <Button Content="Print" Width="50" Height="26"/>
                        </ToolBar>
                        <ToolBar>
                            <Button Content="Undo" Width="50" Height="26"/>
                            <Button Content="Redo" Width="50" Height="26"/>
                            <Separator/>
                            <Button Content="Find" Width="50" Height="26"/>
                            <Button Content="Replace" Width="60" Height="26"/>
                        </ToolBar>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.ToolBar.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ToolBar Margin="0,0,0,16">
                            <Button x:Name="NewButton" Content="New" Command="{Binding ExecuteCommand}" CommandParameter="New" Width="50" Height="28"/>
                            <Button x:Name="OpenButton" Content="Open" Command="{Binding ExecuteCommand}" CommandParameter="Open" Width="50" Height="28"/>
                            <Button x:Name="SaveButton" Content="Save" Command="{Binding ExecuteCommand}" CommandParameter="Save" Width="50" Height="28"/>
                            <Separator/>
                            <Button x:Name="UndoButton" Content="Undo" Command="{Binding ExecuteCommand}" CommandParameter="Undo" Width="50" Height="28"/>
                            <Button x:Name="RedoButton" Content="Redo" Command="{Binding ExecuteCommand}" CommandParameter="Redo" Width="50" Height="28"/>
                        </ToolBar>
                        <TextBlock x:Name="ActionText"
                                   Text="{Binding LastAction}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.ToolBar.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.ToolBar.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
