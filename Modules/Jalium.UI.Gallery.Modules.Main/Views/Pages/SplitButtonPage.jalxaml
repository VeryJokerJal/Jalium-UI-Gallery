<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SplitButtonPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="SplitButton">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.SplitButton.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.SplitButton.Sub1}" />

        <!-- Basic SplitButton -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SplitButton.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SplitButton.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <SplitButton x:Name="RunSplitButton"
                                     Content="Run"
                                     Width="180"
                                     Height="36"
                                     Command="{Binding RunCommand}">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Jalium.UI.Controls"
                                                    Command="{Binding SelectTargetCommand}"
                                                    CommandParameter="Jalium.UI.Controls"/>
                                    <MenuFlyoutItem Text="Jalium.UI.Core"
                                                    Command="{Binding SelectTargetCommand}"
                                                    CommandParameter="Jalium.UI.Core"/>
                                    <MenuFlyoutItem Text="Jalium.UI.Xaml"
                                                    Command="{Binding SelectTargetCommand}"
                                                    CommandParameter="Jalium.UI.Xaml"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <TextBlock x:Name="RunStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding RunStatusText}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Command + Flyout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SplitButton.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SplitButton.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <SplitButton x:Name="BuildSplitButton"
                                     Content="Build"
                                     Width="180"
                                     Height="36"
                                     Command="{Binding BuildCommand}"
                                     behaviors:SplitButtonFlyoutBehavior.IsOpen="{Binding IsBuildFlyoutOpen, Mode=TwoWay}"
                                     Margin="0,0,0,12">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Build Debug"
                                                    Command="{Binding SelectBuildCommand}"
                                                    CommandParameter="Build Debug"/>
                                    <MenuFlyoutItem Text="Build Release"
                                                    Command="{Binding SelectBuildCommand}"
                                                    CommandParameter="Build Release"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <WrapPanel>
                            <Button Content="Open Flyout"
                                    Command="{Binding OpenBuildFlyoutCommand}"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"/>
                            <Button Content="Close Flyout"
                                    Command="{Binding CloseBuildFlyoutCommand}"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"/>
                        </WrapPanel>

                        <TextBlock x:Name="BuildStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding BuildStatusText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SplitButton.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SplitButton.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
