<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SplitButtonPage"
      Title="SplitButton">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="SplitButton" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control with a primary action and a drop-down button that opens a Flyout." />

        <!-- Basic SplitButton -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic SplitButton" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Primary click runs the action. Drop-down selects the target." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <SplitButton x:Name="RunSplitButton"
                                     Content="Run"
                                     Width="180"
                                     Height="36"
                                     Click="OnRunSplitButtonClick">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Jalium.UI.Controls" Click="OnRunTargetClick"/>
                                    <MenuFlyoutItem Text="Jalium.UI.Core" Click="OnRunTargetClick"/>
                                    <MenuFlyoutItem Text="Jalium.UI.Xaml" Click="OnRunTargetClick"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <TextBlock x:Name="RunStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Selected target: Jalium.UI.Controls"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Command + Flyout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Command + Flyout" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Demonstrates Command/CommandParameter and programmatic flyout state." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <SplitButton x:Name="BuildSplitButton"
                                     Content="Build"
                                     Width="180"
                                     Height="36"
                                     Margin="0,0,0,12">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Build Debug" Click="OnBuildMenuItemClick"/>
                                    <MenuFlyoutItem Text="Build Release" Click="OnBuildMenuItemClick"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <WrapPanel>
                            <Button Content="Open Flyout"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Click="OnOpenBuildFlyoutClick"/>
                            <Button Content="Close Flyout"
                                    Width="110"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Click="OnCloseBuildFlyoutClick"/>
                        </WrapPanel>

                        <TextBlock x:Name="BuildStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Ready." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the SplitButtons above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring click handlers, commands and programmatic flyout control in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
