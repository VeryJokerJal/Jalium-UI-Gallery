<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ExpanderPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Expander">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Expander.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Expander.Sub1}" />

        <!-- Basic expander -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Expander.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Expander.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Expander Header="{DynamicResource Loc.P.Expander.Demo1}" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <TextBlock Text="{DynamicResource Loc.P.Expander.Demo2}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                        <Expander Header="{DynamicResource Loc.P.Expander.Demo3}" IsExpanded="True">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <TextBlock Text="{DynamicResource Loc.P.Expander.Demo4}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Complex content -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Expander.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Expander.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Expander Header="Settings" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox Content="{DynamicResource Loc.P.Expander.Ui1}" Margin="0,0,0,8"/>
                                    <CheckBox Content="{DynamicResource Loc.P.Expander.Ui2}" Margin="0,0,0,8"/>
                                    <CheckBox Content="{DynamicResource Loc.P.Expander.Ui3}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Width="120" Height="28">
                                            <ComboBoxItem Content="Light"/>
                                            <ComboBoxItem Content="Dark" IsSelected="True"/>
                                            <ComboBoxItem Content="System"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Expander Header="{DynamicResource Loc.P.Expander.Ui4}">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Name:" Width="80"/>
                                        <TextBox Width="200" Height="28" Text="John Doe"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Email:" Width="80"/>
                                        <TextBox Width="200" Height="28" Text="john@example.com"/>
                                    </StackPanel>
                                    <Button Content="{DynamicResource Loc.P.Expander.Ui5}" Width="120" Height="32" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested expanders -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Expander.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Expander.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Expander Header="Category A">
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="8" CornerRadius="8">
                            <StackPanel Orientation="Vertical">
                                <Expander Header="Subcategory A1" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource GalleryCardInnerBackground}" Padding="12" CornerRadius="8">
                                        <TextBlock Text="Content for Subcategory A1"/>
                                    </Border>
                                </Expander>
                                <Expander Header="Subcategory A2" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource GalleryCardInnerBackground}" Padding="12" CornerRadius="8">
                                        <TextBlock Text="Content for Subcategory A2"/>
                                    </Border>
                                </Expander>
                                <Expander Header="Subcategory A3">
                                    <Border Background="{DynamicResource GalleryCardInnerBackground}" Padding="12" CornerRadius="8">
                                        <TextBlock Text="Content for Subcategory A3"/>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Expander>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Expander.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="ExpandButton" Content="Expand" Command="{Binding ExpandCommand}" Width="80" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="CollapseButton" Content="Collapse" Command="{Binding CollapseCommand}" Width="80" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="ToggleButton" Content="Toggle" Command="{Binding ToggleCommand}" Width="80" Height="28" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Expander x:Name="ControlledExpander"
                                  Header="{DynamicResource Loc.P.Expander.Demo5}"
                                  IsExpanded="{Binding IsControlledExpanderOpen, Mode=TwoWay}">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <TextBlock Text="{DynamicResource Loc.P.Expander.Demo6}"
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Expander.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Expander.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
