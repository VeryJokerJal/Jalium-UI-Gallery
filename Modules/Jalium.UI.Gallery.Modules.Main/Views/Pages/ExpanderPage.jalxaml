<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ExpanderPage"
      Title="Expander">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Expander" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control with a clickable header that expands and collapses to reveal or hide a section of content, keeping secondary details tucked away until they are needed." />

        <!-- Basic expander -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic expander" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click the header to expand or collapse the content region." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Expander Header="Click to expand" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <TextBlock Text="This content is revealed when the expander is expanded. You can put any content here including text, images, and other controls."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                        <Expander Header="Initially expanded" IsExpanded="True">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <TextBlock Text="This expander starts in the expanded state. Click the header to collapse it."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Complex content -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Complex content" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="An expander can host any content, from checkboxes and dropdowns to full input forms." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Expander Header="Settings" Margin="0,0,0,8">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <StackPanel Orientation="Vertical">
                                    <CheckBox Content="Enable notifications" Margin="0,0,0,8"/>
                                    <CheckBox Content="Auto-save documents" Margin="0,0,0,8"/>
                                    <CheckBox Content="Show line numbers" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox Width="120" Height="28">
                                            <ComboBoxItem Content="Light"/>
                                            <ComboBoxItem Content="Dark" IsSelected="True"/>
                                            <ComboBoxItem Content="System"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                        <Expander Header="User Profile">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Name:" Width="80"/>
                                        <TextBox Width="200" Height="28" Text="John Doe"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <TextBlock Text="Email:" Width="80"/>
                                        <TextBox Width="200" Height="28" Text="john@example.com"/>
                                    </StackPanel>
                                    <Button Content="Save Changes" Width="120" Height="32" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested expanders -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Nested expanders" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Expanders can be nested to build collapsible, tree-like sections." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Expander Header="Category A">
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="8" CornerRadius="8">
                            <StackPanel Orientation="Vertical">
                                <Expander Header="Subcategory A1" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource GalleryCardInnerBackground}" Padding="12" CornerRadius="8">
                                        <TextBlock Text="Content for Subcategory A1"/>
                                    </Border>
                                </Expander>
                                <Expander Header="Subcategory A2" Margin="0,0,0,4">
                                    <Border Background="{DynamicResource GalleryCardInnerBackground}" Padding="12" CornerRadius="8">
                                        <TextBlock Text="Content for Subcategory A2"/>
                                    </Border>
                                </Expander>
                                <Expander Header="Subcategory A3">
                                    <Border Background="{DynamicResource GalleryCardInnerBackground}" Padding="12" CornerRadius="8">
                                        <TextBlock Text="Content for Subcategory A3"/>
                                    </Border>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </Expander>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drive the expander from code — expand, collapse or toggle it with the buttons." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="ExpandButton" Content="Expand" Width="80" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="CollapseButton" Content="Collapse" Width="80" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="ToggleButton" Content="Toggle" Width="80" Height="28" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <Expander x:Name="ControlledExpander" Header="Controlled Expander">
                            <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="16" CornerRadius="8">
                                <TextBlock Text="This expander can be controlled using the buttons above."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the expanders shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring the buttons to the expander and handling its expand and collapse events from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
