<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MapViewPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="MapView">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.MapsAndGeo}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.MapView.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.MapView.Sub1}" />

        <!-- Basic Map -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MapView.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MapView.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <MapView Height="300"
                             Center="{Binding BeijingCenter}"
                             ZoomLevel="12"
                             TileSource="{Binding TileSource}"
                             ShowZoomControls="True"
                             ShowScaleBar="True"
                             ShowAttribution="True"
                             IsPanEnabled="True"
                             IsZoomEnabled="True" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Markers & Overlays -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MapView.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MapView.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <MapView Height="350"
                             Center="{Binding ChinaCenter}"
                             ZoomLevel="4"
                             TileSource="{Binding TileSource}"
                             ShowZoomControls="True"
                             ShowScaleBar="True"
                             Markers="{Binding Markers}"
                             Polylines="{Binding Polylines}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Zoom Controls -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.MapView.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MapView.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <MapView Height="300"
                                 Center="{Binding ZoomCenter, Mode=TwoWay}"
                                 ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                 TileSource="{Binding TileSource}"
                                 ShowZoomControls="True"
                                 ShowScaleBar="True"
                                 IsPanEnabled="True"
                                 IsZoomEnabled="True" />
                        <TextBlock Text="{Binding ZoomLevelText}"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Margin="0,8,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Zoom In"
                                    Command="{Binding ZoomInCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Zoom Out"
                                    Command="{Binding ZoomOutCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="Reset View"
                                    Command="{Binding ResetViewCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MapView.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.MapView.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
