<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.MapViewPage"
      Title="MapView">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MAPS &amp; GEO" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="MapView" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A map control that displays slippy-map tiles with support for markers, polylines, panning, and zooming." />

        <!-- Basic Map -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Map" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A MapView centered on Beijing with default zoom controls and scale bar." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicMapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Markers & Overlays -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Markers &amp; Overlays" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A MapView with labeled markers at key locations and a polyline connecting them." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="MarkersMapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Zoom Controls -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Zoom Controls" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Interactive zoom and pan demo. Use the buttons to zoom in/out or click the map to pan." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="ZoomMapContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the maps shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building maps with markers and polylines in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
