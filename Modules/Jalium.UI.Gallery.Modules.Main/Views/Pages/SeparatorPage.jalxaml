<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SeparatorPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Separator" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A visual separator used to divide content in menus, toolbars, and other layouts." />

        <!-- Between content -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Between content" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Place a Separator between stacked blocks to draw a clean dividing line." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Section 1 Content" Margin="0,0,0,8" />
                        <Separator />
                        <TextBlock Text="Section 2 Content" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- In a menu -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="In a menu" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Separators group related commands inside menus, flyouts, and command lists." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Border Background="#3D3D40" Padding="8" CornerRadius="8" Width="200" HorizontalAlignment="Left">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="New File" Margin="4" />
                            <TextBlock Text="Open File" Margin="4" />
                            <Separator Margin="0,4" />
                            <TextBlock Text="Save" Margin="4" />
                            <TextBlock Text="Save As..." Margin="4" />
                            <Separator Margin="0,4" />
                            <TextBlock Text="Exit" Margin="4" />
                        </StackPanel>
                    </Border>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="What the Separator brings to menus, toolbars, and stacked layouts." />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Visual division of content" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Works in menus, toolbars, status bars" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Horizontal or vertical orientation" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Customizable appearance" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for separators between content, in a menu, and in a toolbar." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating separators and assembling a settings panel in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
