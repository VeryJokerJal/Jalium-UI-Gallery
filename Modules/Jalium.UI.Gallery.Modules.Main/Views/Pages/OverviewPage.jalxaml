<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.OverviewPage"
      Title="Jalium.UI Gallery Overview">

    <!--
        "ISSUE Nº 1 — THE GREEN PRESS"  ·  editorial / magazine-cover landing.

        DIRECTION: luxury editorial restraint. One oversized masthead is the
        hero; a single amber accent cuts the deep-forest field. A 1px vertical
        rule splits the cover asymmetrically into a masthead column plus a
        numbered "specimen rail" (a type-sample book), so the breadth of the
        library is implied without a card wall. A running head and a colophon
        frame it like a real journal.

        Layout: a 4-column / 3-row editorial grid
          cols  88 margin | masthead * | 1 rule | 326 specimen rail
          rows  104 running head | body * | 132 colophon
        wrapped in an atmosphere Canvas (off-canvas halo blooms + a ghost "J"
        watermark) that sits behind the type.

        Every gradient / glow / shadow / staggered fade lives in
        OverviewPage.jalxaml.cs. This markup is pure structure plus
        {DynamicResource} tokens, so it re-skins live across the forest-dark
        and mint-light palettes. Named regions let code-behind paint and
        animate them; animated children start at Opacity 0 and the FadeAnimator
        tweens every one of them back to 1. The only contract back to the shell
        is the central "Enter the Gallery" button, wired to OnEnterButtonClick.
    -->
    <Border x:Name="PosterRoot">
        <Grid>

            <!-- ============================================================ -->
            <!--  ATMOSPHERE  ·  off-canvas halo blooms + ghost glyph          -->
            <!--  (painted and glowed in code-behind; sits behind the type)    -->
            <!-- ============================================================ -->
            <Canvas x:Name="AuraLayer">
                <Border x:Name="HaloEmerald"
                        Canvas.Left="-150" Canvas.Top="380"
                        Width="560" Height="560" CornerRadius="280"
                        Opacity="0"/>
                <Border x:Name="HaloAmber"
                        Canvas.Left="1080" Canvas.Top="-160"
                        Width="420" Height="420" CornerRadius="210"
                        Opacity="0"/>
                <TextBlock x:Name="GhostGlyph"
                           Canvas.Left="690" Canvas.Top="120"
                           Text="J"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="640" FontWeight="Bold"
                           Opacity="0"
                           Foreground="{DynamicResource GalleryAccent}"/>
            </Canvas>

            <!-- ============================================================ -->
            <!--  EDITORIAL GRID                                               -->
            <!-- ============================================================ -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="104"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="132"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="326"/>
                </Grid.ColumnDefinitions>

                <!-- ===== RUNNING HEAD ===== -->
                <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                      x:Name="RunningHead" Opacity="0" Margin="0,30,40,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30"
                                Shape="SuperEllipse" SuperEllipseN="4"
                                Background="{DynamicResource GalleryAccent}"
                                VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="J"
                                       FontFamily="Segoe UI Variable Display, Segoe UI"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="#06140C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="JALIUM.UI"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource GalleryTextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="  /  THE CONTROL GALLERY"
                                   FontFamily="Cascadia Code, Consolas" FontSize="12"
                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="LiveDot" Width="8" Height="8" CornerRadius="4"
                                Background="{DynamicResource GalleryAccentLight}"
                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ISSUE Nº 1"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextTertiary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                        x:Name="HeadRule" Height="2" CornerRadius="1"
                        VerticalAlignment="Bottom" Margin="2,0,40,0" Opacity="0"
                        Background="{DynamicResource GalleryBorderSubtle}"/>

                <!-- ===== HERO MASTHEAD (LEFT) ===== -->
                <StackPanel Grid.Row="1" Grid.Column="1"
                            VerticalAlignment="Center" Margin="0,0,48,0">

                    <StackPanel x:Name="Kicker" Orientation="Horizontal"
                                Opacity="0" Margin="2,0,0,22">
                        <Border x:Name="KickerTick" Width="34" Height="6" CornerRadius="3"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                Background="{DynamicResource GalleryAccent}"/>
                        <TextBlock Text="A NATIVE .NET 10 UI PLATFORM"
                                   FontFamily="Cascadia Code, Consolas"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextSecondary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="TitleLine1" Text="Compose"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="84" FontWeight="Bold"
                               Opacity="0"
                               Foreground="{DynamicResource GalleryTextPrimary}"/>
                    <TextBlock x:Name="TitleLine2" Text="interfaces"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="84" FontWeight="Light"
                               Opacity="0"
                               Foreground="{DynamicResource GalleryTextSecondary}"/>
                    <TextBlock x:Name="TitleLine3" Text="that ship."
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontSize="84" FontWeight="Bold"
                               HorizontalAlignment="Left"
                               Opacity="0" Foreground="#F59E0B"/>

                    <TextBlock x:Name="Deck"
                               Text="WPF-grade ergonomics, a GPU-accelerated renderer, one XAML dialect across desktop, mobile and web — with every control proven live in this gallery."
                               FontFamily="Segoe UI" FontSize="16"
                               MaxWidth="520" Opacity="0" TextWrapping="Wrap"
                               HorizontalAlignment="Left" Margin="4,28,0,0"
                               Foreground="{DynamicResource GalleryTextTertiary}"/>

                    <StackPanel x:Name="CtaRow" Orientation="Horizontal"
                                Opacity="0" Margin="4,38,0,0" VerticalAlignment="Center">
                        <Button x:Name="EnterButton"
                                Content="Enter the Gallery  →"
                                Click="OnEnterButtonClick"
                                Height="56" MinWidth="248"
                                FontSize="16" FontWeight="Bold"
                                Padding="32,0,32,0"/>
                        <StackPanel Margin="22,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="press [ enter ] to load the gallery"
                                       FontFamily="Cascadia Code, Consolas" FontSize="12"
                                       Foreground="{DynamicResource GalleryTextSecondary}"/>
                            <TextBlock Text="120+ controls · live · gpu · native-aot"
                                       FontFamily="Cascadia Code, Consolas" FontSize="11"
                                       Foreground="{DynamicResource GalleryTextMuted}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ===== VERTICAL RULE ===== -->
                <Border Grid.Row="1" Grid.Column="2"
                        x:Name="SpineRule" Width="1" Opacity="0"
                        VerticalAlignment="Stretch" Margin="0,24,0,24"
                        Background="{DynamicResource GalleryBorderSubtle}"/>

                <!-- ===== SPECIMEN RAIL (RIGHT) ===== -->
                <StackPanel Grid.Row="1" Grid.Column="3"
                            VerticalAlignment="Center" Margin="34,0,40,0">

                    <TextBlock x:Name="RailHead" Text="SPECIMENS"
                               FontFamily="Cascadia Code, Consolas"
                               FontSize="12" FontWeight="SemiBold"
                               Opacity="0" Margin="0,0,0,6"
                               Foreground="{DynamicResource GalleryTextTertiary}"/>
                    <TextBlock x:Name="RailSub"
                               Text="A few live, hand-set from the collection"
                               FontFamily="Segoe UI" FontSize="12" Opacity="0"
                               TextWrapping="Wrap" Margin="0,0,0,20"
                               Foreground="{DynamicResource GalleryTextMuted}"/>

                    <StackPanel x:Name="Specimen1" Opacity="0" Margin="0,0,0,16">
                        <TextBlock Text="01 — ToggleSwitch / CheckBox"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   Margin="0,0,0,8"/>
                        <ToggleSwitch Header="GPU compositing"
                                      IsOn="True" OnContent="On" OffContent="Off"/>
                        <CheckBox IsChecked="True" Margin="0,4,0,0">
                            <TextBlock Text="Hardware acceleration" FontSize="11"
                                       Foreground="{DynamicResource GalleryTextSecondary}"/>
                        </CheckBox>
                    </StackPanel>

                    <Border x:Name="RailDiv1" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen2" Opacity="0" Margin="0,0,0,16">
                        <TextBlock Text="02 — Slider / ProgressBar"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   Margin="0,0,0,10"/>
                        <Slider Minimum="0" Maximum="100" Value="72"
                                Height="22" Margin="0,0,0,10"/>
                        <ProgressBar Value="72" Minimum="0" Maximum="100" Height="6"/>
                    </StackPanel>

                    <Border x:Name="RailDiv2" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen3" Opacity="0" Margin="0,0,0,16">
                        <TextBlock Text="03 — SplitButton / ComboBox"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   Margin="0,0,0,10"/>
                        <SplitButton Content="dotnet run" Height="34"
                                     HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Desktop"/>
                                    <MenuFlyoutItem Text="Android"/>
                                    <MenuFlyoutItem Text="Web (WASM)"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <ComboBox Height="30" SelectedIndex="0"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Forest Emerald"/>
                            <ComboBoxItem Content="Midnight Slate"/>
                            <ComboBoxItem Content="Amber Dusk"/>
                        </ComboBox>
                    </StackPanel>

                    <Border x:Name="RailDiv3" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen4" Opacity="0" Margin="0,0,0,16">
                        <TextBlock Text="04 — Razor @@{ for } · SuperEllipse"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   Margin="0,0,0,10"/>
                        <WrapPanel>
                            @{
                                for (var i = 1; i <= 6; i++) {
                                    <Border Width="34" Height="34"
                                            Shape="SuperEllipse" SuperEllipseN="4"
                                            Background="{DynamicResource GalleryAccent}"
                                            Margin="0,0,7,7">
                                        <TextBlock Text="@(i.ToString())"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   FontSize="13" FontWeight="Bold"
                                                   Foreground="#06140C"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                }
                            }
                        </WrapPanel>
                    </StackPanel>

                    <Border x:Name="RailDiv4" Height="1" Opacity="0" Margin="0,0,0,16"
                            Background="{DynamicResource GalleryBorderSubtle}"/>

                    <StackPanel x:Name="Specimen5" Opacity="0">
                        <TextBlock Text="05 — LiquidGlass · refractive"
                                   FontFamily="Cascadia Code, Consolas" FontSize="11"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   Margin="0,0,0,10"/>
                        <Border Height="46" CornerRadius="12"
                                LiquidGlass="True" LiquidGlassInteractive="True"
                                Background="#2238BDF8">
                            <TextBlock Text="frosted · refractive glass"
                                       FontFamily="Cascadia Code, Consolas" FontSize="11"
                                       Foreground="{DynamicResource GalleryTextPrimary}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- ===== FOOTER / COLOPHON ===== -->
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                      x:Name="Colophon" Opacity="0" Margin="2,0,40,34"
                      VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Grid.ColumnSpan="2"
                            Height="1" VerticalAlignment="Top" Margin="0,0,0,18"
                            Background="{DynamicResource GalleryBorderSubtle}"/>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="DESKTOP" FontFamily="Cascadia Code, Consolas"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextSecondary}"/>
                        <TextBlock Text="  ·  " FontFamily="Cascadia Code, Consolas" FontSize="12"
                                   Foreground="{DynamicResource GalleryTextMuted}"/>
                        <TextBlock Text="ANDROID" FontFamily="Cascadia Code, Consolas"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextSecondary}"/>
                        <TextBlock Text="  ·  " FontFamily="Cascadia Code, Consolas" FontSize="12"
                                   Foreground="{DynamicResource GalleryTextMuted}"/>
                        <TextBlock Text="WEB" FontFamily="Cascadia Code, Consolas"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource GalleryTextSecondary}"/>
                        <TextBlock Text="   —   gpu-rendered · native-aot · 16.6 ms/frame"
                                   FontFamily="Cascadia Code, Consolas" FontSize="12"
                                   Foreground="{DynamicResource GalleryTextMuted}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="jaliumui.top"
                               FontFamily="Cascadia Code, Consolas" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="0,18,0,0" Foreground="#F59E0B"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Page>
