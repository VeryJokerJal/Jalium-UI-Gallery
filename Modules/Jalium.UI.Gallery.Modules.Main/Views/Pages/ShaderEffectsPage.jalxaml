<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ShaderEffectsPage"
    Title="Shader Effects">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="EFFECTS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Shader Effects" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A WPF-compatible shader effect system with BlurEffect, DropShadowEffect, and custom ShaderEffect support." />

        <!-- BlurEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="BlurEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Applies a Gaussian blur effect. Supports KernelType and RenderingBias settings." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Blur Radius: " VerticalAlignment="Center"/>
                            <Slider x:Name="BlurRadiusSlider" Width="200" Minimum="0" Maximum="50" Value="10" Margin="8,0,0,0"/>
                            <TextBlock x:Name="BlurRadiusText" Text="10" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border x:Name="BlurEffectDemo" Background="#2B2742" Width="200" Height="100" CornerRadius="8" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Blur Demo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DropShadowEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="DropShadowEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Adds a drop shadow behind elements. Configurable color, blur radius, direction, and depth." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Shadow Depth: " VerticalAlignment="Center"/>
                            <Slider x:Name="ShadowDepthSlider" Width="200" Minimum="0" Maximum="30" Value="5" Margin="8,0,0,0"/>
                            <TextBlock x:Name="ShadowDepthText" Text="5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border x:Name="DropShadowDemo" Background="{DynamicResource GalleryAccent}" Width="150" Height="80" CornerRadius="14" Margin="20,16,0,0" HorizontalAlignment="Left">
                            <TextBlock Text="Shadow Demo" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom ShaderEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Custom ShaderEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Create custom pixel shader effects using HLSL. Load compiled shader bytecode and register shader constant/sampler properties." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="// Example custom shader effect" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="public class MyShaderEffect : ShaderEffect" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="{" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="    public MyShaderEffect()" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="    {" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="        PixelShader = new PixelShader();" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="        PixelShader.UriSource = new Uri(&quot;myshader.ps&quot;);" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="    }" FontFamily="Consolas" FontSize="12"/>
                        <TextBlock Text="}" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the effect demos above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Applying the effects and wiring the sliders in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
