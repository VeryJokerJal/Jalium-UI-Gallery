<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:effects="clr-namespace:Jalium.UI.Media.Effects;assembly=Jalium.UI.Media"
    xmlns:local="clr-namespace:Jalium.UI.Gallery.Modules.Main.Views.Pages;assembly=Jalium.UI.Gallery.Modules.Main"
    xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ShaderEffectsPage"
    hosting:ViewModelLocator.AutoWireViewModel="True"
    Title="Shader Effects">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Effects}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ShaderEffects.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ShaderEffects.Sub1}" />

        <!-- BlurEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShaderEffects.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShaderEffects.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.P.ShaderEffects.Ui3}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="BlurRadiusSlider" Width="200" Minimum="0" Maximum="50" SmallChange="1" LargeChange="5"
                                        Value="{Binding BlurRadius, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="{DynamicResource Loc.P.ShaderEffects.Ui3}" />
                                <TextBlock Text="{Binding BlurRadius, StringFormat='{}{0:F0}'}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <CheckBox x:Name="BoxBlurCheckBox" Margin="0,0,0,8" HorizontalAlignment="Left"
                                  Content="{DynamicResource Loc.P.ShaderEffects.Ui7}"
                                  automation:AutomationProperties.Name="{DynamicResource Loc.P.ShaderEffects.Ui7}" />

                        <Border x:Name="BlurPreview" Background="{DynamicResource GalleryEffectStage}" Width="200" Height="100" CornerRadius="8" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <Border.Effect>
                                <effects:BlurEffect />
                            </Border.Effect>
                            <TextBlock Text="{DynamicResource Loc.P.ShaderEffects.Ui5}" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DropShadowEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShaderEffects.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShaderEffects.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.P.ShaderEffects.Ui4}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="ShadowDepthSlider" Width="200" Minimum="0" Maximum="30" SmallChange="1" LargeChange="5"
                                        Value="{Binding ShadowDepth, Mode=TwoWay}"
                                        automation:AutomationProperties.Name="{DynamicResource Loc.P.ShaderEffects.Ui4}" />
                                <TextBlock Text="{Binding ShadowDepth, StringFormat='{}{0:F0}'}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="ShadowPreview" Background="{DynamicResource GalleryAccent}" Width="150" Height="80" CornerRadius="14" Margin="20,16,0,0" HorizontalAlignment="Left">
                            <Border.Effect>
                                <effects:DropShadowEffect BlurRadius="10"
                                                          ShadowDepth="5"
                                                          Direction="315"
                                                          Opacity="0.8" />
                            </Border.Effect>
                            <TextBlock Text="{DynamicResource Loc.P.ShaderEffects.Ui6}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom ShaderEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ShaderEffects.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShaderEffects.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Loc.P.ShaderEffects.Ui1}" Margin="0,0,0,8" />
                        <Slider x:Name="InvertAmountSlider"
                                Minimum="0" Maximum="1" Value="0.75" SmallChange="0.05" LargeChange="0.25"
                                Width="200" HorizontalAlignment="Left"
                                automation:AutomationProperties.Name="{DynamicResource Loc.P.ShaderEffects.Ui1}" />
                        <Border x:Name="HlslPreview" Background="{DynamicResource GalleryEffectStage}" Width="200" Height="100"
                                CornerRadius="8" Margin="0,16,0,0" HorizontalAlignment="Left">
                            <Border.Effect>
                                <local:GalleryInvertEffect />
                            </Border.Effect>
                            <Grid>
                                <Border Background="{DynamicResource GalleryAccent}" Width="60" Height="60"
                                        CornerRadius="16" HorizontalAlignment="Left" Margin="16,0,0,0" />
                                <TextBlock Text="{DynamicResource Loc.P.ShaderEffects.Ui2}" Foreground="White"
                                           Margin="88,0,12,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShaderEffects.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ShaderEffects.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
