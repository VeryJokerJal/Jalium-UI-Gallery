<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ContextMenuPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ContextMenu">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Navigation}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ContextMenu.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ContextMenu.Sub1}" />

        <!-- Basic ContextMenu -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ContextMenu.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContextMenu.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="120"
                        x:Name="ContextMenuArea">
                    <TextBlock Text="{DynamicResource Loc.P.ContextMenu.Hint1}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <ContextMenuService.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Cut" InputGestureText="{DynamicResource Loc.Shortcut.Cut}" />
                            <MenuItem Header="Copy" InputGestureText="{DynamicResource Loc.Shortcut.Copy}" />
                            <MenuItem Header="Paste" InputGestureText="{DynamicResource Loc.Shortcut.Paste}" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Loc.P.ContextMenu.Menu1}" InputGestureText="{DynamicResource Loc.Shortcut.SelectAll}" />
                        </ContextMenu>
                    </ContextMenuService.ContextMenu>
                </Border>
            </StackPanel>
        </Border>

        <!-- ContextMenu with submenus -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ContextMenu.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContextMenu.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="120">
                    <TextBlock Text="{DynamicResource Loc.P.ContextMenu.Hint2}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <ContextMenuService.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="New">
                                <MenuItem Header="File" />
                                <MenuItem Header="Folder" />
                                <MenuItem Header="Project" />
                            </MenuItem>
                            <MenuItem Header="Open" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Loc.P.ContextMenu.Menu2}">
                                <MenuItem Header="Name" />
                                <MenuItem Header="Date" />
                                <MenuItem Header="Size" />
                                <MenuItem Header="Type" />
                            </MenuItem>
                            <MenuItem Header="View">
                                <MenuItem Header="{DynamicResource Loc.P.ContextMenu.Menu3}" />
                                <MenuItem Header="{DynamicResource Loc.P.ContextMenu.Menu4}" />
                                <MenuItem Header="List" />
                                <MenuItem Header="Details" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Properties" />
                        </ContextMenu>
                    </ContextMenuService.ContextMenu>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContextMenu.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}"
                        MinHeight="120"
                        x:Name="InteractiveArea">
                    <StackPanel Orientation="Vertical"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Loc.P.ContextMenu.Hint1}"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="SelectedActionText"
                                   Text="{DynamicResource Loc.P.ContextMenu.Menu5}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <ContextMenuService.ContextMenu>
                        <ContextMenu x:Name="InteractiveContextMenu">
                            <MenuItem Header="Action 1" x:Name="Action1" />
                            <MenuItem Header="Action 2" x:Name="Action2" />
                            <MenuItem Header="Action 3" x:Name="Action3" />
                        </ContextMenu>
                    </ContextMenuService.ContextMenu>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContextMenu.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ContextMenu.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
