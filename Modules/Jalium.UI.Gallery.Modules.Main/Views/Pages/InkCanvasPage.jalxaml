<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.InkCanvasPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="InkCanvas">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Media}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.InkCanvas.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.InkCanvas.Sub1}" />

        <!-- Basic drawing -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <InkCanvas x:Name="MainInkCanvas"
                               Width="600"
                               Height="300"
                               EditingMode="{Binding EditingMode}"
                               behaviors:InkCanvasBehavior.IsEnabled="True"
                               behaviors:InkCanvasBehavior.DrawingSettings="{Binding DrawingSettings}"
                               behaviors:InkCanvasBehavior.Request="{Binding CanvasRequest}" />
                </Border>
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="Draw" Command="{Binding DrawCommand}" Margin="0,0,10,10" />
                    <Button Content="Erase" Command="{Binding EraseCommand}" Margin="0,0,10,10" />
                    <Button Content="Clear All" Command="{Binding ClearCommand}" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="{Binding ModeStatus}" />
            </StackPanel>
        </Border>

        <!-- Stroke color -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Command="{Binding UseBlackCommand}" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="{DynamicResource GalleryBorderStrong}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#000000" CornerRadius="3" />
                        </Button>
                        <Button Command="{Binding UseRedCommand}" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="{DynamicResource GalleryBorderStrong}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#E81123" CornerRadius="3" />
                        </Button>
                        <Button Command="{Binding UseBlueCommand}" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="{DynamicResource GalleryBorderStrong}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#0078D4" CornerRadius="3" />
                        </Button>
                        <Button Command="{Binding UseGreenCommand}" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="{DynamicResource GalleryBorderStrong}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#00CC6A" CornerRadius="3" />
                        </Button>
                        <Button Command="{Binding UseOrangeCommand}" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="{DynamicResource GalleryBorderStrong}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#F7630C" CornerRadius="3" />
                        </Button>
                        <Button Command="{Binding UsePurpleCommand}" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="{DynamicResource GalleryBorderStrong}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#886CE4" CornerRadius="3" />
                        </Button>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stroke width -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="WidthSlider"
                                Width="300"
                                Minimum="1"
                                Maximum="20"
                                Value="{Binding StrokeWidth, Mode=TwoWay}"
                                Margin="0,0,16,0" />
                        <TextBlock x:Name="WidthText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding WidthStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Highlighter mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <CheckBox Content="Enable Highlighter"
                              IsChecked="{Binding IsHighlighter, Mode=TwoWay}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Brush type -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="圆笔" Command="{Binding UseRoundBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="毛笔" Command="{Binding UseCalligraphyBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="书写笔" Command="{Binding UsePenBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="喷枪" Command="{Binding UseAirbrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="油画笔" Command="{Binding UseOilBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="蜡笔" Command="{Binding UseCrayonBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="记号笔" Command="{Binding UseMarkerBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="铅笔" Command="{Binding UsePencilBrushCommand}" Width="80" Margin="0,0,10,10" />
                            <Button Content="水彩笔" Command="{Binding UseWatercolorBrushCommand}" Width="80" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="BrushTypeStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding BrushTypeStatus}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Taper mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT6}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="Normal" Command="{Binding UseNormalTaperCommand}" Margin="0,0,10,10" />
                            <Button Content="Tapered Start" Command="{Binding UseTaperedStartCommand}" Margin="0,0,10,10" />
                            <Button Content="Tapered End" Command="{Binding UseTaperedEndCommand}" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="AnimationStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding TaperStatus}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stroke information -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.InkCanvas.CT7}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TextBlock x:Name="StrokeCountText"
                               Style="{StaticResource GalleryValueLabel}"
                               Text="{Binding StrokeCountStatus}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC8}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.InkCanvas.CC9}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
