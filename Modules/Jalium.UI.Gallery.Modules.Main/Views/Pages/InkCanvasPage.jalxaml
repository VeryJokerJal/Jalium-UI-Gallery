<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.InkCanvasPage"
      Title="InkCanvas">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MEDIA" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="InkCanvas" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A drawing surface that captures freehand ink strokes from mouse, pen or touch, with configurable stroke color, width, brush type and eraser modes." />

        <!-- Basic drawing -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Drawing" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Draw with your mouse, switch between ink and erase modes, or clear the canvas." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <InkCanvas x:Name="MainInkCanvas"
                               Width="600"
                               Height="300"
                               EditingMode="Ink" />
                </Border>
                <WrapPanel Margin="0,16,0,0">
                    <Button x:Name="InkModeButton" Content="Draw" Margin="0,0,10,10" />
                    <Button x:Name="EraseModeButton" Content="Erase" Margin="0,0,10,10" />
                    <Button x:Name="ClearButton" Content="Clear All" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBlock x:Name="StatusText"
                           Style="{StaticResource GalleryValueLabel}"
                           Text="Mode: Ink" />
            </StackPanel>
        </Border>

        <!-- Stroke color -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stroke Color" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Pick a color to draw with." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button x:Name="BlackColorButton" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="#33FFFFFF" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#000000" CornerRadius="3" />
                        </Button>
                        <Button x:Name="RedColorButton" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="#33FFFFFF" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#E81123" CornerRadius="3" />
                        </Button>
                        <Button x:Name="BlueColorButton" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="#33FFFFFF" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#0078D4" CornerRadius="3" />
                        </Button>
                        <Button x:Name="GreenColorButton" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="#33FFFFFF" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#00CC6A" CornerRadius="3" />
                        </Button>
                        <Button x:Name="OrangeColorButton" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="#33FFFFFF" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#F7630C" CornerRadius="3" />
                        </Button>
                        <Button x:Name="PurpleColorButton" Width="40" Height="40" MinWidth="40" MinHeight="40" Margin="0,0,10,10" Padding="3" Background="Transparent" BorderBrush="#33FFFFFF" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                            <Border Background="#886CE4" CornerRadius="3" />
                        </Button>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stroke width -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stroke Width" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Adjust the width of the stroke." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="WidthSlider"
                                Width="300"
                                Minimum="1"
                                Maximum="20"
                                Value="2"
                                Margin="0,0,16,0" />
                        <TextBlock x:Name="WidthText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Width: 2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Highlighter mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Highlighter Mode" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Toggle highlighter mode for semi-transparent strokes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <CheckBox x:Name="HighlighterCheckBox" Content="Enable Highlighter" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Brush type -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Brush Type" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Select the brush type used for new strokes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="RoundBrushButton" Content="圆笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="CalligraphyBrushButton" Content="毛笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="PenBrushButton" Content="书写笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="AirbrushButton" Content="喷枪" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="OilBrushButton" Content="油画笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="CrayonBrushButton" Content="蜡笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="MarkerBrushButton" Content="记号笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="PencilBrushButton" Content="铅笔" Width="80" Margin="0,0,10,10" />
                            <Button x:Name="WatercolorBrushButton" Content="水彩笔" Width="80" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="BrushTypeStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Brush Type: 圆笔"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Taper mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Taper Mode" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Select the taper style for new strokes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="AnimNoneButton" Content="Normal" Margin="0,0,10,10" />
                            <Button x:Name="AnimGrowInButton" Content="Tapered Start" Margin="0,0,10,10" />
                            <Button x:Name="AnimShrinkOutButton" Content="Tapered End" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="AnimationStatusText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Taper: Normal"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stroke information -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stroke Information" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Shows the number of strokes currently on the canvas." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TextBlock x:Name="StrokeCountText"
                               Style="{StaticResource GalleryValueLabel}"
                               Text="Strokes: 0" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the InkCanvas demo above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Setting the editing mode, drawing attributes and handling stroke events in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
