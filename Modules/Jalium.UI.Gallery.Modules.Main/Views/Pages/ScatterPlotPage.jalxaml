<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ScatterPlotPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ScatterPlot">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ScatterPlot.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ScatterPlot.Sub1}" />

        <!-- Basic Scatter Plot -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ScatterPlot.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ScatterPlot.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ScatterPlot Width="600"
                                 Height="400"
                                 Title="Random Data Points">
                        <ScatterPlot.Series>
                            <ScatterSeries Title="Dataset A"
                                           Brush="#417EE0"
                                           PointShape="Circle"
                                           DataPoints="{Binding DatasetA}" />
                            <ScatterSeries Title="Dataset B"
                                           Brush="#4CAF50"
                                           PointShape="Triangle"
                                           DataPoints="{Binding DatasetB}" />
                        </ScatterPlot.Series>
                    </ScatterPlot>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bubble Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ScatterPlot.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ScatterPlot.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ScatterPlot Width="600"
                                 Height="400"
                                 Title="Bubble Sizing"
                                 MinPointSize="6"
                                 MaxPointSize="30">
                        <ScatterPlot.Series>
                            <ScatterSeries Title="Bubble Data"
                                           Brush="#9C5FC4"
                                           PointShape="Circle"
                                           DataPoints="{Binding BubbleData}" />
                        </ScatterPlot.Series>
                    </ScatterPlot>
                </Border>
            </StackPanel>
        </Border>

        <!-- Trend Line -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ScatterPlot.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ScatterPlot.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ScatterPlot Width="600"
                                 Height="400"
                                 Title="Linear Trend Line"
                                 ShowTrendLine="True"
                                 TrendLineType="Linear">
                        <ScatterPlot.Series>
                            <ScatterSeries Title="Correlated Data"
                                           Brush="#FF9E22"
                                           PointShape="Diamond"
                                           DataPoints="{Binding CorrelatedData}" />
                        </ScatterPlot.Series>
                    </ScatterPlot>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ScatterPlot.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ScatterPlot.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
