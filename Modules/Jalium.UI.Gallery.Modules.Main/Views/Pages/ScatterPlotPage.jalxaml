<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ScatterPlotPage"
      Title="ScatterPlot">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ScatterPlot" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays data as a scatter plot with multiple point shapes, optional bubble sizing, and trend lines." />

        <!-- Basic Scatter Plot -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Scatter Plot" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A scatter plot with random data points using circle markers." />
                <Border x:Name="BasicScatterContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Bubble Chart -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Bubble Chart" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A scatter plot with varying point sizes to represent a third data dimension." />
                <Border x:Name="BubbleChartContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Trend Line -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Trend Line" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A scatter plot with a linear trend line overlay showing data correlation." />
                <Border x:Name="TrendLineContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a scatter plot with series, bubble sizing and a trend line." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a scatter plot and its series in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
