<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DocumentViewerPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="DocumentViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataViewers}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.DocumentViewer.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.DocumentViewer.Sub1}" />

        <!-- Live demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DocumentViewer.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DocumentViewer.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" ClipToBounds="True">
                    <StackPanel Orientation="Vertical">
                        <!-- Toolbar -->
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="8">
                            <WrapPanel>
                                <Button Command="{Binding FirstPageCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="First page"
                                        automation:AutomationProperties.Name="First page"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="Previous" />
                                </Button>
                                <Button Command="{Binding PreviousPageCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Previous page"
                                        automation:AutomationProperties.Name="Previous page"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="PageLeft" />
                                </Button>
                                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <Button Command="{Binding NextPageCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Next page"
                                        automation:AutomationProperties.Name="Next page"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="PageRight" />
                                </Button>
                                <Button Command="{Binding LastPageCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Last page"
                                        automation:AutomationProperties.Name="Last page"
                                        Margin="0,0,16,8">
                                    <SymbolIcon Symbol="Next" />
                                </Button>

                                <Button Command="{Binding ZoomOutCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Zoom out"
                                        automation:AutomationProperties.Name="Zoom out"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="ZoomOut" />
                                </Button>
                                <TextBlock Text="{Binding Zoom, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center" Width="52" TextAlignment="Center" Margin="0,0,8,8"/>
                                <Button Command="{Binding ZoomInCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Zoom in"
                                        automation:AutomationProperties.Name="Zoom in"
                                        Margin="0,0,16,8">
                                    <SymbolIcon Symbol="ZoomIn" />
                                </Button>

                                <Button Content="{DynamicResource Loc.P.DocumentViewer.Ui1}" Command="{Binding FitWidthCommand}" Width="70" Height="24" FontSize="11" Margin="0,0,10,10"/>
                                <Button Content="{DynamicResource Loc.P.DocumentViewer.Ui2}" Command="{Binding FitPageCommand}" Width="65" Height="24" FontSize="11" Margin="0,0,10,10"/>

                                <Button Command="{Binding PrintCommand}"
                                        Style="{StaticResource GalleryIconButton}"
                                        ToolTip="Print"
                                        automation:AutomationProperties.Name="Print"
                                        Margin="0,0,8,8">
                                    <SymbolIcon Symbol="Print" />
                                </Button>
                            </WrapPanel>
                        </Border>

                        <!-- DocumentViewer -->
                        <DocumentViewer x:Name="DemoViewer"
                                        Height="400"
                                        Zoom="{Binding Zoom, Mode=TwoWay}"
                                        FitMode="FitWidth"
                                        PageDisplay="{Binding PageDisplay}"
                                        ShowPageBorders="{Binding ShowPageBorders}"
                                        HorizontalPageSpacing="{Binding PageSpacing}"
                                        VerticalPageSpacing="{Binding PageSpacing}"
                                        behaviors:DocumentViewerBehavior.IsEnabled="True"
                                        behaviors:DocumentViewerBehavior.Request="{Binding ViewerRequest}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Text search -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DocumentViewer.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DocumentViewer.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <TextBox ToolTip="{DynamicResource Loc.P.DocumentViewer.Ui3}" Text="{Binding SearchText, Mode=TwoWay}" Width="250" Height="28" Margin="0,0,10,10"/>
                            <Button Content="Find" Command="{Binding FindCommand}" Width="50" Height="28" Margin="0,0,10,10"/>
                            <Button Content="Next" Command="{Binding FindNextCommand}" Width="50" Height="28" Margin="0,0,10,10"/>
                            <Button Content="Prev" Command="{Binding FindPreviousCommand}" Width="50" Height="28" Margin="0,0,10,10"/>
                            <Button Content="Clear" Command="{Binding ClearSearchCommand}" Width="50" Height="28" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox Content="{DynamicResource Loc.P.DocumentViewer.Ui4}" IsChecked="{Binding MatchCase, Mode=TwoWay}" Margin="0,0,10,10"/>
                            <CheckBox Content="{DynamicResource Loc.P.DocumentViewer.Ui5}" IsChecked="{Binding MatchWholeWord, Mode=TwoWay}" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding SearchResult}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Display options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DocumentViewer.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DocumentViewer.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Loc.P.DocumentViewer.Ui6}" Width="100" VerticalAlignment="Center"/>
                            <ComboBox Width="160"
                                      Height="28"
                                      ItemsSource="{Binding PageDisplayOptions}"
                                      SelectedItem="{Binding PageDisplay, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Zoom:" Width="100" VerticalAlignment="Center"/>
                            <Slider Minimum="25" Maximum="400" Value="{Binding Zoom, Mode=TwoWay}" Width="200" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Zoom, StringFormat='{}{0:F0}%'}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Loc.P.DocumentViewer.Ui7}" IsChecked="{Binding ShowPageBorders, Mode=TwoWay}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.P.DocumentViewer.Ui8}" Width="100" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="30" Value="{Binding PageSpacing, Mode=TwoWay}" Width="150" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding PageSpacing, StringFormat='{}{0:F0}'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DocumentViewer.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="180"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DocumentViewer.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="350"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
