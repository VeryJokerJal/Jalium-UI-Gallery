<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DocumentViewerPage"
      Title="DocumentViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VIEWERS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="DocumentViewer" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control for viewing paginated documents with zoom, page navigation, search, fit modes, and print support." />

        <!-- Live demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Document Viewer Demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A DocumentViewer with toolbar controls for navigation and zoom." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" ClipToBounds="True">
                    <StackPanel Orientation="Vertical">
                        <!-- Toolbar -->
                        <Border Background="{DynamicResource GalleryCardAltBackground}" Padding="8">
                            <WrapPanel>
                                <Button x:Name="FirstPageButton" Content="|&lt;" Width="32" Height="24" FontSize="11" Margin="0,0,10,10"/>
                                <Button x:Name="PrevPageButton" Content="&lt;" Width="28" Height="24" FontSize="11" Margin="0,0,10,10"/>
                                <TextBlock x:Name="PageInfoText" Text="Page 1 / 1" VerticalAlignment="Center" Margin="0,0,10,10"/>
                                <Button x:Name="NextPageButton" Content="&gt;" Width="28" Height="24" FontSize="11" Margin="0,0,10,10"/>
                                <Button x:Name="LastPageButton" Content="&gt;|" Width="32" Height="24" FontSize="11" Margin="0,0,10,10"/>

                                <Button x:Name="ZoomOutButton" Content="-" Width="28" Height="24" FontSize="11" Margin="0,0,10,10"/>
                                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Width="45" TextAlignment="Center" Margin="0,0,10,10"/>
                                <Button x:Name="ZoomInButton" Content="+" Width="28" Height="24" FontSize="11" Margin="0,0,10,10"/>

                                <Button x:Name="FitWidthButton" Content="Fit Width" Width="70" Height="24" FontSize="11" Margin="0,0,10,10"/>
                                <Button x:Name="FitPageButton" Content="Fit Page" Width="65" Height="24" FontSize="11" Margin="0,0,10,10"/>

                                <Button x:Name="PrintButton" Content="Print" Width="50" Height="24" FontSize="11" Margin="0,0,10,10"/>
                            </WrapPanel>
                        </Border>

                        <!-- DocumentViewer -->
                        <DocumentViewer x:Name="DemoViewer"
                                        Height="400"
                                        Zoom="100"
                                        FitMode="FitWidth"
                                        ShowPageBorders="True"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Text search -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Text Search" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Search for text within the document with match options." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <TextBox x:Name="SearchBox" ToolTip="Search text..." Width="250" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="FindButton" Content="Find" Width="50" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="FindNextButton" Content="Next" Width="50" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="FindPrevButton" Content="Prev" Width="50" Height="28" Margin="0,0,10,10"/>
                            <Button x:Name="ClearSearchButton" Content="Clear" Width="50" Height="28" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox x:Name="MatchCaseCheckBox" Content="Match case" Margin="0,0,10,10"/>
                            <CheckBox x:Name="WholeWordCheckBox" Content="Whole word" Margin="0,0,10,10"/>
                        </WrapPanel>
                        <TextBlock x:Name="SearchResultText"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Text="Enter text and click Find to search."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Display options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Display Options" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Configure page display mode, spacing, and border visibility." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Page Display:" Width="100" VerticalAlignment="Center"/>
                            <ComboBox x:Name="PageDisplayComboBox" Width="160" Height="28">
                                <ComboBoxItem Content="One Page" IsSelected="True"/>
                                <ComboBoxItem Content="Two Pages"/>
                                <ComboBoxItem Content="Two Up Facing"/>
                                <ComboBoxItem Content="Continuous"/>
                                <ComboBoxItem Content="Continuous Facing"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Zoom:" Width="100" VerticalAlignment="Center"/>
                            <Slider x:Name="ZoomSlider" Minimum="25" Maximum="400" Value="100" Width="200" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ZoomSliderText" Text="100%" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox x:Name="ShowBordersCheckBox" Content="Show page borders" IsChecked="True" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Page Spacing:" Width="100" VerticalAlignment="Center"/>
                            <Slider x:Name="SpacingSlider" Minimum="0" Maximum="30" Value="10" Width="150" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SpacingText" Text="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a DocumentViewer with default settings." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="180"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Driving navigation, zoom, search and events from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="350"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
