<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SplitterPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Splitter">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Splitter.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Splitter.Sub1}" />

        <!-- Horizontal splitter -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Splitter.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Splitter.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="200">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource GalleryCardAltBackground}" Padding="16">
                            <TextBlock Text="Left Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" ResizeBehavior="PreviousAndNext"/>

                        <Border Grid.Column="2" Background="{DynamicResource GalleryAccentSoft}" Padding="16">
                            <TextBlock Text="Right Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Vertical splitter -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Splitter.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Splitter.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="250">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="50"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="50"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource GalleryCardAltBackground}" Padding="16">
                            <TextBlock Text="Top Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                        <Border Grid.Row="2" Background="{DynamicResource GalleryAccentSoft}" Padding="16">
                            <TextBlock Text="Bottom Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Multi-panel layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Splitter.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Splitter.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="300">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left sidebar -->
                        <Border Grid.Column="0" Background="{DynamicResource GalleryAccentSoft}" Padding="12">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Sidebar" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="• Item 1" Margin="0,0,0,4"/>
                                <TextBlock Text="• Item 2" Margin="0,0,0,4"/>
                                <TextBlock Text="• Item 3" Margin="0,0,0,4"/>
                                <TextBlock Text="• Item 4"/>
                            </StackPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6"/>

                        <!-- Right section with vertical split -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" MinHeight="80"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="60"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource GalleryCardAltBackground}" Padding="16">
                                <TextBlock Text="Main Content Area" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                            <Border Grid.Row="2" Background="{DynamicResource GalleryAccentSoft}" Padding="16">
                                <TextBlock Text="Output / Console" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CommonUseCases}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Splitter.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Splitter.Use1}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Splitter.Use2}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Splitter.Use3}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Splitter.Use4}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Splitter.Use5}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Splitter.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Splitter.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
