<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SplitterPage"
      Title="Splitter">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Splitter" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Drag a GridSplitter between grid cells to resize adjacent panels — the building block for resizable columns, rows and full IDE-style layouts." />

        <!-- Horizontal splitter -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Horizontal Splitter" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag the vertical bar to resize the left and right panels." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="200">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="100"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource GalleryCardAltBackground}" Padding="16">
                            <TextBlock Text="Left Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6" ResizeBehavior="PreviousAndNext"/>

                        <Border Grid.Column="2" Background="{DynamicResource GalleryAccentSoft}" Padding="16">
                            <TextBlock Text="Right Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Vertical splitter -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Vertical Splitter" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag the horizontal bar to resize the top and bottom panels." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="250">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="50"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="50"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{DynamicResource GalleryCardAltBackground}" Padding="16">
                            <TextBlock Text="Top Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                        <Border Grid.Row="2" Background="{DynamicResource GalleryAccentSoft}" Padding="16">
                            <TextBlock Text="Bottom Panel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Multi-panel layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Multi-Panel Layout" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Combine several splitters — a sidebar plus a stacked content and console — for an IDE-style workspace." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="300">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" MinWidth="100"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left sidebar -->
                        <Border Grid.Column="0" Background="{DynamicResource GalleryAccentSoft}" Padding="12">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Sidebar" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <TextBlock Text="• Item 1" Margin="0,0,0,4"/>
                                <TextBlock Text="• Item 2" Margin="0,0,0,4"/>
                                <TextBlock Text="• Item 3" Margin="0,0,0,4"/>
                                <TextBlock Text="• Item 4"/>
                            </StackPanel>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="6"/>

                        <!-- Right section with vertical split -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" MinHeight="80"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*" MinHeight="60"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{DynamicResource GalleryCardAltBackground}" Padding="16">
                                <TextBlock Text="Main Content Area" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                            <Border Grid.Row="2" Background="{DynamicResource GalleryAccentSoft}" Padding="16">
                                <TextBlock Text="Output / Console" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common use cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Common Use Cases" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Splitters power the resizable layouts found across everyday desktop apps." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="• IDE layouts (code editor + output)" Margin="0,0,0,8"/>
                        <TextBlock Text="• File explorers (tree + details)" Margin="0,0,0,8"/>
                        <TextBlock Text="• Email clients (folders + list + preview)" Margin="0,0,0,8"/>
                        <TextBlock Text="• Dashboard layouts" Margin="0,0,0,8"/>
                        <TextBlock Text="• Settings panels"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the splitter layouts above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a resizable IDE-style layout with GridSplitters in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
