<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.NavigationDemoPage"
    hosting:ViewModelLocator.AutoWireViewModel="True"
    Title="Navigation Framework">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.System}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.NavigationDemo.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.NavigationDemo.Sub1}" />

        <!-- NavigationService -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NavigationDemo.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NavigationDemo.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="BackButton" Content="Go Back" Command="{Binding GoBackCommand}" Width="100" Margin="0,0,10,10" />
                            <Button x:Name="ForwardButton" Content="Go Forward" Command="{Binding GoForwardCommand}" Width="100" Margin="0,0,10,10" />
                            <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshCommand}" Width="100" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="NavigationStatus"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding NavigationStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- JournalEntry -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NavigationDemo.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NavigationDemo.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="// Create journal entry with custom state" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="var entry = new JournalEntry(uri, &quot;Page Title&quot;);" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="entry.CustomContentState = new MyContentState();" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="navigationService.AddBackEntry(entry.CustomContentState);" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- NavigationWindow -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NavigationDemo.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NavigationDemo.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button x:Name="OpenNavigationWindowButton"
                            Content="Open NavigationWindow Demo"
                            Command="{Binding OpenNavigationWindowCommand}"
                            Width="220"
                            HorizontalAlignment="Left" />
                </Border>
            </StackPanel>
        </Border>

        <!-- CustomContentState -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NavigationDemo.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NavigationDemo.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{DynamicResource Loc.P.NavigationDemo.Val1}" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - DictionaryContentState: Key-value pair storage" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - ScrollContentState: Preserve scroll position" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - DataContextContentState: Preserve DataContext" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - CompositeContentState: Combine multiple states" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NavigationDemo.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NavigationDemo.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
