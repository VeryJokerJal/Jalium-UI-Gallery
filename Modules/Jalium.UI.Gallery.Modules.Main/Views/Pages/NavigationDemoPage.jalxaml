<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.NavigationDemoPage"
    Title="Navigation Framework">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="SYSTEM" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Navigation" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="WPF-compatible navigation with NavigationService, JournalEntry, and NavigationWindow." />

        <!-- NavigationService -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="NavigationService" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Provides navigation methods and maintains back / forward history." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="BackButton" Content="Go Back" Width="100" Margin="0,0,10,10" />
                            <Button x:Name="ForwardButton" Content="Go Forward" Width="100" Margin="0,0,10,10" />
                            <Button x:Name="RefreshButton" Content="Refresh" Width="100" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="NavigationStatus"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Navigation Status: Ready" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- JournalEntry -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="JournalEntry" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Represents entries in navigation history with custom state support." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="// Create journal entry with custom state" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="var entry = new JournalEntry(uri, &quot;Page Title&quot;);" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="entry.CustomContentState = new MyContentState();" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="navigationService.AddBackEntry(entry.CustomContentState);" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- NavigationWindow -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="NavigationWindow" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A Window with built-in navigation chrome including back / forward buttons." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button x:Name="OpenNavigationWindowButton"
                            Content="Open NavigationWindow Demo"
                            Width="220"
                            HorizontalAlignment="Left" />
                </Border>
            </StackPanel>
        </Border>

        <!-- CustomContentState -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="CustomContentState" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Save and restore page state during navigation. Includes DictionaryContentState and ScrollContentState." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Available state types:" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - DictionaryContentState: Key-value pair storage" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - ScrollContentState: Preserve scroll position" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - DataContextContentState: Preserve DataContext" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="  - CompositeContentState: Combine multiple states" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a NavigationWindow, navigation buttons, and an embedded Frame." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Navigating, handling navigation events, and opening a NavigationWindow in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
