<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TreeMapPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="TreeMap">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataVisualization}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.TreeMap.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.TreeMap.Sub1}" />

        <!-- Basic TreeMap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TreeMap.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeMap.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TreeMap Width="600"
                             Height="400"
                             Algorithm="Squarified"
                             ShowLabels="True"
                             Title="Market Sectors"
                             Items="{Binding MarketItems}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Nested TreeMap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TreeMap.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeMap.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TreeMap Width="600"
                             Height="400"
                             Algorithm="Squarified"
                             ShowLabels="True"
                             Title="Disk Usage"
                             Items="{Binding NestedItems}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Squarified Algorithm -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TreeMap.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeMap.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <TreeMap Width="290"
                                 Height="300"
                                 Algorithm="Squarified"
                                 ShowLabels="True"
                                 Title="Squarified"
                                 Items="{Binding SquarifiedItems}" />
                        <TreeMap Width="290"
                                 Height="300"
                                 Algorithm="SliceAndDice"
                                 ShowLabels="True"
                                 Title="Slice &amp; Dice"
                                 Items="{Binding SliceAndDiceItems}"
                                 Margin="16,0,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeMap.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeMap.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
