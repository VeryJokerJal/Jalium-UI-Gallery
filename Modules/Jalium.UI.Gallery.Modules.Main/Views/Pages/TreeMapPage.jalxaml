<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TreeMapPage"
      Title="TreeMap">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="TreeMap" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays hierarchical data as nested, space-filling rectangles proportional to data values." />

        <!-- Basic TreeMap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic TreeMap" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A flat tree map of market sectors sized by market capitalization." />
                <Border x:Name="BasicTreeMapContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Nested TreeMap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Nested TreeMap" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A hierarchical tree map with parent categories and child items." />
                <Border x:Name="NestedTreeMapContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Squarified Algorithm -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Squarified Algorithm" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Comparison of Squarified vs SliceAndDice layout algorithms on identical data." />
                <Border x:Name="AlgorithmContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for building the tree maps above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building tree maps and switching layout algorithms in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
