<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ElementEffectsPage"
    Title="Element Effects">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="EFFECTS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Element Effects" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Modern element-level visual effects — OuterGlow, InnerShadow, Emboss, ColorMatrix and EffectGroup — each applied to a single element and composable into effect groups." />

        <!-- OuterGlowEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="OuterGlowEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Renders a glow around the outer edges of an element. Replaces the deprecated OuterGlowBitmapEffect." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Glow Size: " />
                            <Slider x:Name="GlowSizeSlider" Width="200" Minimum="0" Maximum="40" Value="10" Margin="12,0,0,0" />
                            <TextBlock x:Name="GlowSizeText" Style="{StaticResource GalleryValueLabel}" Text="10" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Intensity: " />
                            <Slider x:Name="GlowIntensitySlider" Width="200" Minimum="0" Maximum="50" Value="10" Margin="12,0,0,0" />
                            <TextBlock x:Name="GlowIntensityText" Style="{StaticResource GalleryValueLabel}" Text="1.0" Margin="12,0,0,0" />
                        </StackPanel>
                        <Border Background="#1A1A2E" Height="120" CornerRadius="8" HorizontalAlignment="Stretch">
                            <Border x:Name="OuterGlowDemo" Background="{DynamicResource GalleryAccent}" Width="160" Height="60" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Outer Glow" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Border>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- InnerShadowEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="InnerShadowEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Renders a shadow inside the element bounds, similar to CSS box-shadow: inset." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Blur Radius: " />
                            <Slider x:Name="InnerShadowBlurSlider" Width="200" Minimum="0" Maximum="30" Value="8" Margin="12,0,0,0" />
                            <TextBlock x:Name="InnerShadowBlurText" Style="{StaticResource GalleryValueLabel}" Text="8" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Shadow Depth: " />
                            <Slider x:Name="InnerShadowDepthSlider" Width="200" Minimum="0" Maximum="20" Value="5" Margin="12,0,0,0" />
                            <TextBlock x:Name="InnerShadowDepthText" Style="{StaticResource GalleryValueLabel}" Text="5" Margin="12,0,0,0" />
                        </StackPanel>
                        <Border x:Name="InnerShadowDemo" Background="#3D3D50" Width="220" Height="100" CornerRadius="16" HorizontalAlignment="Left">
                            <TextBlock Text="Inner Shadow" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- EmbossEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="EmbossEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creates a raised or sunken appearance by simulating light hitting the surface. Replaces the deprecated EmbossBitmapEffect." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Amount: " />
                            <Slider x:Name="EmbossAmountSlider" Width="200" Minimum="0" Maximum="50" Value="15" Margin="12,0,0,0" />
                            <TextBlock x:Name="EmbossAmountText" Style="{StaticResource GalleryValueLabel}" Text="1.5" Margin="12,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Light Angle: " />
                            <Slider x:Name="EmbossAngleSlider" Width="200" Minimum="0" Maximum="360" Value="45" Margin="12,0,0,0" />
                            <TextBlock x:Name="EmbossAngleText" Style="{StaticResource GalleryValueLabel}" Text="45" Margin="12,0,0,0" />
                        </StackPanel>
                        <Border x:Name="EmbossDemo" Background="#556677" Width="200" Height="80" CornerRadius="10" HorizontalAlignment="Left">
                            <TextBlock Text="Emboss Demo" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ColorMatrixEffect -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="ColorMatrixEffect" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Applies 5x4 color matrix transformations with preset factories for grayscale, sepia, brightness, contrast, saturation, hue rotation and invert." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <Button x:Name="GrayscaleBtn" Content="Grayscale" Margin="0,0,10,10" />
                            <Button x:Name="SepiaBtn" Content="Sepia" Margin="0,0,10,10" />
                            <Button x:Name="InvertBtn" Content="Invert" Margin="0,0,10,10" />
                            <Button x:Name="HueRotateBtn" Content="Hue Rotate" Margin="0,0,10,10" />
                            <Button x:Name="ResetColorBtn" Content="Reset" Margin="0,0,10,10" />
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Saturation: " />
                            <Slider x:Name="SaturationSlider" Width="200" Minimum="0" Maximum="30" Value="10" Margin="12,0,0,0" />
                            <TextBlock x:Name="SaturationText" Style="{StaticResource GalleryValueLabel}" Text="1.0" Margin="12,0,0,0" />
                        </StackPanel>
                        <Border Background="#1A1A2E" CornerRadius="8" Padding="12">
                            <WrapPanel HorizontalAlignment="Center">
                                <Border x:Name="ColorDemo1" Background="#FF4444" Width="50" Height="50" CornerRadius="8" Margin="2" />
                                <Border x:Name="ColorDemo2" Background="#FF8800" Width="50" Height="50" CornerRadius="8" Margin="2" />
                                <Border x:Name="ColorDemo3" Background="#FFDD00" Width="50" Height="50" CornerRadius="8" Margin="2" />
                                <Border x:Name="ColorDemo4" Background="#44CC44" Width="50" Height="50" CornerRadius="8" Margin="2" />
                                <Border x:Name="ColorDemo5" Background="#4488FF" Width="50" Height="50" CornerRadius="8" Margin="2" />
                                <Border x:Name="ColorDemo6" Background="#44CC71" Width="50" Height="50" CornerRadius="8" Margin="2" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- EffectGroup -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="EffectGroup" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Composes multiple effects into a single group. Effects are applied sequentially, with each output feeding the next." />
                <Border Style="{StaticResource GalleryDemoSurface}" Margin="0,0,0,12">
                    <Border Background="#1A1A2E" Height="120" CornerRadius="8" HorizontalAlignment="Stretch">
                        <Border x:Name="EffectGroupDemo" Background="#CC5500" Width="180" Height="70" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Glow + Shadow" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Border>
                    </Border>
                </Border>
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="// Composing multiple effects" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="var group = new EffectGroup();" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="group.Children.Add(new OuterGlowEffect" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    { GlowColor = Colors.Orange, GlowSize = 12 });" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="group.Children.Add(new DropShadowEffect" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="    { ShadowDepth = 6, BlurRadius = 8 });" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="element.Effect = group;" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup applying element effects through the Effect property." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating, configuring and composing effects in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
