<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.HeatmapPage"
      Title="Heatmap">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Heatmap" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays a 2D matrix of values as a color-coded grid with optional labels and a color scale bar." />

        <!-- Basic Heatmap -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Heatmap" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A 10x10 heatmap with the default BlueToRed color scale." />
                <Border x:Name="BasicHeatmapContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Color Scales -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Color Scales" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The same data rendered with the Viridis and Grayscale color scales." />
                <Border x:Name="ColorScalesContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- Cell Values -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Cell Values" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A heatmap with ShowCellValues enabled, displaying the numeric value inside each cell." />
                <Border x:Name="CellValuesContainer" Style="{StaticResource GalleryDemoSurface}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a heatmap with axis labels and cell values." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Generating sample data and building a heatmap in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
