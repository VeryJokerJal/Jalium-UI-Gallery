<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.JsonTreeViewerPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="JsonTreeViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.DataViewers}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.JsonTreeViewer.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.JsonTreeViewer.Sub1}" />

        <!-- Basic JSON tree -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.JsonTreeViewer.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.JsonTreeViewer.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <JsonTreeViewer x:Name="BasicJsonTree"
                                    Height="350"
                                    ExpandDepth="2"
                                    JsonText="{Binding SampleJson}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Search & filter -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.JsonTreeViewer.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.JsonTreeViewer.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBox x:Name="SearchInput"
                                 ToolTip="{DynamicResource Loc.P.JsonTreeViewer.Ui1}"
                                 Margin="0,0,0,12"
                                 Text="{Binding SearchText, Mode=TwoWay}" />
                        <JsonTreeViewer x:Name="SearchJsonTree"
                                        Height="300"
                                        ExpandDepth="3"
                                        JsonText="{Binding SearchSampleJson}"
                                        SearchText="{Binding SearchText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.JsonTreeViewer.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Text="{DynamicResource Loc.P.JsonTreeViewer.Ui2}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="JsonInput"
                                     AcceptsReturn="True"
                                     Height="350"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Text="{Binding InteractiveJson, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Text="Tree View:" FontSize="12" Margin="0,0,0,4" />
                            <JsonTreeViewer x:Name="InteractiveJsonTree"
                                            Height="350"
                                            ExpandDepth="3"
                                            JsonText="{Binding InteractiveJson}" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.JsonTreeViewer.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.JsonTreeViewer.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
