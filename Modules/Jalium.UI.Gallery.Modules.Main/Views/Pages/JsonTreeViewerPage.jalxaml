<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.JsonTreeViewerPage"
      Title="JsonTreeViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VIEWERS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="JsonTreeViewer" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that displays JSON data in an interactive tree view with search, expand/collapse, and path copying." />

        <!-- Basic JSON tree -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic JSON tree" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Display structured JSON data with color-coded types and expandable nodes." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <JsonTreeViewer x:Name="BasicJsonTree"
                                    Height="350"
                                    ExpandDepth="2" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Search & filter -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Search &amp; filter" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Type in the search box to highlight matching keys and values in the tree." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBox x:Name="SearchInput"
                                 ToolTip="Search keys or values..."
                                 Margin="0,0,0,12" />
                        <JsonTreeViewer x:Name="SearchJsonTree"
                                        Height="300"
                                        ExpandDepth="3" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Enter JSON text on the left and see the tree view update on the right." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Text="JSON Input:" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="JsonInput"
                                     AcceptsReturn="True"
                                     Height="350"
                                     FontFamily="Consolas"
                                     FontSize="12" />
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Width="400" Margin="0,0,10,10">
                            <TextBlock Text="Tree View:" FontSize="12" Margin="0,0,0,4" />
                            <JsonTreeViewer x:Name="InteractiveJsonTree"
                                            Height="350"
                                            ExpandDepth="3" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the JSON tree viewers above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Loading JSON, wiring the search box, and updating the tree in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
