<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.CalendarPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="COLLECTIONS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Calendar" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that displays a monthly calendar for browsing and selecting dates, with month, year and decade views." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Pick a day on the calendar and the selected date updates below." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Calendar x:Name="DemoCalendar" Margin="0,0,10,10" />
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Style="{StaticResource GalleryCaptionText}"
                                       Text="Selected date"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="SelectedDateText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="None" />
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The Calendar control supports the following out of the box." />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Month / year / decade views" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Single or range date selection" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Blackout dates" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Display date range constraints" Margin="0,0,0,6" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• First day of week customization" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the Calendar shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating a Calendar and handling date selection in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
