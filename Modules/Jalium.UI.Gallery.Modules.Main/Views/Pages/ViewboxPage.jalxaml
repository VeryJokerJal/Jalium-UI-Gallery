<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ViewboxPage"
      Title="Viewbox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Viewbox" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A decorator that scales its single child to fit the available space, with control over stretch mode and direction." />

        <!-- Uniform Stretch -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Uniform Stretch" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Content is scaled uniformly to fit while preserving aspect ratio." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="100" Margin="0,0,10,10">
                            <Viewbox Stretch="Uniform">
                                <Button Content="Scale Me" Width="200" Height="50"/>
                            </Viewbox>
                        </Border>
                        <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="150" Height="100" Margin="0,0,10,10">
                            <Viewbox Stretch="Uniform">
                                <Button Content="Scale Me" Width="200" Height="50"/>
                            </Viewbox>
                        </Border>
                        <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="200" Height="100" Margin="0,0,10,10">
                            <Viewbox Stretch="Uniform">
                                <Button Content="Scale Me" Width="200" Height="50"/>
                            </Viewbox>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stretch Modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stretch Modes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Different stretch modes control how content fills the viewbox." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="None" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80">
                                <Viewbox Stretch="None">
                                    <Ellipse Width="60" Height="40" Fill="{DynamicResource GalleryAccent}"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="Fill" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80">
                                <Viewbox Stretch="Fill">
                                    <Ellipse Width="60" Height="40" Fill="#00CC6A"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="Uniform" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80">
                                <Viewbox Stretch="Uniform">
                                    <Ellipse Width="60" Height="40" Fill="#F7630C"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="UniformToFill" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80" ClipToBounds="True">
                                <Viewbox Stretch="UniformToFill">
                                    <Ellipse Width="60" Height="40" Fill="#E81123"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stretch Direction -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stretch Direction" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Control whether content scales up, down, or both." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="UpOnly" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="120" Height="80">
                                <Viewbox Stretch="Uniform" StretchDirection="UpOnly">
                                    <TextBlock Text="Small" FontSize="8"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="DownOnly" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="60" Height="40">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock Text="Large" FontSize="24"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="Both" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="60">
                                <Viewbox Stretch="Uniform" StretchDirection="Both">
                                    <TextBlock Text="Both" FontSize="16"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive Demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive Demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Resize the container with the sliders to see the viewbox rescale its child." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="WidthSlider" Minimum="50" Maximum="400" Value="200" Width="200"/>
                            <TextBlock x:Name="WidthText" Text="200" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Height:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="HeightSlider" Minimum="50" Maximum="300" Value="150" Width="200"/>
                            <TextBlock x:Name="HeightText" Text="150" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="DemoContainer" BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="200" Height="150" HorizontalAlignment="Left">
                            <Viewbox Stretch="Uniform">
                                <StackPanel Orientation="Vertical" Width="200">
                                    <TextBlock Text="Viewbox Demo" FontSize="18" HorizontalAlignment="Center"/>
                                    <Button Content="Scaled Button" Width="120" Height="30" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common Use Cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Common Use Cases" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Where a viewbox earns its keep in real layouts." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="• Scaling icons to different sizes" Margin="0,0,0,8"/>
                        <TextBlock Text="• Creating responsive layouts" Margin="0,0,0,8"/>
                        <TextBlock Text="• Fitting vector graphics" Margin="0,0,0,8"/>
                        <TextBlock Text="• Thumbnail previews" Margin="0,0,0,8"/>
                        <TextBlock Text="• Zoom functionality"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the viewbox examples above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring the interactive sliders and scaling icons in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
