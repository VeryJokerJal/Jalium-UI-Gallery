<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ViewboxPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Viewbox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Viewbox.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Viewbox.Sub1}" />

        <!-- Uniform Stretch -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Viewbox.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="100" Margin="0,0,10,10">
                            <Viewbox Stretch="Uniform">
                                <Button Content="Scale Me" Width="200" Height="50"/>
                            </Viewbox>
                        </Border>
                        <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="150" Height="100" Margin="0,0,10,10">
                            <Viewbox Stretch="Uniform">
                                <Button Content="Scale Me" Width="200" Height="50"/>
                            </Viewbox>
                        </Border>
                        <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="200" Height="100" Margin="0,0,10,10">
                            <Viewbox Stretch="Uniform">
                                <Button Content="Scale Me" Width="200" Height="50"/>
                            </Viewbox>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stretch Modes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Viewbox.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="None" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80">
                                <Viewbox Stretch="None">
                                    <Ellipse Width="60" Height="40" Fill="{DynamicResource GalleryAccent}"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="Fill" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80">
                                <Viewbox Stretch="Fill">
                                    <Ellipse Width="60" Height="40" Fill="#00CC6A"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="Uniform" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80">
                                <Viewbox Stretch="Uniform">
                                    <Ellipse Width="60" Height="40" Fill="#F7630C"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="UniformToFill" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="80" ClipToBounds="True">
                                <Viewbox Stretch="UniformToFill">
                                    <Ellipse Width="60" Height="40" Fill="#E81123"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Stretch Direction -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Viewbox.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="UpOnly" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="120" Height="80">
                                <Viewbox Stretch="Uniform" StretchDirection="UpOnly">
                                    <TextBlock Text="Small" FontSize="8"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="DownOnly" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="60" Height="40">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock Text="Large" FontSize="24"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" Margin="0,0,10,10">
                            <TextBlock Text="Both" FontSize="12" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                            <Border BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" Width="100" Height="60">
                                <Viewbox Stretch="Uniform" StretchDirection="Both">
                                    <TextBlock Text="Both" FontSize="16"/>
                                </Viewbox>
                            </Border>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Interactive Demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Width:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="WidthSlider" Minimum="50" Maximum="400" Value="{Binding PreviewWidth, Mode=TwoWay}" Width="200"/>
                            <TextBlock x:Name="WidthText" Text="{Binding PreviewWidthText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <TextBlock Text="Height:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider x:Name="HeightSlider" Minimum="50" Maximum="300" Value="{Binding PreviewHeight, Mode=TwoWay}" Width="200"/>
                            <TextBlock x:Name="HeightText" Text="{Binding PreviewHeightText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Border x:Name="DemoContainer"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                Width="{Binding PreviewWidth}"
                                Height="{Binding PreviewHeight}"
                                HorizontalAlignment="Left">
                            <Viewbox Stretch="Uniform">
                                <StackPanel Orientation="Vertical" Width="200">
                                    <TextBlock Text="Viewbox Demo" FontSize="18" HorizontalAlignment="Center"/>
                                    <Button Content="Scaled Button" Width="120" Height="30" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Viewbox>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Common Use Cases -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CommonUseCases}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Viewbox.Use1}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Viewbox.Use2}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Viewbox.Use3}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Viewbox.Use4}" Margin="0,0,0,8"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.Viewbox.Use5}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Viewbox.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
