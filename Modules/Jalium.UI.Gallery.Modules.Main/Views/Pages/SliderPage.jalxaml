<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SliderPage"
      Title="Slider">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Slider" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that lets people pick a value from a range by dragging a thumb along a track, with optional tick marks and snapping." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag the thumb to change the value and watch the readout update live." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Slider x:Name="DemoSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="50"
                                Height="24"
                                Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Value: " />
                            <TextBlock x:Name="SliderValue"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="50" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Slider with ticks -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Slider with ticks" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Tick marks placed at a regular TickFrequency hint at the available stops along the track." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Slider Minimum="0"
                            Maximum="100"
                            Value="50"
                            TickFrequency="10"
                            Height="24" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Snap to ticks -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Snap to ticks" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="With IsSnapToTickEnabled the thumb locks onto the nearest tick position as you drag." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Slider Minimum="0"
                            Maximum="100"
                            Value="50"
                            TickFrequency="25"
                            IsSnapToTickEnabled="True"
                            Height="24" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom range -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Custom range" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Set any Minimum and Maximum — including negative ranges — to match the data you are bound to." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="Volume (0-100)"
                                   Margin="0,0,0,6" />
                        <Slider Minimum="0"
                                Maximum="100"
                                Value="75"
                                Height="24"
                                Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="Temperature (-10 to 40)"
                                   Margin="0,0,0,6" />
                        <Slider Minimum="-10"
                                Maximum="40"
                                Value="22"
                                Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the sliders above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Handling ValueChanged and building sliders in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
