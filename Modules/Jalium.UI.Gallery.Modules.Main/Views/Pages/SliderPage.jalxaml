<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SliderPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Slider">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Slider.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Slider.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Slider x:Name="DemoSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding Value, Mode=TwoWay}"
                                Height="24"
                                Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Value: " />
                            <TextBlock x:Name="SliderValue"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding ValueText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Slider with ticks -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Slider.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Slider Minimum="0"
                            Maximum="100"
                            Value="50"
                            TickFrequency="10"
                            Height="24" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Snap to ticks -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.SnapToTicks}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Slider Minimum="0"
                            Maximum="100"
                            Value="50"
                            TickFrequency="25"
                            IsSnapToTickEnabled="True"
                            Height="24" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Segmented track -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.SegmentedTrack}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.Slider.Cap1}"
                                   Margin="0,0,0,4" />
                        <Slider Minimum="0"
                                Maximum="100"
                                Value="60"
                                TickFrequency="20"
                                IsSnapToTickEnabled="True"
                                TrackMode="Segmented"
                                Height="24"
                                Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.Slider.Cap2}"
                                   Margin="0,0,0,4" />
                        <Slider Minimum="0"
                                Maximum="100"
                                Value="45"
                                TickFrequency="20"
                                TrackMode="Segmented"
                                Height="24"
                                Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.Slider.Cap3}"
                                   Margin="0,0,0,4" />
                        <Slider Minimum="0"
                                Maximum="100"
                                Value="45"
                                Ticks="10, 30, 60"
                                SegmentGap="6"
                                TrackMode="Segmented"
                                Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom range -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Slider.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{DynamicResource Loc.P.Slider.Val1}"
                                   Margin="0,0,0,6" />
                        <Slider Minimum="0"
                                Maximum="100"
                                Value="75"
                                Height="24"
                                Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{DynamicResource Loc.P.Slider.Val2}"
                                   Margin="0,0,0,6" />
                        <Slider Minimum="-10"
                                Maximum="40"
                                Value="22"
                                Height="24" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Slider.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
