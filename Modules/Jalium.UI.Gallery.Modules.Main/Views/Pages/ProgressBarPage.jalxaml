<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ProgressBarPage"
      Title="ProgressBar">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ProgressBar" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control that visualizes the progress of an operation, either as a determinate percentage or an indeterminate loading animation." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Use the slider to change the progress value." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <ProgressBar x:Name="DemoProgressBar"
                                     Value="45"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Value: " />
                            <TextBlock x:Name="ProgressValue"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="45%" />
                        </StackPanel>
                        <Slider x:Name="ProgressSlider"
                                Minimum="0"
                                Maximum="100"
                                Value="45"
                                Height="24"
                                Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Progress variants -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Progress variants" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The same ProgressBar filled to a range of determinate values." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="25%" Margin="0,0,0,4" />
                        <ProgressBar Value="25"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="50%" Margin="0,0,0,4" />
                        <ProgressBar Value="50"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="75%" Margin="0,0,0,4" />
                        <ProgressBar Value="75"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8"
                                     Margin="0,0,0,16" />

                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="100%" Margin="0,0,0,4" />
                        <ProgressBar Value="100"
                                     Minimum="0"
                                     Maximum="100"
                                     Height="8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Indeterminate mode -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Indeterminate mode" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A progress bar that shows ongoing activity without a specific percentage." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <ProgressBar IsIndeterminate="True"
                                 Height="8" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the progress bars shown above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring the slider to the bar and animating a download from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
