<Page
    xmlns="http://schemas.jalium.com/jalxaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PrintingPage"
    Title="Printing System">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="SYSTEM" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Printing" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="WPF-compatible printing with PrintDialog, PrintQueue, and DocumentPaginator support." />

        <!-- PrintDialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="PrintDialog" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Standard print dialog for selecting a printer and print options." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button x:Name="ShowPrintDialogButton" Content="Show Print Dialog" Width="150" Margin="0,0,10,10" />
                            <Button x:Name="PrintVisualButton" Content="Print Visual" Width="120" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock x:Name="PrintStatus"
                                   Style="{StaticResource GalleryCaptionText}"
                                   Text="Print Status: Ready"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- PrintQueue -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="PrintQueue" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Represents a printer and provides print-capabilities querying." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button x:Name="ListPrintersButton"
                                Content="List Available Printers"
                                Width="180"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="150">
                            <TextBlock x:Name="PrinterList"
                                       Text="Click to list printers..."
                                       FontFamily="Consolas"
                                       FontSize="12" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- PrintCapabilities -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="PrintCapabilities" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Query printer capabilities including paper sizes, colors, and resolution." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="Supported features" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="Page Sizes: Letter, Legal, A3, A4, A5, Tabloid, Executive" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="Orientations: Portrait, Landscape, Reverse" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="Colors: Color, Grayscale, Monochrome" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="Duplex: OneSided, TwoSidedShortEdge, TwoSidedLongEdge" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="Quality: Draft, Normal, High, Photographic" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DocumentPaginator -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="DocumentPaginator" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Paginate documents for printing with the IDocumentPaginatorSource interface." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="// Print a document" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="var paginator = document.DocumentPaginator;" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="paginator.PageSize = new Size(816, 1056);" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="printDialog.PrintDocument(paginator, &quot;My Doc&quot;);" FontFamily="Consolas" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the print buttons and printer list above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Showing the dialog, enumerating printers, and paginating a document in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
