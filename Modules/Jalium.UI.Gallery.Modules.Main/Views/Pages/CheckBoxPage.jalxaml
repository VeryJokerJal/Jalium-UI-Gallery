<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.CheckBoxPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="CheckBox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.CheckBox.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.CheckBox.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CheckBox.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="DemoCheckBox"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.P.CheckBox.Demo1}" FontSize="14"/>
                        </CheckBox>
                        <TextBlock x:Name="CheckBoxStatus"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CheckBoxStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Basic checkboxes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.CheckBox.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CheckBox.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Margin="0,0,0,8">
                            <TextBlock Text="Option 1" FontSize="14"/>
                        </CheckBox>
                        <CheckBox IsChecked="True" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.P.CheckBox.Demo2}" FontSize="14"/>
                        </CheckBox>
                        <CheckBox IsEnabled="False">
                            <TextBlock Text="{DynamicResource Loc.P.CheckBox.Demo3}" FontSize="14"/>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Three-state checkbox -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.CheckBox.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CheckBox.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="ThreeStateCheckBox"
                                  IsThreeState="True"
                                  IsChecked="{Binding ThreeStateValue, Mode=TwoWay}"
                                  Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Loc.P.CheckBox.Demo4}" FontSize="14"/>
                        </CheckBox>
                        <TextBlock x:Name="ThreeStateStatus"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding ThreeStateStatus}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CheckBox.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CheckBox.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
