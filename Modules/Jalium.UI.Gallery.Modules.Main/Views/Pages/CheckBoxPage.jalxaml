<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.CheckBoxPage"
      Title="CheckBox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="CheckBox" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A control a user can select and clear, with optional support for an indeterminate third state." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click the checkbox to toggle its state." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="DemoCheckBox" Margin="0,0,0,8">
                            <TextBlock Text="I agree to the terms" FontSize="14"/>
                        </CheckBox>
                        <TextBlock x:Name="CheckBoxStatus"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Status: Unchecked" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Basic checkboxes -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic checkboxes" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Standard checkbox controls in unchecked, checked and disabled states." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox Margin="0,0,0,8">
                            <TextBlock Text="Option 1" FontSize="14"/>
                        </CheckBox>
                        <CheckBox IsChecked="True" Margin="0,0,0,8">
                            <TextBlock Text="Option 2 (checked)" FontSize="14"/>
                        </CheckBox>
                        <CheckBox IsEnabled="False">
                            <TextBlock Text="Disabled option" FontSize="14"/>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Three-state checkbox -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Three-state checkbox" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A checkbox that adds an indeterminate state alongside checked and unchecked." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="ThreeStateCheckBox" IsThreeState="True" Margin="0,0,0,8">
                            <TextBlock Text="Three-state checkbox" FontSize="14"/>
                        </CheckBox>
                        <TextBlock x:Name="ThreeStateStatus"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Status: Indeterminate" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the checkboxes above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring checked, unchecked and indeterminate handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
