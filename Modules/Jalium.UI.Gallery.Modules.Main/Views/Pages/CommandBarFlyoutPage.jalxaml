<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.CommandBarFlyoutPage"
      Title="CommandBarFlyout">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="CommandBarFlyout" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A flyout that displays a CommandBar with primary and secondary commands in a lightweight popup." />

        <!-- Basic CommandBarFlyout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic CommandBarFlyout" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Click the button below to open a CommandBarFlyout with editing commands." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="BasicFlyoutContainer" Orientation="Vertical" />
                </Border>
                <TextBlock x:Name="BasicFlyoutStatus"
                           Style="{StaticResource GalleryCaptionText}"
                           Text="Click the button to open the CommandBarFlyout."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- CommandBarFlyout with mixed commands -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="CommandBarFlyout with Mixed Commands" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="A CommandBarFlyout with both primary and secondary commands. The secondary commands appear in the overflow." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="MixedFlyoutContainer" Orientation="Vertical" />
                </Border>
                <TextBlock x:Name="MixedFlyoutStatus"
                           Style="{StaticResource GalleryCaptionText}"
                           Text="Click the button to open the flyout with mixed commands."
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the trigger button that shows the flyout." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building the CommandBarFlyout and wiring its commands in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
