<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.CommandBarFlyoutPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="CommandBarFlyout">

    <StackPanel Style="{StaticResource GalleryPageStack}">
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.MenusAndToolbars}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.CommandBarFlyout.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.CommandBarFlyout.Sub1}" />

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.CommandBarFlyout.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CommandBarFlyout.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button Content="Show Editing Commands"
                            Height="36"
                            Width="200"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenBasicFlyoutCommand}">
                        <behaviors:FlyoutButtonBehavior.Flyout>
                            <CommandBarFlyout>
                                <CommandBarFlyout.PrimaryCommands>
                                    <AppBarButton Label="Cut"
                                                  Command="{Binding ExecuteBasicCommand}"
                                                  CommandParameter="Cut">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Cut" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Copy"
                                                  Command="{Binding ExecuteBasicCommand}"
                                                  CommandParameter="Copy">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Copy" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Paste"
                                                  Command="{Binding ExecuteBasicCommand}"
                                                  CommandParameter="Paste">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Paste" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Select All"
                                                  Command="{Binding ExecuteBasicCommand}"
                                                  CommandParameter="Select All">
                                        <AppBarButton.Icon><SymbolIcon Symbol="SelectAll" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBarFlyout.PrimaryCommands>
                            </CommandBarFlyout>
                        </behaviors:FlyoutButtonBehavior.Flyout>
                    </Button>
                </Border>
                <TextBlock Style="{StaticResource GalleryCaptionText}"
                           Text="{Binding BasicStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.CommandBarFlyout.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CommandBarFlyout.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button Content="Show Mixed Commands Flyout"
                            Height="36"
                            Width="240"
                            HorizontalAlignment="Left"
                            Command="{Binding OpenMixedFlyoutCommand}">
                        <behaviors:FlyoutButtonBehavior.Flyout>
                            <CommandBarFlyout>
                                <CommandBarFlyout.PrimaryCommands>
                                    <AppBarButton Label="Share"
                                                  Command="{Binding ExecuteMixedCommand}"
                                                  CommandParameter="Share">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Share" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Favorite"
                                                  Command="{Binding ExecuteMixedCommand}"
                                                  CommandParameter="Favorite">
                                        <AppBarButton.Icon><SymbolIcon Symbol="FavoriteStar" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBarFlyout.PrimaryCommands>
                                <CommandBarFlyout.SecondaryCommands>
                                    <AppBarButton Label="Rename"
                                                  Command="{Binding ExecuteMixedCommand}"
                                                  CommandParameter="Rename">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Rename" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Delete"
                                                  Command="{Binding ExecuteMixedCommand}"
                                                  CommandParameter="Delete">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Delete" /></AppBarButton.Icon>
                                    </AppBarButton>
                                    <AppBarButton Label="Properties"
                                                  Command="{Binding ExecuteMixedCommand}"
                                                  CommandParameter="Properties">
                                        <AppBarButton.Icon><SymbolIcon Symbol="Settings" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBarFlyout.SecondaryCommands>
                            </CommandBarFlyout>
                        </behaviors:FlyoutButtonBehavior.Flyout>
                    </Button>
                </Border>
                <TextBlock Style="{StaticResource GalleryCaptionText}"
                           Text="{Binding MixedStatus}"
                           Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CommandBarFlyout.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.CommandBarFlyout.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
