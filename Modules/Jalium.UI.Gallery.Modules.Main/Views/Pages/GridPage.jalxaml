<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GridPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Grid">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Grid.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Grid.Sub1}" />

        <!-- Basic grid layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Grid.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Grid.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <!-- Real 3x3 Grid demo -->
                    <Grid HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                            <RowDefinition Height="60"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GalleryAccent}" Margin="0,0,4,4">
                            <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#22C55E" Margin="0,0,4,4">
                            <TextBlock Foreground="Black" Text="0,1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#179842" Margin="0,0,0,4">
                            <TextBlock Foreground="Black" Text="0,2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Background="#CA5010" Margin="0,0,4,4">
                            <TextBlock Foreground="White" Text="1,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Background="#008272" Margin="0,0,4,4">
                            <TextBlock Foreground="White" Text="1,1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="#39C267" Margin="0,0,0,4">
                            <TextBlock Foreground="Black" Text="1,2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Background="#567C73" Margin="0,0,4,0">
                            <TextBlock Foreground="White" Text="2,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" Background="#7E735F" Margin="0,0,4,0">
                            <TextBlock Foreground="White" Text="2,1"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" Background="#4C4A48">
                            <TextBlock Foreground="White" Text="2,2"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Grid features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Grid.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Grid.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <!-- Real Grid demo showing spans and mixed sizing -->
                        <Grid Height="190">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="70"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                    Background="{DynamicResource GalleryAccent}"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,8">
                                <TextBlock Foreground="{ThemeResource TextOnAccent}" Text="Header (ColumnSpan=3)"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="2"
                                    Background="#22C55E"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <TextBlock Foreground="Black" Text="Sidebar&#10;(RowSpan=2)"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                    Background="#179842"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <TextBlock Foreground="Black" Text="Content Area&#10;(ColumnSpan=2)"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="1"
                                    Background="#CA5010"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <TextBlock Foreground="White" Text="Fixed + Star sizing"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>

                            <Border Grid.Row="2" Grid.Column="2"
                                    Background="#008272"
                                    CornerRadius="8"
                                    Padding="12">
                                <TextBlock Foreground="White" Text="Grid.Row / Grid.Column"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.Grid.Cap1}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Grid.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Grid.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
