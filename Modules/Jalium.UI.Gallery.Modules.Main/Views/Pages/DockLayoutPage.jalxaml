<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DockLayoutPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="DockLayout">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.DockLayout.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.DockLayout.Sub1}" />

        <!-- Example 1: IDE Layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DockLayout.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DockLayout.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="400">
                    <DockLayout>
                        <DockSplitPanel Orientation="Horizontal">
                            <!-- Left Sidebar -->
                            <DockTabPanel DockSplitPanel.Size="220" DockSplitPanel.MinSize="150">
                                <DockItem Header="Explorer">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="{DynamicResource Loc.P.DockLayout.Ui1}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="  MyApp" FontSize="12"/>
                                        <TextBlock Text="    src/" FontSize="12"/>
                                        <TextBlock Text="      Program.cs" FontSize="12"/>
                                        <TextBlock Text="      MainWindow.cs" FontSize="12"/>
                                        <TextBlock Text="      App.config" FontSize="12"/>
                                        <TextBlock Text="    assets/" FontSize="12"/>
                                        <TextBlock Text="      logo.png" FontSize="12"/>
                                    </StackPanel>
                                </DockItem>
                                <DockItem Header="Search">
                                    <StackPanel Margin="12">
                                        <TextBox Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Loc.P.DockLayout.Ui2}" FontSize="12"/>
                                    </StackPanel>
                                </DockItem>
                            </DockTabPanel>

                            <!-- Center + Bottom -->
                            <DockSplitPanel Orientation="Vertical">
                                <!-- Editor Area -->
                                <DockTabPanel>
                                    <DockItem Header="MainWindow.cs">
                                        <StackPanel Margin="12">
                                            <TextBlock Text="using Jalium.UI;" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="using Jalium.UI.Controls;" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="" FontSize="12"/>
                                            <TextBlock Text="namespace MyApp;" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="" FontSize="12"/>
                                            <TextBlock Text="public class MainWindow : Window" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="{" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="    public MainWindow()" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="    {" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="        Title = &quot;My Application&quot;;" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="    }" FontSize="12" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="}" FontSize="12" FontFamily="Cascadia Code"/>
                                        </StackPanel>
                                    </DockItem>
                                    <DockItem Header="App.cs">
                                        <StackPanel Margin="12">
                                            <TextBlock Text="// Application entry point" FontSize="12" FontFamily="Cascadia Code"/>
                                        </StackPanel>
                                    </DockItem>
                                </DockTabPanel>

                                <!-- Bottom Panel -->
                                <DockTabPanel DockSplitPanel.Size="130" DockSplitPanel.MinSize="80">
                                    <DockItem Header="Output">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="Build started..." FontSize="11" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="1>------ Build started: Project: MyApp ------" FontSize="11" Foreground="{DynamicResource GalleryTextSecondary}" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="1>MyApp -> bin\Debug\MyApp.exe" FontSize="11" Foreground="{DynamicResource GalleryTextSecondary}" FontFamily="Cascadia Code"/>
                                            <TextBlock Text="========== Build: 1 succeeded ==========" FontSize="11" FontFamily="Cascadia Code"/>
                                        </StackPanel>
                                    </DockItem>
                                    <DockItem Header="Terminal">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="PS D:\Projects\MyApp> _" FontSize="11" Foreground="{DynamicResource GalleryTextSecondary}" FontFamily="Cascadia Code"/>
                                        </StackPanel>
                                    </DockItem>
                                    <DockItem Header="{DynamicResource Loc.P.DockLayout.Ui3}">
                                        <StackPanel Margin="8">
                                            <TextBlock Text="{DynamicResource Loc.P.DockLayout.Ui4}" FontSize="11"/>
                                        </StackPanel>
                                    </DockItem>
                                </DockTabPanel>
                            </DockSplitPanel>
                        </DockSplitPanel>
                    </DockLayout>
                </Border>
            </StackPanel>
        </Border>

        <!-- Example 2: Three Column Layout -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DockLayout.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DockLayout.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" Height="250">
                    <DockLayout>
                        <DockSplitPanel Orientation="Horizontal">
                            <DockTabPanel DockSplitPanel.Size="*">
                                <DockItem Header="Files">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="{DynamicResource Loc.P.DockLayout.Ui5}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Documents/" FontSize="12"/>
                                        <TextBlock Text="Downloads/" FontSize="12"/>
                                        <TextBlock Text="Pictures/" FontSize="12"/>
                                    </StackPanel>
                                </DockItem>
                            </DockTabPanel>
                            <DockTabPanel DockSplitPanel.Size="2*">
                                <DockItem Header="Preview">
                                    <StackPanel Margin="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Loc.P.DockLayout.Ui6}" FontSize="14"/>
                                        <TextBlock Text="(2x width)" FontSize="12" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockItem>
                            </DockTabPanel>
                            <DockTabPanel DockSplitPanel.Size="*">
                                <DockItem Header="Properties" CanClose="False">
                                    <StackPanel Margin="12">
                                        <TextBlock Text="Properties" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBlock Text="Name: document.txt" FontSize="12"/>
                                        <TextBlock Text="Size: 4.2 KB" FontSize="12"/>
                                        <TextBlock Text="Modified: 2026-02-16" FontSize="12"/>
                                    </StackPanel>
                                </DockItem>
                            </DockTabPanel>
                        </DockSplitPanel>
                    </DockLayout>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DockLayout.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DockLayout.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
