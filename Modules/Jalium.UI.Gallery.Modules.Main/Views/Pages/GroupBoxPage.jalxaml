<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GroupBoxPage"
      hosting:ViewModelLocator.AutoWireViewModel="True">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Layout}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.GroupBox.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.GroupBox.Sub1}" />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.InteractiveDemo}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GroupBox.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <GroupBox Header="{DynamicResource Loc.P.GroupBox.Demo1}" Width="250" Margin="0,0,10,10">
                            <StackPanel Orientation="Vertical" Margin="8">
                                <TextBlock Text="Name:" Margin="0,0,0,4" />
                                <TextBox Margin="0,0,0,8" />
                                <TextBlock Text="Email:" Margin="0,0,0,4" />
                                <TextBox />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Preferences" Width="250" Margin="0,0,10,10">
                            <StackPanel Orientation="Vertical" Margin="8">
                                <CheckBox Content="{DynamicResource Loc.P.GroupBox.Demo2}" Margin="0,0,0,8"/>
                                <CheckBox Content="{DynamicResource Loc.P.GroupBox.Demo3}" Margin="0,0,0,8"/>
                                <CheckBox Content="{DynamicResource Loc.P.GroupBox.Demo4}"/>
                            </StackPanel>
                        </GroupBox>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Features}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GroupBox.CC2}" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.GroupBox.Body1}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.GroupBox.Body2}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.GroupBox.Body3}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.GroupBox.Body4}" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GroupBox.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.GroupBox.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
