<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GroupBoxPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="GroupBox" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A container that frames a set of related controls under a titled header, giving forms and settings panels clear visual structure." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Two GroupBoxes on one row, each framing its own set of fields." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <GroupBox Header="Personal Information" Width="250" Margin="0,0,10,10">
                            <StackPanel Orientation="Vertical" Margin="8">
                                <TextBlock Text="Name:" Margin="0,0,0,4" />
                                <TextBox Margin="0,0,0,8" />
                                <TextBlock Text="Email:" Margin="0,0,0,4" />
                                <TextBox />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Preferences" Width="250" Margin="0,0,10,10">
                            <StackPanel Orientation="Vertical" Margin="8">
                                <CheckBox Content="Receive updates" Margin="0,0,0,8"/>
                                <CheckBox Content="Enable dark mode" Margin="0,0,0,8"/>
                                <CheckBox Content="Show advanced options"/>
                            </StackPanel>
                        </GroupBox>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="What the GroupBox container gives you." />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Visual grouping of related controls" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Customizable header text" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Header can contain any content" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Styled border around content" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the grouped forms above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a settings GroupBox and its fields in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
