<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ToolTipPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ToolTip">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Overlays}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ToolTip.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.ToolTip.Sub1}" />

        <!-- Basic ToolTip -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolTip.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToolTip.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button x:Name="SaveButton"
                                Content="Save"
                                Width="80"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip1}" />
                        <Button Content="Open"
                                Width="80"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip2}" />
                        <Button Content="Delete"
                                Width="80"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip3}" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ToolTips on Various Controls -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolTip.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToolTip.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBox Width="200"
                                     Height="32"
                                     ToolTip="{DynamicResource Loc.P.ToolTip.Tip4}"
                                     Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource Loc.P.ToolTip.Tip5}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Slider Width="200"
                                    Minimum="0"
                                    Maximum="100"
                                    ToolTip="{DynamicResource Loc.P.ToolTip.Tip6}"
                                    Margin="0,0,12,0" />
                            <TextBlock Text="{DynamicResource Loc.P.ToolTip.Tip7}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="{DynamicResource Loc.P.ToolTip.Tip8}"
                                      ToolTip="{DynamicResource Loc.P.ToolTip.Tip9}"
                                      Margin="0,0,12,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Rich Content ToolTip -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolTip.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToolTip.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <Button Content="{DynamicResource Loc.P.ToolTip.Tip10}" Width="180" Height="32">
                        <Button.ToolTip>
                            <ToolTip>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{DynamicResource Loc.P.ToolTip.Tip11}" FontWeight="Bold" Margin="0,0,0,4" />
                                    <TextBlock Text="{DynamicResource Loc.P.ToolTip.Tip12}" TextWrapping="Wrap" />
                                    <TextBlock Text="{DynamicResource Loc.P.ToolTip.Tip13}" TextWrapping="Wrap" />
                                    <Separator Margin="0,8" />
                                    <TextBlock Text="{DynamicResource Loc.P.ToolTip.Tip14}" FontSize="11" />
                                </StackPanel>
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                </Border>
            </StackPanel>
        </Border>

        <!-- ToolTip Placement -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToolTip.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToolTip.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Top"
                                Width="60"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip15}" />
                        <Button Content="Right"
                                Width="60"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip16}" />
                        <Button Content="Bottom"
                                Width="60"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip17}" />
                        <Button Content="Left"
                                Width="60"
                                Height="32"
                                Margin="0,0,10,10"
                                ToolTip="{DynamicResource Loc.P.ToolTip.Tip18}" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToolTip.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.ToolTip.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
