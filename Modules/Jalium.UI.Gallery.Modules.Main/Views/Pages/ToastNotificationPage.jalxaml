<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ToastNotificationPage"
      Title="ToastNotification">

    <!--
        ToastNotification page. The visible content column adopts the shared
        gallery scaffold (GalleryPageStack + GalleryCard sections). It is wrapped
        in a Grid only so the ToastNotificationHost can overlay the page as a
        sibling that renders on top of the content — the framework's content host
        provides scrolling, so no page-level ScrollViewer is needed.
    -->

    <Grid>

        <StackPanel Style="{StaticResource GalleryPageStack}">

            <!-- Page header -->
            <TextBlock Style="{StaticResource GalleryEyebrow}" Text="OVERLAYS" />
            <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ToastNotification" />
            <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                       Text="A transient overlay that surfaces brief, self-dismissing notifications in a corner of the window without blocking the user." />

            <!-- Basic notifications -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic toast notifications" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="Fire a toast at each severity level and watch it appear in the overlay host." />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <WrapPanel>
                            <Button x:Name="InfoToastButton" Content="Info" Width="70" Height="28" Margin="0,0,10,10" />
                            <Button x:Name="SuccessToastButton" Content="Success" Width="80" Height="28" Margin="0,0,10,10" />
                            <Button x:Name="WarningToastButton" Content="Warning" Width="80" Height="28" Margin="0,0,10,10" />
                            <Button x:Name="ErrorToastButton" Content="Error" Width="70" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Toast preview" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="Static examples of how each severity renders inside a toast." />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <StackPanel Orientation="Vertical">
                            <!-- Info Toast Preview -->
                            <ToastNotificationItem Severity="Information"
                                                   Title="Information"
                                                   Message="This is an informational message."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"
                                                   Margin="0,0,0,8"/>

                            <!-- Success Toast Preview -->
                            <ToastNotificationItem Severity="Success"
                                                   Title="Success"
                                                   Message="Operation completed successfully."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"
                                                   Margin="0,0,0,8"/>

                            <!-- Warning Toast Preview -->
                            <ToastNotificationItem Severity="Warning"
                                                   Title="Warning"
                                                   Message="Please review before proceeding."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"
                                                   Margin="0,0,0,8"/>

                            <!-- Error Toast Preview -->
                            <ToastNotificationItem Severity="Error"
                                                   Title="Error"
                                                   Message="An error occurred during the operation."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- With actions -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Toast with actions" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="Toasts can include action buttons; trigger one to see the action handler respond." />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <StackPanel Orientation="Vertical">
                            <!-- Toast with Actions Preview -->
                            <Border Background="{DynamicResource GalleryCardBackground}" BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="📥" FontSize="16" Margin="0,0,12,0"/>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="Download Complete" FontWeight="SemiBold"/>
                                            <TextBlock Text="Your file has been downloaded." FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Open" Width="60" Height="24" FontSize="11" Margin="0,0,8,0"/>
                                        <Button Content="Dismiss" Width="70" Height="24" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="ShowActionToastButton" Content="Show Toast with Actions" Width="180" Height="28" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Configuration -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Toast configuration" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="Set the host position and duration, toggle the close button and auto-dismiss, then show a custom toast." />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Position:" Width="100" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PositionComboBox" Width="150" Height="28">
                                    <ComboBoxItem Content="Top Right" IsSelected="True"/>
                                    <ComboBoxItem Content="Top Left"/>
                                    <ComboBoxItem Content="Top Center"/>
                                    <ComboBoxItem Content="Bottom Right"/>
                                    <ComboBoxItem Content="Bottom Left"/>
                                    <ComboBoxItem Content="Bottom Center"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Duration:" Width="100" VerticalAlignment="Center"/>
                                <Slider x:Name="DurationSlider" Minimum="1" Maximum="15" Value="5" Width="150" Margin="0,0,8,0"/>
                                <TextBlock x:Name="DurationText" Text="5s" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="ShowCloseCheckBox" Content="Show close button" IsChecked="True" Margin="0,0,0,8"/>
                            <CheckBox x:Name="PauseOnHoverCheckBox" Content="Auto-dismiss (pause on hover)" IsChecked="True" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button x:Name="ShowCustomToastButton" Content="Show Custom Toast" Width="150" Height="28" Margin="0,0,10,10"/>
                                <Button x:Name="DismissAllButton" Content="Dismiss All" Width="100" Height="28" Margin="0,0,10,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- XAML code example -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="Declarative markup for the toast host and preview items above." />
                    <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                        <EditControl x:Name="XamlCodeEditor"
                                     Height="200"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     ShowLineNumbers="True"
                                     FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- C# code example -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="Showing, configuring and dismissing toasts from code-behind." />
                    <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                        <EditControl x:Name="CSharpCodeEditor"
                                     Height="200"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     ShowLineNumbers="True"
                                     FontSize="13"/>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Toast notification overlay host (renders on top of content) -->
        <ToastNotificationHost x:Name="ToastHost"
                               Position="TopRight"
                               MaxVisibleToasts="5"
                               ToastWidth="380"
                               Spacing="8"/>
    </Grid>
</Page>
