<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ToastNotificationPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="ToastNotification">

    <!--
        ToastNotification page. The visible content column adopts the shared
        gallery scaffold (GalleryPageStack + GalleryCard sections). It is wrapped
        in a Grid only so the ToastNotificationHost can overlay the page as a
        sibling that renders on top of the content — the framework's content host
        provides scrolling, so no page-level ScrollViewer is needed.
    -->

    <Grid>

        <StackPanel Style="{StaticResource GalleryPageStack}">

            <!-- Page header -->
            <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Overlays}" />
            <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.ToastNotification.Title1}" />
            <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                       Text="{DynamicResource Loc.P.ToastNotification.Sub1}" />

            <!-- Basic notifications -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToastNotification.CT1}" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="{DynamicResource Loc.P.ToastNotification.CC1}" />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <WrapPanel>
                            <Button Content="Info" Command="{Binding ShowToastCommand}" CommandParameter="Information" Width="70" Height="28" Margin="0,0,10,10" />
                            <Button Content="Success" Command="{Binding ShowToastCommand}" CommandParameter="Success" Width="80" Height="28" Margin="0,0,10,10" />
                            <Button Content="Warning" Command="{Binding ShowToastCommand}" CommandParameter="Warning" Width="80" Height="28" Margin="0,0,10,10" />
                            <Button Content="Error" Command="{Binding ShowToastCommand}" CommandParameter="Error" Width="70" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Preview -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToastNotification.CT2}" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="{DynamicResource Loc.P.ToastNotification.CC2}" />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <StackPanel Orientation="Vertical">
                            <!-- Info Toast Preview -->
                            <ToastNotificationItem Severity="Information"
                                                   Title="Information"
                                                   Message="This is an informational message."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"
                                                   Margin="0,0,0,8"/>

                            <!-- Success Toast Preview -->
                            <ToastNotificationItem Severity="Success"
                                                   Title="Success"
                                                   Message="Operation completed successfully."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"
                                                   Margin="0,0,0,8"/>

                            <!-- Warning Toast Preview -->
                            <ToastNotificationItem Severity="Warning"
                                                   Title="Warning"
                                                   Message="Please review before proceeding."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"
                                                   Margin="0,0,0,8"/>

                            <!-- Error Toast Preview -->
                            <ToastNotificationItem Severity="Error"
                                                   Title="Error"
                                                   Message="An error occurred during the operation."
                                                   IsAutoDismissEnabled="False"
                                                   IsClosable="False"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- With actions -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToastNotification.CT3}" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="{DynamicResource Loc.P.ToastNotification.CC3}" />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <StackPanel Orientation="Vertical">
                            <!-- Toast with Actions Preview -->
                            <Border Background="{DynamicResource GalleryCardBackground}" BorderBrush="{DynamicResource GalleryBorderDefault}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Orientation="Vertical">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Width="36"
                                                Height="36"
                                                Background="{DynamicResource GalleryInfoSoft}"
                                                CornerRadius="10"
                                                Margin="0,0,12,0">
                                            <SymbolIcon Symbol="Download"
                                                        Width="18"
                                                        Height="18"
                                                        Foreground="{DynamicResource GalleryInfoOnSurface}"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{DynamicResource Loc.P.ToastNotification.Ui1}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource Loc.P.ToastNotification.Ui2}" FontSize="12"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Open" Width="60" Height="24" FontSize="11" Margin="0,0,8,0"/>
                                        <Button Content="Dismiss" Width="70" Height="24" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button Content="{DynamicResource Loc.P.ToastNotification.Ui3}" Command="{Binding ShowActionToastCommand}" Width="180" Height="28" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Configuration -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.ToastNotification.CT4}" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="{DynamicResource Loc.P.ToastNotification.CC4}" />
                    <Border Style="{StaticResource GalleryDemoSurface}">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Position:" Width="100" VerticalAlignment="Center"/>
                                <ComboBox Width="150"
                                          Height="28"
                                          ItemsSource="{Binding Positions}"
                                          SelectedItem="{Binding Position, Mode=TwoWay}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Duration:" Width="100" VerticalAlignment="Center"/>
                                <Slider Minimum="1" Maximum="15" Value="{Binding DurationSeconds, Mode=TwoWay}" Width="150" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding DurationSeconds, StringFormat='{}{0:F0}s'}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Content="{DynamicResource Loc.P.ToastNotification.Ui4}" IsChecked="{Binding ShowCloseButton, Mode=TwoWay}" Margin="0,0,0,8"/>
                            <CheckBox Content="{DynamicResource Loc.P.ToastNotification.Ui5}" IsChecked="{Binding AutoDismiss, Mode=TwoWay}" Margin="0,0,0,8"/>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="{DynamicResource Loc.P.ToastNotification.Ui6}" Command="{Binding ShowCustomToastCommand}" Width="150" Height="28" Margin="0,0,10,10"/>
                                <Button Content="{DynamicResource Loc.P.ToastNotification.Ui7}" Command="{Binding DismissAllCommand}" Width="100" Height="28" Margin="0,0,10,10"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- XAML code example -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="{DynamicResource Loc.P.ToastNotification.CC5}" />
                    <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                        <EditControl x:Name="XamlCodeEditor"
                                     Height="200"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     ShowLineNumbers="True"
                                     FontSize="13"
                                     Language="jalxaml"
                                     Text="{Binding XamlExample}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- C# code example -->
            <Border Style="{StaticResource GalleryCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                    <TextBlock Style="{StaticResource GalleryCardCaption}"
                               Text="{DynamicResource Loc.P.ToastNotification.CC6}" />
                    <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                        <EditControl x:Name="CSharpCodeEditor"
                                     Height="200"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     ShowLineNumbers="True"
                                     FontSize="13"
                                     Language="csharp"
                                     Text="{Binding CSharpExample}" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Toast notification overlay host (renders on top of content) -->
        <ToastNotificationHost x:Name="ToastHost"
                               Position="{Binding Position}"
                               MaxVisibleToasts="5"
                               ToastWidth="380"
                               Spacing="8"
                               behaviors:ToastHostBehavior.Request="{Binding Request}"/>
    </Grid>
</Page>
