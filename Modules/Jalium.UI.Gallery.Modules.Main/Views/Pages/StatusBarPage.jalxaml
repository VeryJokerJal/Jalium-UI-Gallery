<?xml version="1.0" encoding="utf-8"?>
<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.StatusBarPage">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="STATUS &amp; INFO" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="StatusBar" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A horizontal bar that surfaces status information — cursor position, encoding, progress — along the bottom edge of a window." />

        <!-- Interactive demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Interactive demo" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Status items separated by dividers, laid out as you would place them at the bottom of an editor window." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StatusBar Height="28">
                        <StatusBarItem Content="Ready" />
                        <Separator />
                        <StatusBarItem Content="Line: 42" />
                        <Separator />
                        <StatusBarItem Content="Column: 15" />
                        <Separator />
                        <StatusBarItem Content="UTF-8" />
                    </StatusBar>
                </Border>
            </StackPanel>
        </Border>

        <!-- Features -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Features" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="What the StatusBar control gives you out of the box." />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Multiple status items with separators" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Can contain any content" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Typically placed at window bottom" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource GalleryBodyText}" Text="• Supports progress indicators" />
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the status bar above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Updating status items from code-behind as the editor's caret position changes." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
