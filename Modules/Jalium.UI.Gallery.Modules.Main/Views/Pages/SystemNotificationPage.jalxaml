<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SystemNotificationPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="SystemNotification">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Overlays}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.SystemNotification.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.SystemNotification.Sub1}" />

        <!-- Basic notification -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SystemNotification.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Title:" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BasicTitle, Mode=TwoWay}" Width="300" Height="28"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Body:" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding BasicBody, Mode=TwoWay}" Width="300" Height="28"/>
                        </StackPanel>
                        <Button Content="{DynamicResource Loc.P.SystemNotification.Ui1}" Command="{Binding SendBasicCommand}" IsEnabled="{Binding IsSupported}" Width="150" Height="28"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Priority levels -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SystemNotification.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button Content="Low" Command="{Binding SendPriorityCommand}" CommandParameter="Low" IsEnabled="{Binding IsSupported}" Width="70" Height="28" Margin="0,0,10,10"/>
                        <Button Content="Normal" Command="{Binding SendPriorityCommand}" CommandParameter="Normal" IsEnabled="{Binding IsSupported}" Width="80" Height="28" Margin="0,0,10,10"/>
                        <Button Content="High" Command="{Binding SendPriorityCommand}" CommandParameter="High" IsEnabled="{Binding IsSupported}" Width="70" Height="28" Margin="0,0,10,10"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Notification with actions -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SystemNotification.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Button Content="{DynamicResource Loc.P.SystemNotification.Ui2}" Command="{Binding SendWithActionsCommand}" IsEnabled="{Binding IsSupported}" Width="150" Height="28" Margin="0,0,0,12"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding ActionResult}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Advanced options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SystemNotification.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tag:" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Tag, Mode=TwoWay}" Width="200" Height="28"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Group:" Width="80" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding Group, Mode=TwoWay}" Width="200" Height="28"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Expiration:" Width="80" VerticalAlignment="Center"/>
                            <Slider Minimum="0" Maximum="30" Value="{Binding ExpirationSeconds, Mode=TwoWay}" Width="150" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ExpirationSeconds, StringFormat='{}{0:F0}s'}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Loc.P.SystemNotification.Ui3}" IsChecked="{Binding IsSilent, Mode=TwoWay}" Margin="0,0,0,12"/>
                        <WrapPanel>
                            <Button Content="{DynamicResource Loc.P.SystemNotification.Ui4}" Command="{Binding SendAdvancedCommand}" IsEnabled="{Binding IsSupported}" Width="120" Height="28" Margin="0,0,10,10"/>
                            <Button Content="{DynamicResource Loc.P.SystemNotification.Ui5}" Command="{Binding RemoveTagCommand}" IsEnabled="{Binding IsSupported}" Width="120" Height="28" Margin="0,0,10,10"/>
                            <Button Content="{DynamicResource Loc.P.SystemNotification.Ui6}" Command="{Binding ClearAllCommand}" IsEnabled="{Binding IsSupported}" Width="100" Height="28" Margin="0,0,10,10"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Platform support -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.SystemNotification.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding SupportMessage}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="150"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.SystemNotification.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="350"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
