<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.SwipeControlPage"
      Title="SwipeControl">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="SwipeControl" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A touch-friendly control that reveals contextual actions such as Archive, Delete and Flag through swipe gestures on list items." />

        <!-- Swipe to reveal -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Swipe to reveal" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Swipe items left or right to reveal contextual actions like Archive and Delete." />
                <Border x:Name="SwipeContainer"
                        Style="{StaticResource GalleryDemoSurfaceFlush}"
                        MinHeight="200" />
            </StackPanel>
        </Border>

        <!-- Swipe action log -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Swipe action log" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Interact with the swipe items above to see the action results here." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <TextBlock x:Name="SwipeStatusText"
                               Style="{StaticResource GalleryBodyText}"
                               Text="No swipe action yet." />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a swipe control with left and right actions." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building swipe rows and wiring their action handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
