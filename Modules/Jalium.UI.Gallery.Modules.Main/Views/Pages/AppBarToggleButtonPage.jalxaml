<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.AppBarToggleButtonPage"
      Title="AppBarToggleButton">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="MENUS &amp; TOOLBARS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="AppBarToggleButton" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A toggle button designed for use in a CommandBar, holding a persistent checked or unchecked state to switch a setting on and off." />

        <!-- Text formatting -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Text Formatting" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Toggle buttons for text formatting options like Bold, Italic, and Underline." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <AppBarToggleButton x:Name="BoldToggle"
                                                Label="Bold"
                                                Width="72"
                                                Height="48"
                                                Margin="0,0,10,10" />
                            <AppBarToggleButton x:Name="ItalicToggle"
                                                Label="Italic"
                                                Width="72"
                                                Height="48"
                                                Margin="0,0,10,10" />
                            <AppBarToggleButton x:Name="UnderlineToggle"
                                                Label="Underline"
                                                Width="84"
                                                Height="48"
                                                Margin="0,0,10,10" />
                        </WrapPanel>

                        <TextBlock x:Name="FormattingPreviewText"
                                   Text="Sample text with formatting"
                                   FontSize="16"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Checked state -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Checked State" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Toggle buttons that display their IsChecked state." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <WrapPanel>
                            <AppBarToggleButton x:Name="WifiToggle"
                                                Label="Wi-Fi"
                                                Width="72"
                                                Height="48"
                                                Margin="0,0,10,10" />
                            <AppBarToggleButton x:Name="BluetoothToggle"
                                                Label="Bluetooth"
                                                Width="84"
                                                Height="48"
                                                Margin="0,0,10,10" />
                            <AppBarToggleButton x:Name="AirplaneModeToggle"
                                                Label="Airplane"
                                                Width="80"
                                                Height="48"
                                                Margin="0,0,10,10" />
                        </WrapPanel>

                        <TextBlock x:Name="CheckedStateText"
                                   Text="Wi-Fi: Off | Bluetooth: Off | Airplane Mode: Off"
                                   FontSize="12"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the toggle buttons above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C# Code Example" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring checked and unchecked handlers in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
