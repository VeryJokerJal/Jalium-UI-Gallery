<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TransitionDemoPage"
      Title="Content Transitions">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="EFFECTS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Content Transitions" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="TransitioningContentControl plays an animation whenever its content changes — pick a transition mode, then switch the content to watch the effect." />

        <!-- Transition settings -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Transition settings" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Choose a transition mode, then switch content once or auto-play through every mode in sequence." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Transition Mode:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="TransitionComboBox"
                                      Width="220"
                                      Height="32" />
                        </StackPanel>

                        <WrapPanel>
                            <Button x:Name="SwitchButton"
                                    Content="Switch Content"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10" />
                            <Button x:Name="AutoPlayButton"
                                    Content="Auto Play All"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Live preview -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Live preview" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="The selected transition plays each time the content swaps between panels A, B and C." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border Background="#1A1A1A"
                                CornerRadius="8"
                                Height="300"
                                ClipToBounds="True">
                            <TransitioningContentControl x:Name="TransitionControl"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch"/>
                        </Border>
                        <TextBlock x:Name="CurrentTransitionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="Current: Crossfade"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a clipped TransitioningContentControl." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Switching content, changing the transition mode and auto-playing every mode in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
