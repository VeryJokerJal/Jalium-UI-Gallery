<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TransitionDemoPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Content Transitions">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Effects}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.TransitionDemo.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.TransitionDemo.Sub1}" />

        <!-- Transition settings -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TransitionDemo.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TransitionDemo.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Transition Mode:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <ComboBox x:Name="TransitionComboBox"
                                      Width="220"
                                      Height="32"
                                      ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding SelectedMode, Mode=TwoWay}" />
                        </StackPanel>

                        <WrapPanel>
                            <Button x:Name="SwitchButton"
                                    Content="Switch Content"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding SwitchContentCommand}" />
                            <Button x:Name="AutoPlayButton"
                                    Content="{Binding AutoPlayButtonText}"
                                    Width="140"
                                    Height="32"
                                    Margin="0,0,10,10"
                                    Command="{Binding ToggleAutoPlayCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Live preview -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.TransitionDemo.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TransitionDemo.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border Background="{DynamicResource GalleryEffectStage}"
                                CornerRadius="8"
                                Height="300"
                                ClipToBounds="True">
                            <TransitioningContentControl x:Name="TransitionControl"
                                                         TransitionMode="{Binding SelectedMode}"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Border Width="120"
                                            Height="120"
                                            Background="{Binding ContentBackground}"
                                            CornerRadius="{Binding ContentCornerRadius}"
                                            HorizontalAlignment="Center"
                                            Margin="0,0,0,16">
                                        <TextBlock Text="{Binding ContentLetter}"
                                                   FontSize="48"
                                                   Foreground="#FFFFFF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding ContentTitle}"
                                               FontSize="18"
                                               Foreground="{DynamicResource GalleryTextPrimary}"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </TransitioningContentControl>
                        </Border>
                        <TextBlock x:Name="CurrentTransitionText"
                                   Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CurrentTransitionText}"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TransitionDemo.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TransitionDemo.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
