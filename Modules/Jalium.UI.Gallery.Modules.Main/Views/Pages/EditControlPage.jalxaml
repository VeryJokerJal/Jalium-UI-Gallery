<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.EditControlPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="EditControl">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.TextAndTypography}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.EditControl.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.EditControl.Sub1}" />

        <!-- Basic editor -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.EditControl.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.EditControl.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="MainEditor"
                                 Height="400"
                                 HorizontalAlignment="Stretch"
                                 FontSize="14"
                                 Text="{Binding EditorText, Mode=TwoWay}"
                                 Language="{Binding EditorLanguage}"
                                 ShowLineNumbers="{Binding ShowLineNumbers}"
                                 HighlightCurrentLine="{Binding HighlightCurrentLine}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 TabSize="4"
                                 ConvertTabsToSpaces="True"
                                 behaviors:EditControlBehavior.IsEnabled="True"
                                 behaviors:EditControlBehavior.Request="{Binding EditorRequest}" />
                </Border>

                <!-- Live status readout -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText"
                               Style="{StaticResource GalleryCaptionText}"
                               Text="{Binding DocumentStatus}"
                               Margin="0,0,16,0" />
                    <TextBlock x:Name="CursorPositionText"
                               Style="{StaticResource GalleryCaptionText}"
                               Text="{Binding CaretStatus}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Options}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.EditControl.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox Content="Show Line Numbers"
                                      IsChecked="{Binding ShowLineNumbers, Mode=TwoWay}"
                                      Margin="0,0,10,10" />
                            <CheckBox Content="Highlight Current Line"
                                      IsChecked="{Binding HighlightCurrentLine, Mode=TwoWay}"
                                      Margin="0,0,10,10" />
                            <CheckBox Content="Read Only"
                                      IsChecked="{Binding IsReadOnly, Mode=TwoWay}"
                                      Margin="0,0,10,10" />
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,10,10" />
                            <Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,10,10" />
                            <Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,10,10" />
                            <Button Content="Clear" Command="{Binding ClearCommand}" Margin="0,0,10,10" />
                            <Button Content="Load C# Sample" Command="{Binding LoadCSharpSampleCommand}" Margin="0,0,10,10" />
                            <Button Content="Load JALXAML Sample" Command="{Binding LoadJalxamlSampleCommand}" Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Keyboard shortcuts -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.KeyboardShortcuts}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.EditControl.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body1}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body2}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body3}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body4}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body5}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body6}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body7}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body8}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body9}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body10}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Architecture -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.EditControl.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.EditControl.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body11}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body12}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body13}" Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}" Text="{DynamicResource Loc.P.EditControl.Body14}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.EditControl.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.EditControl.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
