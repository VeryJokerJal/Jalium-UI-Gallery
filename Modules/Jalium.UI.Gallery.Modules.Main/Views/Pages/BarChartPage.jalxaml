<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.BarChartPage"
      Title="BarChart">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="DATA VISUALIZATION" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="BarChart" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Renders numeric series as grouped, stacked, or horizontal bars with optional value labels, gridlines, and a legend." />

        <!-- Grouped Bars -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Grouped Bars" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Multiple series displayed as grouped bars side by side for easy comparison." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="GroupedBarContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Stacked Bars -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Stacked Bars" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Series stacked on top of each other to show total and composition." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="StackedBarContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Horizontal Bars -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Horizontal Bars" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Bars rendered horizontally, useful for category comparisons with long labels." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel x:Name="HorizontalBarContainer" Orientation="Vertical" />
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for a grouped bar chart with two series." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building and configuring a BarChart with series and data points in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
