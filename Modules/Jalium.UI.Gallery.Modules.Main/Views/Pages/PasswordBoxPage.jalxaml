<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PasswordBoxPage"
      Title="PasswordBox">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="PasswordBox" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A secure text input that masks each character as it is typed, keeping entered passwords hidden from view." />

        <!-- Basic PasswordBox -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic PasswordBox" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Standard password input with masked characters." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <PasswordBox Width="300"
                                     Height="32"
                                     Margin="0,0,0,12"/>
                        <PasswordBox Width="300"
                                     Height="32"
                                     Password="secret123"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- PasswordBox states -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="PasswordBox States" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Enabled and disabled states." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <PasswordBox Width="200"
                                     Height="32"
                                     Margin="0,0,10,10"/>
                        <PasswordBox Width="200"
                                     Height="32"
                                     IsEnabled="False"
                                     Margin="0,0,10,10"/>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the password inputs above, plus a login form layout." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Handling PasswordChanged, validating matches and scoring password strength in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
