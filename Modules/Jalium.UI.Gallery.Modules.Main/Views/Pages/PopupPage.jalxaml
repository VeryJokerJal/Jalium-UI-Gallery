<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PopupPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Popup">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Overlays}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Popup.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Popup.Sub1}" />

        <!-- Basic popup -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Popup.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Popup.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShowPopupButton"
                                Content="Show Popup"
                                Command="{Binding ToggleBasicPopupCommand}"
                                Height="32" />
                        <Popup x:Name="BasicPopup"
                               IsOpen="{Binding IsBasicPopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=ShowPopupButton}"
                               Placement="Bottom">
                            <Border Background="{DynamicResource GalleryCardBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{DynamicResource Loc.P.Popup.Demo1}"
                                               Margin="0,0,0,8" />
                                    <Button x:Name="ClosePopupButton"
                                            Content="Close"
                                            Command="{Binding CloseBasicPopupCommand}"
                                            Width="80"
                                            Height="28" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Popup with form -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Popup.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Popup.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShowFormPopupButton"
                                Content="Quick Add"
                                Command="{Binding ToggleFormPopupCommand}"
                                Width="100"
                                Height="32" />
                        <Popup x:Name="FormPopup"
                               IsOpen="{Binding IsFormPopupOpen, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=ShowFormPopupButton}"
                               Placement="Bottom"
                               StaysOpen="True">
                            <Border Background="{DynamicResource GalleryCardBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="20"
                                    Width="250">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Quick Add Item"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16" />
                                    <TextBlock Text="Name"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox ToolTip="Enter name"
                                             Text="{Binding ItemName, Mode=TwoWay}"
                                             Height="32"
                                             Margin="0,0,0,12" />
                                    <TextBlock Text="Description"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox ToolTip="Enter description"
                                             Text="{Binding Description, Mode=TwoWay}"
                                             Height="32"
                                             Margin="0,0,0,16" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CancelFormButton"
                                                Content="Cancel"
                                                Command="{Binding CancelFormCommand}"
                                                Width="70"
                                                Height="28"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="SaveFormButton"
                                                Content="Save"
                                                Command="{Binding SaveFormCommand}"
                                                Width="70"
                                                Height="28" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Popup placement -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Popup.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Popup.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button x:Name="TopPopupButton" Content="Top" Height="32" Margin="0,0,10,10" />
                        <Button x:Name="RightPopupButton" Content="Right" Height="32" Margin="0,0,10,10" />
                        <Button x:Name="BottomPopupButton" Content="Bottom" Height="32" Margin="0,0,10,10" />
                        <Button x:Name="LeftPopupButton" Content="Left" Height="32" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Popup.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Popup.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
