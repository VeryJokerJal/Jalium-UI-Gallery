<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.PopupPage"
      Title="Popup">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="OVERLAYS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Popup" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A lightweight overlay surface that floats contextual content above the page, anchored to a target element and shown or dismissed on demand." />

        <!-- Basic popup -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic popup" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Toggle a small popup that opens directly below its trigger button." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShowPopupButton"
                                Content="Show Popup"
                                Height="32" />
                        <Popup x:Name="BasicPopup"
                               PlacementTarget="{Binding ElementName=ShowPopupButton}"
                               Placement="Bottom">
                            <Border Background="{DynamicResource GalleryCardBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="This is a popup!"
                                               Margin="0,0,0,8" />
                                    <Button x:Name="ClosePopupButton"
                                            Content="Close"
                                            Width="80"
                                            Height="28" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Popup with form -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Popup with form" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Popups can host richer content such as a multi-field form." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ShowFormPopupButton"
                                Content="Quick Add"
                                Width="100"
                                Height="32" />
                        <Popup x:Name="FormPopup"
                               PlacementTarget="{Binding ElementName=ShowFormPopupButton}"
                               Placement="Bottom"
                               StaysOpen="True">
                            <Border Background="{DynamicResource GalleryCardBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="20"
                                    Width="250">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="Quick Add Item"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,16" />
                                    <TextBlock Text="Name"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox ToolTip="Enter name"
                                             Height="32"
                                             Margin="0,0,0,12" />
                                    <TextBlock Text="Description"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBox ToolTip="Enter description"
                                             Height="32"
                                             Margin="0,0,0,16" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CancelFormButton"
                                                Content="Cancel"
                                                Width="70"
                                                Height="28"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="SaveFormButton"
                                                Content="Save"
                                                Width="70"
                                                Height="28" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Popup placement -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Popup placement" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Anchor a popup to the top, right, bottom or left edge of its target." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Button x:Name="TopPopupButton" Content="Top" Height="32" Margin="0,0,10,10" />
                        <Button x:Name="RightPopupButton" Content="Right" Height="32" Margin="0,0,10,10" />
                        <Button x:Name="BottomPopupButton" Content="Bottom" Height="32" Margin="0,0,10,10" />
                        <Button x:Name="LeftPopupButton" Content="Left" Height="32" Margin="0,0,10,10" />
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the popups above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Toggle each popup's IsOpen property to show or dismiss it from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
