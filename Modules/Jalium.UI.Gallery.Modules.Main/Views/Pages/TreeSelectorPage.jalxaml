<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.TreeSelectorPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="TreeSelector">

    <Page.Resources>
        <!-- The current virtualizing panel reports zero height during the
             first popup measure while it realizes an expanded hierarchy.
             These compact demo trees are intentionally non-virtualized so
             the Popup receives their complete desired height immediately. -->
        <ItemsPanelTemplate x:Key="TreeSelectorItemsPanel">
            <StackPanel />
        </ItemsPanelTemplate>
    </Page.Resources>

    <!-- The live examples project ViewModel nodes into the explicit
         TreeSelectorItem hierarchy required by the current API. -->
    <StackPanel x:Name="ContentPanel" Style="{StaticResource GalleryPageStack}">

        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Collections}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.TreeSelector.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.TreeSelector.Sub1}" />

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="单选模式" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.TreeSelector.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}" Text="{Binding SingleSelectionStatus}" Margin="0,0,0,8" />
                        <TreeSelector x:Name="SingleSelector"
                                      SelectionMode="Single"
                                      PlaceholderText="请选择节点"
                                      Width="320"
                                      HorizontalAlignment="Left"
                                      ItemsPanel="{StaticResource TreeSelectorItemsPanel}"
                                      AutoExpandSelected="True"
                                      behaviors:TreeSelectorBehavior.Nodes="{Binding Regions}"
                                      behaviors:TreeSelectorBehavior.StateKey="single" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="多选模式" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.TreeSelector.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding MultipleSelectionStatus}"
                                   Margin="0,0,0,8" />
                        <TreeSelector x:Name="MultipleSelector"
                                      SelectionMode="Multiple"
                                      ShowCheckBoxes="True"
                                      PlaceholderText="请选择城市 (可多选)"
                                      Width="360"
                                      HorizontalAlignment="Left"
                                      ItemsPanel="{StaticResource TreeSelectorItemsPanel}"
                                      behaviors:TreeSelectorBehavior.Nodes="{Binding Regions}"
                                      behaviors:TreeSelectorBehavior.StateKey="multiple" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="可搜索" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.TreeSelector.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="在触发器中输入文字过滤树，例如“浦”或“杭”。" Margin="0,0,0,8" />
                        <TreeSelector x:Name="SearchSelector"
                                      SelectionMode="Single"
                                      IsSearchEnabled="True"
                                      PlaceholderText="搜索..."
                                      Width="360"
                                      HorizontalAlignment="Left"
                                      ItemsPanel="{StaticResource TreeSelectorItemsPanel}"
                                      behaviors:TreeSelectorBehavior.Nodes="{Binding Regions}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="父子级联" />
                <TextBlock Style="{StaticResource GalleryCardCaption}" Text="{DynamicResource Loc.P.TreeSelector.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="勾选“华东地区”会一次性勾选所有子节点；再单独取消一个，父节点变成半选状态。" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding CascadeSelectionStatus}"
                                   Margin="0,0,0,8" />
                        <TreeSelector x:Name="CascadeSelector"
                                      SelectionMode="Multiple"
                                      ShowCheckBoxes="True"
                                      CheckCascadeMode="Cascade"
                                      PlaceholderText="请选择(支持级联)"
                                      Width="380"
                                      HorizontalAlignment="Left"
                                      ItemsPanel="{StaticResource TreeSelectorItemsPanel}"
                                      behaviors:TreeSelectorBehavior.Nodes="{Binding Regions}"
                                      behaviors:TreeSelectorBehavior.StateKey="cascade" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeSelector.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="220"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.TreeSelector.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="220"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
