<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DragDropPage"
      Title="Drag &amp; Drop">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="BASIC INPUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="Drag &amp; Drop" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Demonstrates DragEnter, DragOver, DragLeave, and Drop events, plus the Windows Shell enhancements: a caller-supplied drag image on the source, a Shell drop description on the target, and dragging files out to other applications via DoShellDragDrop." />

        <!-- Basic drag and drop -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Drag &amp; Drop" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag items from the source list and drop them into the target area." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <!-- Drag Source -->
                        <StackPanel Orientation="Vertical" Width="200" Margin="0,0,10,10">
                            <TextBlock Text="Drag Source"
                                       FontSize="13"
                                       Margin="0,0,0,8" />
                            <Border x:Name="DragItem1"
                                    Background="{DynamicResource GalleryAccent}"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <TextBlock Text="Item A" FontSize="13" />
                            </Border>
                            <Border x:Name="DragItem2"
                                    Background="#22C55E"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <TextBlock Text="Item B" FontSize="13" />
                            </Border>
                            <Border x:Name="DragItem3"
                                    Background="#D83B01"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <TextBlock Text="Item C" FontSize="13" />
                            </Border>
                        </StackPanel>

                        <!-- Drop Target -->
                        <Border x:Name="DropTarget"
                                Background="{DynamicResource GalleryCardAltBackground}"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Width="300"
                                MinHeight="140"
                                Padding="16"
                                Margin="0,0,10,10"
                                AllowDrop="True">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="DropTargetHint"
                                           Text="Drop items here"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <StackPanel x:Name="DroppedItemsPanel"
                                            Orientation="Vertical" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DragEnter / DragLeave feedback -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="DragEnter / DragLeave Feedback" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag an item over the zones below to see visual feedback on DragEnter and DragLeave." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <!-- Drag source for this demo -->
                        <Border x:Name="FeedbackDragSource"
                                Background="{DynamicResource GalleryAccent}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,16"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Drag me over the zones" FontSize="13" />
                        </Border>

                        <WrapPanel>
                            <Border x:Name="FeedbackZone1"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Width="150"
                                    Height="100"
                                    Margin="0,0,10,10"
                                    AllowDrop="True">
                                <TextBlock x:Name="FeedbackZone1Text"
                                           Text="Zone 1"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FeedbackZone2"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Width="150"
                                    Height="100"
                                    Margin="0,0,10,10"
                                    AllowDrop="True">
                                <TextBlock x:Name="FeedbackZone2Text"
                                           Text="Zone 2"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FeedbackZone3"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Width="150"
                                    Height="100"
                                    Margin="0,0,10,10"
                                    AllowDrop="True">
                                <TextBlock x:Name="FeedbackZone3Text"
                                           Text="Zone 3"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom drag image (drag source) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Custom Drag Image (drag source)" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag the item below. A caller-supplied image follows the cursor instead of an automatic element clone, using DragDrop.DoDragDrop(source, data, effects, dragImage, offset)." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border x:Name="CustomImageDragSource"
                                Background="{DynamicResource GalleryAccent}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,10,10"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="Drag me — custom image" FontSize="13" />
                        </Border>

                        <Border x:Name="CustomImageDropTarget"
                                Background="{DynamicResource GalleryCardAltBackground}"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Width="260"
                                MinHeight="80"
                                Padding="16"
                                Margin="0,0,10,10"
                                AllowDrop="True">
                            <TextBlock x:Name="CustomImageDropHint"
                                       Text="Drop here"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Windows Shell drop (external files) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Windows Shell Drop (external files)" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag one or more files from Windows Explorer onto the area below. Windows renders its own drag image (IDropTargetHelper), and the DragOver handler sets a Shell drop description via e.SetDropDescription(...)." />
                <Border x:Name="ShellDropTarget"
                        Background="{DynamicResource GalleryCardAltBackground}"
                        BorderBrush="{DynamicResource GalleryBorderDefault}"
                        BorderThickness="2"
                        CornerRadius="14"
                        MinHeight="140"
                        Padding="16"
                        AllowDrop="True">
                    <StackPanel Orientation="Vertical">
                        <TextBlock x:Name="ShellDropHint"
                                   Text="Drag files here from Explorer"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <StackPanel x:Name="ShellDroppedFilesPanel"
                                    Orientation="Vertical" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Drag out to Explorer (cross-process) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Drag Out to Explorer (cross-process)" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Drag the item below onto a Windows Explorer window or the desktop. Unlike the in-app drag, DragDrop.DoShellDragDrop runs a real OLE drag so the file is copied out to another application, with the Windows system drag image." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Border x:Name="DragOutSource"
                                Background="#7C3AED"
                                CornerRadius="8"
                                Padding="12,8"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="Drag me to Explorer (creates a .txt)" FontSize="13" />
                        </Border>
                        <TextBlock x:Name="DragOutStatus"
                                   Text="A temp file is created on drag; drop it into a folder to copy it out."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Event log -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource GalleryCardTitle}"
                               Text="Event Log"
                               Margin="0"
                               VerticalAlignment="Center" />
                    <Button x:Name="ClearLogButton"
                            Content="Clear"
                            Height="24"
                            FontSize="11"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Shows DragEnter, DragOver, DragLeave, and Drop events as they fire." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" MaxHeight="200">
                    <ScrollViewer x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="12">
                        <TextBlock x:Name="EventLogText"
                                   Text="(drag items to see events)"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup for the drag and drop demo above." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Wiring drag sources, drop targets and Shell enhancements in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
