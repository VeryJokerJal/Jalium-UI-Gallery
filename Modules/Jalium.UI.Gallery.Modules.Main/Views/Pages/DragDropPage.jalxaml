<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DragDropPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Drag &amp; Drop">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.BasicInput}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.DragDrop.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.DragDrop.Sub1}" />

        <!-- Basic drag and drop -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DragDrop.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <!-- Drag Source -->
                        <StackPanel Orientation="Vertical" Width="200" Margin="0,0,10,10">
                            <TextBlock Text="{DynamicResource Loc.P.DragDrop.Hint1}"
                                       FontSize="13"
                                       Margin="0,0,0,8" />
                            <Border behaviors:DragDropBehavior.SourceText="Item A"
                                    Background="{DynamicResource GalleryAccent}"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <TextBlock Text="Item A" FontSize="13" />
                            </Border>
                            <Border behaviors:DragDropBehavior.SourceText="Item B"
                                    Background="#22C55E"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <TextBlock Text="Item B" FontSize="13" />
                            </Border>
                            <Border behaviors:DragDropBehavior.SourceText="Item C"
                                    Background="#D83B01"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <TextBlock Text="Item C" FontSize="13" />
                            </Border>
                        </StackPanel>

                        <!-- Drop Target -->
                        <Border behaviors:DragDropBehavior.TargetRole="ItemList"
                                behaviors:DragDropBehavior.TargetName="DropTarget"
                                Background="{DynamicResource GalleryCardAltBackground}"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Width="300"
                                MinHeight="140"
                                Padding="16"
                                Margin="0,0,10,10"
                                AllowDrop="True">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding DropTargetHint}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DroppedItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F6CBD"
                                                    CornerRadius="4"
                                                    Padding="10,6"
                                                    Margin="0,0,0,4">
                                                <TextBlock Text="{Binding}"
                                                           Foreground="#FFFFFF"
                                                           FontSize="13" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- DragEnter / DragLeave feedback -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DragDrop.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <!-- Drag source for this demo -->
                        <Border behaviors:DragDropBehavior.SourceText="Feedback Item"
                                Background="{DynamicResource GalleryAccent}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,16"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Loc.P.DragDrop.Hint2}" FontSize="13" />
                        </Border>

                        <WrapPanel>
                            <Border behaviors:DragDropBehavior.TargetRole="Feedback"
                                    behaviors:DragDropBehavior.TargetName="Zone 1"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Width="150"
                                    Height="100"
                                    Margin="0,0,10,10"
                                    AllowDrop="True">
                                <TextBlock Text="Zone 1"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border behaviors:DragDropBehavior.TargetRole="Feedback"
                                    behaviors:DragDropBehavior.TargetName="Zone 2"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Width="150"
                                    Height="100"
                                    Margin="0,0,10,10"
                                    AllowDrop="True">
                                <TextBlock Text="Zone 2"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border behaviors:DragDropBehavior.TargetRole="Feedback"
                                    behaviors:DragDropBehavior.TargetName="Zone 3"
                                    Background="{DynamicResource GalleryCardAltBackground}"
                                    BorderBrush="{DynamicResource GalleryBorderDefault}"
                                    BorderThickness="2"
                                    CornerRadius="14"
                                    Width="150"
                                    Height="100"
                                    Margin="0,0,10,10"
                                    AllowDrop="True">
                                <TextBlock Text="Zone 3"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Custom drag image (drag source) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DragDrop.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <WrapPanel>
                        <Border behaviors:DragDropBehavior.SourceText="Custom Image Item"
                                behaviors:DragDropBehavior.UseCustomImage="True"
                                Background="{DynamicResource GalleryAccent}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,10,10"
                                VerticalAlignment="Center"
                                Cursor="Hand">
                            <TextBlock Text="{DynamicResource Loc.P.DragDrop.Hint3}" FontSize="13" />
                        </Border>

                        <Border behaviors:DragDropBehavior.TargetRole="CustomImage"
                                behaviors:DragDropBehavior.TargetName="CustomImageDropTarget"
                                Background="{DynamicResource GalleryCardAltBackground}"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="2"
                                CornerRadius="14"
                                Width="260"
                                MinHeight="80"
                                Padding="16"
                                Margin="0,0,10,10"
                                AllowDrop="True">
                            <TextBlock Text="{Binding CustomImageDropHint}"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Windows Shell drop (external files) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DragDrop.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC4}" />
                <Border behaviors:DragDropBehavior.TargetRole="ShellFiles"
                        behaviors:DragDropBehavior.TargetName="ShellDropTarget"
                        Background="{DynamicResource GalleryCardAltBackground}"
                        BorderBrush="{DynamicResource GalleryBorderDefault}"
                        BorderThickness="2"
                        CornerRadius="14"
                        MinHeight="140"
                        Padding="16"
                        AllowDrop="True">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="{Binding ShellDropHint}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding ShellDroppedFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               FontSize="12"
                                               Foreground="{DynamicResource GalleryTextSecondary}"
                                               Margin="0,2,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Drag out to Explorer (cross-process) -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.DragDrop.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <Border behaviors:DragDropBehavior.SourceText="JaliumGalleryDragDrop.txt"
                                behaviors:DragDropBehavior.ShellDragOut="True"
                                Background="#7C3AED"
                                CornerRadius="8"
                                Padding="12,8"
                                Cursor="Hand"
                                HorizontalAlignment="Left">
                            <TextBlock Text="{DynamicResource Loc.P.DragDrop.Hint4}" FontSize="13" />
                        </Border>
                        <TextBlock Text="{Binding DragOutStatus}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Event log -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource GalleryCardTitle}"
                               Text="{DynamicResource Loc.P.DragDrop.CT6}"
                               Margin="0"
                               VerticalAlignment="Center" />
                    <Button Content="Clear"
                            Command="{Binding ClearLogCommand}"
                            Height="24"
                            FontSize="11"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" MaxHeight="200">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="12">
                        <TextBlock Text="{Binding EventLog}"
                                   FontSize="12"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.DragDrop.CC8}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
