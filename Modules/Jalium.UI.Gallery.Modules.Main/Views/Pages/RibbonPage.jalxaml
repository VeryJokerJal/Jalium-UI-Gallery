<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:automation="clr-namespace:Jalium.UI.Automation;assembly=Jalium.UI.Core"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      xmlns:ribbon="clr-namespace:Jalium.UI.Controls.Ribbon;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.RibbonPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="Ribbon">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.MenusAndToolbars}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Ribbon.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Ribbon.Sub1}" />

        <!-- Live ribbon demo -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Ribbon.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Ribbon.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}" ClipToBounds="True">
                    <StackPanel Orientation="Vertical">
                        <ribbon:Ribbon x:Name="DemoRibbon"
                                       Title="Ribbon Demo"
                                       IsMinimized="{Binding IsRibbonMinimized, Mode=TwoWay}"
                                       SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                            <ribbon:Ribbon.QuickAccessToolBar>
                                <ribbon:RibbonQuickAccessToolBar>
                                    <Button Content="Save" Width="50" Height="22" FontSize="11"/>
                                    <Button Content="Undo" Width="50" Height="22" FontSize="11"/>
                                    <Button Content="Redo" Width="50" Height="22" FontSize="11"/>
                                </ribbon:RibbonQuickAccessToolBar>
                            </ribbon:Ribbon.QuickAccessToolBar>
                            <ribbon:RibbonTab Header="Home">
                                <ribbon:RibbonGroup Header="Clipboard">
                                    <Button x:Name="PasteButton" Content="Paste" Command="{Binding ExecuteCommand}" CommandParameter="Paste" Width="60" Height="28"/>
                                    <Button x:Name="CutButton" Content="Cut" Command="{Binding ExecuteCommand}" CommandParameter="Cut" Width="50" Height="24" FontSize="11"/>
                                    <Button x:Name="CopyButton" Content="Copy" Command="{Binding ExecuteCommand}" CommandParameter="Copy" Width="50" Height="24" FontSize="11"/>
                                </ribbon:RibbonGroup>
                                <ribbon:RibbonGroup Header="Font">
                                    <Button x:Name="BoldButton" Command="{Binding ExecuteCommand}" CommandParameter="Bold" Width="32" Height="32" ToolTip="Bold" automation:AutomationProperties.Name="Bold">
                                        <SymbolIcon Symbol="Bold" Width="15" Height="15" />
                                    </Button>
                                    <Button x:Name="ItalicButton" Command="{Binding ExecuteCommand}" CommandParameter="Italic" Width="32" Height="32" ToolTip="Italic" automation:AutomationProperties.Name="Italic">
                                        <SymbolIcon Symbol="Italic" Width="15" Height="15" />
                                    </Button>
                                    <Button x:Name="UnderlineButton" Command="{Binding ExecuteCommand}" CommandParameter="Underline" Width="32" Height="32" ToolTip="Underline" automation:AutomationProperties.Name="Underline">
                                        <SymbolIcon Symbol="Underline" Width="15" Height="15" />
                                    </Button>
                                </ribbon:RibbonGroup>
                                <ribbon:RibbonGroup Header="Paragraph">
                                    <Button Content="Left" Width="45" Height="24" FontSize="11"/>
                                    <Button Content="Center" Width="55" Height="24" FontSize="11"/>
                                    <Button Content="Right" Width="50" Height="24" FontSize="11"/>
                                </ribbon:RibbonGroup>
                            </ribbon:RibbonTab>
                            <ribbon:RibbonTab Header="Insert">
                                <ribbon:RibbonGroup Header="Tables">
                                    <Button x:Name="InsertTableButton" Content="Table" Command="{Binding ExecuteCommand}" CommandParameter="Insert Table" Width="60" Height="28"/>
                                </ribbon:RibbonGroup>
                                <ribbon:RibbonGroup Header="Illustrations">
                                    <Button Content="Picture" Width="65" Height="28"/>
                                    <Button Content="Shapes" Width="60" Height="28"/>
                                    <Button Content="Chart" Width="55" Height="28"/>
                                </ribbon:RibbonGroup>
                                <ribbon:RibbonGroup Header="Links">
                                    <Button Content="Hyperlink" Width="75" Height="28"/>
                                    <Button Content="Bookmark" Width="75" Height="28"/>
                                </ribbon:RibbonGroup>
                            </ribbon:RibbonTab>
                            <ribbon:RibbonTab Header="View">
                                <ribbon:RibbonGroup Header="Document Views">
                                    <Button Content="Read Mode" Width="80" Height="28"/>
                                    <Button Content="Print Layout" Width="90" Height="28"/>
                                    <Button Content="Web Layout" Width="80" Height="28"/>
                                </ribbon:RibbonGroup>
                                <ribbon:RibbonGroup Header="Zoom">
                                    <Button Content="Zoom In" Width="70" Height="28"/>
                                    <Button Content="Zoom Out" Width="70" Height="28"/>
                                    <Button Content="100%" Width="50" Height="28"/>
                                </ribbon:RibbonGroup>
                            </ribbon:RibbonTab>
                        </ribbon:Ribbon>

                        <!-- Simulated document canvas -->
                        <Border Background="{DynamicResource GalleryShellBackground}" Padding="16" Height="100">
                            <TextBlock x:Name="StatusText"
                                       Style="{StaticResource GalleryValueLabel}"
                                       Text="{Binding RibbonStatus}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Ribbon options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Ribbon.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Ribbon.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <CheckBox x:Name="MinimizeCheckBox"
                                  Content="Minimize ribbon (collapse tabs)"
                                  IsChecked="{Binding IsRibbonMinimized, Mode=TwoWay}"
                                  Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Selected Tab:" Width="100" VerticalAlignment="Center"/>
                            <ComboBox x:Name="TabSelectComboBox"
                                      SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                      Width="120"
                                      Height="28">
                                <ComboBoxItem Content="Home" IsSelected="True"/>
                                <ComboBoxItem Content="Insert"/>
                                <ComboBoxItem Content="View"/>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Ribbon components -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Ribbon.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Ribbon.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Style="{StaticResource GalleryBodyText}" Margin="0,0,0,6"
                                   Text="{DynamicResource Loc.P.Ribbon.Body1}"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Margin="16,0,0,6"
                                   Text="{DynamicResource Loc.P.Ribbon.Body2}"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Margin="32,0,0,6"
                                   Text="{DynamicResource Loc.P.Ribbon.Body3}"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Margin="0,0,0,6"
                                   Text="{DynamicResource Loc.P.Ribbon.Body4}"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Margin="0,0,0,6"
                                   Text="{DynamicResource Loc.P.Ribbon.Body5}"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}" Margin="0,0,0,6"
                                   Text="{DynamicResource Loc.P.Ribbon.Body6}"/>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Ribbon.Body7}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.XamlCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Ribbon.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="350"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharpCodeExample}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Ribbon.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="250"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
