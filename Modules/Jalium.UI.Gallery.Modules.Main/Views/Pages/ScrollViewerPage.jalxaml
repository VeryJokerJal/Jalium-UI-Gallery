<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.ScrollViewerPage"
      Title="ScrollViewer">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="LAYOUT" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="ScrollViewer" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="A container that clips its content to a fixed viewport and lets the user pan through the overflow with scrollbars, the mouse wheel or touch." />

        <!-- Vertical scrolling -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Vertical scrolling" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Content that exceeds the visible area can be scrolled vertically." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <ScrollViewer Height="150" VerticalScrollBarVisibility="Visible">
                        <StackPanel Orientation="Vertical" Margin="12">
                            <TextBlock Text="Scroll down to see more content..." FontSize="12" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource GalleryAccent}" Height="30" Margin="0,0,0,4">
                                <TextBlock Text="Item 1"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#22C55E" Height="30" Margin="0,0,0,4">
                                <TextBlock Text="Item 2"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#179842" Height="30" Margin="0,0,0,4">
                                <TextBlock Text="Item 3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#CA5010" Height="30" Margin="0,0,0,4">
                                <TextBlock Text="Item 4"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="#008272" Height="30">
                                <TextBlock Text="Item 5"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- Scrollbar visibility -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Scrollbar visibility options" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Control when scrollbars appear on each axis." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="8" Height="8" Background="{DynamicResource GalleryAccent}" CornerRadius="8" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Auto - Shows scrollbar only when needed" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="8" Height="8" Background="#22C55E" CornerRadius="8" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Visible - Always shows scrollbar" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="8" Height="8" Background="#179842" CornerRadius="8" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Hidden - Scrolling enabled, scrollbar hidden" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" Background="#CA5010" CornerRadius="8" Margin="0,0,8,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Disabled - No scrolling allowed" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Key properties -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Key properties" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Important ScrollViewer properties for reading and driving scroll state." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="VerticalScrollBarVisibility" Width="220"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Controls vertical scrollbar" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="HorizontalScrollBarVisibility" Width="220"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Controls horizontal scrollbar" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="VerticalOffset" Width="220"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Current vertical scroll position" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="HorizontalOffset" Width="220"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Current horizontal scroll position" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource GalleryValueLabel}" Text="ViewportHeight / ViewportWidth" Width="220"/>
                            <TextBlock Style="{StaticResource GalleryBodyText}" Text="Size of visible area" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Declarative markup showing common ScrollViewer configurations." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Building a ScrollViewer and reacting to scroll events in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
