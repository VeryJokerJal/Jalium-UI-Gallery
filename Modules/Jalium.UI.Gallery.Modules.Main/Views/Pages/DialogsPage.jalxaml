<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.DialogsPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="File Dialogs">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Dialogs}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.Dialogs.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.Dialogs.Sub1}" />

        <!-- Open File Dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui1}" Command="{Binding ShowDialogCommand}" CommandParameter="OpenFile" Width="100" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui2}" Command="{Binding ShowDialogCommand}" CommandParameter="OpenMultiple" Width="110" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui3}" Command="{Binding ShowDialogCommand}" CommandParameter="PickFolder" Width="118" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding SelectedFile}"
                                   Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding SelectedPickerFolder}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Save File Dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button Content="{DynamicResource Loc.P.Dialogs.Ui4}" Command="{Binding ShowDialogCommand}" CommandParameter="SaveFile" Width="100" Height="28" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding SavePath}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Folder Browser Dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button Content="{DynamicResource Loc.P.Dialogs.Ui5}" Command="{Binding ShowDialogCommand}" CommandParameter="BrowseFolder" Width="120" Height="28" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding SelectedFolder}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Shell Dialogs -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <WrapPanel>
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui6}" Command="{Binding ShowDialogCommand}" CommandParameter="PickIcon" Width="100" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui7}" Command="{Binding ShowDialogCommand}" CommandParameter="OpenWith" Width="105" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui8}" Command="{Binding ShowDialogCommand}" CommandParameter="FileProperties" Width="126" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui9}" Command="{Binding ShowDialogCommand}" CommandParameter="PrinterProperties" Width="140" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui10}" Command="{Binding ShowDialogCommand}" CommandParameter="VolumeProperties" Width="140" Height="28" Margin="0,0,10,10" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui11}" Command="{Binding ShowDialogCommand}" CommandParameter="MultiFileProperties" Width="156" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding SelectedIcon}"
                                   Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding OpenWithTarget}"
                                   Margin="0,0,0,6" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding PropertiesTarget}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Font Dialog -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT5}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Button Content="{DynamicResource Loc.P.Dialogs.Ui12}" Command="{Binding ShowDialogCommand}" CommandParameter="ChooseFont" Width="110" Height="28" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{DynamicResource Loc.P.Dialogs.Body1}" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding SelectedFont}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Message Dialogs -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT6}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC6}" />
                <TextBlock Style="{StaticResource GalleryBodyText}"
                           Text="{DynamicResource Loc.P.Dialogs.Body2}"
                           Margin="0,0,0,16" />

                <WrapPanel Margin="0,0,0,6">
                    <Border Style="{StaticResource GalleryDemoSurface}" Width="200" Margin="0,0,10,10">
                        <StackPanel>
                            <Border Style="{StaticResource GalleryChip}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.Dialogs.Chip1}" />
                            </Border>
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="{DynamicResource Loc.P.Dialogs.Body3}"
                                       Margin="0,0,0,12" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui13}"
                                    Command="{Binding ShowDialogCommand}"
                                    CommandParameter="Information"
                                    Width="108"
                                    Height="32" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GalleryDemoSurface}" Width="200" Margin="0,0,10,10">
                        <StackPanel>
                            <Border Style="{StaticResource GalleryChip}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.Dialogs.Chip2}" />
                            </Border>
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="{DynamicResource Loc.P.Dialogs.Body4}"
                                       Margin="0,0,0,12" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui14}"
                                    Command="{Binding ShowDialogCommand}"
                                    CommandParameter="Warning"
                                    Width="108"
                                    Height="32" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GalleryDemoSurface}" Width="200" Margin="0,0,10,10">
                        <StackPanel>
                            <Border Style="{StaticResource GalleryChip}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.Dialogs.Chip3}" />
                            </Border>
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="{DynamicResource Loc.P.Dialogs.Body5}"
                                       Margin="0,0,0,12" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui15}"
                                    Command="{Binding ShowDialogCommand}"
                                    CommandParameter="Error"
                                    Width="108"
                                    Height="32" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GalleryDemoSurface}" Width="200" Margin="0,0,10,10">
                        <StackPanel>
                            <Border Style="{StaticResource GalleryChip}" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource GalleryChipText}" Text="{DynamicResource Loc.P.Dialogs.Chip4}" />
                            </Border>
                            <TextBlock Style="{StaticResource GalleryBodyText}"
                                       Text="{DynamicResource Loc.P.Dialogs.Body6}"
                                       Margin="0,0,0,12" />
                            <Button Content="{DynamicResource Loc.P.Dialogs.Ui16}"
                                    Command="{Binding ShowDialogCommand}"
                                    CommandParameter="Confirm"
                                    Width="116"
                                    Height="32" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <Border x:Name="DialogResultAccent"
                                Background="#4C93FF"
                                CornerRadius="999"
                                Height="4"
                                Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.Dialogs.Cap1}"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource GalleryCardTitle}"
                                   Text="{Binding MessageCaption}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding MessageDescription}"
                                   Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryBodyText}"
                                   Text="{Binding MessageText}"
                                   Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{Binding MessageDetails}"
                                   Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryValueLabel}"
                                   Text="{Binding MessageResult}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Dialog Options -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.Dialogs.CT7}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC7}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Dialogs.Cap2}" Margin="0,0,0,4" />
                        <TextBox Text="Text files (*.txt)|*.txt|All files (*.*)|*.*"
                                 Height="28"
                                 Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}" Text="{DynamicResource Loc.P.Dialogs.Cap3}" Margin="0,0,0,4" />
                        <TextBox Text="C:\Users\Documents"
                                 Height="28"
                                 Margin="0,0,0,12" />
                        <CheckBox Content="{DynamicResource Loc.P.Dialogs.Ui17}" Margin="0,0,0,8" />
                        <CheckBox Content="{DynamicResource Loc.P.Dialogs.Ui18}" Margin="0,0,0,8" IsChecked="True" />
                        <CheckBox Content="{DynamicResource Loc.P.Dialogs.Ui19}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC8}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.Dialogs.CC9}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
