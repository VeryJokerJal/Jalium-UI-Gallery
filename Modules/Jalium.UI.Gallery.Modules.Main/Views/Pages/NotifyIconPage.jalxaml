<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.NotifyIconPage"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="NotifyIcon">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="{DynamicResource Loc.Shared.Overlays}" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="{DynamicResource Loc.P.NotifyIcon.Title1}" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="{DynamicResource Loc.P.NotifyIcon.Sub1}" />

        <!-- Basic tray icon -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NotifyIcon.CT1}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NotifyIcon.CC1}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tooltip:" Width="80" VerticalAlignment="Center" />
                            <TextBox x:Name="TooltipBox"
                                     Text="{Binding TooltipText, Mode=TwoWay}"
                                     Width="250"
                                     Height="28" />
                        </StackPanel>
                        <WrapPanel>
                            <Button x:Name="ShowIconButton" Content="Show Icon" Width="100" Height="28" Margin="0,0,10,10"
                                    Command="{Binding ShowIconCommand}" />
                            <Button x:Name="HideIconButton" Content="Hide Icon" Width="100" Height="28" Margin="0,0,10,10"
                                    Command="{Binding HideIconCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Balloon tips -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NotifyIcon.CT2}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NotifyIcon.CC2}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Title:" Width="80" VerticalAlignment="Center" />
                            <TextBox x:Name="BalloonTitleBox"
                                     Text="{Binding BalloonTitle, Mode=TwoWay}"
                                     Width="250"
                                     Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Text:" Width="80" VerticalAlignment="Center" />
                            <TextBox x:Name="BalloonTextBox"
                                     Text="{Binding BalloonText, Mode=TwoWay}"
                                     Width="250"
                                     Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Icon:" Width="80" VerticalAlignment="Center" />
                            <ComboBox x:Name="BalloonIconComboBox"
                                      Width="150"
                                      Height="28"
                                      ItemsSource="{Binding BalloonIcons}"
                                      SelectedItem="{Binding SelectedBalloonIcon, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Timeout:" Width="80" VerticalAlignment="Center" />
                            <Slider x:Name="BalloonTimeoutSlider"
                                    Minimum="1"
                                    Maximum="30"
                                    Value="{Binding BalloonTimeout, Mode=TwoWay}"
                                    Width="150"
                                    Margin="0,0,8,0" />
                            <TextBlock x:Name="BalloonTimeoutText"
                                       Text="{Binding BalloonTimeoutText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ShowBalloonButton"
                                Content="Show Balloon Tip"
                                Width="140"
                                Height="28"
                                Command="{Binding ShowBalloonCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Events -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NotifyIcon.CT3}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NotifyIcon.CC3}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="Event Log:" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource GalleryCardBackground}"
                                BorderBrush="{DynamicResource GalleryBorderDefault}"
                                BorderThickness="1"
                                CornerRadius="8" Padding="8" Height="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="EventLogText"
                                           Text="{Binding EventLogText}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <Button x:Name="ClearLogButton"
                                Content="Clear Log"
                                Width="100"
                                Height="24"
                                Margin="0,8,0,0"
                                Command="{Binding ClearLogCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Context menu -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.P.NotifyIcon.CT4}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NotifyIcon.CC4}" />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <CheckBox x:Name="EnableContextMenuCheckBox"
                                  Content="{DynamicResource Loc.P.NotifyIcon.Ui1}"
                                  IsChecked="{Binding IsContextMenuEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="{DynamicResource Loc.P.NotifyIcon.Cap1}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.Xaml}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NotifyIcon.CC5}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="jalxaml"
                                 Text="{Binding XamlExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="{DynamicResource Loc.Shared.CSharp}" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="{DynamicResource Loc.P.NotifyIcon.CC6}" />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="300"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 Language="csharp"
                                 Text="{Binding CSharpExample}"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
