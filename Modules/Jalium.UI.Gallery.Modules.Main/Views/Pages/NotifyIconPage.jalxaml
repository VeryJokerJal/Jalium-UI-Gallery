<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.NotifyIconPage"
      Title="NotifyIcon">

    <StackPanel Style="{StaticResource GalleryPageStack}">

        <!-- Page header -->
        <TextBlock Style="{StaticResource GalleryEyebrow}" Text="OVERLAYS" />
        <TextBlock Style="{StaticResource GalleryPageTitle}" Text="NotifyIcon" />
        <TextBlock Style="{StaticResource GalleryPageSubtitle}"
                   Text="Displays an icon in the system notification area (system tray), with support for tooltip text, balloon tips, context menus, and click events." />

        <!-- Basic tray icon -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Basic Tray Icon" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Show or hide an icon in the system tray with tooltip text." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Tooltip:" Width="80" VerticalAlignment="Center" />
                            <TextBox x:Name="TooltipBox" Text="Jalium.UI Gallery" Width="250" Height="28" />
                        </StackPanel>
                        <WrapPanel>
                            <Button x:Name="ShowIconButton" Content="Show Icon" Width="100" Height="28" Margin="0,0,10,10" />
                            <Button x:Name="HideIconButton" Content="Hide Icon" Width="100" Height="28" Margin="0,0,10,10" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Balloon tips -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Balloon Tips" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Show balloon tip notifications from the tray icon with different icon types." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Title:" Width="80" VerticalAlignment="Center" />
                            <TextBox x:Name="BalloonTitleBox" Text="Balloon Tip" Width="250" Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Text:" Width="80" VerticalAlignment="Center" />
                            <TextBox x:Name="BalloonTextBox" Text="This is a balloon tip from the tray." Width="250" Height="28" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Icon:" Width="80" VerticalAlignment="Center" />
                            <ComboBox x:Name="BalloonIconComboBox" Width="150" Height="28">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Info" IsSelected="True" />
                                <ComboBoxItem Content="Warning" />
                                <ComboBoxItem Content="Error" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Timeout:" Width="80" VerticalAlignment="Center" />
                            <Slider x:Name="BalloonTimeoutSlider" Minimum="1" Maximum="30" Value="5" Width="150" Margin="0,0,8,0" />
                            <TextBlock x:Name="BalloonTimeoutText" Text="5s" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ShowBalloonButton" Content="Show Balloon Tip" Width="140" Height="28" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Events -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Events" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="NotifyIcon raises events for click, double-click, and balloon tip interactions." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <TextBlock Text="Event Log:" Margin="0,0,0,8" />
                        <Border Background="#111111" CornerRadius="8" Padding="8" Height="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="EventLogText"
                                           Text="Interact with the tray icon to see events..."
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                        <Button x:Name="ClearLogButton" Content="Clear Log" Width="100" Height="24" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Context menu -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="Context Menu" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Assign a ContextMenu to the tray icon. Right-click the tray icon to see the menu." />
                <Border Style="{StaticResource GalleryDemoSurface}">
                    <StackPanel>
                        <CheckBox x:Name="EnableContextMenuCheckBox" Content="Enable context menu on tray icon" IsChecked="True" Margin="0,0,0,8" />
                        <TextBlock Style="{StaticResource GalleryCaptionText}"
                                   Text="The context menu includes: Show Window, Settings, About, Exit" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- XAML code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="XAML" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="NotifyIcon is a code-only component; declare the trigger buttons in markup and build the icon from code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="XamlCodeEditor"
                                 Height="200"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

        <!-- C# code example -->
        <Border Style="{StaticResource GalleryCard}">
            <StackPanel>
                <TextBlock Style="{StaticResource GalleryCardTitle}" Text="C#" />
                <TextBlock Style="{StaticResource GalleryCardCaption}"
                           Text="Creating the tray icon, wiring events, showing balloon tips, and attaching a context menu in code-behind." />
                <Border Style="{StaticResource GalleryDemoSurfaceFlush}">
                    <EditControl x:Name="CSharpCodeEditor"
                                 Height="300"
                                 HorizontalAlignment="Stretch"
                                 IsReadOnly="True"
                                 ShowLineNumbers="True"
                                 FontSize="13" />
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</Page>
