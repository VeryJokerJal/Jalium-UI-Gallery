<Page xmlns="http://schemas.jalium.ui/2024"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="clr-namespace:Jalium.UI.Gallery.Modules.Main.Behaviors"
      xmlns:converters="clr-namespace:Jalium.UI.Gallery.Modules.Main.Converters"
      xmlns:hosting="clr-namespace:Jalium.UI.Hosting;assembly=Jalium.UI.Controls"
      xmlns:presentation="clr-namespace:Jalium.UI.Gallery.Modules.Main.Presentation"
      x:Class="Jalium.UI.Gallery.Modules.Main.Views.Pages.GalleryDemoWorkbench"
      hosting:ViewModelLocator.AutoWireViewModel="True"
      Title="{Binding Title}">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <converters:StringEqualsConverter x:Key="StringEquals" />

        <Style x:Key="WorkbenchSegmentButton"
               TargetType="RadioButton">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background"
                    Value="{DynamicResource GalleryCardBackground}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource GalleryBorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground"
                    Value="{DynamicResource GalleryTextSecondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <ControlTemplate TargetType="RadioButton">
                    <Border Name="SegmentRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="SegmentRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryBackgroundHover}" />
                            <Setter TargetName="SegmentRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="SegmentRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryBackgroundPressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="SegmentRoot"
                                    Property="Background"
                                    Value="{DynamicResource GalleryAccentSoft}" />
                            <Setter TargetName="SegmentRoot"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GalleryAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource GalleryAccentDark}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid x:Name="WorkbenchRoot"
          Background="Transparent"
          behaviors:GalleryWorkbenchLayoutBehavior.IsEnabled="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="0" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding CategoryLabel}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GalleryAccent}"
                           Margin="0,0,0,5" />
                <TextBlock Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource GalleryTextPrimary}"
                           Margin="0,0,0,5" />
                <TextBlock Text="{Binding Description}"
                           FontSize="13"
                           Foreground="{DynamicResource GalleryTextTertiary}"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource GalleryAccentSoft}"
                    BorderBrush="{DynamicResource GalleryAccent}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="9,4"
                    VerticalAlignment="Top">
                <TextBlock Text="{DynamicResource Loc.Workbench.Ui1}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GalleryAccentDark}" />
            </Border>
        </Grid>

        <StackPanel Grid.Row="1"
                    Grid.Column="0">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui2}"
                                 GroupName="WorkbenchTabs"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ShowingPreview, Mode=OneWay}"
                                 Command="{Binding ShowPreviewCommand}" />
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui3}"
                                 GroupName="WorkbenchTabs"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ShowingCode, Mode=OneWay}"
                                 Command="{Binding ShowCodeCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui4}"
                                 GroupName="WorkbenchViewports"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ViewportMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Desktop}"
                                 Command="{Binding SetViewportCommand}"
                                 CommandParameter="Desktop" />
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui5}"
                                 GroupName="WorkbenchViewports"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ViewportMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Tablet}"
                                 Command="{Binding SetViewportCommand}"
                                 CommandParameter="Tablet" />
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui6}"
                                 GroupName="WorkbenchViewports"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ViewportMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Mobile}"
                                 Command="{Binding SetViewportCommand}"
                                 CommandParameter="Mobile" />
                </StackPanel>
            </Grid>

            <Border x:Name="PreviewFrame"
                    Visibility="{Binding ShowingPreview, Converter={StaticResource BooleanToVisibility}}"
                    Background="{Binding SurfaceBrush}"
                    BorderBrush="{Binding PreviewBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{Binding PreviewCornerRadius}"
                    Padding="{Binding PreviewPaddingThickness}"
                    MaxWidth="{Binding PreviewMaxWidth}"
                    HorizontalAlignment="Stretch"
                    ClipToBounds="True">
                <ContentPresenter x:Name="DemoContentPresenter"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Opacity="{Binding PreviewOpacity}"
                                  IsEnabled="{Binding IsPreviewEnabled}" />
            </Border>

            <StackPanel Visibility="{Binding ShowingCode, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="JALXAML"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GalleryTextPrimary}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="{DynamicResource Loc.Workbench.Ui7}"
                               FontSize="11"
                               Foreground="{DynamicResource GalleryTextTertiary}"
                               Margin="0,0,0,8" />
                    <Border Background="{DynamicResource GalleryCardInnerBackground}"
                            BorderBrush="{DynamicResource GalleryBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <EditControl Height="220"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     ShowLineNumbers="True"
                                     FontSize="13"
                                     Language="jalxaml"
                                     Text="{Binding ExampleMarkup}" />
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="C#"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GalleryTextPrimary}"
                               Margin="0,0,0,3" />
                    <TextBlock Text="{DynamicResource Loc.Workbench.Ui8}"
                               FontSize="11"
                               Foreground="{DynamicResource GalleryTextTertiary}"
                               Margin="0,0,0,8" />
                    <Border Background="{DynamicResource GalleryCardInnerBackground}"
                            BorderBrush="{DynamicResource GalleryBorderDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <EditControl Height="220"
                                     HorizontalAlignment="Stretch"
                                     IsReadOnly="True"
                                     ShowLineNumbers="True"
                                     FontSize="13"
                                     Language="csharp"
                                     Text="{Binding ExampleCSharp}" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Border x:Name="InspectorPanel"
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource GalleryCardBackground}"
                BorderBrush="{DynamicResource GalleryBorderDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,16,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Loc.Workbench.Ui9}"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="{DynamicResource GalleryTextPrimary}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{DynamicResource Loc.Workbench.Ui10}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GallerySuccess}"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Text="{DynamicResource Loc.Workbench.Ui11}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GalleryTextMuted}"
                           Margin="0,0,0,12" />

                <presentation:GalleryInspectorNumericStepper
                    Label="{DynamicResource Loc.Workbench.Ui16}"
                    Minimum="0"
                    Maximum="40"
                    Step="2"
                    Suffix="px"
                    Value="{Binding PreviewPadding, Mode=TwoWay}" />
                <presentation:GalleryInspectorNumericStepper
                    Label="{DynamicResource Loc.Workbench.Ui17}"
                    Minimum="0"
                    Maximum="24"
                    Step="2"
                    Suffix="px"
                    Value="{Binding CornerRadius, Mode=TwoWay}" />
                <presentation:GalleryInspectorNumericStepper
                    Label="{DynamicResource Loc.Workbench.Ui18}"
                    Minimum="40"
                    Maximum="100"
                    Step="5"
                    Suffix="%"
                    Value="{Binding PreviewOpacityPercent, Mode=TwoWay}" />

                <ToggleSwitch Header="{DynamicResource Loc.Workbench.Ui21}"
                              IsOn="{Binding IsPreviewEnabled, Mode=TwoWay}"
                              Foreground="{DynamicResource GalleryTextSecondary}"
                              OnBackground="{DynamicResource GalleryAccent}"
                              Margin="0,2,0,16" />

                <Border Height="1"
                        Background="{DynamicResource GalleryBorderSubtle}"
                        Margin="0,0,0,16" />

                <TextBlock Text="{DynamicResource Loc.Workbench.Ui12}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GalleryTextMuted}"
                           Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,14">
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui14}"
                                 Width="82"
                                 GroupName="WorkbenchThemes"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Light}"
                                 Command="{Binding UseLightThemeCommand}" />
                    <RadioButton Content="{DynamicResource Loc.Workbench.Ui15}"
                                 Width="82"
                                 GroupName="WorkbenchThemes"
                                 Style="{StaticResource WorkbenchSegmentButton}"
                                 IsChecked="{Binding ThemeMode, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Dark}"
                                 Command="{Binding UseDarkThemeCommand}" />
                </StackPanel>

                <presentation:GalleryInspectorColorEditor
                    Label="{DynamicResource Loc.Workbench.Ui19}"
                    PaletteKind="Accent"
                    Color="{Binding Accent, Mode=TwoWay}" />
                <presentation:GalleryInspectorColorEditor
                    Label="{DynamicResource Loc.Workbench.Ui20}"
                    PaletteKind="Surface"
                    Color="{Binding Surface, Mode=TwoWay}" />

                <Button Content="{DynamicResource Loc.Workbench.Ui13}"
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource GalleryCardInnerBackground}"
                        BorderBrush="{DynamicResource GalleryBorderDefault}"
                        Foreground="{DynamicResource GalleryTextSecondary}"
                        ToolTip="Restore the default preview settings"
                        Command="{Binding ResetCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
